

FUNCTION DENCF 

(P$INSTR VARCHAR2) RETURN VARCHAR2 IS
   V$STRLEN NUMBER  := LENGTH(P$INSTR) ;
   V$CURCHR VARCHAR2(2):= CHR(SUBSTR(P$INSTR,1,2)-2);
   V$NXTCHR VARCHAR2(2);
    V$OUTSTR VARCHAR2(300);
   BEGIN
     V$OUTSTR :=V$CURCHR;
   FOR I IN 1 .. V$STRLEN+4
    LOOP
  IF MOD(I,2)=0 THEN
          V$CURCHR := CHR(SUBSTR(P$INSTR-2,I+1,2)-2)  ;
          V$NXTCHR := CHR((SUBSTR(P$INSTR-2,I+1,2)-2));
          V$OUTSTR := V$OUTSTR ||V$CURCHR;
  END IF;
  END LOOP ;
          RETURN V$OUTSTR ;
     END;


FUNCTION ENCF 
(VP$INSTR VARCHAR2) RETURN VARCHAR2 IS
   P$INSTR  VARCHAR2(30) := UPPER(VP$INSTR);
   V$STRLEN NUMBER  := LENGTH(P$INSTR) ;
   V$PRVCHR NUMBER  ;
   V$CURCHR NUMBER  :=ASCII(SUBSTR(P$INSTR,1,1));
   V$NXTCHR NUMBER  ;
   V$OUTSTR VARCHAR2(300);
  BEGIN
     V$OUTSTR :=V$CURCHR +2 ;
   FOR I IN 1 .. V$STRLEN LOOP
 --    V$PRVCHR := SUBSTR(P$INSTR,I-1,1);
    V$CURCHR := ASCII(SUBSTR(P$INSTR,I,1))  ;
    V$NXTCHR := ASCII(SUBSTR(P$INSTR,I+1,1));
    V$OUTSTR := V$OUTSTR ||V$NXTCHR+2;
  END LOOP ;
    RETURN V$OUTSTR ;
  END;


FUNCTION ENCRYPT
(P$INSTR VARCHAR2) RETURN VARCHAR2 IS
 V$STRLEN NUMBER  := LENGTH(P$INSTR) ;
 V$PRVCHR NUMBER  := ASCII(SUBSTR(P$INSTR,-1,1)) ;
 V$CURCHR NUMBER  := ASCII(SUBSTR(P$INSTR,1,1)) ;
 V$NXTCHR NUMBER  := ASCII(SUBSTR(P$INSTR,2,1)) ;
 V$OUTSTR VARCHAR2(300);
BEGIN
   V$OUTSTR := CHR(V$CURCHR - V$PRVCHR + V$NXTCHR);
  FOR I IN 2 .. V$STRLEN-11 LOOP
  V$PRVCHR := ASCII(SUBSTR(P$INSTR,I-1,1));
  V$CURCHR := ASCII(SUBSTR(P$INSTR,I,1));
  V$NXTCHR := ASCII(SUBSTR(P$INSTR,I+1,1));
    V$OUTSTR := V$OUTSTR || CHR(V$CURCHR - V$PRVCHR + V$NXTCHR);
 END LOOP ;
  V$PRVCHR := ASCII(SUBSTR(P$INSTR,V$STRLEN-1,1));
  V$CURCHR := ASCII(SUBSTR(P$INSTR,V$STRLEN,1));
  V$NXTCHR := ASCII(SUBSTR(P$INSTR,1,1));
  V$OUTSTR := V$OUTSTR || CHR(V$CURCHR - V$PRVCHR + V$NXTCHR);
 RETURN V$OUTSTR ;
END;



FUNCTION ENCRYPTN
(P$INSTR VARCHAR2) RETURN VARCHAR2 IS

 V$STRLEN NUMBER  := LENGTH(P$INSTR) ;
 V$PRVCHR NUMBER  := ASCII(SUBSTR(P$INSTR,-1,1))+17 ;
 V$CURCHR NUMBER  := ASCII(SUBSTR(P$INSTR,1,1))+19 ;
 V$NXTCHR NUMBER  := ASCII(SUBSTR(P$INSTR,2,1))+16 ;
 V$OUTSTR VARCHAR2(300);
 
BEGIN

   V$OUTSTR := CHR(V$CURCHR - V$PRVCHR + V$NXTCHR);
  FOR I IN 2 .. V$STRLEN LOOP
  V$PRVCHR := ASCII(SUBSTR(P$INSTR,I-1,1))+13;
  V$CURCHR := ASCII(SUBSTR(P$INSTR,I,1))+12;
  V$NXTCHR := ASCII(SUBSTR(P$INSTR,I+1,1))+14;
    V$OUTSTR := V$OUTSTR || CHR(V$CURCHR - V$PRVCHR + V$NXTCHR);
 END LOOP ;
  V$PRVCHR := ASCII(SUBSTR(P$INSTR,V$STRLEN-1,1))+15;
  V$CURCHR := ASCII(SUBSTR(P$INSTR,V$STRLEN,1))+12;
  V$NXTCHR := ASCII(SUBSTR(P$INSTR,1,1))+13;
  V$OUTSTR := V$OUTSTR || CHR(V$CURCHR - V$PRVCHR + V$NXTCHR);
 
 RETURN V$OUTSTR ;
END;
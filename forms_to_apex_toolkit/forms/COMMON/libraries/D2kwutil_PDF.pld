Procedure Set_Pointer(FileHandle       IN     Win_API_PDF.FILE_TYPE,
 					   StartPos        IN     VARCHAR2,
 					   Offset          IN     PLS_INTEGER,
                       RaiseExceptions IN     BOOLEAN DEFAULT FALSE) is
  iRC       PLS_INTEGER;
  iOrigin   PLS_INTEGER;
 begin
   Win_API_Debug_PDF.DebugLog(99,'Set_Pointer','Args:  FileHandle='||to_char(FileHandle)||', StartPos="'||StartPos||'", Offset='||to_char(Offset)||', RaiseExceptions='||Win_API_Debug_PDF.booltochar(RaiseExceptions));
   Win_API_PDF.Clean_Error_Stack;
   if Win_API_PDF.API_ENABLED then
  	CheckFileHandle('Set_Pointer',FileHandle); 
    Win_API_PDF.Register_function_call(iFileSeek,'d2kwutil_FileSeek','LONG','LONG,LONG,INT'); 
    
    if upper(StartPos)    = 'START' then
    	iOrigin := 0; 
    elsif upper(StartPos) = 'END' then 
    	iOrigin := 2; 
    elsif upper(StartPos) = 'CURRENT' then 
        iOrigin := 1; 
    else
        Win_API_PDF.Add_error('Set_Pointer','Invalid StartPos: valid Values are START, END or CURRENT');
    end if;
    
    iRC := d2kwutil_FileSeek(Win_API_PDF.FunctionHandle(iFileSeek),FileHandle,Offset,iOrigin);
    if iRC <> 0 then 
    	 Win_API_PDF.Add_error('Set_Pointer','Set_Pointer failed RC='||to_char(iRC));
    	 if RaiseExceptions then 
    	 	raise NO_DATA_FOUND;
    	 end if;
    end if;
  end if;
exception
  when NO_DATA_FOUND then 
    if RaiseExceptions then 
    	raise;
    end if;
  when Win_API_PDF.NOT_AVAILABLE then
    Win_API_PDF.Add_error('Set_Pointer',Win_API_PDF.NoAPI);
    raise;
  when others then 
    Win_API_PDF.Add_error('Set_Pointer', Win_API_PDF.UError||Win_API_PDF.Add_External_errors); 
    raise;
end;


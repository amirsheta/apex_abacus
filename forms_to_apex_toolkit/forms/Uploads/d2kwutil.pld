END WIN_API_BITOP;


PACKAGE BODY Win_API is 

  -- Private Constants
   DLL32Bit		CONSTANT	VARCHAR2(12) := 'D2KWUT32.DLL';
   DLL16Bit		CONSTANT	VARCHAR2(12) := 'D2KWUT16.DLL';
 
  -- Private Variables
   DLL_NAME		VARCHAR2(12)		:= DLL32Bit;
   DLL_PATH		VARCHAR2(256)		:= NULL;
   DLL_LOAD_COUNT	PLS_INTEGER		:= 0; 
   iPreLoadCount	PLS_INTEGER		:= 0;
   vcTestPath		VARCHAR2(256) 		:= NULL;


  -- Private Function and Procedure Declarations
   FUNCTION  Attempt_DLL_Load	(TargetPath	in out	VARCHAR2,
				 TargetDLL	in	VARCHAR2,
				 LoadCount	in 	BOOLEAN DEFAULT TRUE) return ORA_FFI.LibHandleType;



  -- Function and Procedure Bodies

   PROCEDURE PreLoad is
   begin 
	Win_API.Clean_Error_Stack;
	if WIN_API.API_ENABLED then 
		if not Win_API.Check_DLL_Handle(iPreLoadCount)  then
			null;
		end if;
	else 
		raise WIN_API.NOT_AVAILABLE;
	end if;  
   exception
	when WIN_API.NOT_AVAILABLE then
		Win_API.Add_error(Win_API.NoAPI);
		raise;
	when others then
		Win_API.Add_error('PreLoad:'||Win_API.UError||WIN_API.Add_External_errors); 
		raise;
   end PreLoad;

   PROCEDURE Clean_Error_Stack is
   begin 
	-- just empty the variables
	ERROR_ENCOUNTERED	:= FALSE;
	ERROR_STACK		:= NULL;
   end Clean_Error_Stack;


   PROCEDURE Add_Error (Set_Error_Text in varchar2) is
   begin 
 	-- Just watch for value errors 
	ERROR_ENCOUNTERED	:= TRUE;
	ERROR_STACK		:= substr(Set_Error_Text,1,2000);
   end Add_Error;

   FUNCTION Add_External_Errors return varchar2 is
	iCounter	pls_integer;
	vcErrBuff	varchar2(2000);
   begin 
	if tool_err.nerrors > 0 then 
		for iCounter in 1..tool_err.nerrors LOOP
			begin 
				vcErrBuff := vcErrBuff||chr(10)||tool_err.message;
			exception
				when VALUE_ERROR then 
					exit; /* String exceeds 2000 long */
			end;
			tool_err.pop;
		end loop;
	elsif SQLERRM is not null then 
		vcErrBuff := chr(10)||SQLERRM; 
	end if;
	return vcErrBuff;
   end Add_External_Errors;


   FUNCTION Check_DLL_Handle (LocalLoadCount in PLS_INTEGER) RETURN BOOLEAN is
   begin 
	DLL_HANDLE := ORA_FFI.find_library(DLL_NAME);
	if LocalLoadCount <> DLL_LOAD_COUNT then
		return FALSE;
	else
		RETURN TRUE;
	end if;
   exception
	when others then 
		begin 
			DLL_HANDLE := Attempt_DLL_Load(DLL_Path, DLL_NAME);
			RETURN FALSE;
		exception
			when others then 
				API_ENABLED := FALSE;
 				add_error('API DLL '||DLL_NAME||' not found.');
				RAISE NO_DATA_FOUND;
		end;
   end;


   FUNCTION  Attempt_DLL_Load	(TargetPath in out VARCHAR2, TargetDLL in VARCHAR2, LoadCount in BOOLEAN DEFAULT TRUE) return ORA_FFI.LibHandleType is
	hDLL	ORA_FFI.LibHandleType;
   begin 
	if TargetPath is not null then 
		-- strip off trailing semicolon
		if substr(TargetPath,-1,1) = ';' then 
			TargetPath := substr(TargetPath,1,length(TargetPath)-1);
		end if;
		-- Add trailing Directory Sep if required
		TargetPath := StripDirSep(TargetPath)||'\';
	end if;

	hDLL := ORA_FFI.LOAD_LIBRARY(TargetPath, TargetDLL);
	if LoadCount then 
		DLL_LOAD_COUNT	:= DLL_LOAD_COUNT + 1;
		API_ENABLED	:= TRUE;
	end if;
	return hDLL;
   exception
	when others then 
		API_ENABLED := FALSE;
		return hDLL; /* Will be null */
   end Attempt_DLL_Load;

  Function StripDirSep ( InPath in varchar2) return varchar2 is 
	vcPath	varchar2(500) := InPath;
  begin 
	-- Check and Strip SemiColons
	if substr(vcPath,-1,1) = ';' then 
		vcPath := substr(vcPath,1,length(vcPath)-1);
	end if;

	-- Check and Strip '\'
	if substr(vcPath,-1,1) = '\' then 
		vcPath := substr(vcPath,1,length(vcPath)-1);
	end if;
	
	return vcPath;
  end;

BEGIN
   /*----------------------------------------------------------------------------*\
    * This body section is only run once (per instance of the PLL)
    * and sets up all required flags and paths.
   \*----------------------------------------------------------------------------*/   
 
   -- 1. Attempt to detect O/S 
   declare
    hKern	ora_ffi.libHandleType;
   begin	/* Attempt to find/load 32 bit DLL */
	hKern := Attempt_DLL_Load( vcTestPath /* NULL */,'KERNEL32.DLL',FALSE);
	if not ora_ffi.is_null_ptr(hKern) then 
		Is32Bit := TRUE;
	end if;
   exception
  	when NO_DATA_FOUND then  /* Can't find 32 bit indicators */
		begin   /* Attempt to load 16 bit DLL */
			hKern := Attempt_DLL_Load( vcTestPath /* NULL */,'KRNL386.EXE',FALSE);
			if not ora_ffi.is_null_ptr(hKern) then 
				Is32Bit := FALSE;
			end if;
		exception
		   	when others then 
				-- If we have got this far then we cannot load
				-- any windows Kernel libs so we must assume this 
				-- is not a Windows machine 
				raise WIN_API.NOT_AVAILABLE;
		end; 
   end;/* 1. Attempt to detect OS */

   -- 2. Locate the actual API DLL
   begin 
	--Set the Correct Name for the DLL
        --
	if Is32Bit then 
		DLL_NAME := DLL32Bit;
	else 
		DLL_NAME := DLL16Bit;
	end if;

	begin 
		-- Check the debug location first if the variable D2KWUTIL_PATH is set in the 
		-- Oracle.ini or hkey_local_machine/software/oracle section of the registry
		-- This variable is not *required* and is only used to load from a non 
		-- Default location (e.g. not Windows, Windows/system, or $ORACLE_HOME/bin 
		TOOL_ENV.GETVAR('D2KWUTIL_PATH',DLL_PATH);
		-- If the variable did not exist then DLL_PATH will still be null.
		DLL_HANDLE	:= Attempt_DLL_load(DLL_PATH,DLL_NAME);
	exception
		when others then /* Try from $ORACLE_HOME\bin */
			-- Set the path to $ORACLE_HOME\bin
			TOOL_ENV.GETVAR('ORACLE_HOME',DLL_PATH);
			if DLL_PATH is not null then 
				DLL_PATH := DLL_PATH||'\bin';
			
				-- now try and load from $ORACLE_HOME\bin
				begin 
					DLL_HANDLE	:= Attempt_DLL_load(DLL_PATH,DLL_NAME);
				exception
					when NO_DATA_FOUND then 
						raise WIN_API.NOT_AVAILABLE;
				end;
			else
				raise WIN_API.NOT_AVAILABLE;
			end if;
	end;
	
	-- at this point we have a handle to the DLL so all is ok.
	if not ora_ffi.is_null_ptr(DLL_HANDLE) then 
		API_ENABLED := TRUE;
	end if;
  end;

EXCEPTION
	when WIN_API.NOT_AVAILABLE then 
		API_ENABLED := FALSE;
		Win_API.Add_error(Win_API.NoAPI);
	when others then 
		add_error('Unexpected error starting D2KWUTIL '||add_external_errors);
END Win_API; /* End Package Body Win API */



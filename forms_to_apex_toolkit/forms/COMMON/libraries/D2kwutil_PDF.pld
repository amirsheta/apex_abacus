    Win_API_PDF.Add_error('Get_Net_Connection',Win_API_PDF.UError||Win_API_PDF.Add_External_errors); 
    raise;
end Get_Net_Connection;


FUNCTION Read_Registry (RegPath         IN  VARCHAR2,
                        RegEntry        IN  VARCHAR2, 
                        RaiseExceptions IN  BOOLEAN DEFAULT FALSE)  RETURN VARCHAR2 is
  vcBuff1    VARCHAR2(512);
  vcBuff2    VARCHAR2(512);
  vcBuff3    VARCHAR2(2000);
  vcBuff4    VARCHAR2(512);
  vcBuff5    VARCHAR2(512);                        
  vcRoot     VARCHAR2(20);
  iBuff1     PLS_INTEGER;
  iBuff2     PLS_INTEGER;
  iBuff3		 PLS_INTEGER;
  iRC        PLS_INTEGER;
begin
  Win_API_Debug_PDF.DebugLog(99,'Read_Registry','Args: RegPath="'||RegPath||'", RegEntry="'||RegEntry||'", RaiseExceptions='||Win_API_Debug_PDF.booltochar(RaiseExceptions));	  
  Win_API_PDF.Clean_Error_Stack;
  iRC  := 0;
  if Win_API_PDF.API_ENABLED then 
    Win_API_PDF.Register_function_call(iGetRegKey,'d2kwutil_GetRegKey','INT','INT,*CHAR,*CHAR,*CHAR,INT,INT');  
    -- Which Root?
    vcRoot  := upper(substr(RegPath,1,instr(RegPath,'\')-1));
    if      vcRoot =  'HKEY_LOCAL_MACHINE' then 
      iBuff1 := 0;
    elsif   vcRoot =  'HKEY_CLASSES_ROOT' then 
      iBuff1 := 1;
    elsif   vcRoot =  'HKEY_CURRENT_USER' then 
      iBuff1 := 2;
    elsif   vcRoot =  'HKEY_USERS' then
      iBuff1 := 3;
    elsif   vcRoot =  'HKEY_CURRENT_CONFIG' then
      iBuff1 := 4;      
    else
      Win_API_PDF.Add_error('Read_Registry','Invalid Registry Key '||RegPath);
      if  RaiseExceptions then
        raise NO_DATA_FOUND;
      end if;  
    end if;

    iBuff2     := 2000; /* Length of buffer */
    vcBuff1    := substr(RegPath,instr(RegPath,'\')+1);
    vcBuff2    := RegEntry;
    vcBuff3    := RPAD(SUBSTR(NVL(vcBuff3,' '),1,2000),2000,CHR(0));
    if not Win_API_PDF.COMPAT_EXPAND_REG_VALUES then 
    	iBuff3 := 1;
    	Win_API_Debug_PDF.DebugLog(99,'Read_Registry','Compatibility: Reg Value expansion supressed');	  
    else
    	iBuff3 := 0;
    end if;
    
    iRC        := d2kwutil_GetRegKey(Win_API_PDF.FunctionHandle(iGetRegKey),iBuff1,vcBuff1,vcBuff2,vcBuff3,iBuff2,iBuff3);
    Win_API_Debug_PDF.DebugLog(99,'Read_Registry','Result:  RC='||to_char(iRC)||', vcBuff3="'||vcBuff3||'"');	      
  else 
    raise Win_API_PDF.NOT_AVAILABLE;
  end if;  
  if iRC = -1  then 
    Win_API_PDF.Add_error('Read_Registry','Cannot read  entry '||RegPath||'->'||RegEntry);
    if not RaiseExceptions then
      return NULL;
    else 
      raise NO_DATA_FOUND;
    end if;
  elsif iRC = -2 then
    Win_API_PDF.Add_error('Read_Registry', RegPath||'->'||RegEntry||' is an unsupported datatype');
    if not RaiseExceptions then
      return NULL;
    else 
      raise NO_DATA_FOUND;
    end if;
  elsif iRC = -3 then
    Win_API_PDF.Add_error('Read_Registry',RegPath||'->'||RegEntry||' is longer than '||to_char(iBuff2)||' Bytes');
    if not RaiseExceptions then
      return NULL;
    else 
      raise VALUE_ERROR;
    end if;
  elsif iRC = -4 then
    Win_API_PDF.Add_error('Read_Registry', RegPath||'->'||RegEntry||' Failed to expand environment string');
    if not RaiseExceptions then
      return NULL;
    else 
      raise NO_DATA_FOUND;
    end if;    
  end if;
  return vcBuff3;
exception
  when NO_DATA_FOUND then 
    raise;
  when VALUE_ERROR then 
    raise;
  when Win_API_PDF.NOT_AVAILABLE then
    Win_API_PDF.Add_error('Read_Registry',Win_API_PDF.NoAPI);
    raise;
  when others then 
    Win_API_PDF.Add_error('Read_Registry',Win_API_PDF.UError||Win_API_PDF.Add_External_errors); 
    raise;
end Read_Registry;

PROCEDURE Wrap_Write_Registry(  CalledBy        IN  VARCHAR2,
                                RegPath         IN  VARCHAR2,
                                RegEntry        IN  VARCHAR2, 
                                RegValue        IN  VARCHAR2, 
                                RegFormat       IN  PLS_INTEGER,
                                RaiseExceptions IN  BOOLEAN DEFAULT FALSE) is
  vcBuff1    VARCHAR2(512);
  vcBuff2    VARCHAR2(512);
  vcBuff3    VARCHAR2(512);
  vcRoot     VARCHAR2(20);
  iBuff1     PLS_INTEGER;
  iBuff2     PLS_INTEGER;
  iBuff3     PLS_INTEGER;
  iRC        PLS_INTEGER;
  iNullInd	 PLS_INTEGER := 0;
begin 
  Win_API_Debug_PDF.DebugLog(99,'Wrap_Write_Registry','Args: CalledBy="'||CalledBy||'", RegPath="'||RegPath||'", RegEntry="'||RegEntry||'", RegValue="'||RegValue||'", RegFormat='||to_char(RegFormat)||', RaiseExceptions='||Win_API_Debug_PDF.booltochar(RaiseExceptions));	  	
  Win_API_PDF.Clean_Error_Stack;
  iRC  := 0;
  if Win_API_PDF.API_ENABLED then 
    Win_API_PDF.Register_function_call(iSetRegKey,'d2kwutil_SetRegKey','INT','INT,*CHAR,*CHAR,INT,*CHAR,LONG,INT');  
    -- Which Root?
    vcRoot  := upper(substr(RegPath,1,instr(RegPath,'\')-1));
    if      vcRoot =  'HKEY_LOCAL_MACHINE' then 
      iBuff1 := 0;
    elsif   vcRoot =  'HKEY_CLASSES_ROOT' then 
      iBuff1 := 1;
    elsif   vcRoot =  'HKEY_CURRENT_USER' then 
      iBuff1 := 2;
    elsif   vcRoot =  'HKEY_USERS' then
      iBuff1 := 3;
    elsif   vcRoot =  'HKEY_CURRENT_CONFIG' then
      iBuff1 := 4;            
    else
      Win_API_PDF.Add_error(CalledBy,'Invalid Registry Key '||RegPath);
      if  RaiseExceptions then
        raise NO_DATA_FOUND;
      end if;  
    end if;

    iBuff2    := RegFormat;
    if RegValue is NULL then 
    	iBuff3 := 0;
    	vcBuff3 := ' ';
    	iNullInd := 1;
     	Win_API_Debug_PDF.DebugLog(99,'Wrap_Write_Registry','NULL value passed.');	  	
    else
      if RegFormat = Win_API_PDF.REG_DWORD then 
      	iBuff3 := trunc(abs(to_number(RegValue)));
      	if iBuff3 > 4294967295 then 
        	Raise VALUE_ERROR; /* larger than a DWORD */
	    	end if;
      else
    		vcBuff3    := RegValue;
      end if;
    end if;

    vcBuff1    := substr(RegPath,instr(RegPath,'\')+1);
    vcBuff2    := RegEntry;

    iRC   := d2kwutil_SetRegKey(Win_API_PDF.FunctionHandle(iSetRegKey),iBuff1,vcBuff1,vcBuff2,iBuff2,vcBuff3,iBuff3,iNullInd);
    Win_API_Debug_PDF.DebugLog(99,'Wrap_Write_Registry','Result:  RC='||to_char(iRC));	      
  else 
    raise Win_API_PDF.NOT_AVAILABLE;
  end if;  
  if iRC <> 0  then 
    Win_API_PDF.Add_error(CalledBy,'Cannot set Registry Entry '||RegPath||'->'||RegEntry||' to '||RegValue);
    if  RaiseExceptions then
      raise NO_DATA_FOUND;
    end if;
  end if;
exception
  when NO_DATA_FOUND then 
    raise;
  when VALUE_ERROR then 
    Win_API_PDF.Add_error(CalledBy,'The value being set exceeded the maximum for a DWORD (4,294,967,295)');
    raise;
  when Win_API_PDF.NOT_AVAILABLE then
    Win_API_PDF.Add_error(CalledBy,Win_API_PDF.NoAPI);
    raise;
  when others then 
    Win_API_PDF.Add_error(CalledBy,Win_API_PDF.UError||Win_API_PDF.Add_External_errors); 
    raise;
end Wrap_Write_Registry;

PROCEDURE Write_Registry( RegPath         IN   VARCHAR2,
                          RegEntry        IN   VARCHAR2, 
                          RegValue        IN   VARCHAR2, 
                          RaiseExceptions IN   BOOLEAN DEFAULT FALSE) is
begin
  Wrap_Write_Registry('Write_Registry',RegPath, RegEntry,RegValue,Win_API_PDF.REG_SZ, RaiseExceptions);
end Write_Registry;

PROCEDURE Write_RegistryEx(  RegPath         IN  VARCHAR2,
                             RegEntry        IN  VARCHAR2, 
                             RegValue        IN  VARCHAR2, 
                             RegFormat       IN  PLS_INTEGER,
                             RaiseExceptions IN  BOOLEAN DEFAULT FALSE) is
begin
  Wrap_Write_Registry('Write_RegistryEx',RegPath, RegEntry,RegValue,RegFormat, RaiseExceptions);
end Write_RegistryEx;

PROCEDURE Wrap_Maint_Registry(  CalledBy        IN   VARCHAR2,
                                RegPath         IN   VARCHAR2,
                                Opt             IN  PLS_INTEGER,
                                RaiseExceptions IN  BOOLEAN DEFAULT FALSE) is
  vcOp       VARCHAR2(10);
  vcBuff1    VARCHAR2(512);
  vcRoot     VARCHAR2(20);
  iBuff1     PLS_INTEGER;
  iRC        PLS_INTEGER;
begin 
  Win_API_Debug_PDF.DebugLog(99,'Wrap_Maint_Registry','Args: CalledBy="'||CalledBy||'", RegPath="'||RegPath||'", Opt='||to_char(Opt)||', RaiseExceptions='||Win_API_Debug_PDF.booltochar(RaiseExceptions));	  	
  Win_API_PDF.Clean_Error_Stack;
  iRC  := 0;
  if Win_API_PDF.API_ENABLED then 
    Win_API_PDF.Register_function_call(iMaintRegKey,'d2kwutil_MaintRegKey','INT','INT,*CHAR,INT');  
    -- Which Root?
    vcRoot  := upper(substr(RegPath,1,instr(RegPath,'\')-1));
    if      vcRoot =  'HKEY_LOCAL_MACHINE' then 
      iBuff1 := 0;
    elsif   vcRoot =  'HKEY_CLASSES_ROOT' then 
      iBuff1 := 1;
    elsif   vcRoot =  'HKEY_CURRENT_USER' then 
      iBuff1 := 2;
    elsif   vcRoot =  'HKEY_USERS' then
      iBuff1 := 3;
    else
      Win_API_PDF.Add_error(CalledBy,'Invalid Registry Key '||RegPath);
      if  RaiseExceptions then
        raise NO_DATA_FOUND;
      end if;  
    end if;
    
    vcBuff1    := substr(RegPath,instr(RegPath,'\')+1);

    if opt = 0 then
      vcOp := 'Create';
    else
      vcOp := 'Delete';
      if (instr(vcBuff1,'\') = 0) and iBuff1 <> 1 then
            Win_API_PDF.Add_error(CalledBy,'You Probably don''t want to delete something this high in the Registry hierachy: '||RegPath);
            raise NO_DATA_FOUND;
      end if;
    end if;

    iRC   := d2kwutil_MaintRegKey(Win_API_PDF.FunctionHandle(iMaintRegKey),iBuff1,vcBuff1,opt);
    Win_API_Debug_PDF.DebugLog(99,'Wrap_Maint_Registry','Result:  RC='||to_char(iRC));	      
  else 
    raise Win_API_PDF.NOT_AVAILABLE;
  end if;  
  if iRC <> 0  then 
    Win_API_PDF.Add_error(CalledBy,'Cannot '||vcOp||' Registry Key '||RegPath|| ' (Error code = '||to_char(iRC)||')');
    if  RaiseExceptions then
      raise NO_DATA_FOUND;
    end if;
  end if;
exception
  when NO_DATA_FOUND then 
    if RaiseExceptions then 
      raise;
    end if;
  when Win_API_PDF.NOT_AVAILABLE then
    Win_API_PDF.Add_error(CalledBy,Win_API_PDF.NoAPI);
    raise;
  when others then 
    Win_API_PDF.Add_error(CalledBy,Win_API_PDF.UError||Win_API_PDF.Add_External_errors); 
    raise;
end Wrap_Maint_Registry;

PROCEDURE Create_Registry_Key(  RegPath         IN   VARCHAR2,
                                RaiseExceptions IN  BOOLEAN DEFAULT FALSE) is
begin
  Wrap_Maint_Registry('Create_Registry_Key',RegPath,0,RaiseExceptions);
end;


PROCEDURE Delete_Registry_Key(  RegPath         IN   VARCHAR2,
                                RaiseExceptions IN  BOOLEAN DEFAULT FALSE) is
begin
  Wrap_Maint_Registry('Delete_Registry_Key',RegPath,1,RaiseExceptions);
end;



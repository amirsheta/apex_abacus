Procedure Flush_File_Buffer (FileHandle      IN     Win_API_PDF.FILE_TYPE, RaiseExceptions IN BOOLEAN DEFAULT FALSE) is
  iRC PLS_INTEGER;
begin                    
  Win_API_Debug_PDF.DebugLog(99,'Flush_File_Buffer','Args: FileHandle='||to_char(FileHandle)||', RaiseExceptions='||Win_API_Debug_PDF.booltochar(RaiseExceptions));	  	
  Win_API_PDF.Clean_Error_Stack;
  if Win_API_PDF.API_ENABLED then 
    Win_API_PDF.Register_function_call(iFileFlush,'d2kwutil_FileFlush','INT','LONG');
    CheckFileHandle('Flush_File_Buffer',FileHandle); 
    iRC := d2kwutil_FileFlush(Win_API_PDF.FunctionHandle(iFileFlush),FileHandle);
    Win_API_Debug_PDF.DebugLog(99,'Flush_File_Buffer','Result:  RC='||to_char(iRC));
  else 
    raise Win_API_PDF.NOT_AVAILABLE;
  end if;
  if iRC = -1 then
    Win_API_PDF.Add_error('Flush_File_Buffer','Error Flushing Buffer to Disk - Write Failure');
    if RaiseExceptions then 
      raise NO_DATA_FOUND;
    end if;
  end if;
exception
  when NO_DATA_FOUND then 
    if RaiseExceptions then 
    	raise;
    end if;
  when Win_API_PDF.NOT_AVAILABLE then
    Win_API_PDF.Add_error('Flush_File_Buffer',Win_API_PDF.NoAPI);
    raise;
  when others then 
    Win_API_PDF.Add_error('Flush_File_Buffer', Win_API_PDF.UError||Win_API_PDF.Add_External_errors); 
    raise;
end;

Function End_of_File (FileHandle IN Win_API_PDF.FILE_TYPE, RaiseExceptions IN BOOLEAN DEFAULT FALSE) return BOOLEAN is
  iRC PLS_INTEGER;
  bRC BOOLEAN;
begin                    
  Win_API_Debug_PDF.DebugLog(99,'End_Of_File','Args: RaiseExceptions='||Win_API_Debug_PDF.booltochar(RaiseExceptions));	  	
  Win_API_PDF.Clean_Error_Stack;
  if Win_API_PDF.API_ENABLED then 
    Win_API_PDF.Register_function_call(iFileEOF,'d2kwutil_FileEOF','INT','LONG');
    CheckFileHandle('End_Of_File',FileHandle); 
    iRC := d2kwutil_FileEOF(Win_API_PDF.FunctionHandle(iFileEOF),FileHandle);
    Win_API_Debug_PDF.DebugLog(99,'End_Of_File','Result:  RC='||to_char(iRC));
  else 
    raise Win_API_PDF.NOT_AVAILABLE;
  end if;
  if iRC = 0 then
    bRC := FALSE;
  else
    Win_API_PDF.Add_error('Flush_File_Buffer','Last Read operation reached the End-of-File marker ');
  	bRC := TRUE;
  end if;
  return bRC;
exception
  when NO_DATA_FOUND then 
    if RaiseExceptions then 
    	raise;
    end if;
  when Win_API_PDF.NOT_AVAILABLE then
    Win_API_PDF.Add_error('End_Of_File',Win_API_PDF.NoAPI);
    raise;
  when others then 
    Win_API_PDF.Add_error('End_Of_File', Win_API_PDF.UError||Win_API_PDF.Add_External_errors); 
    raise;
end;


                    
END WIN_API_FILE_PDF;


PACKAGE Win_API_PDF IS
/*-------------------------------------------------------------------------------*\
 * WIN_API ->  This package defines the constants used throughout 
 *      the library as a whole, including versions of those 
 *      constants defined within WINDOWS.H/WINUSER.H that 
 *      we'll be using. Add more constants in here if required
 *      The package also contains Explict Exception declarations,
 *      various status Flags and functions for Error Handling
 * NOTE:    In order to make this library portable across Forms,
 *      Reports and Graphics we do not use any application 
 *      specific built-ins such as the Forms MESSAGE() 
 *      Built-in. Instead errors are recorded in a package
 *      variable which the programmer can examine if required
\*-------------------------------------------------------------------------------*/

/*-------------------------------------------------------------------------------*\
 * Internal Version Number  ** Oracle Developer Release 6.0 Version
\*-------------------------------------------------------------------------------*/
  WIN_API_VERSION  CONSTANT  VARCHAR2(30) := '6.0.6.0 Production';
  DLL_NAME         CONSTANT  VARCHAR2(12) := 'D2KWUT60.DLL';
  DLL_PATH         VARCHAR2(256)          := NULL;


/*-------------------------------------------------------------------------------*\
 * General Window Classes of Common Applications for use with WIN_API_SESSION
 * ** WARNING ** These Window classes are out of our control and might change 
 *               when you upgrade the software in question,
\*-------------------------------------------------------------------------------*/

  -- Oracle Apps
  WINCLASS_DEVELOPER_2000_V1  CONSTANT  VARCHAR2(15)  := 'ui23MDIroot_W32';             /* Developer/2000 release 1.n / Toolkit 2.3 Apps on 32 bit */
  WINCLASS_DEVELOPER_2000_V2  CONSTANT  VARCHAR2(15)  := 'ui25MDIroot_W32';             /* Developer/2000 Release 2.0 / Toolkit 2.5 Apps on 32 bit */
  WINCLASS_DEVELOPER_2000_V6  CONSTANT  VARCHAR2(15)  := 'ui60MDIroot_W32';             /* Developer/2000 Release 6.0 / Toolkit 6.0 Apps on 32 bit */  
  D2K_WINDOW_CLASS            CONSTANT  VARCHAR2(15)  := WINCLASS_DEVELOPER_2000_V6;    /* Set to the "current" version */  
  WINCLASS_INTEROFFICE_40     CONSTANT  VARCHAR2(28)  := 'Afx:10000000:b:10008:6:5023b';/* Oracle Interoffice 4.0 Client 32 bit */
  WINCLASS_INTEROFFICE_41     CONSTANT  VARCHAR2(28)  := 'Afx:10000000:b:1496:6:3a17';  /* Oracle Interoffice 4.0 Client 32 bit */
  WINCLASS_SQLPLUS            CONSTANT  VARCHAR2(13)  := 'SqlplusWClass';               /* Sql*Plus 32 bit */
  WINCLASS_REPORTSSERVER_V1   CONSTANT  VARCHAR2(15)  := 'R25SRV_WINCLASS';             /* Reports Server Reports 2.5 */
  WINCLASS_REPORTSSERVER_V2   CONSTANT  VARCHAR2(15)  := 'R30SRV_WINCLASS';             /* Reports Server Reports 3.0 */
  WINCLASS_REPORTSSERVER_V6   CONSTANT  VARCHAR2(14)  := 'RWRBE_WINCLASS';              /* Reports Server Reports 6.0 */

  -- Microsoft Office Apps - Office97
  WINCLASS_MSWORD_97         CONSTANT  VARCHAR2(7) := 'OpusApp';                        /* Microsoft Word 97 */
  WINCLASS_MSEXCEL_97        CONSTANT  VARCHAR2(6) := 'XLMAIN';                         /* Microsoft Excel 97 */
  WINCLASS_MSPOWERPOINT_97   CONSTANT  VARCHAR2(14):= 'PP97FrameClass';                 /* Microsoft Power Point 97 */


  -- Microsoft Office Apps - Office95
  WINCLASS_MSWORD_7          CONSTANT  VARCHAR2(7) := 'OpusApp';                        /* Microsoft Word 7 */
  WINCLASS_MSEXCEL_7         CONSTANT  VARCHAR2(6) := 'XLMAIN';                         /* Microsoft Excel 7 */
  WINCLASS_MSPOWERPOINT_7    CONSTANT  VARCHAR2(13):= 'PP7FrameClass';                  /* Microsoft Power Point 7 */
  WINCLASS_MSSCHEDULE_7      CONSTANT  VARCHAR2(23):= 'MS Schedule+ 32 Panesdi';        /* Microsoft Schedule 7 */
  WINCLASS_MSEXCHANGE_4      CONSTANT  VARCHAR2(29):= 'Microsoft Exchange 4.0 Viewer';  /* Microsoft Exchange 4 in-tray */


  -- Microsoft O/S Utilities
  WINCLASS_INETEXPLORER      CONSTANT  VARCHAR2(7):= 'IEFrame';                         /* Internet Explorer */
  WINCLASS_OUTLOOK_EXPRESS   CONSTANT  VARCHAR2(29):= 'Outlook Express Browser Class';  /* Outlook Express */
  WINCLASS_EXPLORER          CONSTANT  VARCHAR2(13):= 'ExploreWClass';                  /* Explorer */
  WINCLASS_MYCOMPUTER        CONSTANT  VARCHAR2(13):= 'CabinetWClass';                  /* My Computer & Network Neighborhood*/
  WINCLASS_CALCULATOR        CONSTANT  VARCHAR2(7) := 'SciCalc';                        /* Windows Calculator */
  WINCLASS_NOTEPAD           CONSTANT  VARCHAR2(7) := 'Notepad';                        /* Windows Notepad */
  WINCLASS_WORDPAD           CONSTANT  VARCHAR2(12):= 'WordPadClass';                   /* Windows Wordpad/Write */
  WINCLASS_DOS               CONSTANT  VARCHAR2(18):= 'ConsoleWindowClass';             /* Dos Window */

  -- Other
  WINCLASS_NETSCAPE_3        CONSTANT  VARCHAR2(27):= 'Afx:40000000:b:150e:6:38cfe';    /* Netscape Navigator 3.0 */
  WINCLASS_NETSCAPE_4        CONSTANT  VARCHAR2(28):= 'Afx:40000000:b:10008:6:6063e';   /* Netscape Communicator 4.0 */
  WINCLASS_PFE_7             CONSTANT  VARCHAR2(11):= 'PFE32_Frame';                    /* Programmers File Editor */
  WINCLASS_REGEDIT           CONSTANT  VARCHAR2(15):= 'RegEdit_RegEdit';                /* Registry Editor */


-- Window Style Constants (from WINUSER.H)
--  Any PU's that use these constants will explain 
--  their use.  For further information consult the
--  Windows SDK.

  SW_HIDE              CONSTANT  PLS_INTEGER := 0;
  SW_SHOWNORMAL        CONSTANT  PLS_INTEGER := 1;
  SW_SHOWMINIMIZED     CONSTANT  PLS_INTEGER := 2;
  SW_SHOWMAXIMIZED     CONSTANT  PLS_INTEGER := 3;
  SW_SHOWNOACTIVATE    CONSTANT  PLS_INTEGER := 4;
  SW_SHOW              CONSTANT  PLS_INTEGER := 5;
  SW_MINIMIZE          CONSTANT  PLS_INTEGER := 6;
  SW_SHOWMINNOACTIVE   CONSTANT  PLS_INTEGER := 7;
  SW_SHOWNA            CONSTANT  PLS_INTEGER := 8;
  SW_RESTORE           CONSTANT  PLS_INTEGER := 9;
  SW_SHOWDEFAULT       CONSTANT  PLS_INTEGER := 10;

-- Help Access Constants (From WINUSER.H)
--  See WIN_API_SHELL.WinHelp

  HELP_CONTEXT         CONSTANT  PLS_INTEGER := 1;   /* 0x0001L */
  HELP_QUIT            CONSTANT  PLS_INTEGER := 2;   /* 0x0002L */
  HELP_INDEX           CONSTANT  PLS_INTEGER := 3;   /* 0x0003L */
  HELP_CONTENTS        CONSTANT  PLS_INTEGER := 3;   /* 0x0003L */
  HELP_HELPONHELP      CONSTANT  PLS_INTEGER := 4;   /* 0x0004L */
  HELP_SETINDEX        CONSTANT  PLS_INTEGER := 5;   /* 0x0005L */
  HELP_SETCONTENTS     CONSTANT  PLS_INTEGER := 5;   /* 0x0005L */
  HELP_CONTEXTPOPUP    CONSTANT  PLS_INTEGER := 8;   /* 0x0008L */
  HELP_FORCEFILE       CONSTANT  PLS_INTEGER := 9;   /* 0x0009L */
  HELP_KEY             CONSTANT  PLS_INTEGER := 257; /* 0x0101L */
  HELP_COMMAND         CONSTANT  PLS_INTEGER := 258; /* 0x0102L */
  HELP_PARTIALKEY      CONSTANT  PLS_INTEGER := 261; /* 0x0105L */
  HELP_MULTIKEY        CONSTANT  PLS_INTEGER := 513; /* 0x0201L */
  HELP_SETWINPOS       CONSTANT  PLS_INTEGER := 515; /* 0x0203L */
-- Windows 4+
  HELP_CONTEXTMENU     CONSTANT  PLS_INTEGER := 10;  /* 0x000a  */
  HELP_FINDER          CONSTANT  PLS_INTEGER := 11;  /* 0x000b  */
  HELP_WM_HELP         CONSTANT  PLS_INTEGER := 12;  /* 0x000c  */
  HELP_SETPOPUP_POS    CONSTANT  PLS_INTEGER := 13;  /* 0x000d  */


-- Windows Messages for use with SendMessage
-- DO NOT utilise the Windows Sendmessage interface without being conversant
-- with the Windows message handling mechanism
-- Refer to the Microsoft Windows SDK for Messages and Parameter values
  WM_SYSCOMMAND        CONSTANT  PLS_INTEGER := 274;   /* 0x0112 */
  WM_MDITILE           CONSTANT  PLS_INTEGER := 550;   /* 0x0226 */
  WM_MDICASCADE        CONSTANT  PLS_INTEGER := 551;   /* 0x0227 */
  WM_MDIICONARRANGE    CONSTANT  PLS_INTEGER := 552;   /* 0x0228 */      
  SC_RESTORE           CONSTANT  PLS_INTEGER := 61728; /* 0xF120 */
  SC_MINIMIZE          CONSTANT  PLS_INTEGER := 61472; /* 0xF020 */
  SC_MAXIMIZE          CONSTANT  PLS_INTEGER := 61488; /* 0xF030 */
  


-- Flags for use with File Dialog boxes ("Save As" or "Open")
-- Refer to your Microsoft documentation for details on the 
-- Exact usage and dependancies of each option
  OFN_READONLY           CONSTANT  PLS_INTEGER := 1;        /* 0x00000001 */
  OFN_OVERWRITEPROMPT    CONSTANT  PLS_INTEGER := 2;        /* 0x00000002 */
  OFN_HIDEREADONLY       CONSTANT  PLS_INTEGER := 4;        /* 0x00000004 */
  OFN_NOCHANGEDIR        CONSTANT  PLS_INTEGER := 8;        /* 0x00000008 */
  OFN_SHOWHELP           CONSTANT  PLS_INTEGER := 16;       /* 0x00000010 */
  OFN_NOVALIDATE         CONSTANT  PLS_INTEGER := 256;      /* 0x00000100 */
  OFN_ALLOWMULTISELECT   CONSTANT  PLS_INTEGER := 512;      /* 0x00000200 */
  OFN_EXTENSIONDIFFERENT CONSTANT  PLS_INTEGER := 1024;     /* 0x00000400 */
  OFN_PATHMUSTEXIST      CONSTANT  PLS_INTEGER := 2048;     /* 0x00000800 */
  OFN_FILEMUSTEXIST      CONSTANT  PLS_INTEGER := 4096;     /* 0x00001000 */
  OFN_CREATEPROMPT       CONSTANT  PLS_INTEGER := 8192;     /* 0x00002000 */
  OFN_SHAREAWARE         CONSTANT  PLS_INTEGER := 16384;    /* 0x00004000 */
  OFN_NOREADONLYRETURN   CONSTANT  PLS_INTEGER := 32768;    /* 0x00008000 */
  OFN_NOTESTFILECREATE   CONSTANT  PLS_INTEGER := 65536;    /* 0x00010000 */
  OFN_NONETWORKBUTTON    CONSTANT  PLS_INTEGER := 131072;   /* 0x00020000 */
  OFN_NOLONGNAMES        CONSTANT  PLS_INTEGER := 262144;   /* 0x00040000 */
  OFN_EXPLORER           CONSTANT  PLS_INTEGER := 524288;   /* 0x00080000 */
  OFN_NODEREFERENCELINKS CONSTANT  PLS_INTEGER := 1048576;  /* 0x00100000 */
  OFN_LONGNAMES          CONSTANT  PLS_INTEGER := 2097152;  /* 0x00200000 */

-- The defaults used here (WIN_API.OFN_PATHMUSTEXIST|WIN_API.OFN_FILEMUSTEXIST|WIN_API.OFN_HIDEREADONLY|WIN_API.OFN_NOCHANGEDIR|WIN_API.OFN_EXPLORER)
  OFN_FLAG_DEFAULT       CONSTANT  PLS_INTEGER :=  530444;
  
  
-- Registry Data types for Write_RegistryEx
  REG_EXPAND_SZ          CONSTANT  PLS_INTEGER := 0;
  REG_SZ                 CONSTANT  PLS_INTEGER := 1;
  REG_DWORD              CONSTANT  PLS_INTEGER := 2;
  
-- Compatibility Flags - Used where I have changed behaviour and you might not like the new version
-- Change these at runtime to FALSE to revert to "old" behaviour
  COMPAT_EXPAND_REG_VALUES	BOOLEAN := TRUE;

  
  
-- Types
  TYPE aFunctionHandle is table of ORA_FFI.FUNCHANDLETYPE index by BINARY_INTEGER;  
  --SUBTYPE FILE_TYPE is ORA_FFI.POINTERTYPE;
  SUBTYPE FILE_TYPE is PLS_INTEGER;

-- Public Variables
   ERROR_ENCOUNTERED  BOOLEAN := FALSE;  /* The Last Call resulted in an error */
   ERROR_STACK        VARCHAR2(2000);    /* Holds Text of Last error(s) */ 
   API_ENABLED        BOOLEAN := FALSE;   /* Are API functions usable ?*/
   DLL_HANDLE         ORA_FFI.LibHandleType;
   FunctionHandle     aFunctionHandle;
   

-- Public Exceptions
   NOT_AVAILABLE      EXCEPTION;  /* A call to the API was made but API functions not currently available (e.g. not on Windows) */
     
-- Error Constants
   UError             CONSTANT  VARCHAR2(30) := ' Caused an unexpected error: ';
   NoAPI              CONSTANT  VARCHAR2(31) := 'API Functions are not Available';
   MaxDWord           CONSTANT  VARCHAR2(33) := 'Integer Argument exceeds 32 bits ';
   MaxWord            CONSTANT  VARCHAR2(33) := 'Integer Argument exceeds 16 bits ';
   MaxByte            CONSTANT  VARCHAR2(32) := 'Integer Argument exceeds 8 bits ';
   MinBound           CONSTANT  VARCHAR2(27) := 'Integer Argument too Small ';
   MaxBound           CONSTANT  VARCHAR2(27) := 'Integer Argument too Large ';
   NullArg            CONSTANT  VARCHAR2(24) := 'Argument cannot be NULL ';

   /*----------------------------------------------------------------------------*\
    * PreLoad ->  Loads the DLL into memory 
    *             DLL_Location argument allows you to explicitly load 
    *             from a particular place
   \*----------------------------------------------------------------------------*/    
   PROCEDURE PreLoad(RaiseExceptions IN BOOLEAN DEFAULT TRUE);
   
   /*----------------------------------------------------------------------------*\
    * DLLVersion ->  Returns the Version String of the DLL in use. 
   \*----------------------------------------------------------------------------*/    
   FUNCTION DLLVersion return varchar2; 

   /*----------------------------------------------------------------------------*\
    * Clean_Error_Stack ->  Re-initialises the error mechanism
   \*----------------------------------------------------------------------------*/    
   PROCEDURE Clean_Error_Stack;

   /*----------------------------------------------------------------------------*\
    * Add_Error ->  Adds the text of the specified error to the 
    *        ERROR_STACK variable and sets the error Flag 
    *        ERROR_ENCOUTERED.
   \*----------------------------------------------------------------------------*/    
   PROCEDURE Add_Error (CallingFunction in VARCHAR2, SetErrorText in VARCHAR2);
 
   /*----------------------------------------------------------------------------*\
    * Add_External_Errors ->  If we get an unexpected error this funtion will 
    *        return a sting containing the error text
   \*----------------------------------------------------------------------------*/    
   FUNCTION Add_External_Errors return varchar2;

   /*----------------------------------------------------------------------------*\
    * Register_Function_Call ->  Ensures that the DLL is still loaded and
    *                            registers the function if required
    *                            Raises NO_DATA_FOUND if the library 
    *                            cannot be loaded
   \*----------------------------------------------------------------------------*/    
   PROCEDURE Register_Function_Call (FunctionID in PLS_INTEGER, 
                                     FunctionName in VARCHAR2,
                                     FunctionReturn in VARCHAR2, 
                                     FunctionArgs in VARCHAR2);

   /*----------------------------------------------------------------------------*\
    * StripDirSep ->  Removes trailing directory seperators or 
    *        SemiColons from paths, providing a known format
   \*----------------------------------------------------------------------------*/    
   FUNCTION StripDirSep ( INPath in varchar2) return varchar2; 

   /*----------------------------------------------------------------------------*\
    * GetResource ->  Returns the name of the Resource requested Prefixed with  
    *                 The name of the DLL in the Correct Format
    *                 If the resource being requested is a Cursor then 
    *                 the D2kwutil DLL file *Must* be on the O/S Path
   \*----------------------------------------------------------------------------*/    
   FUNCTION GetResource (ResourceName in VARCHAR2) return VARCHAR2;
   
END Win_API_PDF; /* End Package Declaration */


PACKAGE BODY Win_API_PDF is

  -- Private Types
  TYPE aFunctionLoadCount is table of PLS_INTEGER index by BINARY_INTEGER;
  BadLocation EXCEPTION;

  -- Private Variables
   DLL_LOAD_COUNT    PLS_INTEGER    := 0; 
   iPreLoadCount     PLS_INTEGER    := 0;
   vcTestPath        VARCHAR2(256)  := NULL;
   FunctionLoad      aFunctionLoadCount;

-- Private Function and Procedure Declarations
FUNCTION  Attempt_DLL_Load  (TargetPath  in out  VARCHAR2,
                             TargetDLL  in  VARCHAR2,
                             LoadCount  in   BOOLEAN DEFAULT TRUE) return ORA_FFI.LibHandleType;
       
FUNCTION TranslateType(Datatype in VARCHAR2) return PLS_INTEGER;

PROCEDURE d2kwutil_version (hfunc        in     ORA_FFI.FUNCHANDLETYPE,
                            Version      in out VARCHAR2);
                            

-- Pragmas
PRAGMA INTERFACE(C,d2kwutil_Version,11265);
-- Function and Procedure Bodies

PROCEDURE PreLoad(RaiseExceptions IN BOOLEAN DEFAULT TRUE) is
  vcVersion VARCHAR2(40);
begin
 Win_API_Debug_PDF.DebugLog(99,'PreLoad','Args: (None)');  	
  vcVersion := DLLVersion;
exception
  when NO_DATA_FOUND then
    Win_API_PDF.Add_error('D2KWUTIL (Pre-Load)', Win_API_PDF.NoAPI);
    if RaiseExceptions then
    	raise;	
    end if;
  when Win_API_PDF.NOT_AVAILABLE then
    Win_API_PDF.Add_error('D2KWUTIL (Pre-Load)', Win_API_PDF.NoAPI);
    if RaiseExceptions then
    	raise;
    end if;
  when others then
    Win_API_PDF.Add_error('D2KWUTIL (Pre-Load)', Win_API_PDF.UError||Win_API_PDF.Add_External_errors); 
    if RaiseExceptions then
    	raise;
    end if;
end PreLoad;
 
FUNCTION DLLVersion return varchar2 is
  vcVersion VARCHAR2(100) := RPAD(' ',40);
begin
   Win_API_Debug_PDF.DebugLog(99,'DLLVersion','Args: <No Arguments>'); 
   Win_API_PDF.Clean_Error_Stack;
   Register_function_call(1,'d2kwutil_Version','VOID','*CHAR');
   d2kwutil_version(Win_API_PDF.FunctionHandle(1),vcVersion);
   Win_API_Debug_PDF.DebugLog(99,'DLLVersion','Result: Version='||vcVersion); 
   return vcVersion;
end DLLVersion;

PROCEDURE Clean_Error_Stack is 
begin 
  -- just empty the variables
  ERROR_ENCOUNTERED  := FALSE;
  ERROR_STACK        := NULL;
end Clean_Error_Stack;

PROCEDURE Add_Error (CallingFunction in VARCHAR2, SetErrorText in VARCHAR2) is
begin 
  -- Just watch for value errors 
  ERROR_ENCOUNTERED  := TRUE;
  ERROR_STACK    := CallingFunction||': '||substr(SetErrorText,1,1968);
  Win_API_Debug_PDF.DebugLog(99,'Add_Error',ERROR_STACK);
end Add_Error;

FUNCTION Add_External_Errors return varchar2 is
  iCounter   pls_integer;
  vcErrBuff  varchar2(1968);
begin 
  if tool_err.nerrors > 0 then 
    for iCounter in 1..tool_err.nerrors LOOP
      begin 
        vcErrBuff := vcErrBuff||chr(10)||tool_err.message;
      exception
        when VALUE_ERROR then 
          exit; /* String exceeds allowable buffer */
      end;
      tool_err.pop;
    end loop;
  elsif SQLERRM is not null then 
    vcErrBuff := chr(10)||SQLERRM; 
  end if;
  return vcErrBuff;
end Add_External_Errors;


PROCEDURE Register_Function_Call ( FunctionID     in PLS_INTEGER, 
                                   FunctionName   in VARCHAR2,
                                   FunctionReturn in VARCHAR2, 
                                   FunctionArgs   in VARCHAR2) is
  vcArgs  VARCHAR2(200);
  vcFrag  VARCHAR2(10);
  iOffset PLS_INTEGER;   
begin 
   -- See if the DLL has been loaded at all.
   -- if this call to FIND_LIBRARY fails, we'll fall through to the Exception.
   begin
    DLL_HANDLE := ORA_FFI.find_library(DLL_NAME);
  exception
    when ora_ffi.ffi_error then 
      -- Attempt to load the DLL again in a subblock. If this fails
      -- then the API must be disabled and NOT_DATA_FOUND raised
      begin 
          DLL_HANDLE := Attempt_DLL_Load(DLL_Path, DLL_NAME);
      exception
          when ora_ffi.ffi_error then 
            API_ENABLED := FALSE;
              add_error('D2KWUTIL',DLL_NAME||' not found.');
            RAISE NO_DATA_FOUND;
      end;
  end;

  -- now compare the Cached value for this function's loadcount with 
  -- that for the DLL this tells us that the function has either not 
  -- been registered yet, or that the DLL has been reloaded in between 
  -- times.  This would not be healthy so we have to re-register in that case.
  if (not FunctionLoad.exists(FunctionId)) or (FunctionLoad(FunctionId)<> DLL_LOAD_COUNT) then
    -- We need to go through the registration process.      
    -- Register the function with the DLL
    FunctionHandle(FunctionId) := ora_ffi.register_function(Win_API_PDF.DLL_HANDLE,FunctionName,ORA_FFI.C_STD);
    if FunctionName <> 'd2kwutil_DebugString' then 
    	if not FunctionLoad.exists(FunctionId) then 
    		Win_API_Debug_PDF.DebugLog(99,'Register_Function_Call','Ftn="'||FunctionName||'", DLL Count='||to_char(DLL_LOAD_COUNT)||', Initial Reg');
    	else
       		Win_API_Debug_PDF.DebugLog(99,'Register_Function_Call','Ftn="'||FunctionName||'", DLL Count='||to_char(DLL_LOAD_COUNT)||', Re-Registration Count = '||to_char(FunctionLoad(FunctionId)));
       	end if;
    end if;
    
    -- Loop through and register the parameters
    vcArgs := FunctionArgs||',';
    while vcArgs is not null and vcArgs <> ',' and vcArgs <> 'VOID,' LOOP
      iOffset := instr(vcArgs,',');
      vcFrag := substr(vcArgs,1,iOffset-1);
      ora_ffi.register_parameter(FunctionHandle(FunctionId),TranslateType(vcFrag));
      if iOffset = length(vcArgs) then
        vcArgs := NULL;
      else
        vcArgs := substr(vcArgs,iOffset+1);
      end if;
    end LOOP;
    
    -- Register the return type IF this is a function
    if upper(FunctionReturn) <> 'VOID' and FunctionReturn is not NULL then 
      ora_ffi.register_return(FunctionHandle(FunctionId),TranslateType(FunctionReturn));
    end if;
    
    -- Now add this Function's Loadcount to the array to prevent un-nessary re-registration
    FunctionLoad(FunctionId) := DLL_LOAD_COUNT;
  end if;
exception
   when ora_ffi.ffi_error then
    Win_API_PDF.Add_error(FunctionName, Win_API_PDF.UError||Win_API_PDF.Add_External_errors); 
    raise NO_DATA_FOUND;
end Register_Function_Call;


FUNCTION  Attempt_DLL_Load  (TargetPath in out VARCHAR2, TargetDLL in VARCHAR2, LoadCount in BOOLEAN DEFAULT TRUE) return ORA_FFI.LibHandleType is
  hDLL  ORA_FFI.LibHandleType;
  hFile TEXT_IO.FILE_TYPE;
begin 
    	
  if TargetPath is not null then 
    -- Watch out for folks who put multiple Paths in here 
    -- Oh yes it's happened! Just use the first & throw the rest away
    -- Add trailing Directory Sep if required
    TargetPath := StripDirSep(TargetPath)||'\';
    
    -- Check that there is actually a file there.
    begin 
  	  hFile := TEXT_IO.FOPEN(TargetPath||TargetDLL,'R');
  	  TEXT_IO.FCLOSE(hFile);
    exception
  	  when others then
  	    Win_API_Debug_PDF.DebugLog(99,'Attempt_DLL_LOAD',TargetDLL||' not found in the specified location of "'||TargetPath||'"'); 
  		  raise BadLocation;
    end;
  end if;
  
  hDLL := ORA_FFI.LOAD_LIBRARY(TargetPath, TargetDLL);
  if LoadCount then 
    DLL_LOAD_COUNT  := DLL_LOAD_COUNT + 1;
    API_ENABLED  := TRUE;
  end if;
  return hDLL;
exception
  when others then 
    API_ENABLED := FALSE;
    return hDLL; /* Will be null */
end Attempt_DLL_Load;
 
FUNCTION TranslateType(DataType in VARCHAR2) return PLS_INTEGER is
   -- Just a simple lookup of the types.
   vcType VARCHAR2(10) := UPPER(DataType);
   iRC    PLS_INTEGER;
begin 
  if vcType = '*CHAR' then 
    iRC := ORA_FFI.C_CHAR_PTR;
  elsif vcType = 'CHAR' then 
    iRC := ORA_FFI.C_CHAR;
  elsif vcType = '*INT' then 
    iRC := ORA_FFI.C_INT_PTR;
  elsif vcType = 'INT' then 
    iRC := ORA_FFI.C_INT;
  elsif vcType = '*LONG' then 
    iRC := ORA_FFI.C_LONG_PTR;
  elsif vcType = 'LONG' then 
    iRC := ORA_FFI.C_LONG;
  elsif vcType = '*SHORT' or vcType = '*BYTE'  then 
    iRC := ORA_FFI.C_SHORT_PTR;
  elsif vcType = 'SHORT' or vcType = 'BYTE' then 
    iRC := ORA_FFI.C_SHORT;
  elsif vcType = '*DOUBLE' then 
    iRC := ORA_FFI.C_DOUBLE_PTR;
  elsif vcType = 'DOUBLE' then 
    iRC := ORA_FFI.C_DOUBLE;  
  elsif vcType = '*VOID' then 
    iRC := ORA_FFI.C_VOID_PTR;      
  end if;
return iRC;
end TranslateType;

  

Function StripDirSep ( InPath in varchar2) return varchar2 is 
  vcPath  varchar2(500) := InPath;
begin 
  -- Check and Strip SemiColons, we take everything
  -- Before the first Semicolon as our path
  if instr(vcPath,';') > 0 then
    vcPath := substr(vcPath,1,instr(vcPath,';') -1);
  end if;

  -- Check and Strip '\'
  if substr(vcPath,-1,1) = '\' then 
    vcPath := substr(vcPath,1,length(vcPath)-1);
  end if;

  return vcPath;
end StripDirSep;

FUNCTION GetResource (ResourceName in VARCHAR2) return VARCHAR2 is
begin 
  Return '<'||substr(DLL_NAME,1,(instr(DLL_NAME,'.')-1))||'>'||ResourceName;
end GetResource;


BEGIN
/*----------------------------------------------------------------------------*\
 * This body section is only run once (per instance of the PLL)
 * and sets up all required flags and paths.
\*----------------------------------------------------------------------------*/   
  -- Search Path is:
  --  1. Preload override location set by WIN_API_PRELOAD.SET_LOAD_LOC
  --  2. D2KWUTILnn_PATH e.g. D2KWUTIL60_PATH
  --  3. D2KWUTIL_PATH
  --  4. Working Directory / O/S Path
  --  5. \Bin directory based in ..\bin
  --  6. %ORACLE_HOME%\Bin

  Win_API_Debug_PDF.DebugLog(99,'Win_API(init)','Searching For DLL ('||DLL_NAME||')');
  
  DLL_PATH := WIN_API_PRELOAD_PDF.GET_LOAD_LOC;
  if DLL_PATH is not NULL then 
  	DLL_HANDLE  := Attempt_DLL_load(DLL_PATH,DLL_NAME);
  	if Win_API_PDF.API_ENABLED then 
        Win_API_Debug_PDF.DebugLog(99,'Win_API(init)','DLL loaded from Preload Location: '||DLL_PATH);
     else
        Win_API_Debug_PDF.DebugLog(99,'Win_API(init)','DLL failed to load from Preload Location: '||DLL_PATH);
     end if;
  else
     Win_API_Debug_PDF.DebugLog(99,'Win_API(init)','Preload location not set');	
  end if;
  	
  if NOT Win_API_PDF.API_ENABLED then /* Try the Specific Variable */
	  -- Work out the version number and look for that variable
	  TOOL_ENV.GETVAR('D2KWUTIL'||substr(replace(win_api_version,'.',NULL),1,2)||'_PATH',DLL_PATH);
	  if DLL_PATH is not NULL then 
	   	 DLL_HANDLE  := Attempt_DLL_load(DLL_PATH,DLL_NAME);
	     if Win_API_PDF.API_ENABLED then 
	        Win_API_Debug_PDF.DebugLog(99,'Win_API(init)','DLL loaded from D2KWUTIL'||substr(replace(win_api_version,'.',NULL),1,2)||'_PATH ('||DLL_PATH||')');
	     else
	        Win_API_Debug_PDF.DebugLog(99,'Win_API(init)','DLL failed to load from D2KWUTIL'||substr(replace(win_api_version,'.',NULL),1,2)||'_PATH');
	     end if;
	  else
	     Win_API_Debug_PDF.DebugLog(99,'Win_API(init)','Variable D2KWUTIL'||substr(replace(win_api_version,'.',NULL),1,2)||'_PATH not set');	
	  end if;
  end if;
  
  if not Win_API_PDF.API_ENABLED then /* Try the plain path */
     TOOL_ENV.GETVAR('D2KWUTIL_PATH',DLL_PATH);
     if DLL_PATH is not null then 
    	DLL_HANDLE  := Attempt_DLL_load(DLL_PATH,DLL_NAME);
  	    if Win_API_PDF.API_ENABLED then 
           Win_API_Debug_PDF.DebugLog(99,'Win_API(init)','DLL loaded from D2KWUTIL_PATH');
  	    else
  	       Win_API_Debug_PDF.DebugLog(99,'Win_API(init)','DLL failed to load from D2KWUTIL_PATH');
        end if;
     else
      	Win_API_Debug_PDF.DebugLog(99,'Win_API(init)','Variable D2KWUTIL_PATH not set, Searching O/S PATH');
     end if;
  end if;
  
  if not Win_API_PDF.API_ENABLED then /* Try Working Directory and O/S Path */
  	 DLL_PATH := NULL;
     DLL_HANDLE  := Attempt_DLL_load(DLL_PATH,DLL_NAME);
	 if Win_API_PDF.API_ENABLED then 
        Win_API_Debug_PDF.DebugLog(99,'Win_API(init)','DLL loaded from O/S Path');
        DLL_PATH := '%PATH%';
	 else
	 	Win_API_Debug_PDF.DebugLog(99,'Win_API(init)','DLL not found in O/S Path or Working Directory');
     end if;
  end if;

  if not Win_API_PDF.API_ENABLED then /* Try relative Bin directory */
  	 DLL_PATH := '..\bin';
     DLL_HANDLE  := Attempt_DLL_load(DLL_PATH,DLL_NAME);
	 if Win_API_PDF.API_ENABLED then 
        Win_API_Debug_PDF.DebugLog(99,'Win_API(init)','DLL loaded from relative bin (..\bin\)');
	 else
	 	Win_API_Debug_PDF.DebugLog(99,'Win_API(init)','DLL not found in relative bin');
     end if;
  end if;
  
  if not Win_API_PDF.API_ENABLED then /* Try %ORACLE_HOME%\bin */
     TOOL_ENV.GETVAR('ORACLE_HOME',DLL_PATH);
     if DLL_PATH is not null then
     	 DLL_PATH    := DLL_PATH||'\bin'; 
         DLL_HANDLE  := Attempt_DLL_load(DLL_PATH,DLL_NAME);
	     if Win_API_PDF.API_ENABLED then 
            Win_API_Debug_PDF.DebugLog(99,'Win_API(init)','DLL loaded from %ORACLE_HOME%/bin');
	     else
	 	    Win_API_Debug_PDF.DebugLog(99,'Win_API(init)','DLL not found in %ORACLE_HOME%/bin');
         end if;
     else
      	Win_API_Debug_PDF.DebugLog(99,'Win_API(init)','Variable ORACLE_HOME not set, Aborting');
     end if;
  end if;

  -- Final Double Check
  if not ora_ffi.is_null_ptr(DLL_HANDLE) then 
     API_ENABLED := TRUE;
     Win_API_Debug_PDF.DEBUG_API_ENABLED := TRUE;
     Win_API_Debug_PDF.DebugLog(99,'Win_API(init)','DLL Found and Loaded');
  else
  	raise Win_API_PDF.NOT_AVAILABLE;
  end if;

EXCEPTION
  when Win_API_PDF.NOT_AVAILABLE then 
    API_ENABLED := FALSE;
    Win_API_PDF.Add_error('D2KWUTIL (Init)',Win_API_PDF.NoAPI);
  when others then 
    add_error('D2KWUTIL (Init)', 'Unexpected error '||add_external_errors);
END Win_API_PDF; /* End Package Body Win API */


/*-------------------------------------------------------------------------------*\
 * WIN_API_PRELOAD ->  This package allows you to override the DLL searching 
 *      Within WIN_API by explicitly Defining the location of the DLL
\*-------------------------------------------------------------------------------*/
PACKAGE WIN_API_PRELOAD_PDF IS
  PROCEDURE SET_LOAD_LOC (Location IN VARCHAR2);
  FUNCTION GET_LOAD_LOC RETURN VARCHAR2;
END;

PACKAGE BODY WIN_API_PRELOAD_PDF IS

  DLL_LOCATION VARCHAR2(2000);

  PROCEDURE SET_LOAD_LOC (Location IN VARCHAR2) is
  BEGIN 
  	DLL_LOCATION := Location;
  END SET_LOAD_LOC;
  
  FUNCTION GET_LOAD_LOC RETURN VARCHAR2 IS
  BEGIN 
  	RETURN DLL_LOCATION;
  END GET_LOAD_LOC;

END WIN_API_PRELOAD_PDF;

PACKAGE win_api_session_PDF IS
/*-------------------------------------------------------------------------*\
 * WIN_API_SESSION ->   This package is concerned with altering/interacting 
 *      with the MDI session as a whole 
 * Contents:
 *    One_Session     -> Allows you to restrict the number
 *                       of copies of a product running
 *                       e.g. only allow 1 runform session
 *    FindAppWindow   -> Returns the top level application window.
 *    Find3rdPartyApp -> Checks for processes already running.
 *    Change_MDI_Icon -> Lets you change the icon for the Runform
 *                       MDI window
 *    TimeOut         -> A Three part call that allows you 
 *                       to detect that the User has been
 *                       idle for a certain amount of time
 *
 * Dependancies:
 *    WIN_API
 *    WIN_API_DEBUG
\*-------------------------------------------------------------------------*/ 

/*-------------------------------------------------------------------------*\
 * One_Session      ->  Checks for processes already running. 
 *            
 * Arguments: 
 *   WindowTitle  ->   MDI Window Title to Check for
 *   ModuleName   ->  Name of executable module eg 'F45RUN32.EXE'
 *                    ** Caution ** when you run from the Form Builder
 *                    the executable will be for the Debug Runtime
 *                    not the normal Runtime
 *   MatchType    ->  Looks for other applications which match on
 *                    window title only, module name only or both.
 *                    Values 'WINDOW', 'MODULE', 'BOTH'.
 *   Activate     ->  Activates the other session if found. Values
 *                    TRUE or FALSE.
 *   Class        ->  Window Class of MDI window (find in SPY++) Defaults
 *                    for Developer/2000 products, though you will have to 
 *                    change this for other products
 *   RaiseExceptions ->   Set to TRUE or FALSE (default).  If this is set 
 *                    to TRUE, then finding another instance of the application 
 *                    will raise NO_DATA_FOUND
 *
 * Returns:
 *  BOOLEAN TRUE for only session, otherwise FALSE...
\*-------------------------------------------------------------------------*/

  FUNCTION One_Session (  WindowTitle     IN VARCHAR2,
                          ModuleName      IN VARCHAR2,
                          MatchType       IN VARCHAR2,
                          Activate        IN BOOLEAN,
                          Class           IN VARCHAR2 DEFAULT WIN_API_PDF.D2K_WINDOW_CLASS,
                          RaiseExceptions IN BOOLEAN  DEFAULT FALSE) RETURN BOOLEAN;

/*-------------------------------------------------------------------------*\
 * FindAppWindow  ->  Returns the top level application window. 
 *            
 * Arguments: 
 *   WindowTitle  -> MDI Window Title to Check for
 *   ModuleName   -> Name of executable module eg 'F45RUN32.EXE'
 *                   ** Caution ** when you run from the Form Builder
 *                   the executable will be for the Debug Runtime
 *                   not the normal Runtime
 *   MatchType    -> Looks for other applications which match on
 *                   window title only, module name only or both.
 *                   Values 'WINDOW', 'MODULE', 'BOTH'.
 *  Class         -> Window Class of MDI window (find in SPY++) Defaults
 *                   for Developer/2000 products, though you will have to 
 *                   change this for other products
 *  RaiseExceptions ->   Set to TRUE or FALSE (default).  If this is set 
 *                  to TRUE, then not being able to Find the app Window 
 *                  will raise NO_DATA_FOUND
 *	
 *
 * Returns:
 *  Window Handle  
\*-------------------------------------------------------------------------*/

  FUNCTION FindAppWindow (WindowTitle     IN VARCHAR2,
                          ModuleName      IN VARCHAR2,
                          MatchType       IN VARCHAR2,
                          Class           IN VARCHAR2,
                          RaiseExceptions IN BOOLEAN  DEFAULT FALSE) RETURN number;

/*-------------------------------------------------------------------------*\
 * Find3rdPartyApp  ->  Checks for processes already running. 
 *            
 * Arguments: 
 *   WindowTitle  ->  MDI Window Title to Check for
 *   ModuleName   ->  Name of executable module eg 'F45RUN32.EXE'
 *   MatchType    -> Looks for other applications which match on
 *                   window title only, module name only or both.
 *                   Values 'WINDOW', 'MODULE', 'BOTH'.
 *   Activate     -> Activates the other session if found. Values
 *                   TRUE or FALSE.
 *   Class        -> Window Class of MDI window (find in SPY++) Defaults
 *                   for Developer/2000 products, though you will have to 
 *                   change this for other products
 *   RaiseExceptions ->   Set to TRUE or FALSE (default).  If this is set 
 *                   to TRUE, then finding another instance of the application 
 *                   will raise NO_DATA_FOUND
 *
 * Returns:
 *  BOOLEAN TRUE is Found
\*-------------------------------------------------------------------------*/

  FUNCTION Find3rdPartyApp (  WindowTitle     IN VARCHAR2,
                              ModuleName      IN VARCHAR2,
                              MatchType       IN VARCHAR2,
                              Activate        IN BOOLEAN,
                              Class           IN VARCHAR2,
                              RaiseExceptions IN BOOLEAN  DEFAULT FALSE) RETURN BOOLEAN;

/*-------------------------------------------------------------------------*\
 * Find3rdPartyAppEx ->  Checks for processes already running. 
 *            
 * Arguments: 
 *   WindowTitle  ->  MDI Window Title to Check for
 *   ModuleName   ->  Name of executable module eg 'F45RUN32.EXE'
 *   MatchType    -> Looks for other applications which match on
 *                   window title only, module name only or both.
 *                   Values 'WINDOW', 'MODULE', 'BOTH'.
 *   Activate     -> Activates the other session if found. Values
 *                   TRUE or FALSE.
 *   Minimize     -> If the other session is Activated then minimise it.
 *                   TRUE or FALSE.
 *   Class        -> Window Class of MDI window (find in SPY++) Defaults
 *                   for Developer/2000 products, though you will have to 
 *                   change this for other products
 *   RaiseExceptions ->   Set to TRUE or FALSE (default).  If this is set 
 *                   to TRUE, then finding another instance of the application 
 *                   will raise NO_DATA_FOUND
 *
 * Returns:
 *  BOOLEAN TRUE is Found
\*-------------------------------------------------------------------------*/

  FUNCTION Find3rdPartyAppEx (WindowTitle     IN VARCHAR2,
                              ModuleName      IN VARCHAR2,
                              MatchType       IN VARCHAR2,
                              Activate        IN BOOLEAN,
                              Minimize				IN BOOLEAN,
                              Class           IN VARCHAR2,
                              RaiseExceptions IN BOOLEAN  DEFAULT FALSE) RETURN BOOLEAN;
                              

/*-------------------------------------------------------------------------*\
 * Change_MDI_Icon    ->  Changes the MDI Window Icon 
 *            
 * Arguments: 
 *  MDIWindow   -> Handle to the MDI window
 *  IconFile    -> File which contains the icon - can be
 *                 exe, dll or ico file
 *  IconIndex   -> Index of icon to retrieve - zero returns
 *                 first
 *
 * NOTE: If the specified icon is not located, the default Windows Flag icon will 
 *       be used.
 * Returns:
 *  (None)
\*-------------------------------------------------------------------------*/
PROCEDURE Change_MDI_Icon ( MDIWindow  IN  PLS_INTEGER,
                            IconFile   IN  VARCHAR2,
                            IconIndex  IN  PLS_INTEGER DEFAULT 0);

/*-------------------------------------------------------------------------*\
 * Timeout      ->  Allows you to detect inactivity by 
 *          the user.  Consists of Three Separate
 *          Program units.
 *
 * Typical Usage:
 *   When-New-Form-Instance:
 *    declare
 *      hWind    PLS_INTEGER;
 *      CheckTimer  TIMER;
 *    begin
 *      hWind := get_window_property(FORMS_MDI_WINDOW,WINDOW_HANDLE);
 *      Win_API_Session.Timeout_Start_Timer(hWind);
 *      CheckTimer := Create_Timer('CheckTimeout',1000,repeat);
 * 
 *    end;
 *
 *  When-Timer-Expired:
 *    begin
 *      if upper(get_application_property(TIMER_NAME)) = 'CHECKTIMEOUT' then 
 *      if Win_API_Session.Timeout_get_inactive_time > 100000 then
 *        -- Logout after 100 secs of idle 
 *        Win_API_Session.timout_delete_timer;
 *        exit_form (NO_VALIDATE);
 *      end if;
 *    end if;
 *    end;
 *    
 *-------------------------------------------------------------------------*
 * Timeout Program Unit 1:
 * Timeout_Start_Timer    ->   Switches on the timier mechanism
 *            
 * Arguments: 
 *  WindowHandle    ->  Handle to the Window that you want to 
 *          check for activity in e.g. Handle for
 *          the Forms MDI window
 * Returns:
 *  (None)
\*-------------------------------------------------------------------------*/
  PROCEDURE Timeout_Start_Timer (WindowHandle in NUMBER);

/*-------------------------------------------------------------------------*\
 * Timeout Program Unit 2:
 * Timeout_Get_Inactive_Time  ->   Reports how long this application has
 *          been inactive for in Seconds
 *            
 * Arguments: 
 *  (None)
 * Returns:
 *  Number -> Inactive time in Milliseconds
\*-------------------------------------------------------------------------*/
  FUNCTION Timeout_Get_Inactive_Time return number;

/*-------------------------------------------------------------------------*\
 * Timeout Program Unit 3:
 * Timeout_Delete_Timer    ->   Is used to clean up the Timout 
 *          process and should be called as 
 *          your application exits.
 *            
 * Arguments: 
 *  (None)
 * Returns:
 *  (None)
\*-------------------------------------------------------------------------*/
  PROCEDURE Timeout_Delete_Timer;

END win_api_session_PDF;


PACKAGE BODY win_api_session_PDF IS

-- Constants for maintaining the Function Handle Array
-- These should be unique through the Whole Library
-- Session has indexes in the range 500 - 599
iOneSession           CONSTANT  PLS_INTEGER  := 500;
iFindAppWindow        CONSTANT  PLS_INTEGER  := 501;
iFind3rdPartyApp      CONSTANT  PLS_INTEGER  := 502;
iChangeMDIIcon        CONSTANT  PLS_INTEGER  := 503;
iTimeOutInit          CONSTANT  PLS_INTEGER  := 504;
iTimeOutLastEvent     CONSTANT  PLS_INTEGER  := 505;
iTimeOutUnHook        CONSTANT  PLS_INTEGER  := 506;

NOT_VALID_ON_NT       EXCEPTION;

  -- Private Program unit headers
FUNCTION d2kwutil_OneSession (    hFunc        IN      ORA_FFI.funcHandleType,
                                  WindowTitle  IN OUT  VARCHAR2,
                                  ModuleName   IN OUT  VARCHAR2,
                                  Class        IN OUT  VARCHAR2,
                                  Activate     IN      PLS_INTEGER
                                  )  return PLS_INTEGER;

FUNCTION d2kwutil_FindAppWindow(  hFunc        IN       ORA_FFI.funcHandleType,
                                  WindowTitle  IN OUT  VARCHAR2,
                                  ModuleName   IN OUT  VARCHAR2,
                                  Class        IN OUT  VARCHAR2,
                                  Activate     IN OUT  PLS_INTEGER
                                  )  return PLS_INTEGER;

FUNCTION d2kwutil_Find3rdPartyApp(hFunc        IN       ORA_FFI.funcHandleType,
                                  WindowTitle  IN OUT  VARCHAR2,
                                  ModuleName   IN OUT  VARCHAR2,
                                  Class        IN OUT  VARCHAR2,
                                  Activate     IN      PLS_INTEGER
                                  ) return PLS_INTEGER;

FUNCTION d2kwutil_ChangeMDIIcon  (hFunc       IN      ORA_FFI.funcHandleType,
                                  hWnd        IN      PLS_INTEGER,
                                  IconFile    IN OUT  VARCHAR2,
                                  IconIndex   IN      PLS_INTEGER,
                                  IconFileSM  IN OUT  VARCHAR2,
                                  IconIndexSM IN      PLS_INTEGER
                                  ) return  PLS_INTEGER;

FUNCTION d2kwutil_TimeOutInit   ( hFunc    IN   ORA_FFI.funcHandleType,
                                  hWnd     IN   NUMBER
                                )  return PLS_INTEGER;

FUNCTION d2kwutil_TimeOutLastEvent (  fFunc    IN  ORA_FFI.funcHandleType
                                    ) return  NUMBER;

FUNCTION d2kwutil_TimeOutUnHook  (  fFunc    IN  ORA_FFI.funcHandleType
                                  ) return PLS_INTEGER;
                                  
FUNCTION Wrap_Find3rdPartyApp(			CalledBy				In VARCHAR2,
																		WindowTitle     IN VARCHAR2,
				                            ModuleName      IN VARCHAR2,
				                            MatchType       IN VARCHAR2,
				                            Activate        IN BOOLEAN,
				                            Minimize				IN BOOLEAN,
				                            Class           IN VARCHAR2,
				                            RaiseExceptions IN BOOLEAN  DEFAULT FALSE) RETURN BOOLEAN;                                  
                                  
PROCEDURE ProcessOptions        ( WindowTitle     IN       VARCHAR2,
                                  ModuleName      IN       VARCHAR2,
                                  MatchType       IN       VARCHAR2,
                                  Class           IN       VARCHAR2,                                  
                                  Activate        IN       BOOLEAN,
                                  Minimize        IN       BOOLEAN,
                                  vcBuff1         IN OUT   VARCHAR2,
                                  vcBuff2         IN OUT   VARCHAR2,
                                  vcBuff3         IN OUT   VARCHAR2,
                                  iBuff1          IN OUT   PLS_INTEGER);
                                
-- Pragmas
 PRAGMA INTERFACE(C,d2kwutil_OneSession,      11265);
 PRAGMA INTERFACE(C,d2kwutil_FindAppWindow,    11265);
 PRAGMA INTERFACE(C,d2kwutil_Find3rdPartyApp,  11265);
 PRAGMA INTERFACE(C,d2kwutil_ChangeMDIIcon,    11265);
 PRAGMA INTERFACE(C,d2kwutil_TimeOutInit,      11265);
 PRAGMA INTERFACE(C,d2kwutil_TimeOutLastEvent,11265);
 PRAGMA INTERFACE(C,d2kwutil_TimeOutUnHook,    11265);

-- Public Bodies

function One_Session(  WindowTitle     IN VARCHAR2,
                       ModuleName      IN VARCHAR2,
                       MatchType       IN VARCHAR2,
                       Activate        IN BOOLEAN,
                       Class           IN VARCHAR2 DEFAULT Win_API_PDF.D2K_WINDOW_CLASS,
                       RaiseExceptions IN BOOLEAN DEFAULT FALSE
                      )  return BOOLEAN IS
   vcBuff1    varchar2(512);
   vcBuff2    varchar2(512);
   vcBuff3    varchar2(512);
   iBuff1    pls_integer;
   iRC      pls_integer;                      
BEGIN
  Win_API_Debug_PDF.DebugLog(99,'One_Session','Args: WindowTitle="'||WindowTitle||'", ModuleName="'||ModuleName||'", MatchType="'||MatchType||'", Activate='||Win_API_Debug_PDF.booltochar(Activate)||', Class="'||Class||'", RaiseExceptions='||Win_API_Debug_PDF.booltochar(RaiseExceptions)); 
  Win_API_PDF.Clean_Error_Stack;
  iRC  := 0;
  if Win_API_PDF.API_ENABLED then
    Win_API_PDF.Register_function_call(iOneSession,'d2kwutil_OneSession','INT','*CHAR,*CHAR,*CHAR,INT');
    ProcessOptions(WindowTitle, ModuleName, MatchType, Class, Activate,FALSE,vcBuff1, vcBuff2, vcBuff3,iBuff1);
    iRC   := d2kwutil_OneSession(Win_API_PDF.FunctionHandle(iOneSession),vcBuff1,vcBuff2,vcBuff3,iBuff1);
    Win_API_Debug_PDF.DebugLog(99,'One_Session','Result: RC='||to_char(iRC));    
  else 
    raise Win_API_PDF.NOT_AVAILABLE;
  end if;  
  if iRC <> 0 and RaiseExceptions then 
  	Win_API_PDF.Add_error('One_Session','No Matching Session Found');
    raise NO_DATA_FOUND;
  elsif iRC = 0 then 
          return(FALSE);
  else 
    return (TRUE);
  end if;
exception
  when NO_DATA_FOUND then 
    raise;
  when NOT_VALID_ON_NT then 
    Win_API_PDF.Add_error('One_Session','Only matching on "WINDOW" is allowed on NT');
    if RaiseExceptions then
        Raise NO_DATA_FOUND;
    end if;  
  when Win_API_PDF.NOT_AVAILABLE then
    Win_API_PDF.Add_error('One_Session',Win_API_PDF.NoAPI);
    raise;
  when others then
    Win_API_PDF.Add_error('One_Session',Win_API_PDF.UError||Win_API_PDF.Add_External_errors); 
    raise;
END One_Session;

function FindAppWindow( WindowTitle     IN VARCHAR2,
                        ModuleName      IN VARCHAR2,
                        MatchType       IN VARCHAR2,
                        Class           IN VARCHAR2,
                        RaiseExceptions IN BOOLEAN DEFAULT FALSE
                        )  return number IS
   vcBuff1    varchar2(512);
   vcBuff2    varchar2(512);
   vcBuff3    varchar2(512);
   iBuff1    pls_integer;
   iRC      pls_integer;
BEGIN
  Win_API_Debug_PDF.DebugLog(99,'FindAppWindow','Args: WindowTitle="'||WindowTitle||'", ModuleName="'||ModuleName||'", MatchType="'||MatchType||', Class="'||Class||'", RaiseExceptions='||Win_API_Debug_PDF.booltochar(RaiseExceptions));     
  Win_API_PDF.Clean_Error_Stack;
  iRC  := 0;
  if Win_API_PDF.API_ENABLED then 
    Win_API_PDF.Register_function_call(iFindAppWindow,'d2kwutil_FindAppWindow','INT','*CHAR,*CHAR,*CHAR,INT');
    ProcessOptions(WindowTitle, ModuleName, MatchType, Class, FALSE, FALSE, vcBuff1, vcBuff2, vcBuff3,iBuff1);
    iRC   := d2kwutil_FindAppWindow(Win_API_PDF.FunctionHandle(iFindAppWindow),vcBuff1,vcBuff2,vcBuff3,iBuff1);
    Win_API_Debug_PDF.DebugLog(99,'FindAppWindow','Result: RC='||to_char(iRC));       
  else 
    raise Win_API_PDF.NOT_AVAILABLE;
  end if;  
  if iRC = 0 and RaiseExceptions then 
    Win_API_PDF.Add_error('FindAppWindow','No matching application was found');
    raise NO_DATA_FOUND;
  else
    return iRC;
  end if;
exception
  when NO_DATA_FOUND then 
    raise;
  when NOT_VALID_ON_NT then 
    Win_API_PDF.Add_error('FindAppWindow','Only matching on "WINDOW" is allowed on NT');
    if RaiseExceptions then
        Raise NO_DATA_FOUND;
    end if;      
  when Win_API_PDF.NOT_AVAILABLE then
    Win_API_PDF.Add_error('FindAppWindow',Win_API_PDF.NoAPI);
    raise;
  when others then
    Win_API_PDF.Add_error('FindAppWindow', Win_API_PDF.UError||Win_API_PDF.Add_External_errors); 
    raise;
END FindAppWindow;


FUNCTION Wrap_Find3rdPartyApp(			CalledBy				In VARCHAR2,
																		WindowTitle     IN VARCHAR2,
				                            ModuleName      IN VARCHAR2,
				                            MatchType       IN VARCHAR2,
				                            Activate        IN BOOLEAN,
				                            Minimize				IN BOOLEAN,
				                            Class           IN VARCHAR2,
				                            RaiseExceptions IN BOOLEAN  DEFAULT FALSE) RETURN BOOLEAN IS                        
   vcBuff1    varchar2(512);
   vcBuff2    varchar2(512);
   vcBuff3    varchar2(512);
   iBuff1     pls_integer;
   iRC        pls_integer;   
BEGIN
  Win_API_Debug_PDF.DebugLog(99,CalledBy,'Args: WindowTitle="'||WindowTitle||'", ModuleName="'||ModuleName||'", MatchType="'||MatchType||'", Activate='||Win_API_Debug_PDF.booltochar(Activate)||', Class="'||Class||'", RaiseExceptions='||Win_API_Debug_PDF.booltochar(RaiseExceptions));     
  Win_API_PDF.Clean_Error_Stack;
  iRC  := 0;
  if Win_API_PDF.API_ENABLED then 
    Win_API_PDF.Register_function_call(iFind3rdPartyApp,'d2kwutil_Find3rdPartyApp','INT','*CHAR,*CHAR,*CHAR,INT');
    ProcessOptions(WindowTitle, ModuleName, MatchType, Class, Activate, Minimize, vcBuff1, vcBuff2, vcBuff3,iBuff1);
    iRC   := d2kwutil_Find3rdPartyApp(Win_API_PDF.FunctionHandle(iFind3rdPartyApp),vcBuff1,vcBuff2,vcBuff3,iBuff1);
    Win_API_Debug_PDF.DebugLog(99,CalledBy,'Result: RC='||to_char(iRC));           
  else 
    raise Win_API_PDF.NOT_AVAILABLE;
  end if;  
  if iRC = 0 and RaiseExceptions then 
  	 Win_API_PDF.Add_error(CalledBy,'Application not found');
    raise NO_DATA_FOUND;
  elsif iRC = 0 then 
          return(FALSE);
  else 
    return TRUE;
  end if;
exception
  when NO_DATA_FOUND then 
    raise;
  when NOT_VALID_ON_NT then 
    Win_API_PDF.Add_error(CalledBy,'Only matching on "WINDOW" is allowed on NT');
    if RaiseExceptions then
        Raise NO_DATA_FOUND;
    end if;      
  when Win_API_PDF.NOT_AVAILABLE then
    Win_API_PDF.Add_error(CalledBy,Win_API_PDF.NoAPI);
    raise;
  when others then
    Win_API_PDF.Add_error(CalledBy,Win_API_PDF.UError||Win_API_PDF.Add_External_errors); 
    raise;
END Wrap_Find3rdPartyApp;


function Find3rdPartyApp( WindowTitle     IN VARCHAR2,
                          ModuleName      IN VARCHAR2,
                          MatchType       IN VARCHAR2,
                          Activate        IN BOOLEAN,
                          Class           IN VARCHAR2,
                          RaiseExceptions IN BOOLEAN DEFAULT FALSE
                        ) return BOOLEAN IS
BEGIN
	RETURN Wrap_Find3rdPartyApp('Find3rdPartyApp', WindowTitle, ModuleName, MatchType, Activate, FALSE, Class, RaiseExceptions);
END Find3rdPartyApp;

FUNCTION Find3rdPartyAppEx (WindowTitle     IN VARCHAR2,
                            ModuleName      IN VARCHAR2,
                            MatchType       IN VARCHAR2,
                            Activate        IN BOOLEAN,
                            Minimize				IN BOOLEAN,
                            Class           IN VARCHAR2,
                            RaiseExceptions IN BOOLEAN  DEFAULT FALSE) RETURN BOOLEAN IS
BEGIN
	RETURN Wrap_Find3rdPartyApp('Find3rdPartyAppEx', WindowTitle, ModuleName, MatchType, Activate, Minimize, Class, RaiseExceptions);
END Find3rdPartyAppEx;
                            
                            

procedure Change_MDI_Icon(  MDIWindow  IN PLS_INTEGER,
                            IconFile   IN VARCHAR2,
                            IconIndex  IN PLS_INTEGER DEFAULT 0) IS
   vcBuff1    varchar2(256);
   vcBuff2    varchar2(256);
   iBuff1    pls_integer;
   iBuff2    pls_integer;
   iBuff3    pls_integer;
   iRC      pls_integer;
                            
BEGIN
  Win_API_Debug_PDF.DebugLog(99,'Change_MDI_Icon','Args: MDIWindow='||to_char(MDIWindow)||', IconFile="'||IconFile||'", IconIndex='||IconIndex);     
  Win_API_PDF.Clean_Error_Stack;
  iRC  := 0;
  if Win_API_PDF.API_ENABLED then 
    Win_API_PDF.Register_function_call(iChangeMDIIcon,'d2kwutil_ChangeMDIIcon','INT','INT,*CHAR,INT,*CHAR,INT');
    vcBuff1    := rpad(IconFile,255,chr(0));
    vcBuff2    := rpad(IconFile,255,chr(0));
    iBuff1    := MDIWindow;
    iBuff2    := IconIndex;
    iBuff3    := IconIndex;
    iRC   := d2kwutil_ChangeMDIIcon(Win_API_PDF.FunctionHandle(iChangeMDIIcon),iBuff1,vcBuff1,iBuff2,vcBuff2,iBuff3);
    Win_API_Debug_PDF.DebugLog(99,'Change_MDI_Icon','Result: RC='||to_char(iRC));               
  else 
    raise Win_API_PDF.NOT_AVAILABLE;
  end if;  
exception
  when Win_API_PDF.NOT_AVAILABLE then
    Win_API_PDF.Add_error('Change_MDI_Icon',Win_API_PDF.NoAPI);
    raise;
  when others then
    Win_API_PDF.Add_error('Change_MDI_Icon',Win_API_PDF.UError||Win_API_PDF.Add_External_errors); 
    raise;
END Change_MDI_Icon;


procedure Timeout_Start_Timer (  WindowHandle  IN NUMBER)  IS
   iBuff1    number;
   iRC       pls_integer;
BEGIN
  Win_API_Debug_PDF.DebugLog(99,'Timeout_Start_Timer','Args: WindowHandle='||to_char(WindowHandle));
  Win_API_PDF.Clean_Error_Stack;
  iRC  := 0;
  if Win_API_PDF.API_ENABLED then 
    Win_API_PDF.Register_function_call(iTimeOutInit,'d2kwutil_TimeOutInit','INT','DOUBLE');
    iBuff1    := WindowHandle;
    if iBuff1 is NULL or iBuff1 = 0 then 
    	RAISE NO_DATA_FOUND;
    end if;
    iRC   := d2kwutil_TimeOutInit(Win_API_PDF.FunctionHandle(iTimeOutInit),iBuff1);
    Win_API_Debug_PDF.DebugLog(99,'Timeout_Start_Timer','Result: RC='||to_char(iRC));                   
  else 
    raise Win_API_PDF.NOT_AVAILABLE;
  end if;  
exception
  when NO_DATA_FOUND then   	
    Win_API_PDF.Add_error('Timeout_Start_Timer','A NULL Window Handle to attach the Timer to was specified');
    raise;  	
  when Win_API_PDF.NOT_AVAILABLE then
    Win_API_PDF.Add_error('Timeout_Start_Timer',Win_API_PDF.NoAPI);
    raise;
  when others then
    Win_API_PDF.Add_error('Timeout_Start_Timer',Win_API_PDF.UError||Win_API_PDF.Add_External_errors); 
    raise;
END Timeout_Start_Timer;

function Timeout_Get_Inactive_Time return NUMBER IS
   iRC      number;
BEGIN
  Win_API_Debug_PDF.DebugLog(99,'Timeout_Get_Inactive_Time','Args: <No Arguments>');  
  Win_API_PDF.Clean_Error_Stack;
  iRC  := 0;
  if Win_API_PDF.API_ENABLED then 
    Win_API_PDF.Register_function_call(iTimeOutLastEvent,'d2kwutil_TimeOutLastEvent','DOUBLE',NULL);
    iRC   := d2kwutil_TimeOutLastEvent(Win_API_PDF.FunctionHandle(iTimeOutLastEvent));
    Win_API_Debug_PDF.DebugLog(99,'Timeout_Get_Inactive_Time','Result: RC='||to_char(iRC));                       
  else 
    raise Win_API_PDF.NOT_AVAILABLE;
  end if;  
  return(iRC);
exception
  when Win_API_PDF.NOT_AVAILABLE then
    Win_API_PDF.Add_error('Timeout_Get_Inactive_Time',Win_API_PDF.NoAPI);
    raise;
  when others then
    Win_API_PDF.Add_error('Timeout_Get_Inactive_Time',Win_API_PDF.UError||Win_API_PDF.Add_External_errors); 
    raise;
END Timeout_Get_Inactive_Time;

procedure Timeout_Delete_Timer IS
   iRC      pls_integer;
BEGIN
  Win_API_Debug_PDF.DebugLog(99,'Timeout_Delete_Timer','Args: <No Arguments>');     
  Win_API_PDF.Clean_Error_Stack;
  iRC  := 0;
  if Win_API_PDF.API_ENABLED then 
    Win_API_PDF.Register_function_call(iTimeOutUnHook,'d2kwutil_TimeOutUnHook','INT',NULL);
    iRC   := d2kwutil_TimeOutUnHook(Win_API_PDF.FunctionHandle(iTimeOutUnHook));
    Win_API_Debug_PDF.DebugLog(99,'Timeout_Delete_Timer','Result: RC='||to_char(iRC));                           
  else 
    raise Win_API_PDF.NOT_AVAILABLE;
  end if;  
exception
  when Win_API_PDF.NOT_AVAILABLE then
    Win_API_PDF.Add_error('Timeout_Delete_Timer',Win_API_PDF.NoAPI);
    raise;
  when others then
    Win_API_PDF.Add_error('Timeout_Delete_Timer', Win_API_PDF.UError||Win_API_PDF.Add_External_errors); 
    raise;
   END Timeout_Delete_Timer;
   
-- Private Bodies

PROCEDURE ProcessOptions        ( WindowTitle     IN       VARCHAR2,
                                  ModuleName      IN       VARCHAR2,
                                  MatchType       IN       VARCHAR2,
                                  Class           IN      VARCHAR2,
                                  Activate        IN       BOOLEAN,
                                  Minimize        IN       BOOLEAN,
                                  vcBuff1         IN OUT   VARCHAR2,
                                  vcBuff2         IN OUT   VARCHAR2,
                                  vcBuff3         IN OUT   VARCHAR2,
                                  iBuff1          IN OUT   PLS_INTEGER) is
begin
    -- Check Correct O/S
    IF MatchType <> 'WINDOW' and win_api_environment_PDF.Get_Windows_Version = 'WindowsNT' then
        Raise NOT_VALID_ON_NT;
    end if;
    IF MatchType = 'MODULE' THEN 
      ibuff1 := 1;
    ELSIF MatchType = 'WINDOW'   THEN 
      ibuff1 := 2;
    ELSE
      ibuff1 := 3;
    END IF;
    IF Activate THEN
      ibuff1 := ibuff1 + 3;
      IF Minimize THEN 
    		ibuff1 := ibuff1 + 3;
    	END IF;
    END IF;

    vcBuff1    := nvl(WindowTitle,'*');
    vcBuff2    := nvl(ModuleName,'*');
    vcBuff3    := nvl(Class,'*');
end;  

END;


PACKAGE WIN_API_Shell_PDF IS

/*-------------------------------------------------------------------------*\
 * WIN_API_SHELL ->   This package is concerned with accesssing common
 *       Shell functions such as WinExec and Help
 * Contents:
 *    WinExec       -> Excutes the specified command
 *    StartFile     -> Emulates the "Start" command in the Command shell
 *    WinHelp       -> Access MS/Windows Help file by Keyword
 *                     Search or Topic Number.
 *    WinHelpEx     -> Extended version of Winhelp which allows positioning 
 *                     of the help window
 *    MousePosition -> Get the X/Y coords of the mouse
 *    SendMessage   -> Hook into the Windows Message Queue
 *    SendKeys      -> Simulate keystrokes
 *		ShellExecute	-> A better version of Startfile. 
 * 
 * **** Bonus Procedure ****
 *    Start_Or_Restore -> Will check to see if the named program is already
 *                        Running, if so it will activate it, otherwise 
 *                        WinExec will be used to start it.
 * Dependancies:
 *    WIN_API
 *    WIN_API_ENVIRONMENT
\*-------------------------------------------------------------------------*/ 

/*-------------------------------------------------------------------------*\
 * WinExec     ->  Execute a command string as if you 
 *        had used the Run Option from Program Manager or
 *        the Start Menu.
 * Arguments: 
 *  Command    ->   The Command String Just as you would issue it from 
 *        the shell
 *      WindowStyle   ->  Use the constants defined in WIN_API
 *        For this Purpose use: 
 *        SW_SHOWNORMAL ->   Start up with applications default
 *        SW_SHOWNOACTIVATE ->   Starts as SW_SHOWNORMAL but 
 *              does not have Focus
 *        SW_SHOWMINIMIZED ->   Will Start Iconised or on 
 *              but will still be 
 *              the active Application
 *        SW_SHOWMINNOACTIVE ->   Starts Iconised without
 *              focus
 *        SW_SHOWMAXIMIZED ->   Starts Maximised
 *  RaiseExceptions ->   TRUE of FALSE(Default) If set to true, then if the 
 *           command is not successful the explicit exception
 *           NO_DATA_FOUND will be raised.
 * Returns:
 *  (NONE)
\*-------------------------------------------------------------------------*/
 
PROCEDURE WinExec (  Command          IN  VARCHAR2,
                    WindowStyle     IN  PLS_INTEGER DEFAULT WIN_API_PDF.SW_SHOWNORMAL,
                    RaiseExceptions IN  BOOLEAN DEFAULT FALSE);

/*-------------------------------------------------------------------------*\
 * StartFile   ->  Given the name of a document file this procedure 
 *        will work out what executable should be used to open it and 
 *        run that executable passing the specified file as an argument
 * Arguments: 
 *      DocumentFile    ->   The file you want to open
 *      WindowStyle     ->  Use the same arguments as for WinExec
 *      RaiseExceptions ->   TRUE of FALSE(Default) If set to true, then if the 
 *           command is not successful the explicit exception
 *           NO_DATA_FOUND will be raised.
 * Returns:
 *  (NONE)
\*-------------------------------------------------------------------------*/
PROCEDURE StartFile  (  DocumentFile    IN  VARCHAR2,
                      WindowStyle     IN  PLS_INTEGER DEFAULT WIN_API_PDF.SW_SHOWNORMAL,
                      RaiseExceptions IN  BOOLEAN DEFAULT FALSE);

/*-------------------------------------------------------------------------*\
 * WinHelp     ->  Hook into the Windows Help mechanism for
 *        Your own Help Files
 * Arguments: 
 *  HelpFile  ->   Name (and path) of your .HLP file
 *  Target    ->   Either the Search String if HELP_KEY
 *        or HELP_PARTIALKEY is being used
 *        or the number of the required Topic
 *        (in a string)
 *      HelpStyle   ->  Use the constants defined in WIN_API
 *        For this Purpose use: 
 *        HELP_CONTEXT ->    Requires the number of a topic
 *              in the help file 
 *              The Help Author would be able to 
 *              Provide this
 *        HELP_INDEX ->    Display the Contents of the help file
 *              no value for Target is required
 *        HELP_KEY ->    Supply a string containing the required
 *              keyword.
 *        HELP_PARTIALKEY ->   Supply a string containing the required
 *              keyword (or portion of it) Similar to 
 *              choosing HELP->SEARCH
 *        HELP_SETCONTENTS ->   Switch to the contents screen. You must
 *              supply the topic number of the contents
 *              topic as the target  
 *        HELP_SETINDEX ->   Switch to the Index screen. You must
 *              supply the topic number of the Index
 *              topic as the target  
 *  RaiseExceptions ->   TRUE of FALSE(Default) If set to true, then if the 
 *           help file or topic is not found then 
 *           NO_DATA_FOUND will be raised.
 * Returns:
 *  (NONE)
\*-------------------------------------------------------------------------*/

PROCEDURE WinHelp (  HelpFile         IN  VARCHAR2,
                    Target          IN  VARCHAR2,
                    HelpType        IN  PLS_INTEGER,
                    RaiseExceptions IN  BOOLEAN   DEFAULT FALSE);

/*-------------------------------------------------------------------------*\
 * WinHelpEx     ->  An extended version of the WinHelp call which will 
 *                  Allow you to define the position and size of the 
 *                  Help window. 
 *                  You must know the name of the Help Window to use this. 
\*-------------------------------------------------------------------------*/

PROCEDURE WinHelpEx(HelpFile         IN  VARCHAR2,
                    Target          IN  VARCHAR2,
                    HelpType        IN  PLS_INTEGER,
                    XPos            IN  PLS_INTEGER,
                    YPos            IN  PLS_INTEGER,
                    Width            IN  PLS_INTEGER,
                    Height          IN  PLS_INTEGER,
                    Window          IN  VARCHAR2,
                    RaiseExceptions IN  BOOLEAN   DEFAULT FALSE);                    

/*-------------------------------------------------------------------------*\
 * MousePosition   ->  Procedure that will give you the Mouse X
 *        and Y coordinates at any Time (not just 
 *        in Mouse related Triggers
 *        Useful for detecting if the mouse has been 
 *        moved since you last checked, Ideal for 
 *        implimenting timeouts
 * Arguments: 
 *    XPos  ->  X position of the mouse cursor in Pixels 
 *    YPos  ->  Y position of the mouse cursor in Pixels 
 * Returns:
 *  (NONE)
\*-------------------------------------------------------------------------*/
 
PROCEDURE MousePosition (  Xpos   OUT  NUMBER,
                          Ypos  OUT  NUMBER);

/*-------------------------------------------------------------------------*\
 * SendMessage   ->    Send any message to the Windows Message
 *        queue.  Valid messages and parameters  
 *        Are documented in your Microsoft Documentation
 * Arguments: 
 *    Target    ->  Window Handle of the recipient of the 
 *          message
 *    MessageCode  ->  Message Number (see WIN_API header 
 *          for some of the more common messages)
 *    Param1    ->  Message parameter 1 depends on Message
 *    Param2    ->  Message parameter 2 depends on Message
 *    RaiseExceptions ->  If a non zero return code comes back from 
 *          sendmessage then raise NO_DATA_FOUND
 *          default = FALSE
 *          NOTE: Some Messages will Return a Non 
 *          Zero return code to indicate 
 *          success. e.g. TRUE = 1 
 *          Treat on a message by message 
 *          basis.
 * Returns:
 *  (NONE)
\*-------------------------------------------------------------------------*/
 
PROCEDURE SendMessage (  Target          IN  PLS_INTEGER,
                        MessageCode      IN  PLS_INTEGER,
                        Param1          IN  PLS_INTEGER DEFAULT 0,
                        Param2          IN  PLS_INTEGER DEFAULT 0,
                        RaiseExceptions IN  BOOLEAN  DEFAULT FALSE);

/*-------------------------------------------------------------------------*\
 * SendKeys   ->    Simulate keystrokes
 *          
 *        
 * Arguments: 
 *    hWnd    ->  Window Handle of the recipient of the 
 *          MDI window
 *    Keys     ->  Keys to be actioned - see help for format 
 *    RaiseExceptions ->  If a non zero return code comes back from 
 *          sendmessage then raise NO_DATA_FOUND
 *          default = FALSE
 *          NOTE: Some Messages will Return a Non 
 *          Zero return code to indicate 
 *          success. e.g. TRUE = 1 
 *          Treat on a message by message 
 *          basis.
 * Returns:
 *  (NONE)
\*-------------------------------------------------------------------------*/
 
PROCEDURE SendKeys (  hWnd            IN  PLS_INTEGER,
                      Keys            IN  VARCHAR2,
                      RaiseExceptions IN  BOOLEAN  DEFAULT FALSE);
                      
                      
/*-------------------------------------------------------------------------*\
 * Start_or_Restore   ->    Wrapper for WinExec and Find3rdPartyApp 
 *                          combined.
 *        
\*-------------------------------------------------------------------------*/
Procedure Start_or_Restore( Executable      IN VARCHAR2,
                            Args            IN VARCHAR2,
                            WindowClass     IN VARCHAR2,
                            ActivationStyle IN PLS_INTEGER DEFAULT WIN_API_PDF.SW_SHOWNORMAL,                           
                            RaiseExceptions IN BOOLEAN);  
                            

/*-------------------------------------------------------------------------*\
 * ShellExecute   ->    Emulates Right Mouse click options on a file 
 *          						allows you to open, print or explore.
 *        
 * Arguments: 
 *    Window       ->  Window Handle of the MDI window
 *    Operation	   ->  'Open', 'Print' or 'Explore'
 *    File         ->  File to open or print. If executable then Open will 
 *                     run it. If this argument is a directory name then 
 *                     it can be Opened or Explored
 *    Parameters   ->  Parameters if File is an executable
 *    Directory    ->  Working Directory
 *    WindowStyle  ->  Use the same arguments as for WinExec
 *    RaiseExceptions ->  If the ShellExecute odes not work 
 *                        then NO_DATA_FOUND will be raised
 * Returns:
 *  (NONE)
\*-------------------------------------------------------------------------*/

PROCEDURE  ShellExecute	(		Window					IN 			PLS_INTEGER,
												    Operation				IN			VARCHAR2,
                            File						IN 			VARCHAR2,
                            Parameters			IN  		VARCHAR2, 
                            Directory				IN  		VARCHAR2,
                            WindowStyle     IN      PLS_INTEGER DEFAULT WIN_API_PDF.SW_SHOWNORMAL,
                            RaiseExceptions IN 			BOOLEAN DEFAULT FALSE);
        
END WIN_API_SHELL_PDF;


PACKAGE BODY WIN_API_SHELL_PDF is
  -- Constants for maintaining the Function Handle Array
  -- These should be unique through the Whole Library
  -- Shell has indexes in the range 600 - 699
  iWinExec    	CONSTANT  PLS_INTEGER  := 600;
  iWinHelp    	CONSTANT  PLS_INTEGER  := 601;
  iMouse_x_y  	CONSTANT  PLS_INTEGER  := 602;
  iSendMsg    	CONSTANT  PLS_INTEGER  := 603;
  iSendKeys   	CONSTANT  PLS_INTEGER  := 604;
  iShellExecute CONSTANT  PLS_INTEGER  := 605;  
  
  
  -- Private Program unit headers
 FUNCTION d2kwutil_WinExec ( hFunc                IN      ORA_FFI.funcHandleType,
                             Command              IN OUT  VARCHAR2,
                             WindowStyle          IN      PLS_INTEGER) return PLS_INTEGER;

 FUNCTION d2kwutil_WinHelp( hFunc               IN      ORA_FFI.funcHandleType,
                            FileName            IN OUT  VARCHAR2,
                            HelpStyle           IN      PLS_INTEGER,
                            OwnerWin            IN      PLS_INTEGER,
                            PosSet              IN      PLS_INTEGER,
                            XPos                IN      PLS_INTEGER,
                            YPos                IN      PLS_INTEGER,
                            Width               IN      PLS_INTEGER,
                            Height              IN      PLS_INTEGER,
                            WindowName          IN      VARCHAR2,
                            TopicTarget         IN      PLS_INTEGER,
                            SearchTarget        IN OUT  VARCHAR2) return PLS_INTEGER;

 PROCEDURE d2kwutil_Mouse_x_y ( hFunc           IN      ORA_FFI.funcHandleType,
                                XPos            IN OUT  PLS_INTEGER,
                                YPos            IN OUT  PLS_INTEGER);
  
 FUNCTION d2kwutil_SendMsg(     hFunc           IN      ORA_FFI.funcHandleType,
                                hWnd            IN      PLS_INTEGER,
                                uMsg            IN      PLS_INTEGER,
                                wParam          IN      PLS_INTEGER,
                                lParam          IN      PLS_INTEGER) return PLS_INTEGER;

 FUNCTION d2kwutil_SendKeys(    hFunc           IN      ORA_FFI.funcHandleType,
                                hWnd            IN      PLS_INTEGER,
                                Keys            IN OUT  VARCHAR2) return PLS_INTEGER;

 FUNCTION d2kwutil_ShellExecute(hFunc           IN      ORA_FFI.funcHandleType,
                                hWnd            IN      PLS_INTEGER,
                                Operation				IN OUT 	VARCHAR2,
                                File						IN OUT	VARCHAR2,
                                Parameters			IN OUT 	VARCHAR2, 
                                Directory				IN OUT 	VARCHAR2,
                                WindowStyle     IN      PLS_INTEGER) return PLS_INTEGER;
                                
                                
 PROCEDURE Wrap_WinHelp (       CalledBy        IN  VARCHAR2,
                                HelpFile        IN  VARCHAR2,
                                Target          IN  VARCHAR2,
                                HelpType        IN  PLS_INTEGER,
                                SetPos          IN  PLS_INTEGER,
                                HelpXPos        IN  PLS_INTEGER,
                                HelpYPos        IN  PLS_INTEGER,
                                HelpWidth       IN  PLS_INTEGER,
                                HelpHeight      IN  PLS_INTEGER,
                                HelpWindow      IN  VARCHAR2,                                                    
                                RaiseExceptions IN  BOOLEAN   DEFAULT FALSE);

-- Pragmas
PRAGMA INTERFACE(C,d2kwutil_WinExec,    	11265);
PRAGMA INTERFACE(C,d2kwutil_WinHelp,    	11265);
PRAGMA INTERFACE(C,d2kwutil_Mouse_x_y,  	11265);
PRAGMA INTERFACE(C,d2kwutil_SendMsg,    	11265);
PRAGMA INTERFACE(C,d2kwutil_SendKeys,   	11265);
PRAGMA INTERFACE(C,d2kwutil_ShellExecute, 11265);

   -- Public Bodies 
PROCEDURE WinExec ( Command          IN  VARCHAR2,
                    WindowStyle      IN  PLS_INTEGER DEFAULT WIN_API_PDF.SW_SHOWNORMAL,
                    RaiseExceptions  IN  BOOLEAN DEFAULT FALSE) is
   iRC      pls_integer := 0;                    
   vcBuff1  varchar2(512);
begin
  Win_API_Debug_PDF.DebugLog(99,'WinExec','Args: Command="'||Command||'", WindowStyle='||to_char(WindowStyle)||', RaiseExceptions='||Win_API_Debug_PDF.BoolToChar(RaiseExceptions)); 
  WIN_API_PDF.Clean_Error_Stack;
  if WIN_API_PDF.API_ENABLED then
    WIN_API_PDF.Register_function_call(iWinExec,'d2kwutil_WinExec','INT','*CHAR,INT');
    vcBuff1    := Command;
    iRC   := d2kwutil_WinExec(WIN_API_PDF.FunctionHandle(iWinExec),vcBuff1,WindowStyle);
    Win_API_Debug_PDF.DebugLog(99,'WinExec','Result: RC='||to_char(iRC));
  else 
    raise WIN_API_PDF.NOT_AVAILABLE;
  end if;  
  
  if iRC < 32 then 
    WIN_API_PDF.Add_error('WinExec','Unable to execute '||Command||'(RC='||to_char(iRC)||')');
    if RaiseExceptions then 
      raise NO_DATA_FOUND;
    end if;
  end if;
exception
  when NO_DATA_FOUND then 
    raise;
  when WIN_API_PDF.NOT_AVAILABLE then
    WIN_API_PDF.Add_error('WinExec',WIN_API_PDF.NoAPI);
    raise;
  when others then
    WIN_API_PDF.Add_error('WINEXEC',WIN_API_PDF.UError||WIN_API_PDF.Add_External_errors); 
    raise;
end WinExec;

PROCEDURE StartFile  ( DocumentFile    IN  VARCHAR2,
                       WindowStyle     IN  PLS_INTEGER DEFAULT WIN_API_PDF.SW_SHOWNORMAL,
                       RaiseExceptions IN  BOOLEAN DEFAULT FALSE) is
  vcExtension    VARCHAR2(30);   
  vcClass        VARCHAR2(256);   
  vcCmd          VARCHAR2(1000);                
begin
  Win_API_Debug_PDF.DebugLog(99,'StartFile','Args: DocumentFile="'||DocumentFile||'", WindowStyle='||to_char(WindowStyle)||', RaiseExceptions='||Win_API_Debug_PDF.BoolToChar(RaiseExceptions)); 	
  vcExtension := substr(DocumentFile,instr(DocumentFile,'.',-1));
  
  vcClass := win_api_environment_PDF.Read_Registry('HKEY_CLASSES_ROOT\'||vcExtension, null, FALSE);
  if vcClass is NULL then /* not registered type */
    WIN_API_PDF.add_error('StartFile','Files of Type "'||vcExtension||'" do not have an associated application.');
    RAISE NO_DATA_FOUND;
  end if;
  
  vcCmd := win_api_environment_PDF.Read_Registry( 'HKEY_CLASSES_ROOT\'||vcClass||'\shell\open\command', null, FALSE); 
  if vcCmd is NULL then /* This type of file cannot be opened */
    WIN_API_PDF.add_error('StartFile','Files of Class "'||vcClass||'" do not have an associated shell open command.');
    RAISE NO_DATA_FOUND;
  end if;
  
  if instr(vcCmd, '%1') > 0 then 
    vcCmd := replace(vcCmd, '%1', DocumentFile); 
  else 
    vcCmd := vcCmd||' "'||DocumentFile||'"'; 
  end if; 
  
  WIN_API_SHELL_PDF.WinExec( vcCmd,WindowStyle,TRUE);
exception
  when others then
    if RaiseExceptions then 
        RAISE;
    end if;
end StartFile;                      
                     
PROCEDURE WinHelp ( HelpFile        IN  VARCHAR2,
                    Target          IN  VARCHAR2,
                    HelpType        IN  PLS_INTEGER,
                    RaiseExceptions IN  BOOLEAN   DEFAULT FALSE) is
begin
  Wrap_WinHelp('WinHelp',HelpFile,Target,HelpType,0,0,0,0,0,NULL,RaiseExceptions);
end WinHelp;  

PROCEDURE WinHelpEx( HelpFile        IN  VARCHAR2,
                     Target          IN  VARCHAR2,
                     HelpType        IN  PLS_INTEGER,
                     XPos            IN  PLS_INTEGER,
                     YPos            IN  PLS_INTEGER,
                     Width           IN  PLS_INTEGER,
                     Height          IN  PLS_INTEGER,
                     Window          IN  VARCHAR2,
                     RaiseExceptions IN  BOOLEAN   DEFAULT FALSE) is
begin
  Wrap_WinHelp('WinHelpEx',HelpFile,Target,HelpType,1,Xpos,YPos,Width,Height,Window,RaiseExceptions);  
end WinHelpEx;                    
                  
PROCEDURE Wrap_WinHelp (  CalledBy        IN  VARCHAR2,
                          HelpFile        IN  VARCHAR2,
                          Target          IN  VARCHAR2,
                          HelpType        IN  PLS_INTEGER,
                          SetPos          IN  PLS_INTEGER,
                          HelpXPos        IN  PLS_INTEGER,
                          HelpYPos        IN  PLS_INTEGER,
                          HelpWidth       IN  PLS_INTEGER,
                          HelpHeight      IN  PLS_INTEGER,
                          HelpWindow      IN  VARCHAR2,                                                    
                          RaiseExceptions IN  BOOLEAN   DEFAULT FALSE) is
   iRC       pls_integer := 0;
   iHLPTest  pls_integer := 0;                                        
   vcBuff1   varchar2(512);
   vcBuff2   varchar2(512);
   vcBuff3   varchar2(60);
   iBuff1    pls_integer;
   iBuff2    pls_integer;
begin 
  Win_API_Debug_PDF.DebugLog(99,'Wrap_WinHelp','Args: CalledBy="'||CalledBy||'", HelpFile="'||HelpFile||'", Target="'||Target||'", HelpType='||to_char(HelpType)||', SetPos='||to_char(SetPos)||', HelpXPos='||to_char(HelpXPos)||', HelpYPos='||to_char(HelpYPos)||', HelpWidth='||to_char(HelpWidth)||', HelpHeight='||to_char(HelpHeight)||', HelpWindow="'||HelpWindow||'", RaiseExceptions='||Win_API_Debug_PDF.BoolToChar(RaiseExceptions)); 	
  WIN_API_PDF.Clean_Error_Stack;
  if WIN_API_PDF.API_ENABLED then 
    WIN_API_PDF.Register_function_call(iWinHelp,'d2kwutil_WinHelp','INT','*CHAR,INT,INT,INT,INT,INT,INT,INT,*CHAR,LONG,*CHAR');
  else 
    raise WIN_API_PDF.NOT_AVAILABLE;
  end if;
  
  -- check to see if help file exists.
  iHLPTest := win_api_file_PDF.File_Size(HelpFile,FALSE);
  
  if iHLPTest = 0 then 
  	 WIN_API_PDF.Add_error(CalledBy,'Unable to locate Help file: '||HelpFile);
     if RaiseExceptions then 
        raise NO_DATA_FOUND;
     end if;
  end if;
  
  vcBuff1    := HelpFile;
  vcBuff2    := Target;
  vcBuff3    := HelpWindow;
  iBuff1     := WIN_API_UTILITY_PDF.GET_ACTIVE_WINDOW(FALSE);

  if    HelpType in (WIN_API_PDF.HELP_KEY,WIN_API_PDF.HELP_PARTIALKEY) then 
    NULL;
  elsif HelpType in (WIN_API_PDF.HELP_INDEX, WIN_API_PDF.HELP_QUIT,WIN_API_PDF.HELP_FINDER) then 
    vcBuff2 := NULL;
    iBuff2  := 0;
  else
    iBuff2 := to_number(Target);
  end if; 
  
  iRC   := d2kwutil_WinHelp(WIN_API_PDF.FunctionHandle(iWinHelp),vcBuff1,HelpType,iBuff1,SetPos,HelpXPos,HelpYPos,HelpWidth,HelpHeight,vcBuff3,iBuff2,vcBuff2);
  Win_API_Debug_PDF.DebugLog(99,'Wrap_WinHelp','Result: RC='||to_char(iRC));

  if iRC = 0 then 
    WIN_API_PDF.Add_error(CalledBy,'Unable to locate WINHELP.EXE');
    if RaiseExceptions then 
      raise NO_DATA_FOUND;
    end if;
  end if;
exception
  when NO_DATA_FOUND then 
    raise;
  when VALUE_ERROR then 
    WIN_API_PDF.Add_error(CalledBy,'When accessing Help a string was supplied in place of a Topic number');
    raise;
  when WIN_API_PDF.NOT_AVAILABLE then
    WIN_API_PDF.Add_error(CalledBy,WIN_API_PDF.NoAPI);
    raise;
  when others then 
    WIN_API_PDF.Add_error(CalledBy,WIN_API_PDF.UError||WIN_API_PDF.Add_External_errors);
    raise;
end Wrap_WinHelp;

PROCEDURE MousePosition (  Xpos   OUT  NUMBER,
                           Ypos  OUT  NUMBER) is
  iRC     pls_integer := 0;
  iBuff1  pls_integer := 0;
  iBuff2  pls_integer := 0;                                                    
begin
  Win_API_Debug_PDF.DebugLog(99,'MousePosition','Args: <No Arguments>'); 		 
  WIN_API_PDF.Clean_Error_Stack;
  if WIN_API_PDF.API_ENABLED then 
    WIN_API_PDF.Register_function_call(iMouse_x_y,'d2kwutil_Mouse_x_y',NULL,'*INT,*INT');    
    d2kwutil_Mouse_x_y(WIN_API_PDF.FunctionHandle(iMouse_x_y),iBuff1,iBuff2);
    Xpos := iBuff1;
    Ypos := iBuff2;
    Win_API_Debug_PDF.DebugLog(99,'MousePosition','Result: XPos='||to_char(iBuff1)||', YPos='||to_char(iBuff2));
  else 
    raise WIN_API_PDF.NOT_AVAILABLE;
  end if;  
 exception
  when WIN_API_PDF.NOT_AVAILABLE then
    WIN_API_PDF.Add_error('MousePosition',WIN_API_PDF.NoAPI);
    raise;
  when others then 
    WIN_API_PDF.Add_error('MOUSEPOSITION',WIN_API_PDF.UError||WIN_API_PDF.Add_External_errors); 
    raise;
 end MousePosition;

PROCEDURE SendMessage (   Target          IN  PLS_INTEGER,
                          MessageCode     IN  PLS_INTEGER,
                          Param1          IN  PLS_INTEGER DEFAULT 0,
                          Param2          IN  PLS_INTEGER DEFAULT 0,
                          RaiseExceptions IN  BOOLEAN      DEFAULT FALSE) is
  iRC PLS_INTEGER := 0;                        
begin 
  Win_API_Debug_PDF.DebugLog(99,'SendMessage','Args: Target='||to_char(Target)||', MessageCode='||to_char(MessageCode)||', Param1='||to_char(Param1)||', Param2='||to_char(Param2)||', RaiseExceptions='||Win_API_Debug_PDF.BoolToChar(RaiseExceptions)); 		
  WIN_API_PDF.Clean_Error_Stack;
  if WIN_API_PDF.API_ENABLED then 
    WIN_API_PDF.Register_function_call(iSendMsg,'d2kwutil_SendMsg','INT','INT,INT,INT,INT');
    iRC   := d2kwutil_SendMsg(WIN_API_PDF.FunctionHandle(iSendMsg),Target,MessageCode, Param1, Param2);
    Win_API_Debug_PDF.DebugLog(99,'SendMessage','Result: RC='||to_char(iRC));
    
    if iRC <> 0 then
      WIN_API_PDF.Add_error('SendMessage',to_char(MessageCode)||' with parameters '||to_char(Param1)||'/'||to_char(Param2)||' to window '||to_char(Target)||', returned a Non-Zero return code ('||to_char(iRC)||')');
      if RaiseExceptions then 
        raise NO_DATA_FOUND;
      end if;
    end if; 
  else 
    raise WIN_API_PDF.NOT_AVAILABLE;
  end if;  
exception
  when NO_DATA_FOUND then 
    raise;
  when WIN_API_PDF.NOT_AVAILABLE then
    WIN_API_PDF.Add_error('SendMessage', WIN_API_PDF.NoAPI);
    raise;
  when others then
    WIN_API_PDF.Add_error('SendMessage',WIN_API_PDF.UError||WIN_API_PDF.Add_External_errors);  
    raise;
end SendMessage;

PROCEDURE SendKeys   ( Hwnd            IN  PLS_INTEGER,
                       Keys            IN  VARCHAR2,
                       RaiseExceptions IN  BOOLEAN  DEFAULT FALSE) is  
  iRC       pls_integer := 0;
  iBuff1    pls_integer := 0;                
  vcBuff1   varchar2(256);
begin 
  Win_API_Debug_PDF.DebugLog(99,'SendKeys','Args: Hwnd='||to_char(Hwnd)||', Keys="'||Keys||'", RaiseExceptions='||Win_API_Debug_PDF.BoolToChar(RaiseExceptions)); 		
  WIN_API_PDF.Clean_Error_Stack;
  -- check that at least something has been sent as a keystroke..
  if Keys is NULL then
    WIN_API_PDF.Add_error('SendKeys','No Keystrokes Specified (Keys parameter is NULL)');
    if RaiseExceptions then 
      raise NO_DATA_FOUND;
    end if;
  end if;
    
  if WIN_API_PDF.API_ENABLED then
    WIN_API_PDF.Register_function_call(iSendKeys,'d2kwutil_SendKeys','INT','INT,*CHAR');
 
    vcbuff1 := rpad(keys,255,chr(0));
    iBuff1 := hWnd;
    iRC   := d2kwutil_SendKeys(WIN_API_PDF.FunctionHandle(iSendkeys), iBuff1, vcbuff1);
    Win_API_Debug_PDF.DebugLog(99,'SendKeys','Result: RC='||to_char(iRC));

    if iRC <> 0 then          
      if iRC = 2 then
        WIN_API_PDF.Add_error('SendKeys','Missing close brace } in key string '||Keys);
      elsif iRC = 3 then
        WIN_API_PDF.Add_error('SendKeys','Invalid Key in key string '||Keys);
      elsif iRC = 4 then
        WIN_API_PDF.Add_error('SendKeys','Missing Close Parenthesis ) in key string '||Keys);
      elsif iRC = 5 then
        WIN_API_PDF.Add_error('SendKeys','Invalid count in key string '||Keys);
      elsif iRC = 6 then
        WIN_API_PDF.Add_error('SendKeys','Key string too long - '||Keys);
      elsif iRC = 7 then
        WIN_API_PDF.Add_error('SendKeys','Can''t install hook');
      else
        WIN_API_PDF.Add_error('SendKeys','Unknown error message = '|| to_char(iRC));
      end if;
      
      if RaiseExceptions then 
        raise NO_DATA_FOUND;
      end if;
    end if; 
  else 
    raise WIN_API_PDF.NOT_AVAILABLE;
  end if;  
exception
  when NO_DATA_FOUND then 
    raise;
  when WIN_API_PDF.NOT_AVAILABLE then
    WIN_API_PDF.Add_error('SendKeys',WIN_API_PDF.NoAPI);
    raise;
  when others then
    WIN_API_PDF.Add_error('SendKeys',WIN_API_PDF.UError||WIN_API_PDF.Add_External_errors);  
    raise;
end SendKeys;


Procedure Start_or_Restore( Executable      IN VARCHAR2,
                            Args            IN VARCHAR2,
                            WindowClass     IN VARCHAR2,
                            ActivationStyle IN PLS_INTEGER DEFAULT WIN_API_PDF.SW_SHOWNORMAL,                           
                            RaiseExceptions IN BOOLEAN) is
   hWinhandle        PLS_INTEGER;
   iLoc              PLS_INTEGER;
   iRestoreMsg       PLS_INTEGER;
   bIsRunning        BOOLEAN;
   vcExec            VARCHAR2(256);
   vcExecName        VARCHAR2(256);
begin
  Win_API_Debug_PDF.DebugLog(99,'Start_or_Restore','Args: Executable="'||Executable||'", Args="'||Args||'", WindowClass="'||WindowClass||'", ActivationStyle='||to_char(ActivationStyle)||', RaiseExceptions='||Win_API_Debug_PDF.BoolToChar(RaiseExceptions));	
  vcExec := Executable;
  if instr(upper(vcExec),'.',-1) = 0 then 
    vcExecName := vcExec||'.EXE';
  end if;
  iLoc := instr(vcExecName,'\'); 
  if  iLoc > 0 then 
    vcExecName := substr(vcExecName,(iLoc+1));
  end if;
  
  bIsRunning := win_api_session_PDF.find3rdpartyapp('*',vcExecName,'WINDOW',TRUE,WindowClass,FALSE); 
   -- Find (and activate) Exec if running
  if bIsRunning then 
     -- So app is running lets send it a message to ensure that it is normalised.
     hWinHandle := win_api_session_PDF.FindAppWindow('*',vcExecName,'WINDOW',WindowClass,TRUE);
     
     -- Get the correct message to send to the window based on the ActivationStyle 
     if ActivationStyle = WIN_API_PDF.SW_SHOWMAXIMIZED then 
        iRestoreMsg := WIN_API_PDF.SC_MAXIMIZE;
     elsif ActivationStyle = WIN_API_PDF.SW_SHOWMINIMIZED then 
        iRestoreMsg := WIN_API_PDF.SC_MINIMIZE;
     else
        iRestoreMsg := WIN_API_PDF.SC_RESTORE;
     end if;
     
     win_api_shell_PDF.sendmessage(hWinHandle,WIN_API_PDF.WM_SYSCOMMAND,iRestoreMsg,0);
   else /* Start app */
     win_api_shell_PDF.winexec(vcExec||' '||Args,ActivationStyle,TRUE);
   end if;
 exception
   when others then 
       if RaiseExceptions then 
         RAISE;
       end if;
 end Start_or_Restore;
 
 PROCEDURE  ShellExecute	( Window					IN 			PLS_INTEGER,
 														Operation				IN  		VARCHAR2,
                            File						IN 			VARCHAR2,
                            Parameters			IN 			VARCHAR2, 
                            Directory				IN 			VARCHAR2,
                            WindowStyle     IN      PLS_INTEGER DEFAULT WIN_API_PDF.SW_SHOWNORMAL,
                            RaiseExceptions IN 			BOOLEAN DEFAULT FALSE) IS
  vcBuff1   varchar2(256) := Operation;
  vcBuff2   varchar2(256) := File;
  vcBuff3   varchar2(256) := Parameters;
  vcBuff4   varchar2(256) := Directory;
  iRC 			PLS_INTEGER;
 BEGIN                            
  Win_API_Debug_PDF.DebugLog(99,'ShellExecute','Args: Operation="'||Operation||'", File="'||file||'", Parameters="'||Parameters||'", Directory="'||Directory||'", WindowStyle='||to_char(WindowStyle)||', RaiseExceptions='||Win_API_Debug_PDF.BoolToChar(RaiseExceptions)); 
  WIN_API_PDF.Clean_Error_Stack;
  if WIN_API_PDF.API_ENABLED then
    WIN_API_PDF.Register_function_call(iShellExecute,'d2kwutil_ShellExecute','INT','INT,*CHAR,*CHAR,*CHAR,*CHAR,INT');
    iRC   := d2kwutil_ShellExecute(WIN_API_PDF.FunctionHandle(iShellExecute),Window,vcBuff1,vcBuff2,vcBuff3,vcBuff4,WindowStyle);
    Win_API_Debug_PDF.DebugLog(99,'ShellExecute','Result: RC='||to_char(iRC));
  else 
    raise WIN_API_PDF.NOT_AVAILABLE;
  end if;  
  
  if iRC < 32 then 
    WIN_API_PDF.Add_error('ShellExecute','Unable to execute '||Operation||':'||File||'(RC='||to_char(iRC)||')');
    if RaiseExceptions then 
      raise NO_DATA_FOUND;
    end if;
  end if;
exception
  when NO_DATA_FOUND then 
    raise;
  when WIN_API_PDF.NOT_AVAILABLE then
    WIN_API_PDF.Add_error('ShellExecute',WIN_API_PDF.NoAPI);
    raise;
  when others then
    WIN_API_PDF.Add_error('ShellExecute',WIN_API_PDF.UError||WIN_API_PDF.Add_External_errors); 
    raise; 	
 END ShellExecute;  	

END WIN_API_SHELL_PDF;


PACKAGE WIN_API_UTILITY_PDF IS

/*-------------------------------------------------------------------------*\
 * WIN_API_UTILITY ->   This package is concerned Helpful utility functions
 * Contents:
 *    Delete_File        -> Erases an O/S file
 *    Move_File          -> Moves an O/S file
 *    Copy_File          -> Copies an O/S file
 *    Create_Directory   -> Creates an O/S Directory
 *    Delete_Directory   -> Deletes an EMPTY O/S Directory
 *    Generate_Temp_Filename   -> The "official" way of getting a 
 *                          Temporary filename.
 *    Get_Active_Window  -> Useful for getting Window Handles 
 *                          when not in Forms (which supplies them
 *                          for you)
 *    Get_Parent_Window  -> Returns the Window handle of the Specified 
 *                          Window's Parent Window, or the top level window
 *                          handle for the app if the recursive option is used.
 *    Play_WAV           -> Plays a Sound file
 *    Sleep              -> Suspends the application
 *    InterruptCheck     -> Check for "Cancel" Mouse Click in tight loops
 *    DebugString        -> Sends a string via the OutputDebugString API call
 *                          You'll need a windows Debugger to view this output
 *    Get_Tick_Count     -> Number of Miliseconds since the machine was last
 *                          re-booted
 *    
 * Dependancies:
 *    WIN_API_ENVIRONMENT
 *    WIN_API
 *    WIN_API_DEBUG
\*-------------------------------------------------------------------------*/ 

/*-------------------------------------------------------------------------*\
 * Delete_File    ->  Deletes the specified file
 * Arguments: 
 *  FileName  ->   The location and name of the file to delete
 *  RaiseExceptions ->   TRUE of FALSE(Default) If set to true, then if the 
 *           command is not successful (e.g the file does 
        not exist) then the explicit exception
 *           NO_DATA_FOUND will be raised.
 * Returns:
 *  (NONE)
\*-------------------------------------------------------------------------*/
 
PROCEDURE Delete_File (  FileName        IN  VARCHAR2,
                        RaiseExceptions IN   BOOLEAN DEFAULT FALSE);

/*-------------------------------------------------------------------------*\
 * Move_File    ->  Moves the specified file
 * Arguments: 
 *  OldFileName  ->   The location and name of the file to Move
 *  NewFileName  ->   The new location and name for the file
 *  RaiseExceptions ->   TRUE or FALSE(Default) If set to true, then if the 
 *           command is not successful (e.g the file does 
        not exist) then the explicit exception
 *           NO_DATA_FOUND will be raised.
 * Returns:
 *  (NONE)
\*-------------------------------------------------------------------------*/
 
PROCEDURE Move_File (  OldFileName      IN  VARCHAR2,
                      NewFileName      IN  VARCHAR2,
                      RaiseExceptions IN   BOOLEAN DEFAULT FALSE);

/*-------------------------------------------------------------------------*\
 * Copy_File    ->  Copies the specified file
 * Arguments: 
 *  OldFileName  ->   The location and name of the file to Copy
 *  NewFileName  ->   The new location and name for the copy of the file
 *  AllowOverWrite  ->  TRUE or FALSE(Default) If FALSE, then if the NewFileName
 *        already exists then the move will fail.  If TRUE the existing
 *        file will just be overwritten.
 *  RaiseExceptions ->   TRUE or FALSE(Default) If set to true, then if the 
 *           command is not successful (e.g the file does 
        not exist) then the explicit exception
 *           NO_DATA_FOUND will be raised.
 * Returns:
 *  (NONE)
\*-------------------------------------------------------------------------*/
 
PROCEDURE Copy_File (  OldFileName      IN  VARCHAR2,
                      NewFileName      IN  VARCHAR2,
                      AllowOverWrite  IN  BOOLEAN DEFAULT FALSE,
                      RaiseExceptions IN   BOOLEAN DEFAULT FALSE);
                      
                      
/*-------------------------------------------------------------------------*\
 * Create_Directory    ->  Creates a Directory
 * Arguments: 
 *  DirectoryPath  ->   The location for the new directory
 *  RaiseExceptions ->  TRUE of FALSE(Default) If set to true, then if the 
 *        			    command is not successful then the explicit exception
 *       			    NO_DATA_FOUND will be raised.
 * Returns:
 *  (NONE)
\*-------------------------------------------------------------------------*/
 
PROCEDURE Create_Directory (  DirectoryPath        IN  VARCHAR2,
                        	  RaiseExceptions IN   BOOLEAN DEFAULT FALSE);
                      
/*-------------------------------------------------------------------------*\
 * Delete_Directory    ->  Deletes a Directory
 * Arguments: 
 *  DirectoryPath  ->   The location of the directory to delete
 *                      This directory MUSt be empty or the command will fail
 *  RaiseExceptions ->  TRUE of FALSE(Default) If set to true, then if the 
 *        			    command is not successful then the explicit exception
 *       			    NO_DATA_FOUND will be raised.
 * Returns:
 *  (NONE)
\*-------------------------------------------------------------------------*/
 
PROCEDURE Delete_Directory (  DirectoryPath        IN  VARCHAR2,
                        	  RaiseExceptions IN   BOOLEAN DEFAULT FALSE);

                      
/*-------------------------------------------------------------------------*\
 * Generate_Temp_Filename->  Asks windows to generate a filename for you 
 *        The filename will take the format of a prefix
 *        (Which you can supply) and a generated number
 *        with a .TMP extension
 *        NOTE: Windows will also create the file 
 *        for you, but it will be empty.
 * Arguments: 
 *  Path    ->   The location you want for the file
 *        NULL ==> Working Directory is the default
 *        To automatically use the Defined Temp dircetory
 *        for the PC then just specify '$TEMP$'
 *      Prefix     ->  A root for the name e.g. 'D2K'(Default)
 *        only the first 3 chars will be used.
 *  RaiseExceptions ->   TRUE of FALSE(Default) If set to true, then if the 
 *           command is not successful the explicit exception
 *           NO_DATA_FOUND will be raised.
 * Returns:
 *  Generated Filename
\*-------------------------------------------------------------------------*/
 
FUNCTION Generate_Temp_Filename(Path             IN  VARCHAR2 DEFAULT NULL,
                                Prefix           IN  VARCHAR2 DEFAULT 'D2K',
                                RaiseExceptions IN  BOOLEAN DEFAULT FALSE) RETURN VARCHAR2;

/*-------------------------------------------------------------------------*\
 * Get_Active_Window  ->  Returns the Windows Window handle to the 
 *        Active Window
 * Arguments: 
 *  RaiseExceptions ->   TRUE of FALSE(Default) If set to true, then if the 
 *           command is not successful then the explicit exception
 *           NO_DATA_FOUND will be raised.
 * Returns:
 *  Integer Window Handle
\*-------------------------------------------------------------------------*/
 
FUNCTION Get_Active_Window (RaiseExceptions IN  BOOLEAN DEFAULT FALSE ) RETURN PLS_INTEGER;


/*-------------------------------------------------------------------------*\
 * Get_Parent_Window  ->  Returns the Windows Window handle to the 
 *                        Active Window
 * Arguments: 
 *  Window_Handle   -> Window to get the parent for
 *  Recursive       -> TRUE of FALSE(Default) If set to true, then the function
 *                     will traverse up the window hierachy for the specified 
 *                     window until the top level window is found.
 *  RaiseExceptions -> TRUE of FALSE(Default) If set to true, then if the 
 *                     command is not successful then the explicit exception
 *                     NO_DATA_FOUND will be raised.
 * Returns:
 *  Integer Window Handle (or Zero if this Window has no Parent)
\*-------------------------------------------------------------------------*/
 
FUNCTION Get_Parent_Window (Window_Handle IN  PLS_INTEGER, Recursive IN BOOLEAN DEFAULT FALSE, RaiseExceptions IN BOOLEAN DEFAULT FALSE) RETURN PLS_INTEGER;


/*-------------------------------------------------------------------------*\
 * Play_WAV  ->  Plays a Windows WAV file
 *
 * Arguments: 
 *  FileName  ->  Path and Name of WAV file to play
 *  Asynchronous  ->  BOOLEAN set to TRUE or FALSE(Default) 
 *        Setting to TRUE, control will return to
 *        PL/SQL immediatly, FALSE will wait until 
 *        the sound has finished
 *  RaiseExceptions  ->  If The Sound File is Not Found or the PC
 *        has no Sound capability then raise 
 *        NO_DATA_FOUND (if TRUE) 
 * Returns:
 *  (NONE)
\*-------------------------------------------------------------------------*/
 
PROCEDURE Play_WAV (   FileName        IN  VARCHAR2,
                      Asynchronous    IN  BOOLEAN DEFAULT FALSE,
                      RaiseExceptions  IN  BOOLEAN DEFAULT FALSE);

/*-------------------------------------------------------------------------*\
 * Sleep    ->  Sleeps for specified time.
 *
 * Arguments: 
 *  SleepTime  ->  Sleep time in milliseconds
 * Returns:
 *  (NONE)
\*-------------------------------------------------------------------------*/
 
PROCEDURE Sleep    (  SleepTime    IN   PLS_INTEGER);

/*-------------------------------------------------------------------------*\
 * InterruptCheck    ->  Allows you to check to see if a button 
 *            has been pressed even in a tight PL/SQL
 *          Loop, or whilst looping through a cursor
 *
 * Arguments: 
 *  ButtonHandle      ->  Handle to a "Cancel" Button
 * Returns:
 *  TRUE if button has been clicked with the mouse.
\*-------------------------------------------------------------------------*/

FUNCTION InterruptCheck (   ButtonHandle  IN  PLS_INTEGER) RETURN BOOLEAN;

/*-------------------------------------------------------------------------*\
 * Get_Tick_Count  ->  Returns the number of Milliseconds since the 
 *                     machine was re-booted
 *                     Useful in Random number generation and for doing
 *                     performance Timings
 *
 * Arguments: 
 *  (NONE)
 * Returns:
 *  PLS_INTEGER
\*-------------------------------------------------------------------------*/
 
FUNCTION Get_Tick_Count RETURN PLS_INTEGER;


END WIN_API_UTILITY_PDF;


PACKAGE BODY WIN_API_UTILITY_PDF is
  -- Constants for maintaining the Function Handle Array
  -- These should be unique through the Whole Library
  -- Utility has indexes in the range 700 - 799
  iDelFile          CONSTANT  PLS_INTEGER  := 700;
  iMoveFile         CONSTANT  PLS_INTEGER  := 701;
  iCopyFile         CONSTANT  PLS_INTEGER  := 702;
  iCreateDir        CONSTANT  PLS_INTEGER  := 703;
  iDeleteDir        CONSTANT  PLS_INTEGER  := 704;  
  iTmpFile          CONSTANT  PLS_INTEGER  := 705;
  iActiveWin        CONSTANT  PLS_INTEGER  := 706;
  iParentWin				CONSTANT  PLS_INTEGER  := 707;
  iPlaySound        CONSTANT  PLS_INTEGER  := 708;
  iSleep            CONSTANT  PLS_INTEGER  := 709;
  iPeekButtonClick  CONSTANT  PLS_INTEGER  := 710;
  iGetTickCount     CONSTANT  PLS_INTEGER  := 711;  

   -- Private Program unit headers
   
FUNCTION d2kwutil_DelFile(    hFunc          IN      ORA_FFI.funcHandleType,
                              FileName      IN OUT  VARCHAR2) return PLS_INTEGER;
FUNCTION d2kwutil_MoveFile (  hFunc          IN      ORA_FFI.funcHandleType,
                              OldFileName    IN OUT  VARCHAR2,
                              NewFileName    IN OUT  VARCHAR2) return PLS_INTEGER;
FUNCTION d2kwutil_CopyFile (  hFunc          IN      ORA_FFI.funcHandleType,
                              OldFileName    IN OUT  VARCHAR2,
                              NewFileName    IN OUT  VARCHAR2,
                              Flags          IN      PLS_INTEGER) return PLS_INTEGER;
FUNCTION d2kwutil_CreateDir(  hFunc          IN      ORA_FFI.funcHandleType,
                              DirectoryPath  IN OUT  VARCHAR2) return PLS_INTEGER;      
FUNCTION d2kwutil_DeleteDir(  hFunc          IN      ORA_FFI.funcHandleType,
                              DirectoryPath  IN OUT  VARCHAR2) return PLS_INTEGER;                              
FUNCTION d2kwutil_TmpFile (   hFunc          IN      ORA_FFI.funcHandleType,
                              Path          IN OUT  VARCHAR2,
                              Prefix        IN OUT  VARCHAR2,
                              FileName      IN OUT  VARCHAR2) return PLS_INTEGER;
FUNCTION d2kwutil_ActiveWin(  hFunc          IN      ORA_FFI.funcHandleType) return PLS_INTEGER;
FUNCTION d2kwutil_ParentWin(  hFunc          IN      ORA_FFI.funcHandleType,
							  wnd            IN      PLS_INTEGER,
							  Recursive      IN      PLS_INTEGER) return PLS_INTEGER;
FUNCTION d2kwutil_PlaySound(  hFunc          IN      ORA_FFI.funcHandleType,
                              FileName      IN OUT   VARCHAR2,
                              Flags          IN       PLS_INTEGER) return PLS_INTEGER;
PROCEDURE d2kwutil_Sleep (          hFunc       IN      ORA_FFI.funcHandleType,
                                    SleepTime   IN      PLS_INTEGER);
FUNCTION d2kwutil_PeekButtonClick ( hFunc       IN      ORA_FFI.funcHandleType,
                                    hBtn        IN      PLS_INTEGER) return PLS_INTEGER;
                                    
FUNCTION d2kwutil_GetTickCount ( hFunc       IN      ORA_FFI.funcHandleType ) return PLS_INTEGER;
                              

 -- Pragmas
 PRAGMA INTERFACE(C,d2kwutil_DelFile,          11265);
 PRAGMA INTERFACE(C,d2kwutil_MoveFile,         11265);
 PRAGMA INTERFACE(C,d2kwutil_CopyFile,         11265);
 PRAGMA INTERFACE(C,d2kwutil_CreateDir,        11265);
 PRAGMA INTERFACE(C,d2kwutil_DeleteDir,        11265);
 PRAGMA INTERFACE(C,d2kwutil_TmpFile,          11265);
 PRAGMA INTERFACE(C,d2kwutil_ActiveWin,        11265);
 PRAGMA INTERFACE(C,d2kwutil_ParentWin,        11265);
 PRAGMA INTERFACE(C,d2kwutil_PlaySound,        11265);
 PRAGMA INTERFACE(C,d2kwutil_Sleep,            11265);
 PRAGMA INTERFACE(C,d2kwutil_PeekButtonClick,  11265);
 PRAGMA INTERFACE(C,d2kwutil_GetTickCount,     11265);

   -- Public Bodies 

PROCEDURE Delete_File (  FileName        IN  VARCHAR2,
                        RaiseExceptions IN   BOOLEAN DEFAULT FALSE) is
  iRC     pls_integer := 0;  
  vcBuff1 varchar2(512);                      
begin 
  Win_API_Debug_PDF.DebugLog(99,'Delete_File','Args: FileName="'||FileName||'", RaiseExceptions='||Win_API_Debug_PDF.booltochar(RaiseExceptions));	  		
  WIN_API_PDF.Clean_Error_Stack;
  if WIN_API_PDF.API_ENABLED then
    win_api_PDF.Register_function_call(iDelFile,'d2kwutil_DelFile','INT','*CHAR');
    vcBuff1    := FileName;
    iRC   := d2kwutil_DelFile(win_api_PDF.FunctionHandle(iDelFile),vcBuff1);
    Win_API_Debug_PDF.DebugLog(99,'Delete_File','Result: RC='||to_char(iRC));
  else 
    raise WIN_API_PDF.NOT_AVAILABLE;
  end if;  
  if iRC = 0 then 
    WIN_API_PDF.Add_error('Delete_File','Could not delete the file '||FileName);
    if RaiseExceptions then 
      raise NO_DATA_FOUND;
    end if;
  end if;
exception
  when NO_DATA_FOUND then 
    raise;
  when WIN_API_PDF.NOT_AVAILABLE then
    Win_API_PDF.Add_error('Delete_File',Win_API_PDF.NoAPI);
    raise;
  when others then 
    Win_API_PDF.Add_error('Delete_File',Win_API_PDF.UError||WIN_API_PDF.Add_External_errors); 
    raise;
   end Delete_file;

PROCEDURE Move_File (  OldFileName      IN  VARCHAR2,
                      NewFileName      IN  VARCHAR2,
                      RaiseExceptions IN   BOOLEAN DEFAULT FALSE) is
    iRC  PLS_INTEGER := 0;
    vcBuff1  VARCHAR2(512);
    vcBuff2  VARCHAR2(512);
begin 
  Win_API_Debug_PDF.DebugLog(99,'Move_File','Args: OldFileName="'||OldFileName||'", NewFileName="'||NewFileName||'", RaiseExceptions='||Win_API_Debug_PDF.booltochar(RaiseExceptions));	  			
  WIN_API_PDF.Clean_Error_Stack;
  if WIN_API_PDF.API_ENABLED then 
    win_api_PDF.Register_function_call(iMoveFile,'d2kwutil_MoveFile','INT','*CHAR,*CHAR');
    vcBuff1    := OldFileName;
    vcBuff2    := NewFileName;
    iRC   := d2kwutil_MoveFile(win_api_PDF.FunctionHandle(iMoveFile),vcBuff1,vcBuff2);
    Win_API_Debug_PDF.DebugLog(99,'Move_File','Result: RC='||to_char(iRC));    
  else 
    raise WIN_API_PDF.NOT_AVAILABLE;
  end if;  
  if iRC = 0 then 
    WIN_API_PDF.Add_error('Move_File','Could not Move the file '||OldFileName||' to '||NewFileName);
    if RaiseExceptions then 
      raise NO_DATA_FOUND;
    end if;
  end if;
exception
  when NO_DATA_FOUND then 
    raise;
  when WIN_API_PDF.NOT_AVAILABLE then
    Win_API_PDF.Add_error('Move_File',Win_API_PDF.NoAPI);
    raise;
  when others then 
    Win_API_PDF.Add_error('Move_File',Win_API_PDF.UError||WIN_API_PDF.Add_External_errors); 
    raise;
end Move_file;

PROCEDURE Copy_File (  OldFileName      IN  VARCHAR2,
                      NewFileName      IN  VARCHAR2,
                      AllowOverWrite  IN  BOOLEAN DEFAULT FALSE,
                      RaiseExceptions IN   BOOLEAN DEFAULT FALSE) is                      
    iRC      PLS_INTEGER := 0;
    iBuff1  PLS_INTEGER := 0;
    vcBuff1  VARCHAR2(512);
    vcBuff2  VARCHAR2(512);
begin 
  Win_API_Debug_PDF.DebugLog(99,'Copy_File','Args: OldFileName="'||OldFileName||'", NewFileName="'||NewFileName||'", AllowOverWrite='||Win_API_Debug_PDF.booltochar(RaiseExceptions)||', RaiseExceptions='||Win_API_Debug_PDF.booltochar(RaiseExceptions));	  				
  WIN_API_PDF.Clean_Error_Stack;
  if WIN_API_PDF.API_ENABLED then 
    win_api_PDF.Register_function_call(iCopyFile,'d2kwutil_CopyFile','INT','*CHAR,*CHAR,INT');
    if AllowOverWrite then 
      iBuff1 := 0;
    else
      iBuff1 := 1;
    end if;
    vcBuff1    := OldFileName;
    vcBuff2    := NewFileName;
    iRC   := d2kwutil_CopyFile(win_api_PDF.FunctionHandle(iCopyFile),vcBuff1,vcBuff2,iBuff1);
    Win_API_Debug_PDF.DebugLog(99,'Copy_File','Result: RC='||to_char(iRC));    
  else 
    raise WIN_API_PDF.NOT_AVAILABLE;
  end if;  
  if iRC = 0 then 
    WIN_API_PDF.Add_error('Copy_File','Could not copy the file '||OldFileName||' to '||NewFileName);
    if RaiseExceptions then 
      raise NO_DATA_FOUND;
    end if;
  end if;
exception
  when NO_DATA_FOUND then 
    raise;
  when WIN_API_PDF.NOT_AVAILABLE then
    Win_API_PDF.Add_error('Copy_File',Win_API_PDF.NoAPI);
    raise;
  when others then 
    Win_API_PDF.Add_error('Copy_File', Win_API_PDF.UError||WIN_API_PDF.Add_External_errors); 
    raise;
end Copy_file;

PROCEDURE Create_Directory (  DirectoryPath        IN  VARCHAR2,
                              RaiseExceptions IN   BOOLEAN DEFAULT FALSE) is
  iRC     pls_integer := 0;  
  vcBuff1 varchar2(261);
begin 
  Win_API_Debug_PDF.DebugLog(99,'Create_Directory','Args: DirectoryPath="'||DirectoryPath||'", RaiseExceptions='||Win_API_Debug_PDF.booltochar(RaiseExceptions));	  		  
  WIN_API_PDF.Clean_Error_Stack;
 
  if WIN_API_PDF.API_ENABLED then
    if length(DirectoryPath) > 260 then 
       WIN_API_PDF.Add_error('Create_Directory','Directory Path is too Long (Max length 260)');
       if RaiseExceptions then
          raise NO_DATA_FOUND;
       end if;
    end if;
    WIN_API_PDF.Register_function_call(iCreateDir,'d2kwutil_CreateDir','INT','*CHAR');
    vcBuff1    := DirectoryPath;
    iRC   := d2kwutil_CreateDir(WIN_API_PDF.FunctionHandle(iCreateDir),vcBuff1);
    Win_API_Debug_PDF.DebugLog(99,'Create_Directory','Result: RC='||to_char(iRC));
  else 
    raise WIN_API_PDF.NOT_AVAILABLE;
  end if;  
  if iRC = 0 then 
    WIN_API_PDF.Add_error('Create_Directory','Could not Create the Directory '||DirectoryPath);
    if RaiseExceptions then
       raise NO_DATA_FOUND;
    end if;
  end if;
exception
  when NO_DATA_FOUND then 
    raise;
  when WIN_API_PDF.NOT_AVAILABLE then
    WIN_API_PDF.Add_error('Create_Directory',WIN_API_PDF.NoAPI);
    raise;
  when others then 
    WIN_API_PDF.Add_error('Create_Directory',WIN_API_PDF.UError||WIN_API_PDF.Add_External_errors); 
    raise;
end Create_Directory;

PROCEDURE Delete_Directory (  DirectoryPath        IN  VARCHAR2,
                              RaiseExceptions      IN   BOOLEAN DEFAULT FALSE) is
  iRC     pls_integer := 0;  
  vcBuff1 varchar2(261);
begin 
  Win_API_Debug_PDF.DebugLog(99,'Delete_Directory','Args: DirectoryPath="'||DirectoryPath||'", RaiseExceptions='||Win_API_Debug_PDF.booltochar(RaiseExceptions));	  		  
  WIN_API_PDF.Clean_Error_Stack;
 
  if WIN_API_PDF.API_ENABLED then
    WIN_API_PDF.Register_function_call(iDeleteDir,'d2kwutil_DeleteDir','INT','*CHAR');
    vcBuff1    := DirectoryPath;
    iRC   := d2kwutil_DeleteDir(WIN_API_PDF.FunctionHandle(iDeleteDir),vcBuff1);
    Win_API_Debug_PDF.DebugLog(99,'Delete_Directory','Result: RC='||to_char(iRC));
  else 
    raise WIN_API_PDF.NOT_AVAILABLE;
  end if;  
  if iRC = 0 then 
    WIN_API_PDF.Add_error('Delete_Directory','Could not Delete the Directory '||DirectoryPath||'. The directory may contain files or may not exist');
    if RaiseExceptions then
       raise NO_DATA_FOUND;
    end if;
  end if;
exception
  when NO_DATA_FOUND then 
    raise;
  when WIN_API_PDF.NOT_AVAILABLE then
    WIN_API_PDF.Add_error('Delete_Directory',WIN_API_PDF.NoAPI);
    raise;
  when others then 
    WIN_API_PDF.Add_error('Delete_Directory',WIN_API_PDF.UError||WIN_API_PDF.Add_External_errors); 
    raise;
end Delete_Directory;

FUNCTION Generate_Temp_Filename (Path               IN  VARCHAR2 DEFAULT NULL,
                                Prefix             IN  VARCHAR2 DEFAULT 'D2K',
                                RaiseExceptions   IN  BOOLEAN DEFAULT FALSE) RETURN VARCHAR2 is
  iRC        PLS_INTEGER := 0;
  vcBuff1    VARCHAR2(512);
  vcBuff2    VARCHAR2(4);
  vcBuff3    VARCHAR2(512);
begin
  Win_API_Debug_PDF.DebugLog(99,'Generate_Temp_Filename','Args: Path="'||Path||'", Prefix="'||Prefix||'", RaiseExceptions='||Win_API_Debug_PDF.booltochar(RaiseExceptions));	  			
  WIN_API_PDF.Clean_Error_Stack;
  if WIN_API_PDF.API_ENABLED then
    WIN_API_PDF.Register_function_call(iTmpFile,'d2kwutil_TmpFile','INT','*CHAR,*CHAR,*CHAR');

    if Path is null then 
      vcBuff1 := '.';
    elsif upper(Path) = '$TEMP$' then 
      vcBuff1 := win_api_environment_PDF.get_temp_directory;
    else
      vcBuff1    := Path;
    end if;
    vcBuff2    := substr(Prefix,1,3);
    vcBuff3    := RPAD(' ',512,CHR(0));
    iRC   := d2kwutil_TmpFile(WIN_API_PDF.FunctionHandle(iTmpFile),vcBuff1,vcBuff2,vcBuff3);
    Win_API_Debug_PDF.DebugLog(99,'Generate_Temp_Filename','Result: RC='||to_char(iRC)||' vcBuff3="'||vcBuff3||'"');        
  else 
    raise WIN_API_PDF.NOT_AVAILABLE;
  end if;  
  
  if (iRC = 0 ) then 
    WIN_API_PDF.Add_error(Generate_Temp_Filename,'Returned no value');
    if (RaiseExceptions) then 
      raise NO_DATA_FOUND;
    end if;
  else 
    return vcBuff3;
  end if;
exception
  when NO_DATA_FOUND then 
    raise;
  when WIN_API_PDF.NOT_AVAILABLE then
    WIN_API_PDF.Add_error('Generate_Temp_Filename',WIN_API_PDF.NoAPI);
    raise;
  when others then 
    WIN_API_PDF.Add_error('Generate_Temp_Filename',WIN_API_PDF.UError||WIN_API_PDF.Add_External_errors); 
    raise;
end Generate_Temp_Filename;

FUNCTION Get_Active_Window (RaiseExceptions IN  BOOLEAN DEFAULT FALSE) RETURN PLS_INTEGER is
  iRC    PLS_INTEGER := 0;
begin
  Win_API_Debug_PDF.DebugLog(99,'Get_Active_Window','Args: RaiseExceptions='||Win_API_Debug_PDF.booltochar(RaiseExceptions));	  			
  WIN_API_PDF.Clean_Error_Stack;
  if WIN_API_PDF.API_ENABLED then 
    WIN_API_PDF.Register_function_call(iActiveWin,'d2kwutil_ActiveWin','INT',NULL);
    iRC   := d2kwutil_ActiveWin(WIN_API_PDF.FunctionHandle(iActiveWin));
    Win_API_Debug_PDF.DebugLog(99,'Get_Active_Window','Result: RC='||to_char(iRC));        
  else 
    raise WIN_API_PDF.NOT_AVAILABLE;
  end if;  
  if iRC = 0 then 
    WIN_API_PDF.Add_error('Get_Active_Window','Unable to obtain active window handle');
    if RaiseExceptions then 
      raise NO_DATA_FOUND;
    end if;
  end if;
  return iRC;
exception
  when NO_DATA_FOUND then 
    raise;
  when WIN_API_PDF.NOT_AVAILABLE then
    WIN_API_PDF.Add_error('Get_Active_Window',WIN_API_PDF.NoAPI);
    raise;
  when others then 
    WIN_API_PDF.Add_error('Get_Active_Window',WIN_API_PDF.UError||WIN_API_PDF.Add_External_errors); 
    raise;
end Get_Active_window;

FUNCTION Get_Parent_Window (Window_Handle IN  PLS_INTEGER, Recursive IN BOOLEAN DEFAULT FALSE, RaiseExceptions IN BOOLEAN DEFAULT FALSE) RETURN PLS_INTEGER is
  iRC    PLS_INTEGER := 0;
  iBuff1 PLS_INTEGER := 0;
begin
  Win_API_Debug_PDF.DebugLog(99,'Get_Parent_Window','Args: Window_Handle ='||to_char(Window_Handle)||', Recursive='||Win_API_Debug_PDF.booltochar(Recursive)||', RaiseExceptions='||Win_API_Debug_PDF.booltochar(RaiseExceptions));	  			
  WIN_API_PDF.Clean_Error_Stack;
  if WIN_API_PDF.API_ENABLED then 
  	if Recursive then 
  		iBuff1 := 1;
  	end if;
    WIN_API_PDF.Register_function_call(iParentWin,'d2kwutil_ParentWin','INT','INT,INT');
    iRC   := d2kwutil_ParentWin(WIN_API_PDF.FunctionHandle(iParentWin),Window_handle,iBuff1);
    Win_API_Debug_PDF.DebugLog(99,'Get_Parent_Window','Result: RC='||to_char(iRC));        
  else 
    raise WIN_API_PDF.NOT_AVAILABLE;
  end if;  
  if iRC = 0 then 
    WIN_API_PDF.Add_error('Get_Parent_Window','Unable to obtain parent window handle');
    if RaiseExceptions then 
      raise NO_DATA_FOUND;
    end if;
  else
    return iRC;
  end if;
exception
  when NO_DATA_FOUND then 
    raise;
  when WIN_API_PDF.NOT_AVAILABLE then
    WIN_API_PDF.Add_error('Get_Parent_Window',WIN_API_PDF.NoAPI);
    raise;
  when others then 
    WIN_API_PDF.Add_error('Get_Parent_Window',WIN_API_PDF.UError||WIN_API_PDF.Add_External_errors); 
    raise;
end Get_Parent_Window;



PROCEDURE Play_WAV (   FileName        IN  VARCHAR2,
                      Asynchronous    IN  BOOLEAN DEFAULT FALSE,
                      RaiseExceptions  IN  BOOLEAN DEFAULT FALSE) is
  iRC          PLS_INTEGER := 0; 
  iBuff1      PLS_INTEGER := 0; 
  vcBuff1      VARCHAR2(512); 
begin 
  Win_API_Debug_PDF.DebugLog(99,'Play_Wav','Args: FileName="'||FileName||'", Asynchronous='||Win_API_Debug_PDF.booltochar(Asynchronous)||', RaiseExceptions='||Win_API_Debug_PDF.booltochar(RaiseExceptions));		
  WIN_API_PDF.Clean_Error_Stack;
  if WIN_API_PDF.API_ENABLED then 
    WIN_API_PDF.Register_function_call(iPlaySound,'d2kwutil_PlaySound','INT','*CHAR,LONG');
    vcBuff1 := Filename;
    if Asynchronous then
      iBuff1 := 1; /* SND_ASYNC -> MMSYSTEM.H */
    else
      iBuff1 := 0; /* SND_SYNC -> MMSYSTEM.H */
    end if;
    iRC   := d2kwutil_PlaySound(WIN_API_PDF.FunctionHandle(iPlaySound),vcBuff1,iBuff1);
    Win_API_Debug_PDF.DebugLog(99,'Play_WAV','Result: RC='||to_char(iRC));    
  else 
    raise WIN_API_PDF.NOT_AVAILABLE;
  end if; 
  if iRC = 0 then 
    WIN_API_PDF.Add_error('Play_WAV','Unable to find Sound file '||FileName||', or this system cannot play sounds');
    if RaiseExceptions then 
      raise NO_DATA_FOUND;
    end if;
  end if;
exception
  when NO_DATA_FOUND then 
    raise;
  when WIN_API_PDF.NOT_AVAILABLE then
    WIN_API_PDF.Add_error('Play_WAV',WIN_API_PDF.NoAPI);
    raise;
  when others then 
    WIN_API_PDF.Add_error('Play_WAV',WIN_API_PDF.UError||WIN_API_PDF.Add_External_errors); 
    raise;
end Play_WAV;

PROCEDURE Sleep (   SleepTime  IN  PLS_INTEGER) is
  iRC          PLS_INTEGER := 0; 
begin
  Win_API_Debug_PDF.DebugLog(99,'Sleep','Args: SleepTime='||SleepTime);			 
  WIN_API_PDF.Clean_Error_Stack;
  if WIN_API_PDF.API_ENABLED then
    WIN_API_PDF.Register_function_call(iSleep,'d2kwutil_Sleep',NULL,'LONG');
    d2kwutil_Sleep(WIN_API_PDF.FunctionHandle(iSleep),SleepTime);
    Win_API_Debug_PDF.DebugLog(99,'Sleep','Result: <NONE>');    
  else 
    raise WIN_API_PDF.NOT_AVAILABLE;
  end if; 
exception
  when WIN_API_PDF.NOT_AVAILABLE then
    WIN_API_PDF.Add_error('Sleep',WIN_API_PDF.NoAPI);
    raise;
  when others then 
    WIN_API_PDF.Add_error('Sleep',WIN_API_PDF.UError||WIN_API_PDF.Add_External_errors); 
    raise;
end Sleep;

FUNCTION InterruptCheck (   ButtonHandle  IN  PLS_INTEGER) 
  RETURN BOOLEAN is
 iRC  PLS_INTEGER := 0;
begin
  Win_API_Debug_PDF.DebugLog(99,'InterruptCheck','Args: ButtonHandle='||ButtonHandle);	 
  WIN_API_PDF.Clean_Error_Stack;
  if WIN_API_PDF.API_ENABLED then
    WIN_API_PDF.Register_function_call(iPeekButtonClick,'d2kwutil_PeekButtonClick','INT','INT');
    iRC := d2kwutil_PeekButtonClick(WIN_API_PDF.FunctionHandle(iPeekButtonClick),ButtonHandle);
    Win_API_Debug_PDF.DebugLog(99,'InteruptCheck','Result: RC='||to_char(iRC));    
    if iRC = 0 then
      return FALSE;
    else
      return TRUE;
    end if;
  else 
    raise WIN_API_PDF.NOT_AVAILABLE;
  end if; 
exception
  when WIN_API_PDF.NOT_AVAILABLE then
    WIN_API_PDF.Add_error('InterruptCheck',WIN_API_PDF.NoAPI);
    raise;
  when others then 
    WIN_API_PDF.Add_error('InterruptCheck',WIN_API_PDF.UError||WIN_API_PDF.Add_External_errors); 
    raise;
end InterruptCheck;

FUNCTION Get_Tick_Count RETURN PLS_INTEGER is
 iRC  PLS_INTEGER := 0;
begin 
  Win_API_Debug_PDF.DebugLog(99,'Get_Tick_Count','Args: <None>');	 	
  WIN_API_PDF.Clean_Error_Stack;
  if WIN_API_PDF.API_ENABLED then
    WIN_API_PDF.Register_function_call(iGetTickCount,'d2kwutil_GetTickCount','LONG',NULL);
    iRC := d2kwutil_GetTickCount(WIN_API_PDF.FunctionHandle(iGetTickCount));
    Win_API_Debug_PDF.DebugLog(99,'Get_Tick_Count','Result: RC='||to_char(iRC));    
  else 
    raise WIN_API_PDF.NOT_AVAILABLE;
  end if; 
  return iRC;
exception
  when WIN_API_PDF.NOT_AVAILABLE then
    WIN_API_PDF.Add_error('Get_Tick_Count',WIN_API_PDF.NoAPI);
    raise;
  when others then 
    WIN_API_PDF.Add_error('Get_Tick_Count',WIN_API_PDF.UError||WIN_API_PDF.Add_External_errors); 
    raise;
end Get_Tick_Count;

END WIN_API_UTILITY_PDF;

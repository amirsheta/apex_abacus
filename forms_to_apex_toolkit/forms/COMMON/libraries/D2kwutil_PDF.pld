  when Win_API_PDF.NOT_AVAILABLE then
    Win_API_PDF.Add_error('Close_File',Win_API_PDF.NoAPI);
    raise;
  when others then 
    Win_API_PDF.Add_error('Close_File', Win_API_PDF.UError||Win_API_PDF.Add_External_errors); 
    raise;
end;


PACKAGE BODY WIN_API_ENVIRONMENT IS

--  Code modified by the Forms Migration Assistant
--  09-√»—-2026 12:00 „


  -- -------------------------------------------------------
  -- GET_ENVIRONMENT_STRING
  -- Returns the value of a client environment variable
  -- e.g. PATH, USERNAME, COMPUTERNAME, TEMP, etc.
  -- -------------------------------------------------------
  FUNCTION Get_Environment_String (
    VarName         IN VARCHAR2,
    RaiseExceptions IN BOOLEAN DEFAULT FALSE
  ) RETURN VARCHAR2 IS
    lValue VARCHAR2(512);
  BEGIN
    lValue := WebUtil_ClientInfo.Get_Env(VarName);

    IF lValue IS NULL THEN
      Message('Environment variable not found: ' || VarName);
      IF RaiseExceptions THEN
        RAISE NO_DATA_FOUND;
      END IF;
    END IF;

    RETURN lValue;
  EXCEPTION
    WHEN NO_DATA_FOUND THEN RAISE;
    WHEN OTHERS THEN
      Message('Get_Environment_String Error: ' || SQLERRM);
      RAISE;
  END Get_Environment_String;

  -- -------------------------------------------------------
  -- GET_WORKING_DIRECTORY
  -- Returns the current working directory on the client
  -- -------------------------------------------------------
  FUNCTION Get_Working_Directory (
    RaiseExceptions IN BOOLEAN DEFAULT FALSE
  ) RETURN VARCHAR2 IS
    lValue VARCHAR2(512);
  BEGIN
    lValue := WebUtil_ClientInfo.Get_Working_Directory;

    IF lValue IS NULL THEN
      Message('Could not retrieve working directory');
      IF RaiseExceptions THEN
        RAISE NO_DATA_FOUND;
      END IF;
    END IF;

    RETURN lValue;
  EXCEPTION
    WHEN NO_DATA_FOUND THEN RAISE;
    WHEN OTHERS THEN
      Message('Get_Working_Directory Error: ' || SQLERRM);
      RAISE;
  END Get_Working_Directory;

  -- -------------------------------------------------------
  -- GET_TEMP_DIRECTORY
  -- Returns the client TEMP directory path
  -- -------------------------------------------------------
  FUNCTION Get_Temp_Directory (
    RaiseExceptions IN BOOLEAN DEFAULT FALSE
  ) RETURN VARCHAR2 IS
    lValue VARCHAR2(512);
  BEGIN
    lValue := WebUtil_ClientInfo.Get_Temp_Directory;

    IF lValue IS NULL THEN
      Message('Could not retrieve temp directory');
      IF RaiseExceptions THEN
        RAISE NO_DATA_FOUND;
      END IF;
    END IF;

    RETURN lValue;
  EXCEPTION
    WHEN NO_DATA_FOUND THEN RAISE;
    WHEN OTHERS THEN
      Message('Get_Temp_Directory Error: ' || SQLERRM);
      RAISE;
  END Get_Temp_Directory;

  -- -------------------------------------------------------
  -- GET_WINDOWS_DIRECTORY
  -- Returns the Windows system directory on the client
  -- -------------------------------------------------------
  FUNCTION Get_Windows_Directory (
    RaiseExceptions IN BOOLEAN DEFAULT FALSE
  ) RETURN VARCHAR2 IS
    lValue VARCHAR2(512);
  BEGIN
    -- 'os.name', 'user.home', 'user.dir' are standard Java system properties
    lValue := WebUtil_ClientInfo.Get_System_Property('user.home');

    IF lValue IS NULL THEN
      Message('Could not retrieve Windows directory');
      IF RaiseExceptions THEN
        RAISE NO_DATA_FOUND;
      END IF;
    END IF;

    RETURN lValue;
  EXCEPTION
    WHEN NO_DATA_FOUND THEN RAISE;
    WHEN OTHERS THEN
      Message('Get_Windows_Directory Error: ' || SQLERRM);
      RAISE;
  END Get_Windows_Directory;

  -- -------------------------------------------------------
  -- GET_USER_NAME
  -- Returns the logged-in client OS username
  -- -------------------------------------------------------
  FUNCTION Get_User_Name (
    RaiseExceptions IN BOOLEAN DEFAULT FALSE
  ) RETURN VARCHAR2 IS
    lValue VARCHAR2(512);
  BEGIN
    lValue := WebUtil_ClientInfo.Get_Env('USERNAME');  -- Windows
    IF lValue IS NULL THEN
      lValue := WebUtil_ClientInfo.Get_Env('USER');    -- Unix/Linux
    END IF;

    IF lValue IS NULL THEN
      -- Fallback: Java system property
      lValue := WebUtil_ClientInfo.Get_System_Property('user.name');
    END IF;

    IF lValue IS NULL THEN
      Message('Could not retrieve username');
      IF RaiseExceptions THEN
        RAISE NO_DATA_FOUND;
      END IF;
    END IF;

    RETURN lValue;
  EXCEPTION
    WHEN NO_DATA_FOUND THEN RAISE;
    WHEN OTHERS THEN
      Message('Get_User_Name Error: ' || SQLERRM);
      RAISE;
  END Get_User_Name;

  -- -------------------------------------------------------
  -- GET_COMPUTER_NAME
  -- Returns the client machine name
  -- -------------------------------------------------------
  FUNCTION Get_Computer_Name (
    RaiseExceptions IN BOOLEAN DEFAULT FALSE
  ) RETURN VARCHAR2 IS
    lValue VARCHAR2(512);
  BEGIN
    lValue := WebUtil_ClientInfo.Get_Env('COMPUTERNAME');  -- Windows
    IF lValue IS NULL THEN
      lValue := WebUtil_ClientInfo.Get_Env('HOSTNAME');    -- Unix/Linux
    END IF;

    IF lValue IS NULL THEN
      Message('Could not retrieve computer name');
      IF RaiseExceptions THEN
        RAISE NO_DATA_FOUND;
      END IF;
    END IF;

    RETURN lValue;
  EXCEPTION
    WHEN NO_DATA_FOUND THEN RAISE;
    WHEN OTHERS THEN
      Message('Get_Computer_Name Error: ' || SQLERRM);
      RAISE;
  END Get_Computer_Name;

  -- -------------------------------------------------------
  -- READ_INI_FILE
  -- No direct WebUtil equivalent in Forms 12c.
  -- Recommended: Store INI-style config in a DB table.
  -- -------------------------------------------------------
  FUNCTION Read_INI_File (
    FileName        IN VARCHAR2,
    Section         IN VARCHAR2,
    KeyName         IN VARCHAR2,
    Default_Value   IN VARCHAR2 DEFAULT NULL,
    RaiseExceptions IN BOOLEAN  DEFAULT FALSE
  ) RETURN VARCHAR2 IS
    lValue VARCHAR2(512);
  BEGIN
    -- INI files are client-side Windows files.
    -- In Forms 12c web, direct INI file access is not supported.
    -- RECOMMENDED REPLACEMENT: Query a config table in the DB:
    --
    --   SELECT config_value INTO lValue
    --   FROM app_config
    --   WHERE config_file    = FileName
    --     AND config_section = Section
    --     AND config_key     = KeyName;
    --
    -- Placeholder implementation:
    BEGIN
      SELECT config_value INTO lValue
      FROM app_config
      WHERE config_file    = FileName
        AND config_section = Section
        AND config_key     = KeyName;
    EXCEPTION
      WHEN NO_DATA_FOUND THEN
        lValue := Default_Value;
    END;

    RETURN lValue;
  EXCEPTION
    WHEN OTHERS THEN
      Message('Read_INI_File Error: ' || SQLERRM);
      IF RaiseExceptions THEN RAISE; END IF;
      RETURN Default_Value;
  END Read_INI_File;

  -- -------------------------------------------------------
  -- WRITE_INI_FILE
  -- No direct WebUtil equivalent in Forms 12c.
  -- Recommended: Store INI-style config in a DB table.
  -- -------------------------------------------------------
  PROCEDURE Write_INI_File (
    FileName        IN VARCHAR2,
    Section         IN VARCHAR2,
    KeyName         IN VARCHAR2,
    Value           IN VARCHAR2,
    RaiseExceptions IN BOOLEAN DEFAULT FALSE
  ) IS
  BEGIN
    -- RECOMMENDED REPLACEMENT: Upsert into a config table in the DB:
    --
    /*MERGE INTO app_config t
    USING (SELECT FileName  AS config_file,
                  Section   AS config_section,
                  KeyName   AS config_key,
                  Value     AS config_value
           FROM DUAL) s
    ON (    t.config_file    = s.config_file
        AND t.config_section = s.config_section
        AND t.config_key     = s.config_key)
    WHEN MATCHED THEN
      UPDATE SET t.config_value = s.config_value
    WHEN NOT MATCHED THEN
      INSERT (config_file, config_section, config_key, config_value)
      VALUES (s.config_file, s.config_section, s.config_key, s.config_value);

    COMMIT_FORM;*/
    NULL;
  EXCEPTION
    WHEN OTHERS THEN
      Message('Write_INI_File Error: ' || SQLERRM);
      IF RaiseExceptions THEN RAISE; END IF;
  END Write_INI_File;

  -- -------------------------------------------------------
  -- READ_REGISTRY
  -- No direct WebUtil equivalent in Forms 12c.
  -- Recommended: Store registry-style config in a DB table.
  -- -------------------------------------------------------
  FUNCTION Read_Registry (
    RootKey         IN VARCHAR2,
    SubKey          IN VARCHAR2,
    ValueName       IN VARCHAR2,
    Default_Value   IN VARCHAR2 DEFAULT NULL,
    RaiseExceptions IN BOOLEAN  DEFAULT FALSE
  ) RETURN VARCHAR2 IS
    lValue VARCHAR2(512);
  BEGIN
    -- Windows Registry is not accessible from Forms 12c web.
    -- RECOMMENDED REPLACEMENT: Query a registry-equivalent DB table:
    --
    /*BEGIN
      SELECT reg_value INTO lValue
      FROM app_registry
      WHERE root_key   = RootKey
        AND sub_key    = SubKey
        AND value_name = ValueName;
    EXCEPTION
      WHEN NO_DATA_FOUND THEN
        lValue := Default_Value;
    END;*/

    RETURN lValue;
  EXCEPTION
    WHEN OTHERS THEN
      Message('Read_Registry Error: ' || SQLERRM);
      IF RaiseExceptions THEN RAISE; END IF;
      RETURN Default_Value;
  END Read_Registry;

  -- -------------------------------------------------------
  -- WRITE_REGISTRY
  -- No direct WebUtil equivalent in Forms 12c.
  -- Recommended: Store registry-style config in a DB table.
  -- -------------------------------------------------------
  PROCEDURE Write_Registry (
    RootKey         IN VARCHAR2,
    SubKey          IN VARCHAR2,
    ValueName       IN VARCHAR2,
    Value           IN VARCHAR2,
    RaiseExceptions IN BOOLEAN DEFAULT FALSE
  ) IS
  BEGIN
    -- RECOMMENDED REPLACEMENT: Upsert into a registry-equivalent DB table:
    --
    /*MERGE INTO app_registry t
    USING (SELECT RootKey   AS root_key,
                  SubKey    AS sub_key,
                  ValueName AS value_name,
                  Value     AS reg_value
           FROM DUAL) s
    ON (    t.root_key   = s.root_key
        AND t.sub_key    = s.sub_key
        AND t.value_name = s.value_name)
    WHEN MATCHED THEN
      UPDATE SET t.reg_value = s.reg_value
    WHEN NOT MATCHED THEN
      INSERT (root_key, sub_key, value_name, reg_value)
      VALUES (s.root_key, s.sub_key, s.value_name, s.reg_value);

    COMMIT_FORM;*/
    NULL;
  EXCEPTION
    WHEN OTHERS THEN
      Message('Write_Registry Error: ' || SQLERRM);
      IF RaiseExceptions THEN RAISE; END IF;
  END Write_Registry;

END WIN_API_ENVIRONMENT;

PACKAGE BODY WIN_API_DIALOG is

   -- Private persistant variables
   fh_CHF		ora_ffi.funcHandleType;
   fh_Print		ora_ffi.funcHandleType;

   iCHFDLLCount		pls_integer	:= 0;
   iPRIDLLCount		pls_integer	:= 0;
   vcBuff1		varchar2(512);
   vcBuff2		varchar2(512);
   vcBuff3		varchar2(512);
   vcBuff4		varchar2(512);
   vcBuff5		varchar2(512);

   iBuff1		pls_integer;
   iBuff2		pls_integer;
   iBuff3		pls_integer;
   iRC			pls_integer;

   -- Private Program unit headers
   FUNCTION ChooseFile(		dialog_type	IN	PLS_INTEGER,
				hwndOwner	IN	PLS_INTEGER,
				szTitle		IN	VARCHAR2,
				szInitDir	IN	VARCHAR2,
				szFileFilter	IN	VARCHAR2,
				Flags		IN	PLS_INTEGER,
				szBuffer	IN OUT	VARCHAR2 ) RETURN PLS_INTEGER;

   FUNCTION externCHF (		hFunc		IN	ORA_FFI.funcHandleType,
				dialog_type	IN	PLS_INTEGER,
				hwndOwner	IN	PLS_INTEGER,
				szTitle		IN OUT	VARCHAR2,
				szInitDir	IN OUT	VARCHAR2,
				szFileFilter	IN OUT	VARCHAR2,
				AdvancedFlags	IN	PLS_INTEGER,
				szBuffer	IN OUT	VARCHAR2) return PLS_INTEGER;

   FUNCTION externPRI (		hFunc		IN	ORA_FFI.funcHandleType,
				hWin		IN	PLS_INTEGER,
				PrinterName	IN OUT	VARCHAR2,
				Port		IN OUT	VARCHAR2) return PLS_INTEGER;

   -- Pragmas
   PRAGMA INTERFACE(C,externCHF,11265);
   PRAGMA INTERFACE(C,externPRI,11265);

   -- Public Bodies 

   FUNCTION Open_File (	Title		IN	VARCHAR2 	DEFAULT 'Open File',
			StartDirectory  IN	VARCHAR2 	DEFAULT '$WINDIR$',
			FileFilter	IN	VARCHAR2 	DEFAULT 'All files(*.*)|*.*|',
			Modal		IN 	BOOLEAN 	DEFAULT TRUE,
			AdvancedFlags	IN	PLS_INTEGER	DEFAULT WIN_API.OFN_FLAG_DEFAULT,
			RaiseExceptions IN 	BOOLEAN 	DEFAULT FALSE
		      ) RETURN VARCHAR2 is
	vcReturnedFile	varchar2(500);
	hWin		pls_integer;
	iLRC		pls_integer := 0;
   begin 
	if Modal then 
		hWin := win_api_utility.get_active_window;
	else
		hWin := 0;
	end if;
	vcReturnedFile := CHR(0);
	iLRC := choosefile(1,hWin,Title,StartDirectory,FileFilter,AdvancedFlags,vcReturnedFile);
	
	if iLRC = 1 then 
		Win_API.Add_error('No file was selected');
		if RaiseExceptions then 
			Raise NO_DATA_FOUND;
		end if;
	else
		return vcReturnedFile;
	end if;
    exception
	when NO_DATA_FOUND then 
		raise;
	when WIN_API.NOT_AVAILABLE then
		Win_API.Add_error(Win_API.NoAPI);
		raise;
	when others then
		Win_API.Add_error('OPEN_FILE'||Win_API.UError||WIN_API.Add_External_errors); 
		raise;
   end Open_file;

   FUNCTION Save_File (	SampleName	IN	VARCHAR2,
			Title		IN	VARCHAR2 	DEFAULT 'Save File As',
			StartDirectory  IN	VARCHAR2 	DEFAULT '$WINDIR$',
			FileFilter	IN	VARCHAR2 	DEFAULT 'All files(*.*)|*.*|',
			Modal		IN 	BOOLEAN 	DEFAULT TRUE,
			AdvancedFlags	IN	PLS_INTEGER	DEFAULT WIN_API.OFN_FLAG_DEFAULT,
			RaiseExceptions IN 	BOOLEAN 	DEFAULT FALSE
		      ) RETURN VARCHAR2 is
	vcReturnedFile	varchar2(500);
	hWin		pls_integer;
	iLRC		pls_integer := 0;
   begin 
	if Modal then 
		hWin := win_api_utility.get_active_window;
	else
		hWin := 0;
	end if;
	vcReturnedFile	:= SampleName;
	iLRC := choosefile(2,hWin,Title,StartDirectory,FileFilter,AdvancedFlags,vcReturnedFile);
	
	if iLRC = 1 then 
		Win_API.Add_error('No file was selected');
		if RaiseExceptions then 
			Raise NO_DATA_FOUND;
		end if;
	else
		return vcReturnedFile;
	end if;
    exception
	when NO_DATA_FOUND then 
		raise;
	when WIN_API.NOT_AVAILABLE then
		Win_API.Add_error(Win_API.NoAPI);
		raise;
	when others then 
		Win_API.Add_error('SAVE_FILE'||Win_API.UError||WIN_API.Add_External_errors); 
		raise;
   end Save_File;
		
   FUNCTION ChooseFile(	dialog_type	IN	PLS_INTEGER,
			hwndOwner	IN	PLS_INTEGER,
			szTitle		IN	VARCHAR2,
			szInitDir	IN	VARCHAR2,
			szFileFilter	IN	VARCHAR2,
			Flags		IN	PLS_INTEGER,
			szBuffer	IN OUT	VARCHAR2 ) RETURN PLS_INTEGER is
   begin 
	Win_API.Clean_Error_Stack;
	iRC	:= 0;
	if Win_API.API_ENABLED then 
		if not Win_API.Check_DLL_Handle(iCHFDLLCount)  then
	   	-- Register the interface to the function
	   		fh_CHF := ora_ffi.register_function(Win_API.DLL_HANDLE,'d2kwutil_ChooseFile',ora_ffi.PASCAL_STD);
     			ora_ffi.register_parameter(fh_CHF,ORA_FFI.C_INT);
     			ora_ffi.register_parameter(fh_CHF,ORA_FFI.C_SHORT);
     			ora_ffi.register_parameter(fh_CHF,ORA_FFI.C_CHAR_PTR);
     			ora_ffi.register_parameter(fh_CHF,ORA_FFI.C_CHAR_PTR);
     			ora_ffi.register_parameter(fh_CHF,ORA_FFI.C_CHAR_PTR);
     			ora_ffi.register_parameter(fh_CHF,ORA_FFI.C_LONG);
     			ora_ffi.register_parameter(fh_CHF,ORA_FFI.C_CHAR_PTR);
			ora_ffi.register_return(fh_CHF,ORA_FFI.C_INT);
		end if;

		iBuff1 		:= dialog_type;
 		iBuff2 		:= hwndOwner;
		iBuff3		:= Flags;
		vcBuff1		:= szTitle;
		if upper(szInitDir) = '$WINDIR$' then 
			vcBuff2 := win_api_environment.get_windows_directory;
		elsif  upper(szInitDir) = '$TEMP$' then 
			vcBuff2 := win_api_environment.get_temp_directory;
		else 
			vcBuff2 := szInitDir;
		end if;
		if substr(vcBuff2,length(vcBuff2),1) <> '\' then 
			vcBuff2 := vcBuff2||'\';
		end if;
		if szFileFilter = NULL or szFileFilter = '' then 
			vcBuff3 := 'All files(*.*)|*.*|';
		else
			vcBuff3 := szFileFilter;
		end if;

		vcBuff4 := RPAD(szBuffer,512,CHR(0)); 
		iRC := externCHF(fh_CHF,iBuff1,iBuff2,vcBuff1,vcBuff2,vcBuff3,iBuff3,vcBuff4);
		szBuffer := vcBuff4;
		return iRC;
	else 
		raise WIN_API.NOT_AVAILABLE;
	end if;  
   end Choosefile;

   PROCEDURE Select_Printer (	PrinterName 	OUT	VARCHAR2,
				Port		OUT	VARCHAR2,
				RaiseExceptions in BOOLEAN DEFAULT FALSE) is
   begin
	Win_API.Clean_Error_Stack;
	iRC	:= 0;
	if Win_API.API_ENABLED then 
		if not Win_API.Check_DLL_Handle(iPRIDLLCount)  then
	   	-- Register the interface to the function
	   		fh_Print := ora_ffi.register_function(Win_API.DLL_HANDLE,'d2kwutil_ChoosePrint',ora_ffi.PASCAL_STD);
     			ora_ffi.register_parameter(fh_Print,ORA_FFI.C_INT);
     			ora_ffi.register_parameter(fh_Print,ORA_FFI.C_CHAR_PTR);
     			ora_ffi.register_parameter(fh_Print,ORA_FFI.C_CHAR_PTR);
			ora_ffi.register_return(fh_Print,ORA_FFI.C_INT);
		end if;

		iBuff1 		:= win_api_utility.get_active_window;
		vcBuff1		:= RPAD(' ',512,CHR(0)); 
		vcBuff2		:= RPAD(' ',512,CHR(0)); 
		iRC := externPRI(fh_Print,iBuff1,vcBuff1,vcBuff2);
	else 
		raise WIN_API.NOT_AVAILABLE;
	end if;  
	if iRC = 0 then 
		PrinterName 	:= vcBuff1;
		Port		:= vcBuff2;
	else
		Win_API.Add_error('No Printer Selected');
		if RaiseExceptions then 
			raise NO_DATA_FOUND;
		end if;
	end if;
    exception
	when NO_DATA_FOUND then 
		raise;
	when WIN_API.NOT_AVAILABLE then
		Win_API.Add_error(Win_API.NoAPI);
		raise;
	when others then 
		Win_API.Add_error('SELECT_PRINTER'||Win_API.UError||WIN_API.Add_External_errors); 
		raise;
   end Select_Printer;

END WIN_API_DIALOG;


PACKAGE BODY WIN_API_BITOP is

   -- Private persistant variables
   fh_OR		ora_ffi.funcHandleType;
   fh_XOR		ora_ffi.funcHandleType;
   fh_AND		ora_ffi.funcHandleType;
   fh_SR		ora_ffi.funcHandleType;
   fh_SL		ora_ffi.funcHandleType;

   iORDLLCount		pls_integer	:= 0;
   iXORDLLCount		pls_integer	:= 0;
   iANDDLLCount		pls_integer	:= 0;
   iSRDLLCount		pls_integer	:= 0;
   iSLDLLCount		pls_integer	:= 0;

   -- Private Program unit headers
   FUNCTION externOR (		hFunc		IN	ORA_FFI.funcHandleType,
				X		IN 	PLS_INTEGER,
				Y		IN 	PLS_INTEGER) return PLS_INTEGER;

   FUNCTION externXOR (		hFunc		IN	ORA_FFI.funcHandleType,
				X		IN 	PLS_INTEGER,
				Y		IN 	PLS_INTEGER) return PLS_INTEGER;

   FUNCTION externAND (		hFunc		IN	ORA_FFI.funcHandleType,
				X		IN 	PLS_INTEGER,
				Y		IN 	PLS_INTEGER) return PLS_INTEGER;

   FUNCTION externSR (		hFunc		IN	ORA_FFI.funcHandleType,
				X		IN 	PLS_INTEGER,
				Steps		IN 	PLS_INTEGER) return PLS_INTEGER;

   FUNCTION externSL (		hFunc		IN	ORA_FFI.funcHandleType,
				X		IN 	PLS_INTEGER,
				Steps		IN 	PLS_INTEGER) return PLS_INTEGER;


   -- Pragmas
   PRAGMA INTERFACE(C,externOR,11265);
   PRAGMA INTERFACE(C,externXOR,11265);
   PRAGMA INTERFACE(C,externAND,11265);
   PRAGMA INTERFACE(C,externSR,11265);
   PRAGMA INTERFACE(C,externSL,11265);

   -- Public Bodies 

FUNCTION BITWISE_OR (	X	IN	PLS_INTEGER,
		 	Y	IN	PLS_INTEGER) RETURN PLS_INTEGER is
   begin 
	Win_API.Clean_Error_Stack;
	if WIN_API.API_ENABLED then 
		if not Win_API.Check_DLL_Handle(iORDLLCount)  then
	   	-- Register the interface to the function
	   		fh_OR := ora_ffi.register_function(Win_API.DLL_HANDLE,'d2kwutil_bwOR',ora_ffi.PASCAL_STD);
     			ora_ffi.register_parameter(fh_OR,ORA_FFI.C_INT);
     			ora_ffi.register_parameter(fh_OR,ORA_FFI.C_INT);
			ora_ffi.register_return(fh_OR,ORA_FFI.C_INT);
		end if;

		return externOR(fh_OR,X,Y);
	else 
		raise WIN_API.NOT_AVAILABLE;
	end if;  
   exception
	when WIN_API.NOT_AVAILABLE then
		Win_API.Add_error(Win_API.NoAPI);
		raise;
	when others then
		Win_API.Add_error('BITWISE_OR'||Win_API.UError||WIN_API.Add_External_errors); 
		raise;
   end BITWISE_OR;

FUNCTION BITWISE_XOR (	X	IN	PLS_INTEGER,

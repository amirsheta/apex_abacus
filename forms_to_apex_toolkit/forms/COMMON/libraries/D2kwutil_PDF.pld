    vcBuff1    := substr(DriveLetter,1,instr(DriveLetter,':'));
    vcBuff2   := RPAD(' ',512,CHR(0));
    iBuff1    := 512;
    iRC   := d2kwutil_WNetGetConnection(Win_API_PDF.FunctionHandle(iWNetGetConnection),vcBuff1,vcBuff2,iBuff1);
    Win_API_Debug_PDF.DebugLog(99,'Get_Net_Connection','Result:  RC='||to_char(iRC)||', vcBuff2="'||vcBuff2||'"');	  
  else 

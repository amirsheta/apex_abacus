FUNCTION Get_Environment_string (  VariableName      IN  VARCHAR2,
                                   RaiseExceptions   IN  BOOLEAN DEFAULT FALSE)  RETURN VARCHAR2 is
  vcBuff1    VARCHAR2(512);
  vcBuff2    VARCHAR2(512);
  iBuff1    PLS_INTEGER;
  iRC        PLS_INTEGER;
begin 
  Win_API_Debug_PDF.DebugLog(99,'Get_Environment_String','Args: VariableName="'||VariableName||'", RaiseExceptions='||Win_API_Debug_PDF.BoolToChar(RaiseExceptions));
  Win_API_PDF.Clean_Error_Stack;
  iRC  := 0;
  if Win_API_PDF.API_ENABLED then
    Win_API_PDF.Register_function_call(iGetDOSEnv,'d2kwutil_GetDOSEnv','LONG','*CHAR,*CHAR,LONG');
    vcBuff1    := '%'||VariableName||'%';
    vcBuff2    := RPAD(' ',512,CHR(0));
    iBuff1    := 512;
    iRC   := d2kwutil_GetDOSEnv(Win_API_PDF.FunctionHandle(iGetDOSEnv),vcBuff1,vcBuff2,iBuff1);
    Win_API_Debug_PDF.DebugLog(99,'Get_Environment_String','Result: Value Length='||to_char(iRC)||', Value='||vcBuff2);
  else 
    raise Win_API_PDF.NOT_AVAILABLE;
  end if;  
  if iRC = 0  or vcBuff2 = vcBuff1 then 
    Win_API_PDF.Add_error('Get_Environment_String','Unable to get the value of the variable '||VariableName);
    if RaiseExceptions then
      raise NO_DATA_FOUND;
    else
      return NULL;
    end if;
  else
    return vcBuff2;
  end if;
exception
  when NO_DATA_FOUND then 
    raise;
  when Win_API_PDF.NOT_AVAILABLE then
    Win_API_PDF.Add_error('Get_Environment_String',Win_API_PDF.NoAPI);
    raise;
  when others then 
    Win_API_PDF.Add_error('Get_Environment_String',Win_API_PDF.UError||Win_API_PDF.Add_External_errors); 
    raise;
end Get_Environment_String;


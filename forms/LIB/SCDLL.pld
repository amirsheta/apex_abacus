   END sc_dll_cleanup;

   FUNCTION  sc_send_txn_post_status(
			txn_post_status     	IN OUT	VARCHAR2
			)  RETURN PLS_INTEGER IS
	RC                   		PLS_INTEGER;
	l_txn_post_status             	VARCHAR2(256)	:= RPAD(SUBSTR(NVL(txn_post_status,' '),1,256),256,CHR(0));
   BEGIN

	rc := i_sc_send_txn_post_status(
			fh_sc_send_txn_post_status,
			l_txn_post_status);
	txn_post_status               	:= l_txn_post_status;
   RETURN RC;
   END sc_send_txn_post_status;

BEGIN

	LoadLibrary;
	rg_str_1252_to_pos;
	rg_sc_send_payment_details;
	rg_sc_get_terminal_id;
	rg_sc_dll_init;
	rg_sc_dll_cleanup;
	rg_sc_send_txn_post_status;
END SCDLL;

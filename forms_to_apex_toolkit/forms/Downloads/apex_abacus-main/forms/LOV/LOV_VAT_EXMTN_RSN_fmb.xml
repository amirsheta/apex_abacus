      <ProgramUnit Name="CHANGE_MESSAGE_COLOR" ProgramUnitText="PROCEDURE CHANGE_MESSAGE_COLOR IS&amp;#10;&#x9;MESSAGE_PROPERTY_FG VARCHAR2 (40) := GET_ITEM_PROPERTY('MESSAGE', FOREGROUND_COLOR);&amp;#10;&#x9;MESSAGE_PROPERTY_BK VARCHAR2 (40) := GET_ITEM_PROPERTY('MESSAGE', BACKGROUND_COLOR);&amp;#10;BEGIN&amp;#10;&#x9;IF MESSAGE_PROPERTY_BK IS NULL THEN&amp;#10;&#x9;&#x9;MESSAGE_PROPERTY_BK := GET_CANVAS_PROPERTY('CG$PAGE_1', BACKGROUND_COLOR);&amp;#10;&#x9;END IF;&amp;#10;&amp;#10;&#x9;IF MESSAGE_PROPERTY_FG = :PARAMETER.P_FG_COLOR THEN&amp;#10;&#x9;&#x9;SET_ITEM_PROPERTY('MESSAGE', FOREGROUND_COLOR, MESSAGE_PROPERTY_BK);&amp;#10;&#x9;ELSE&amp;#10;&#x9;&#x9;SET_ITEM_PROPERTY('MESSAGE', FOREGROUND_COLOR, :PARAMETER.P_FG_COLOR);&amp;#10;&#x9;END IF;&amp;#10;&#x9;DELETE_TIMER('MESSAGE_TIMER');&amp;#10;&#x9;CREATE_MESSAGE_TIMER;&#x9;&amp;#10;END;&amp;#10;" ProgramUnitType="Procedure"/>
      <ProgramUnit Name="CREATE_MESSAGE_TIMER" ProgramUnitText="PROCEDURE CREATE_MESSAGE_TIMER IS&amp;#10;&#x9;MESSAGE_TIMER timer;&amp;#10;BEGIN&amp;#10;&#x9;MESSAGE_TIMER := create_timer('MESSAGE_TIMER', 550, REPEAT);&amp;#10;END;&amp;#10;" ProgramUnitType="Procedure"/>
      <ProgramUnit Name="ADJUST_HEIGHT" ProgramUnitText="PROCEDURE Adjust_Height IS&amp;#10;&#x9;V_HEIGHT     number;&amp;#10;&#x9;SHIFT        number;&amp;#10;&#x9;V_ROW_COUNT  NUMBER;&amp;#10;&#x9;V_TEMP       NUMBER;&amp;#10;BEGIN&amp;#10;&#x9;V_ROW_COUNT := NVL(:PARAMETER.ROW_COUNT, 1);&amp;#10;&#x9;IF V_ROW_COUNT &lt; 1 THEN&amp;#10;&#x9;&#x9;V_ROW_COUNT := 1;&amp;#10;&#x9;ELSIF V_ROW_COUNT > 12 THEN&amp;#10;&#x9;&#x9;V_ROW_COUNT := 12;&amp;#10;&#x9;END IF;&amp;#10;&amp;#10;&#x9;V_HEIGHT := Get_Window_Property('CGSO$WINDOW_1', HEIGHT);&amp;#10;&#x9;SHIFT := (12 - V_ROW_COUNT) * 0.25;&amp;#10;&#x9;V_HEIGHT := V_HEIGHT - SHIFT;&amp;#10;&amp;#10;&#x9;:PARAMETER.BUTTON_Y_POS := :PARAMETER.BUTTON_Y_POS - SHIFT;&amp;#10;&amp;#10;&#x9;Set_Window_Property('CGSO$WINDOW_1', HEIGHT, V_HEIGHT);&amp;#10;&#x9;Set_Canvas_Property('CG$PAGE_1', HEIGHT, V_HEIGHT);&amp;#10;&#x9;SET_VIEW_PROPERTY('BUTTONS', display_position, 0, :PARAMETER.BUTTON_Y_POS);&amp;#10;&amp;#10;&#x9;IF :PARAMETER.P_MSG_DTLS IS NOT NULL AND :PARAMETER.P_MESS_TXT IS NOT NULL THEN&amp;#10;&#x9;&#x9;V_TEMP := (V_HEIGHT - 1) * 0.35;&amp;#10;&#x9;&#x9;Set_Item_Property('MESSAGE', HEIGHT, V_TEMP);&amp;#10;&#x9;&#x9;V_TEMP := V_TEMP + 0.1 + Get_Item_Property('MESS_TEXT.MESSAGE', Y_POS);&amp;#10;&#x9;&#x9;Set_Item_Property('MSG_DTLS', Y_POS, V_TEMP);&amp;#10;&#x9;&#x9;Set_Item_Property('MSG_DTLS', HEIGHT, (V_HEIGHT - 1) * 0.65);&amp;#10;&#x9;ELSIF :PARAMETER.P_MESS_TXT IS NOT NULL THEN&amp;#10;&#x9;&#x9;Set_Item_Property('MESSAGE', HEIGHT, V_HEIGHT - 0.9);&amp;#10;&#x9;ELSIF :PARAMETER.P_MSG_DTLS IS NOT NULL THEN&amp;#10;&#x9;&#x9;Set_Item_Property('MSG_DTLS', Y_POS, TO_NUMBER(GET_ITEM_PROPERTY('MESSAGE', Y_POS)));&amp;#10;&#x9;&#x9;Set_Item_Property('MSG_DTLS', HEIGHT, V_HEIGHT - 0.9);&amp;#10;&#x9;END IF;&amp;#10;END;" ProgramUnitType="Procedure"/>
      <ProgramUnit Name="ADJUST_WIDTH" ProgramUnitText="PROCEDURE Adjust_Width IS&amp;#10;&#x9;Shift number;&amp;#10;&#x9;V_MARGIN number;&amp;#10;&#x9;ENTER_POS number;&amp;#10;&#x9;EXECUTE_POS number;&amp;#10;&#x9;OK_POS number;&amp;#10;&#x9;CANCEL_POS number;&amp;#10;&amp;#10;BEGIN&amp;#10;&#x9;if :PARAMETER.WINDOW_WIDTH &lt; 4 then&amp;#10;&#x9;&#x9;str.DispAlert('عرض الرسـالة أقل من الحد المسموح به','INFORMATION');&amp;#10;&#x9;elsif :PARAMETER.WINDOW_WIDTH > 7.5 then&amp;#10;&#x9;&#x9;str.DispAlert('عرض الرسـالة أكبر من الحد المسموح به','INFORMATION');&amp;#10;&#x9;else&amp;#10;&#x9;&#x9;Shift := 1.75 - ((:PARAMETER.WINDOW_WIDTH - 4)/2);&amp;#10;&#x9;&#x9;IF (GET_ITEM_PROPERTY('PB_CANCEL',VISIBLE) = 'TRUE') THEN&amp;#10;&#x9;&#x9;&#x9;CANCEL_POS:= Get_Item_Property('PB_CANCEL', X_POS);&amp;#10;&#x9;&#x9;END IF;&amp;#10;&#x9;&#x9;IF (GET_ITEM_PROPERTY('PB_OK',VISIBLE) = 'TRUE') THEN      &amp;#10;&#x9;&#x9;&#x9;OK_POS  := Get_Item_Property('PB_OK', X_POS);&amp;#10;&#x9;&#x9;END IF; &amp;#10;&amp;#10;&#x9;&#x9;IF (GET_ITEM_PROPERTY('PB_CANCEL',VISIBLE) = 'TRUE') THEN&amp;#10;&#x9;&#x9;&#x9;Set_Item_Property('PB_CANCEL', X_POS, CANCEL_POS-Shift); &#x9;  &amp;#10;&#x9;&#x9;END IF;&amp;#10;&#x9;&#x9;IF (GET_ITEM_PROPERTY('PB_OK',VISIBLE) = 'TRUE') THEN   &amp;#10;&#x9;&#x9;&#x9;Set_Item_Property('PB_OK', X_POS, OK_POS-Shift); &amp;#10;&#x9;&#x9;END IF;&amp;#10;&amp;#10;&#x9;&#x9;Set_Window_Property('CGSO$WINDOW_1', WIDTH, :PARAMETER.WINDOW_WIDTH);&amp;#10;&#x9;&#x9;Set_Canvas_Property('CG$PAGE_1', WIDTH, :PARAMETER.WINDOW_WIDTH);&#x9;  &amp;#10;&amp;#10;&#x9;  V_MARGIN := 2*:PARAMETER.P_MESS_X_POS;&amp;#10;&#x9;&#x9;IF :PARAMETER.P_MESS_TXT IS NOT NULL THEN&amp;#10;&#x9;&#x9;&#x9;Set_Item_Property('MESSAGE', X_POS, :PARAMETER.P_MESS_X_POS);&amp;#10;&#x9;&#x9;&#x9;Set_Item_Property('MESSAGE', WIDTH, :PARAMETER.WINDOW_WIDTH - V_MARGIN);&amp;#10;&#x9;&#x9;END IF;&amp;#10;&amp;#10;&#x9;&#x9;IF :PARAMETER.P_MSG_DTLS IS NOT NULL THEN&amp;#10;&#x9;&#x9;&#x9;Set_Item_Property('MSG_DTLS', X_POS, :PARAMETER.P_MESS_X_POS);&amp;#10;&#x9;&#x9;&#x9;Set_Item_Property('MSG_DTLS', WIDTH, :PARAMETER.WINDOW_WIDTH - V_MARGIN);&amp;#10;&#x9;&#x9;END IF;&amp;#10;&#x9;end if;&amp;#10;END;&amp;#10;" ProgramUnitType="Procedure"/>
      <ProgramUnit Name="COPY_SELECTED_VALUES" ProgramUnitText="PROCEDURE COPY_SELECTED_VALUES IS&amp;#10;MSG_LVL&#x9;VARCHAR2(5);&amp;#10;BEGIN&amp;#10;/*&#x9;&amp;#10;:GLOBAL.VSSL_PORT_CD &#x9;&#x9;:= :VSSL_PORT_CD;&amp;#10;:GLOBAL.SHPG_AGNT_NBR &#x9;:= :SHPG_AGNT_NBR;&amp;#10;:GLOBAL.DO_ISS_DT &#x9;&#x9;&#x9;:= :DO_ISS_DT;&amp;#10;:GLOBAL.DO_NBR &#x9;&#x9;&#x9;&#x9;&#x9;:= :DO_NBR;&amp;#10;*/&amp;#10;:GLOBAL.EXMTN_RSN &#x9;&#x9;:= :EXMTN_RSN;&amp;#10;:GLOBAL.DATA_SAVE := 1;&amp;#10;&amp;#10;&#x9;MSG_LVL := :SYSTEM.MESSAGE_LEVEL;&amp;#10;&#x9;:SYSTEM.MESSAGE_LEVEL := '25';&amp;#10;&#x9;&#x9;&amp;#10;&#x9;DO_KEY('exit_form');&amp;#10;&#x9;DO_KEY('exit_form');&amp;#10;&#x9;:SYSTEM.MESSAGE_LEVEL := MSG_LVL;&amp;#10;END;&amp;#10;" ProgramUnitType="Procedure"/>
      <ProgramUnit Name="CANCEL_FORM" ProgramUnitText="PROCEDURE CANCEL_FORM IS&amp;#10;MSG_LVL&#x9;VARCHAR2(5);&amp;#10;BEGIN&amp;#10;:GLOBAL.EXMTN_RSN &#x9;&#x9;:= NULL;&amp;#10;&amp;#10;END;" ProgramUnitType="Procedure"/>
      <ProgramUnit Name="POPULATE_DYNAMIC_LISTS" ProgramUnitText="PROCEDURE POPULATE_DYNAMIC_LISTS IS&amp;#10;/* Read each lists values from its record group and populate the list */&amp;#10;  temp NUMBER;  /* Return value of populate_group call */&amp;#10;  rg_id RECORDGROUP;  /* Return value of populate_group call */&amp;#10;BEGIN&amp;#10;  rg_id := create_group_from_query('CGDV$DLRG',&amp;#10;    'SELECT RV_MEANING, RV_LOW_VALUE '||&amp;#10;    'FROM   CG_REF_CODES '||&amp;#10;    'WHERE  RV_DOMAIN = ''VAT_EXMTN_RSN'' '||&amp;#10;    'ORDER BY  2');&amp;#10;  temp := populate_group(rg_id);&amp;#10;  populate_list('EXMTN_RSN', rg_id);&amp;#10;  delete_group(rg_id);&amp;#10;&amp;#10;&amp;#10;END;" ProgramUnitType="Procedure"/>
      <Trigger Name="WHEN-NEW-FORM-INSTANCE" DirtyInfo="true" TriggerText="DECLARE&amp;#10;&#x9;V_PORT_NAME VARCHAR2(50);&amp;#10;BEGIN&amp;#10;&#x9;SET_WINDOW_PROPERTY('CGSO$WINDOW_1',TITLE,' شاشة اختيار سبب الاعفاء من الضريبة');&amp;#10;&amp;#10;:GLOBAL.EXMTN_RSN &#x9;&#x9;&#x9;:= NULL;&amp;#10;&amp;#10;&amp;#10;POPULATE_DYNAMIC_LISTS;&amp;#10;END;&amp;#10;"/>
      <Trigger Name="ON-ERROR" DirtyInfo="true" TriggerText=" DECLARE  &amp;#10;   errnum NUMBER       := ERROR_CODE;  &amp;#10;   errtxt VARCHAR2(80) := ERROR_TEXT;  &amp;#10;   errtyp VARCHAR2(20)  := ERROR_TYPE;  &amp;#10;   alert_is     alert;   &amp;#10;   alert_button number;&amp;#10;   MsgTxt VARCHAR2(2000);&amp;#10;   &amp;#10; BEGIN  &amp;#10;&#x9; IF errnum = 41051 then&amp;#10;&#x9; &#x9;null;&amp;#10;&#x9; else&amp;#10;&#x9; &#x9; IF errtyp = 'FRM' THEN&amp;#10;&#x9;&#x9; &#x9;errtyp := 'خطأ : ش';&amp;#10;&#x9;&#x9; ELSIF errtyp = 'ORA' THEN&amp;#10;&#x9;&#x9; &#x9;errtyp := 'خطأ : ق';&amp;#10;&#x9;&#x9; END IF;&amp;#10;&#x9;&#x9; &amp;#10;&#x9;&#x9; MsgTxt := errtyp||'-'||TO_CHAR(errnum)||': '||errtxt;&amp;#10;&#x9;   alert_is := find_alert('CFG_ERROR');  &amp;#10;&#x9;&amp;#10;&#x9;&#x9; if  (not id_null(alert_is)) then &amp;#10;&#x9;  &#x9;&#x9;set_alert_property(alert_is, ALERT_MESSAGE_TEXT, MsgTxt );  &amp;#10;&#x9;  &#x9;&#x9;alert_button := show_alert(alert_is);  &amp;#10;&#x9;&#x9; else&amp;#10;&#x9;     Message(MsgTxt);  &amp;#10;&#x9;&#x9; end if;&amp;#10;&#x9;&#x9;&amp;#10;&#x9;  RAISE Form_Trigger_Failure;  &amp;#10;end if;&amp;#10; END;  &amp;#10;  &amp;#10; "/>

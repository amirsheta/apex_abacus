      <Trigger Name="ON-ERROR" DirtyInfo="true" TriggerText=" DECLARE  &amp;#10;   errnum NUMBER       := ERROR_CODE;  &amp;#10;   errtxt VARCHAR2(80) := ERROR_TEXT;  &amp;#10;   errtyp VARCHAR2(20)  := ERROR_TYPE;  &amp;#10;   alert_is     alert;   &amp;#10;   alert_button number;&amp;#10;   MsgTxt VARCHAR2(2000);&amp;#10;   &amp;#10; BEGIN  &amp;#10;&#x9; IF errnum = 41051 then&amp;#10;&#x9; &#x9;null;&amp;#10;&#x9; else&amp;#10;&#x9; &#x9; IF errtyp = 'FRM' THEN&amp;#10;&#x9;&#x9; &#x9;errtyp := 'خطأ : ش';&amp;#10;&#x9;&#x9; ELSIF errtyp = 'ORA' THEN&amp;#10;&#x9;&#x9; &#x9;errtyp := 'خطأ : ق';&amp;#10;&#x9;&#x9; END IF;&amp;#10;&#x9;&#x9; &amp;#10;&#x9;   IF DBMS_ERROR_CODE = ERR_DB.GET_DB_ERR_CD THEN&amp;#10;&#x9;&#x9;&#x9;MsgTxt := ERR_DB.GET_LAST_ERROR;&amp;#10;&#x9;   ELSE&amp;#10;&#x9;&#x9;&#x9;MsgTxt := errtyp||'-'||TO_CHAR(errnum)||': '||errtxt;&amp;#10;&#x9;   END IF;&amp;#10;&#x9;   alert_is := find_alert('CFG_ERROR');  &amp;#10;&#x9;&amp;#10;&#x9;&#x9; if  (not id_null(alert_is)) then &amp;#10;&#x9;  &#x9;&#x9;set_alert_property(alert_is, ALERT_MESSAGE_TEXT, MsgTxt );  &amp;#10;&#x9;  &#x9;&#x9;alert_button := show_alert(alert_is);  &amp;#10;&#x9;&#x9; else&amp;#10;&#x9;     Message(MsgTxt);  &amp;#10;&#x9;&#x9; end if;&amp;#10;&#x9;&#x9;&amp;#10;&#x9;  RAISE Form_Trigger_Failure;  &amp;#10;end if;&amp;#10; END;  &amp;#10;  &amp;#10; "/>
      <Trigger Name="ON-MESSAGE" DirtyInfo="true" TriggerText=" DECLARE  &amp;#10;   msgnum NUMBER       := MESSAGE_CODE;  &amp;#10;   msgtxt VARCHAR2(80) := MESSAGE_TEXT;  &amp;#10;   msgtyp VARCHAR2(20)  := MESSAGE_TYPE;  &amp;#10; BEGIN&amp;#10;&#x9; IF msgtyp = 'FRM' THEN&amp;#10;&#x9; &#x9;msgtyp := 'معلومه : ش';&amp;#10;&#x9; ELSIF msgtyp = 'ORA' THEN&amp;#10;&#x9; &#x9;msgtyp := 'معلومه : ق';&amp;#10;&#x9; END IF;&amp;#10;&#x9; &#x9;&amp;#10; &#x9;&#x9;&#x9;&amp;#10;     Message(msgtyp||'-'||TO_CHAR(msgnum)||': '||msgtxt);  &amp;#10;&amp;#10; END;  &amp;#10;  &amp;#10; "/>

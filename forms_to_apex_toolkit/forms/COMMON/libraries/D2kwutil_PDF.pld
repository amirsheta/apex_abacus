 Function Read_Data(FileHandle      IN     Win_API_PDF.FILE_TYPE,
                    DataBuffer      IN OUT VARCHAR2,                    
                    BytesRequired   IN     PLS_INTEGER,
                    IgnoreNulls     IN     BOOLEAN DEFAULT FALSE,
                    BytesRead       IN OUT PLS_INTEGER,
                    RaiseExceptions IN     BOOLEAN DEFAULT FALSE) return BOOLEAN is
 iRC        PLS_INTEGER;
 bRC        BOOLEAN := TRUE;
 NullMask   VARCHAR2(16384);
 iOffset    PLS_INTEGER := 0;
 iEOF       PLS_INTEGER := 0;
 iPtr       PLS_INTEGER;
 vcEsc      VARCHAR2(2);
begin                    
  Win_API_Debug_PDF.DebugLog(99,'Read_Data','Args:  FileHandle='||to_char(FileHandle)||', Bytes='||to_char(BytesRequired)||', RaiseExceptions='||Win_API_Debug_PDF.booltochar(RaiseExceptions));	  	
  Win_API_PDF.Clean_Error_Stack;
  if Win_API_PDF.API_ENABLED then
  	CheckFileHandle('Read_Data',FileHandle); 
    Win_API_PDF.Register_function_call(iFileRead,'d2kwutil_FileRead','INT','LONG,*CHAR,INT,*CHAR,INT,*INT'); 
    --Check Size and Prepare the buffer
    if BytesRequired > 16165 then
    	Win_API_PDF.Add_error('Read_Data','The maximum number of bytes that can be read is 16165'); 
    	raise VALUE_ERROR;
    end if;
    	
    DataBuffer := rpad(' ',BytesRequired,' ');
    NullMask   := rpad('0',BytesRequired,'0'); 
        
    iRC := d2kwutil_FileRead(Win_API_PDF.FunctionHandle(iFileRead),FileHandle,DataBuffer,BytesRequired,NullMask,46,iEOF);
    NullMask := substr(NullMask,1,BytesRequired);
    Win_API_Debug_PDF.DebugLog(99,'Read_Data','Result:  RC='||to_char(iRC)||' EOF='||to_char(iEOF));
  else 
    raise Win_API_PDF.NOT_AVAILABLE;
  end if;
  if iRC = -1 then
    Win_API_PDF.Add_error('Read_Data','Cannot Read File');
    if RaiseExceptions then 
      raise NO_DATA_FOUND;
    end if;
  else
   	DataBuffer := substr(DataBuffer,1,iRC);
   	NullMask   := substr(NullMask,1,iRC);
    -- Process the NullMask and convert any NULLs marked to '\0', also convert '\' to '\\' 
    if not IgnoreNulls then
    	iPtr := instr(NullMask,'1');
    	while iPtr > 0 LOOP
    		if substr(DataBuffer,(iPtr+iOffset),1) = '.' then 
    			vcEsc := '\0';
    		else 
    			vcEsc := '\\';
    		end if;
			DataBuffer := substr(DataBuffer,1,(iPtr+iOffset-1))||vcEsc||substr(DataBuffer,(iPtr+iOffset+1));
    		iOffset := iOffset + 1;
    		iPtr := instr(NullMask,'1',iPtr+1);
    	end LOOP;
    end if;	
  end if;
  BytesRead := iRC;
  if iEOF = 1 then
  	bRC := FALSE;
  end if;
  return bRC;
exception
  when NO_DATA_FOUND then 
    if RaiseExceptions then 
    	raise;
    end if;
  when VALUE_ERROR then 
    Win_API_PDF.Add_error('Read_Data','VALUE_ERROR');
    if RaiseExceptions then
    	raise;
    end if;
  when Win_API_PDF.NOT_AVAILABLE then
    Win_API_PDF.Add_error('Read_Data',Win_API_PDF.NoAPI);
    raise;
  when others then 
    Win_API_PDF.Add_error('Read_Data', Win_API_PDF.UError||Win_API_PDF.Add_External_errors); 
    raise;
end;                    

PROCEDURE Write_Data( FileHandle      IN     Win_API_PDF.FILE_TYPE,
                      DataBuffer      IN     VARCHAR2,
                      RaiseExceptions IN BOOLEAN DEFAULT FALSE) is
 iRC       PLS_INTEGER;
 iBytes	   PLS_INTEGER;
 NullMask  VARCHAR2(32767) := rpad('0',length(DataBuffer),'0');
 vcBuff    VARCHAR2(32767) := DataBuffer;
 iPtr      PLS_INTEGER := 0;
 vcPair    VARCHAR2(2);
 vcRep     VARCHAR2(1);
begin
                    
  Win_API_Debug_PDF.DebugLog(99,'Write_Data','Args:  FileHandle='||to_char(FileHandle)||', RaiseExceptions='||Win_API_Debug_PDF.booltochar(RaiseExceptions));	  	
  Win_API_PDF.Clean_Error_Stack;
  if Win_API_PDF.API_ENABLED then
  	CheckFileHandle('Write_Data',FileHandle); 
    Win_API_PDF.Register_function_call(iFileWrite,'d2kwutil_FileWrite','INT','LONG,*CHAR,INT,*CHAR,'); 
    -- Check & Prepare the buffer 
    if vcBuff is NULL then 
    	Win_API_PDF.Add_error('Write_Data','Write Buffer contains no data');
    	raise VALUE_ERROR;
    end if;
    iPtr := instr(vcBuff,'\');
    while iPtr > 0 LOOP
    	vcPair := substr(vcBuff,iPtr,2);
    	if vcPair = '\0' then 
			vcRep := '.';
			NullMask := substr(NullMask,1,iPtr-1)||'1'||substr(NullMask,iPtr+2);
    	elsif vcPair = '\\' then 
    		vcRep := '\';
    	elsif vcPair = '\n' or vcPair = '\N' then 
    		vcRep := chr(10);
    	elsif vcPair = '\t' or vcPair = '\T' then 
    		vcRep := chr(09);
    	else
    	    Win_API_PDF.Add_error('Write_Data','Unknown escape pair "'||vcPair||'"');
    	    Raise VALUE_ERROR;
    	end if;
    	vcBuff := substr(vcBuff,1,(iPtr-1))||vcRep||substr(vcBuff,(iPtr+2));
    	iPtr := instr(vcBuff,'\',iPtr+1);
    end LOOP;
    iBytes := length(vcBuff);
    if iBytes > 16165 then 
    	Win_API_PDF.Add_error('Write_Data','Only 16165 bytes or less can be written in a single operation');
    end if;
    NullMask := substr(NullMask,1,iBytes);
    iRC := d2kwutil_FileWrite(Win_API_PDF.FunctionHandle(iFileWrite),FileHandle,vcBuff,iBytes,NullMask);
    Win_API_Debug_PDF.DebugLog(99,'Write_Data','Result:  RC='||to_char(iRC));   
  else 
    raise Win_API_PDF.NOT_AVAILABLE;
  end if;
  if iRC <> iBytes then
    Win_API_PDF.Add_error('Write_Data','Only '||to_char(iRC)||' bytes out of '||to_char(iBytes)||' were written');
    if RaiseExceptions then 
      raise NO_DATA_FOUND;
    end if;
  end if;
exception
  when NO_DATA_FOUND then 
    if RaiseExceptions then 
    	raise;
    end if;
  when VALUE_ERROR then 
    if RaiseExceptions then 
    	raise;
    end if;
  when Win_API_PDF.NOT_AVAILABLE then
    Win_API_PDF.Add_error('Write_Data',Win_API_PDF.NoAPI);
    raise;
  when others then 
    Win_API_PDF.Add_error('Write_Data', Win_API_PDF.UError||Win_API_PDF.Add_External_errors); 
    raise;
end; 


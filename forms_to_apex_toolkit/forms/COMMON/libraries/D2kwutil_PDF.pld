

FUNCTION D2KWUTIL_PDF RETURN varchar2 IS
-- Returns the Version number of this Library & the DLL
BEGIN
  Return 'D2KWUTIL_PDF.PLL Version '||Win_API_PDF.WIN_API_VERSION||chr(10)||win_api_PDF.DLLVersion;
END;


PACKAGE WIN_API_BITOP_PDF IS

/*-------------------------------------------------------------------------*\
 * WIN_API_BITOP ->   This package provides 'C' Bit operations for
 *        PL/SQL.  Most of the functions work with Positive 31 Bit 
 *        integers, except where explicitly mentioned.
 *        Passing an integer larger than 32 bits will 
 *        cause a value error to be raised
  * Contents:
 *   Simple Bit Mask Operations
 *      Bitwise_OR
 *      Bitwise_XOR
 *      Bitwise_AND
 *      Bitwise_SHIFT_RIGHT
 *      Bitwise_SHIFT_LEFT
 *   Implimentations of standard Macros
 *      HiWord
 *      LoWord
 *      HiByte
 *      LoByte
 *      MakeWord
 *      MakeLong
 *   Some Handy Datatype Conversion functions
 *      To_BitString
 *      To_HexString
 *      BitString_To_Number
 *      HexString_To_Number
 *
 * Dependancies:
 *    WIN_API
 *    WIN_API_DEBUG
\*-------------------------------------------------------------------------*/ 

/*-------------------------------------------------------------------------*\
 * Bitwise_OR  ->  Performs a C OR operation
 * Arguments: 
 *      ->   Two 32 bit Integers to OR
 * Returns:
 *  integer result
\*-------------------------------------------------------------------------*/
 FUNCTION Bitwise_OR (  X  IN  NUMBER,
                        Y  IN  NUMBER) RETURN NUMBER;
/*-------------------------------------------------------------------------*\
 * Bitwise_XOR  ->  Performs a C XOR operation
 * Arguments: 
 *      ->   Two 32 bit integers to XOR
 * Returns:
 *  32 bit integer result
\*-------------------------------------------------------------------------*/
 FUNCTION Bitwise_XOR (  X  IN  NUMBER,
                         Y  IN  NUMBER) RETURN NUMBER;

/*-------------------------------------------------------------------------*\
 * Bitwise_AND  ->  Performs a C AND operation
 * Arguments: 
 *      ->   Two 32 bit integers to AND
 * Returns:
 *  32 bit integer result
\*-------------------------------------------------------------------------*/
 FUNCTION Bitwise_AND (  X  IN  NUMBER,
                         Y  IN  NUMBER) RETURN NUMBER;

/*-------------------------------------------------------------------------*\
 * Bitwise_SHIFT_RIGHT  ->  Performs a Bitwise Right shift of an Integer
 * Arguments: 
 *    X  ->   32 bit Integer to Shift  
 *    Steps  ->  Number of Bits to Shift  
 * Returns:
 *  32 bit integer result
\*-------------------------------------------------------------------------*/
 FUNCTION Bitwise_SHIFT_RIGHT (  X      IN  NUMBER,
                                 Steps  IN  NUMBER) RETURN NUMBER;


/*-------------------------------------------------------------------------*\
 * BITWISE_SHIFT_LEFT  ->  Performs a Bitwise Left shift of an Integer
 * Arguments: 
 *    X  ->   32 bit Integer to Shift  
 *    Steps  ->  Number of Bits to Shift  
 * Returns:
 *  32 bit integer result
\*-------------------------------------------------------------------------*/
 FUNCTION Bitwise_SHIFT_LEFT (  X      IN  NUMBER,
                                Steps  IN  NUMBER) RETURN NUMBER;


/*-------------------------------------------------------------------------*\
 * HiWord    ->  Extracts the high 16 bits from a 32 bit integer
 * Arguments: 
 *    X  ->   32 bit Integer  
 * Returns:
 *  16 bit integer result
\*-------------------------------------------------------------------------*/
 FUNCTION HiWord       (  X  IN  NUMBER) RETURN NUMBER;


/*-------------------------------------------------------------------------*\
 * LoWord    ->  Extracts the Low 16 bits from a 32 bit integer
 * Arguments: 
 *    X  ->   32 bit Integer  
 * Returns:
 *  16 bit integer result
\*-------------------------------------------------------------------------*/
 FUNCTION LoWord       (  X  IN  NUMBER) RETURN NUMBER;


/*-------------------------------------------------------------------------*\
 * HiByte    ->  Extracts the high 8 bits from a 16 bit integer
 * Arguments: 
 *    X  ->   16 bit Integer  
 * Returns:
 *  8 bit integer result
\*-------------------------------------------------------------------------*/
 FUNCTION HiByte      (  X  IN  NUMBER) RETURN NUMBER;

/*-------------------------------------------------------------------------*\
 * LoByte    ->  Extracts the Low 8 bits from a 16 bit integer
 * Arguments: 
 *    X  ->   16 bit Integer  
 * Returns:
 *  8 bit integer result
\*-------------------------------------------------------------------------*/
 FUNCTION LoByte       (  X  IN  NUMBER) RETURN NUMBER;


/*-------------------------------------------------------------------------*\
 * MakeLong    ->  Combines two 16 bit integers into a Long (32 bit)
 * Arguments: 
 *    X  ->   16 bit Integer to be the Low Word 
 *    Y  ->   16 bit Integer to be the High Word  
 * Returns:
 *  32 bit integer result
\*-------------------------------------------------------------------------*/
 FUNCTION MakeLong       (  X  IN  NUMBER,
                            Y  IN  NUMBER) RETURN NUMBER;


/*-------------------------------------------------------------------------*\
 * MakeWord    ->  Combines two bytes (8 bit integers) into a Word (16 bits)
 * Arguments: 
 *    X  ->   8 bit Integer to be the Low Byte 
 *    Y  ->   8 bit Integer to be the High Byte  
 * Returns:
 *  16 bit integer result
\*-------------------------------------------------------------------------*/
 FUNCTION MakeWord       (  X  IN  NUMBER,
                            Y  IN  NUMBER) RETURN NUMBER;


/*-------------------------------------------------------------------------*\
 * To_BitString    ->  Translates a 32 bit integer to a string of 1's & 0's
 *                     You can specify how many bits you are interested in
 *                    eg, just view the Low 8 bits of a number.
 * Arguments: 
 *    X      ->   32 bit Integer to convert 
 *    Bits  ->   A number of <=32 of bits to convert.  This  
 *              defines the length of the output string.
 *              defaults to the full 32 bits 
 * Returns:
 *    String up to 32 chars long
\*-------------------------------------------------------------------------*/
 FUNCTION To_BitString   (  X     IN  NUMBER,
                            Bits  IN  PLS_INTEGER DEFAULT 32) RETURN VARCHAR2;


/*-------------------------------------------------------------------------*\
 * To_HexString    ->  Translates a 32 bit integer to a Hex String
 * Arguments: 
 *    X      ->   32 bit Integer to convert 
 * Returns:
 *    String up to 8 chars long
\*-------------------------------------------------------------------------*/
 FUNCTION To_HexString   (  X      IN  NUMBER ) RETURN VARCHAR2;


/*-------------------------------------------------------------------------*\
 * BitString_To_Number  ->  Translates a string of 1's and 0's to a number
 * Arguments: 
 *    Src      ->   A String of up to 32 chars to convert 
 * Returns:
 *    32 bit integer
\*-------------------------------------------------------------------------*/
 FUNCTION BitString_To_Number   (Src      IN  VARCHAR2 ) RETURN NUMBER;


/*-------------------------------------------------------------------------*\
 * HexString_To_Number  ->  Translates a Hexidecimal string to a number
 * Arguments: 
 *    Src      ->   A String of up to 8 chars to convert 
 * Returns:
 *    32 bit integer
\*-------------------------------------------------------------------------*/
 FUNCTION HexString_To_Number   (Src      IN  VARCHAR2 ) RETURN NUMBER;

END WIN_API_BITOP_PDF;


PACKAGE BODY WIN_API_BITOP_PDF is

-- Constants for Bounds Checking
-- Note that PLS_INTEGER can't actually take a Full 32 bits only 31
-- So in the case where the 32nd bit needs to be set we use an 
-- Indicator variable to pass the value accross.
MAX_DWORD        CONSTANT  NUMBER  := 4294967295;
MAX_PLS_INT      CONSTANT  NUMBER  := 2147483647;
SIGN_BIT_VALUE   CONSTANT  NUMBER  := 2147483648;
MAX_WORD         CONSTANT  NUMBER  := 65535;
MAX_BYTE         CONSTANT  NUMBER  := 255;

-- Constants for maintaining the Function Handle Array
-- These should be unique through the Whole Library
-- BitOpt has indexes in the range 100 - 199
iBitWise        CONSTANT  PLS_INTEGER  := 100;
iExtractWord    CONSTANT  PLS_INTEGER  := 101;
iExtractByte    CONSTANT  PLS_INTEGER  := 102;
iMakeLong       CONSTANT  PLS_INTEGER  := 103;
iMakeWord       CONSTANT  PLS_INTEGER  := 104;
iToBitString    CONSTANT  PLS_INTEGER  := 105;
iToHexString    CONSTANT  PLS_INTEGER  := 106;
iFromBitString  CONSTANT  PLS_INTEGER  := 107;
iFromHexString  CONSTANT  PLS_INTEGER  := 108;

-- Exceptions
NULL_ARGUMENT      EXCEPTION;
VALUE_TOO_LARGE    EXCEPTION;
VALUE_TOO_SMALL    EXCEPTION;
INVALID_FORMAT     EXCEPTION;

LastError          VARCHAR2(30);

-- Private Program unit headers that impliment the interfaces
FUNCTION d2kwutil_Bitwise     (   hFunc      IN      ORA_FFI.funcHandleType,
                                  X          IN      PLS_INTEGER,
                                  XSignBit   IN      PLS_INTEGER,
                                  Y          IN      PLS_INTEGER, 
                                  YSignBit   IN      PLS_INTEGER,
                                  Opt        IN      PLS_INTEGER,
                                  OverFlow   IN OUT  PLS_INTEGER) return PLS_INTEGER;
                                  
FUNCTION d2kwutil_ExtractWord (   hFunc      IN      ORA_FFI.funcHandleType,
                                  X          IN      PLS_INTEGER,
                                  Overflow   IN      PLS_INTEGER,
                                  Opt        IN      PLS_INTEGER) return PLS_INTEGER; 

FUNCTION d2kwutil_ExtractByte (   hFunc      IN      ORA_FFI.funcHandleType,
                                  X          IN      PLS_INTEGER,
                                  Opt        IN      PLS_INTEGER) return PLS_INTEGER; 

FUNCTION d2kwutil_MakeLong   (    hFunc      IN      ORA_FFI.funcHandleType,
                                  X          IN      PLS_INTEGER,
                                  Y          IN      PLS_INTEGER,
                                  Overflow   IN OUT  PLS_INTEGER) return PLS_INTEGER; 
                                  
FUNCTION d2kwutil_MakeWord   (    hFunc      IN      ORA_FFI.funcHandleType,
                                  X          IN      PLS_INTEGER,
                                  Y          IN      PLS_INTEGER) return PLS_INTEGER; 

PROCEDURE d2kwutil_ToBitString(   hFunc      IN      ORA_FFI.funcHandleType,
                                  X          IN      PLS_INTEGER,
                                  Overflow   IN      PLS_INTEGER,
                                  Bits       IN      PLS_INTEGER,
                                  Result     IN OUT  VARCHAR2); 
                              
PROCEDURE d2kwutil_ToHexString(   hFunc      IN      ORA_FFI.funcHandleType,
                                  X          IN      PLS_INTEGER,
                                  Overflow   IN      PLS_INTEGER,
                                  Result     IN OUT  VARCHAR2); 

FUNCTION d2kwutil_FromBitString(  hFunc      IN      ORA_FFI.funcHandleType,
                                  SRC        IN OUT  VARCHAR2,
                                  Overflow   IN OUT  PLS_INTEGER) return PLS_INTEGER; 

FUNCTION d2kwutil_FromHexString(  hFunc      IN      ORA_FFI.funcHandleType,
                                  SRC        IN OUT  VARCHAR2,
                                  Overflow   IN OUT  PLS_INTEGER) return PLS_INTEGER; 


-- Private Program unit headers that impliment wrapper methods
FUNCTION Bitwise_Wrapper (        CallBy    IN     VARCHAR2,
                                  X         IN     NUMBER,
                                  Y         IN     NUMBER,
                                  Opt       IN     PLS_INTEGER) return NUMBER;
 
FUNCTION ExtractWord_Wrapper (    CallBy    IN     VARCHAR2,
                                  X         IN     NUMBER,
                                  Opt       IN     PLS_INTEGER) return NUMBER;

FUNCTION ExtractByte_Wrapper (    CallBy    IN     VARCHAR2,
                                  X         IN     NUMBER,
                                  Opt       IN     PLS_INTEGER) return NUMBER;
                                  
-- Utility Methods
FUNCTION Num2PLS (                 X        IN     NUMBER, 
                                  SignBit   IN     BOOLEAN DEFAULT FALSE    ) return PLS_INTEGER;                              
FUNCTION PLS2Num (                 X        IN     PLS_INTEGER, 
                                  Overflow  IN     PLS_INTEGER ) return NUMBER;  
                                  
Procedure BoundsCheck (           X          IN NUMBER,
                                  LowerBound IN NUMBER,
                                  UpperBound IN NUMBER,
                                  ArgName    IN VARCHAR2);

-- Pragmas
PRAGMA INTERFACE(C,d2kwutil_Bitwise,11265);
PRAGMA INTERFACE(C,d2kwutil_ExtractWord,11265);
PRAGMA INTERFACE(C,d2kwutil_ExtractByte,11265);
PRAGMA INTERFACE(C,d2kwutil_MakeLong,11265);
PRAGMA INTERFACE(C,d2kwutil_MakeWord,11265);
PRAGMA INTERFACE(C,d2kwutil_ToBitString,11265);
PRAGMA INTERFACE(C,d2kwutil_ToHexString,11265);
PRAGMA INTERFACE(C,d2kwutil_FromBitString,11265);
PRAGMA INTERFACE(C,d2kwutil_FromHexString,11265);

-- Utility Method Bodies
FUNCTION Num2PLS ( X       IN NUMBER, 
                   SignBit IN BOOLEAN DEFAULT FALSE ) return PLS_INTEGER is                              
  iRC PLS_INTEGER;
Begin 
  if X > MAX_PLS_INT then 
    if Not SignBit then
      iRC := (X - SIGN_BIT_VALUE);
    else 
      iRC := 1;
    end if;
  else 
    if Not SignBit then 
      iRC := X;
    else
      iRC := 0;
    end if;
  end if;
  return iRC;
end;


FUNCTION PLS2Num ( X         IN PLS_INTEGER, 
                   Overflow  IN PLS_INTEGER ) return NUMBER is

  iRC NUMBER;
Begin 
  if Overflow = 1 then 
    iRC := X + SIGN_BIT_VALUE;
  else 
    iRC := X;
  end if;
  return iRC;
end;

Procedure BoundsCheck ( X            IN NUMBER,
                        LowerBound   IN NUMBER,
                        UpperBound   IN NUMBER,
                        ArgName      IN VARCHAR2) is                            
begin                                   
  if X < LowerBound then 
      LastError := '['||ArgName||' = '||to_char(x)||']';
      RAISE VALUE_TOO_SMALL;
  elsif X > UpperBound then     
      LastError := '['||ArgName||' = '||to_char(x)||']';
      RAISE VALUE_TOO_LARGE;
  elsif X is NULL then 
      LastError := '['||ArgName||' is NULL]';
      RAISE NULL_ARGUMENT;
  else
      LastError := NULL;
  end if;
end;


-- Public Bodies 

FUNCTION BITWISE_OR (  X  IN  NUMBER,
                       Y  IN  NUMBER) RETURN NUMBER is
begin
  return bitwise_wrapper('Bitwise_OR',X,Y,0); 
end;

FUNCTION BITWISE_XOR (  X  IN  NUMBER,
                         Y  IN  NUMBER) RETURN NUMBER is
begin
  return bitwise_wrapper('Bitwise_XOR',X,Y,1); 
end;

FUNCTION BITWISE_AND (  X  IN  NUMBER,
                         Y  IN  NUMBER) RETURN NUMBER is
begin
  return bitwise_wrapper('Bitwise_And',X,Y,2); 
end;

FUNCTION BITWISE_SHIFT_RIGHT (  X      IN  NUMBER,
                                 Steps  IN  NUMBER) RETURN NUMBER is
begin
  return bitwise_wrapper('Bitwise_Shift_Right',X,Steps,3); 
end;
                                 
FUNCTION BITWISE_SHIFT_LEFT   (  X      IN  NUMBER,
                                 Steps  IN  NUMBER) RETURN NUMBER is
begin
  return bitwise_wrapper('Bitwise_Shift_Left',X,Steps,4); 
end;

FUNCTION HIWORD   (  X      IN  NUMBER) RETURN NUMBER is
begin
  return ExtractWord_wrapper('HiWord',X,0); 
end;

FUNCTION LOWORD   (  X      IN  NUMBER) RETURN NUMBER is
begin
  return ExtractWord_wrapper('LoWord',X,1); 
end;
    
FUNCTION HIBYTE   (  X      IN  NUMBER) RETURN NUMBER is
begin
  return ExtractByte_wrapper('HiByte',X,0); 
end;

FUNCTION LOBYTE   (  X      IN  NUMBER) RETURN NUMBER is
begin
  return ExtractByte_wrapper('LoByte',X,1); 
end;

FUNCTION MakeLong (  X  IN  NUMBER,
                     Y  IN  NUMBER) RETURN NUMBER is
  iRC        PLS_INTEGER;
  iOverFlow  PLS_INTEGER := 0;
  iResult    NUMBER;
begin
  Win_API_Debug_PDF.DebugLog(99,'MakeLong','Args: X="'||to_char(X)||'", Y="'||to_char(Y)||'"');
  Win_API_PDF.Clean_Error_Stack;
  BoundsCheck(X,0,MAX_WORD,'LoWord');
  BoundsCheck(Y,0,MAX_WORD,'HiWord');  
      
  if Win_API_PDF.API_ENABLED then 
    Win_API_PDF.Register_function_call(iMakeLong,'d2kwutil_MakeLong','LONG','SHORT,SHORT,*INT');
    iRC := d2kwutil_MakeLong(Win_API_PDF.FunctionHandle(iMakeLong),X,Y,iOverflow);
    iResult := PLS2Num(iRC,iOverflow);
    Win_API_Debug_PDF.DebugLog(99,'MakeLong','Result: RC="'||to_char(iRC)||'", OverFlow="'||to_char(iOverflow)||'", Result="'||to_char(iResult)||'"');
    return(iResult);
  end if;  
exception
  when VALUE_TOO_LARGE then 
    Win_API_PDF.Add_error('MakeLong',Win_API_PDF.MaxWord||LastError);
    RAISE VALUE_ERROR;
  when VALUE_TOO_SMALL then 
    Win_API_PDF.Add_error('MakeLong',Win_API_PDF.MinBound||LastError);
    RAISE VALUE_ERROR;
  when NULL_ARGUMENT then 
    Win_API_PDF.Add_error('MakeLong',Win_API_PDF.NullArg||LastError);
    RAISE VALUE_ERROR;    
  when Win_API_PDF.NOT_AVAILABLE then
    Win_API_PDF.Add_error('MakeLong',Win_API_PDF.NoAPI);
    raise;
  when others then
    Win_API_PDF.Add_error('MakeLong', Win_API_PDF.UError||Win_API_PDF.Add_External_errors); 
    raise;
end MakeLong;

FUNCTION MakeWord (  X  IN  NUMBER,
                     Y  IN  NUMBER) RETURN NUMBER is
  iRC NUMBER;                     
begin    
  Win_API_Debug_PDF.DebugLog(99,'MakeWord','Args: X="'||to_char(X)||'", Y="'||to_char(Y)||'"');	
  Win_API_PDF.Clean_Error_Stack;
  BoundsCheck(X,0,MAX_BYTE,'LoByte');
  BoundsCheck(Y,0,MAX_BYTE,'HiByte');
  
  if Win_API_PDF.API_ENABLED then 
    Win_API_PDF.Register_function_call(iMakeWord,'d2kwutil_MakeWord','LONG','BYTE,BYTE');
    iRC := d2kwutil_MakeWord(Win_API_PDF.FunctionHandle(iMakeWord),Num2PLS(X),Num2PLS(Y));
    Win_API_Debug_PDF.DebugLog(99,'MakeWord','Result: RC="'||to_char(iRC)||'"');
    Return iRC;
  end if;  
exception
  when VALUE_TOO_LARGE then 
    Win_API_PDF.Add_error('MakeWord',Win_API_PDF.MaxByte||LastError);
    RAISE VALUE_ERROR;
  when VALUE_TOO_SMALL then 
    Win_API_PDF.Add_error('MakeWord',Win_API_PDF.MinBound||LastError);
    RAISE VALUE_ERROR;
  when NULL_ARGUMENT then 
    Win_API_PDF.Add_error('MakeWord',Win_API_PDF.NullArg||LastError);
    RAISE VALUE_ERROR;    
  when Win_API_PDF.NOT_AVAILABLE then
    Win_API_PDF.Add_error('MakeWord',Win_API_PDF.NoAPI);
    raise;
  when others then
    Win_API_PDF.Add_error('MakeWord', Win_API_PDF.UError||Win_API_PDF.Add_External_errors); 
    raise;
end MakeWord;

FUNCTION To_BitString   (  X      IN  NUMBER,
                           Bits  IN  PLS_INTEGER DEFAULT 32) RETURN VARCHAR2 is
  vcBuffer  VARCHAR2(33) := rpad(' ',33);
begin 
  Win_API_Debug_PDF.DebugLog(99,'To_BitString','Args: X="'||to_char(X)||'", Bits="'||to_char(Bits)||'"');	
  Win_API_PDF.Clean_Error_Stack;
  BoundsCheck(X,0,MAX_DWORD,'Arg1');
  BoundsCheck(Bits,1,32,'Bits');
      
  if Win_API_PDF.API_ENABLED then 
    Win_API_PDF.Register_function_call(iToBitString,'d2kwutil_ToBitString','VOID','LONG,INT,INT,*CHAR');
    d2kwutil_ToBitString(Win_API_PDF.FunctionHandle(iToBitString),Num2PLS(X),Num2PLS(X,TRUE),Bits,vcBuffer);
    Win_API_Debug_PDF.DebugLog(99,'To_Bitstring','Result: RC="'||vcBuffer||'"');    
    return SUBSTR(vcBuffer,(33-Bits));
  end if;  
exception
  when VALUE_TOO_LARGE then 
    if instr(LastError,'Bits') > 0 then
      Win_API_PDF.Add_error('To_BitString',Win_API_PDF.MaxBound||LastError);    
    else
      Win_API_PDF.Add_error('To_BitString',Win_API_PDF.MaxDWord||LastError);
    end if;
    RAISE VALUE_ERROR;
  when VALUE_TOO_SMALL then 
    Win_API_PDF.Add_error('To_BitString',Win_API_PDF.MinBound||LastError);
    RAISE VALUE_ERROR;
  when NULL_ARGUMENT then 
    Win_API_PDF.Add_error('To_BitString',Win_API_PDF.NullArg||LastError);
    RAISE VALUE_ERROR;    
  when Win_API_PDF.NOT_AVAILABLE then
    Win_API_PDF.Add_error('To_BitString',Win_API_PDF.NoAPI);
    raise;
  when others then
    Win_API_PDF.Add_error('To_BitString', Win_API_PDF.UError||Win_API_PDF.Add_External_errors); 
    raise;
end To_Bitstring;


FUNCTION To_HexString   (  X      IN  NUMBER ) RETURN VARCHAR2 is
  vcBuffer  VARCHAR2(9) := rpad(' ',9);
begin
  Win_API_Debug_PDF.DebugLog(99,'To_HexString','Args: X="'||to_char(X)||'"');	
  Win_API_PDF.Clean_Error_Stack;
  BoundsCheck(X,0,MAX_DWORD,'Arg1');
  
  if Win_API_PDF.API_ENABLED then 
    Win_API_PDF.Register_function_call(iToHexString,'d2kwutil_ToHexString','VOID','LONG,INT,*CHAR');
    d2kwutil_ToHexString(Win_API_PDF.FunctionHandle(iToHexString),Num2PLS(X),Num2PLS(X,TRUE),vcBuffer);
    Win_API_Debug_PDF.DebugLog(99,'To_HexString','Result: RC="'||vcBuffer||'"');    
    return vcBuffer;
  end if;  
exception
  when VALUE_TOO_LARGE then 
    Win_API_PDF.Add_error('To_HexString',Win_API_PDF.MaxDWord||LastError);
    RAISE VALUE_ERROR;
  when VALUE_TOO_SMALL then 
    Win_API_PDF.Add_error('To_HexString',Win_API_PDF.MinBound||LastError);
    RAISE VALUE_ERROR;
  when NULL_ARGUMENT then 
    Win_API_PDF.Add_error('To_HexString',Win_API_PDF.NullArg||LastError);
    RAISE VALUE_ERROR;    
  when Win_API_PDF.NOT_AVAILABLE then
    Win_API_PDF.Add_error('To_HexString',Win_API_PDF.NoAPI);
    raise;
  when others then
    Win_API_PDF.Add_error('To_HexString', Win_API_PDF.UError||Win_API_PDF.Add_External_errors); 
    raise;
end To_HexString;


FUNCTION BitString_To_Number   (Src      IN  VARCHAR2 ) RETURN NUMBER is
  vcBuffer  VARCHAR2(33) := rpad(Src,33,chr(0));
  iRC        PLS_INTEGER;
  iOverFlow  PLS_INTEGER := 0;
  iResult    NUMBER;
begin
  Win_API_Debug_PDF.DebugLog(99,'BitString_to_Number','Args: Src="'||Src||'"');	
  Win_API_PDF.Clean_Error_Stack;
  BoundsCheck(length(Src),1,32,'Source String');
  
  if replace(replace(Src,'0'),'1') is not NULL then 
      RAISE INVALID_FORMAT;
  end if;
    
  if Win_API_PDF.API_ENABLED then 
    Win_API_PDF.Register_function_call(iFromBitString,'d2kwutil_FromBitString','LONG','*CHAR,*INT');
    iRC := d2kwutil_FromBitString(Win_API_PDF.FunctionHandle(iFromBitString),vcBuffer,iOverFlow);
    iResult := PLS2Num(iRC,iOverflow);
    Win_API_Debug_PDF.DebugLog(99,'BitString_To_Number','Result: RC="'||to_char(iResult)||'"');    
    Return iResult;
  end if;  
exception
  when VALUE_TOO_LARGE then 
    Win_API_PDF.Add_error('BitString_To_Number','Bit String to convert must be 32 characters in length or less (min = 1)');
    RAISE VALUE_ERROR;
  when VALUE_TOO_SMALL then 
    Win_API_PDF.Add_error('BitString_To_Number','Bit String to convert must be 1 character in length or more (max = 32)');  
    RAISE VALUE_ERROR;
  when NULL_ARGUMENT then 
    Win_API_PDF.Add_error('BitString_To_Number',Win_API_PDF.NullArg||LastError);
    RAISE VALUE_ERROR;    
  when INVALID_FORMAT then 
    Win_API_PDF.Add_error('BitString_To_Number','Bit String can only contain "1" and "0" characters');
    RAISE VALUE_ERROR;
  when Win_API_PDF.NOT_AVAILABLE then
    Win_API_PDF.Add_error('BitString_To_Number',Win_API_PDF.NoAPI);
    raise;
  when others then
    Win_API_PDF.Add_error('BitString_To_Number', Win_API_PDF.UError||Win_API_PDF.Add_External_errors); 
    raise;
end BitString_To_Number;

FUNCTION HexString_To_Number   (Src      IN  VARCHAR2 ) RETURN NUMBER is
  vcBuffer   VARCHAR2(9) := rpad(upper(Src),9,chr(0));
  iRC        PLS_INTEGER;
  iOverFlow  PLS_INTEGER := 0;
  iResult    NUMBER;
begin
  Win_API_Debug_PDF.DebugLog(99,'HexString_to_Number','Args: Src="'||Src||'"');	
  Win_API_PDF.Clean_Error_Stack;
  BoundsCheck(length(Src),1,8,'Source String');  
  if replace(translate(Src,'1234567890ABCDEFabcdef','1111111111111111111111'),'1') is not NULL then 
      RAISE INVALID_FORMAT;
  end if;
    
  if Win_API_PDF.API_ENABLED then 
    Win_API_PDF.Register_function_call(iFromHexString,'d2kwutil_FromHexString','LONG','*CHAR,*INT');
    iRC := d2kwutil_FromHexString(Win_API_PDF.FunctionHandle(iFromHexString),vcBuffer,iOverflow);
    iResult := PLS2Num(iRC,iOverflow);
    Win_API_Debug_PDF.DebugLog(99,'HexString_To_Number','Result: RC="'||to_char(iResult)||'"');    
    Return iResult;
  end if;  
exception
  when VALUE_TOO_LARGE then 
    Win_API_PDF.Add_error('HexString_To_Number','String to convert must be between 1 and 8 characters in length');
    RAISE VALUE_ERROR;
  when VALUE_TOO_SMALL then 
    Win_API_PDF.Add_error('HexString_To_Number','String to convert must be between 1 and 8 characters in length');
    RAISE VALUE_ERROR;
  when NULL_ARGUMENT then 
    Win_API_PDF.Add_error('HexString_To_Number',Win_API_PDF.NullArg||LastError);
    RAISE VALUE_ERROR;        
  when INVALID_FORMAT then 
    Win_API_PDF.Add_error('HexString_To_Number','Hex String can only contain the following characters "1234567890ABCDEF"');
    RAISE VALUE_ERROR;
  when Win_API_PDF.NOT_AVAILABLE then
    Win_API_PDF.Add_error('HexString_To_Number',Win_API_PDF.NoAPI);
    raise;
  when others then
    Win_API_PDF.Add_error('HexString_To_Number', Win_API_PDF.UError||Win_API_PDF.Add_External_errors); 
    raise;
end HexString_To_Number;


--Bodies for Internal wrapper Program Units

FUNCTION Bitwise_Wrapper (    CallBy  IN VARCHAR2,
                              X        IN   NUMBER,
                              Y        IN   NUMBER,
                              Opt      IN  PLS_INTEGER) return NUMBER is
 iOverflow   PLS_INTEGER := 0;
 iRC         PLS_INTEGER;
 iResult     NUMBER;
begin
  Win_API_Debug_PDF.DebugLog(99,'BitWise_Wrapper','Args: Callby="'||CallBy||'", X="'||to_char(X)||'", Y="'||to_char(Y)||'", Opt="'||to_char(Opt)||'"');
  Win_API_PDF.Clean_Error_Stack;
  BoundsCheck(X,0,MAX_DWORD,'Arg1');
  if Opt > 2 then
    BoundsCheck(Y,0,32,'Bits to Shift');
  else
    BoundsCheck(Y,0,MAX_DWORD,'Arg2');
  end if;
    
  if Win_API_PDF.API_ENABLED then 
    Win_API_PDF.Register_function_call(iBitwise,'d2kwutil_Bitwise','LONG','LONG,INT,LONG,INT,INT,*INT');
    iRC := d2kwutil_Bitwise(Win_API_PDF.FunctionHandle(iBitwise),Num2PLS(X),Num2PLS(X,TRUE),Num2PLS(Y),Num2PLS(Y,TRUE),Opt,iOverflow);
    iResult := PLS2Num(iRC,iOverflow);
    Win_API_Debug_PDF.DebugLog(99,'Bitwise_Wrapper','Result: RC="'||to_char(iResult)||'"');    
    Return iResult;
  end if;  
exception
  when VALUE_TOO_LARGE then 
    if instr(LastError,'Bits') > 0 then
      Win_API_PDF.Add_error(CallBy,'You cannot shift by more than 32 places');    
    else
      Win_API_PDF.Add_error(CallBy,Win_API_PDF.MaxDWord||LastError);
    end if;
    RAISE VALUE_ERROR;
  when VALUE_TOO_SMALL then 
    Win_API_PDF.Add_error(CallBy,Win_API_PDF.MinBound||LastError);
    RAISE VALUE_ERROR;
  when NULL_ARGUMENT then 
    Win_API_PDF.Add_error(CallBy,Win_API_PDF.NullArg||LastError);
    RAISE VALUE_ERROR;    
  when Win_API_PDF.NOT_AVAILABLE then
    Win_API_PDF.Add_error(CallBy,Win_API_PDF.NoAPI);
    raise;
  when others then
    Win_API_PDF.Add_error(CallBy, Win_API_PDF.UError||Win_API_PDF.Add_External_errors); 
    raise;
end Bitwise_wrapper;


FUNCTION ExtractWord_Wrapper (    CallBy  IN VARCHAR2,
                                  X        IN   NUMBER,
                                  Opt      IN  PLS_INTEGER) return NUMBER is
  iResult NUMBER;
begin
  Win_API_Debug_PDF.DebugLog(99,'ExtractWord_Wrapper','Args: Callby="'||CallBy||'", X="'||to_char(X)||'", Opt="'||to_char(Opt)||'"');
  Win_API_PDF.Clean_Error_Stack;
  BoundsCheck(X,0,MAX_DWORD,'Arg1');
  
  if Win_API_PDF.API_ENABLED then 
    Win_API_PDF.Register_function_call(iExtractWord,'d2kwutil_ExtractWord','LONG','LONG,INT,INT');
    iResult := d2kwutil_ExtractWord(Win_API_PDF.FunctionHandle(iExtractWord),Num2PLS(X),Num2PLS(X,TRUE),Opt);
    Win_API_Debug_PDF.DebugLog(99,'ExtractWord_Wrapper','Result: RC="'||to_char(iResult)||'"');    
    Return iResult;
  end if;  
exception
  when VALUE_TOO_LARGE then 
    Win_API_PDF.Add_error(CallBy,Win_API_PDF.MaxDWord||LastError);
    RAISE VALUE_ERROR;
  when VALUE_TOO_SMALL then 
    Win_API_PDF.Add_error(CallBy,Win_API_PDF.MinBound||LastError);
    RAISE VALUE_ERROR;
  when NULL_ARGUMENT then 
    Win_API_PDF.Add_error(CallBy,Win_API_PDF.NullArg||LastError);
    RAISE VALUE_ERROR;
  when Win_API_PDF.NOT_AVAILABLE then
    Win_API_PDF.Add_error(CallBy,Win_API_PDF.NoAPI);
    raise;
  when others then
    Win_API_PDF.Add_error(CallBy, Win_API_PDF.UError||Win_API_PDF.Add_External_errors); 
    raise;
end ExtractWord_Wrapper;


FUNCTION ExtractByte_Wrapper (    CallBy  IN VARCHAR2,
                                  X        IN   NUMBER,
                                  Opt      IN  PLS_INTEGER) return NUMBER is
  iResult NUMBER;                                  
begin
  Win_API_Debug_PDF.DebugLog(99,'ExtractByte_Wrapper','Args: Callby="'||CallBy||'", X="'||to_char(X)||'", Opt="'||to_char(Opt)||'"');	
  Win_API_PDF.Clean_Error_Stack;
  BoundsCheck(X,0,MAX_WORD,'Arg1');
  
  if Win_API_PDF.API_ENABLED then 
    Win_API_PDF.Register_function_call(iExtractByte,'d2kwutil_ExtractByte','BYTE','SHORT,INT');
    iResult := d2kwutil_ExtractByte(Win_API_PDF.FunctionHandle(iExtractByte),X,Opt);
    Win_API_Debug_PDF.DebugLog(99,'ExtractByte_Wrapper','Result: RC="'||to_char(iResult)||'"');    
    Return iResult;
  end if;  
exception
  when VALUE_TOO_LARGE then 
    Win_API_PDF.Add_error(CallBy,Win_API_PDF.MaxDWord||LastError);
    RAISE VALUE_ERROR;
  when VALUE_TOO_SMALL then 
    Win_API_PDF.Add_error(CallBy,Win_API_PDF.MinBound||LastError);
    RAISE VALUE_ERROR;
  when NULL_ARGUMENT then 
    Win_API_PDF.Add_error(CallBy,Win_API_PDF.NullArg||LastError);
    RAISE VALUE_ERROR;
  when Win_API_PDF.NOT_AVAILABLE then
    Win_API_PDF.Add_error(CallBy,Win_API_PDF.NoAPI);
    raise;
  when others then
    Win_API_PDF.Add_error(CallBy, Win_API_PDF.UError||Win_API_PDF.Add_External_errors); 
    raise;
end ExtractByte_Wrapper;


END WIN_API_BITOP_PDF;


PACKAGE Win_API_Debug_PDF IS
   /*----------------------------------------------------------------------------*\
    * Debugging Functions
   \*----------------------------------------------------------------------------*/
   
   /*----------------------------------------------------------------------------*\        
    * SetDebug ->  Enables/Disables the D2kwutil Internal Debugging
    *              You can Also use this for Debugging your own apps
    * Arguments:
    *    DebugType  0 = Normal State - No Debugging
    *               1 = Log to File named in DebugFile (Name up to 256 chars long)
    *               2 = Log to a Windows Debugger
    *    DebugFile  The Name of the file that you want to write DebugInfo.
    *    DebugLevel A numberical argument that allows you to impose "levels" of
    *               Debugging within a App. Use Values < 99. Level 99 will switch 
    *               on the Debug Calls in D2kwutil.
    *               During Dubugging all messages with a level < DebugLevel will
    *               be processed. Higher Debug levels will be ignored.
    *    TimeStamp  Defines if the Logged messages should be prefixed with
    *               the current time.
    *----------------------------------------------------------------------------
    * Notes:
    *       If you specify Type 2 Debugging (Log to Windows Debugger) rather than
    *       file, and for some reason the Debug API call is not available e.g.
    *       d2kwutil is not instanciated yet, then the output will get sent to the 
    *       specified file in Debug file (or to the file d2kwutil.log if no file
    *       is specified)
    *       If the Debug API subsequently becomes available the output will switch
    *       to it.
    *       Generally, however, you would call WIN_API.PRELOAD *before* switching
    *       on Debugging unless you are trying to debug a problem with d2kwutil 
    *       instanciation.
   \*----------------------------------------------------------------------------*/

   PROCEDURE SetDebug( DebugType   IN PLS_INTEGER, 
                       DebugFile   IN VARCHAR2 DEFAULT NULL, 
                       DebugLevel  IN PLS_INTEGER DEFAULT 98,                        
                       TimeStamp   IN BOOLEAN DEFAULT FALSE);
   
   /*----------------------------------------------------------------------------*\
    * DebugLog ->  Logs the Debug Output either to a Text File (appends)
    *              Or to a Windows Debugger - Depending on the 
    *              value set by SetDebug
   \*----------------------------------------------------------------------------*/    
   PROCEDURE DebugLog (DebugLevel  IN PLS_INTEGER, 
                       LoggingCall IN VARCHAR2, 
                       LogString   IN VARCHAR2); 

   /*----------------------------------------------------------------------------*\
    * DebugPause -> If you are debugging this just switches it off
    *               use DebugResume to restart.
    *               Using Pause and Resume, it doesn't matter if you are actually
    *               Debugging or not. It'll only take effect if you are 
    *               Currently Debugging.
    *               The LogPause argument just allows you to put the fact that you
    *               are pausing into the debug log. 
    *               If this is FALSE then you'll never know that debugging was 
    *               paused.
   \*----------------------------------------------------------------------------*/    
   PROCEDURE DebugPause(LogPause in BOOLEAN := FALSE); 

   /*----------------------------------------------------------------------------*\
    * DebugResume -> Resumes Debugging
    *               The LogResume argument just allows you to put the fact that you
    *               are resuming into the debug log. 
    *               If this is FALSE then you'll never know that debugging was 
    *               resumed.
   \*----------------------------------------------------------------------------*/    
   PROCEDURE DebugResume(LogResume in BOOLEAN := FALSE); 
                       
   /*----------------------------------------------------------------------------*\
    * BoolToChar ->  A utility function for use when outputting Debug Strings
    *                Converts a Boolean Value to it's String equivilent e.g.
    *                TRUE becomes 'TRUE'
   \*----------------------------------------------------------------------------*/       
   FUNCTION  BoolToChar(ThisBoolean IN BOOLEAN) return VARCHAR2;
   
   /*-------------------------------------------------------------------------*\
    * WinDebug  ->  Sends a debug message to a windows Debugger
    *
    * Arguments: 
    *  Text        -> String to send  
    * Returns:
    *  (NONE)
   \*-------------------------------------------------------------------------*/
 
   PROCEDURE WinDebug   (  Text  IN   VARCHAR2);

   
   /*----------------------------------------------------------------------------*\
    * DEBUG_API_ENABLED - Do no alter this variable it is used internally by
    *                     d2kwutil.
   \*----------------------------------------------------------------------------*/
   DEBUG_API_ENABLED  BOOLEAN := FALSE;
END;

PACKAGE BODY Win_API_Debug_PDF IS

 -- Constants for maintaining the Function Handle Array
 -- These should be unique through the Whole Library
 -- Debug has an index of 2
 iDebugString      CONSTANT  PLS_INTEGER  := 2;  


 -- Private Variables
 iDebugState         PLS_INTEGER    := 0;
 iDebugLevel         PLS_INTEGER    := 98;
 vcDebugFile         VARCHAR2(256);
 bDebugTimeStamp     BOOLEAN        := FALSE;
 bDebugType2Required BOOLEAN        := FALSE;
 bDebugPaused        BOOLEAN        := FALSE;
   
 PROCEDURE d2kwutil_DebugString (    hFunc       IN      ORA_FFI.funcHandleType,
                                     Text        IN      VARCHAR2);
 -- Pragmas
 PRAGMA INTERFACE(C,d2kwutil_DebugString,      11265);

PROCEDURE SetDebug( DebugType   IN PLS_INTEGER, 
                    DebugFile   IN VARCHAR2 DEFAULT NULL, 
                    DebugLevel  IN PLS_INTEGER DEFAULT 98,                        
                    TimeStamp   IN BOOLEAN DEFAULT FALSE) is
begin 
    bDebugTimeStamp := TimeStamp;
    vcDebugFile     := DebugFile;
    iDebugLevel     := DebugLevel;
	if DebugType = 1 then 
		iDebugState := 1;
		DebugLog(0,'SetDebug','Logging to File '||DebugFile);
	elsif DebugType = 2 then
		iDebugState := 2;
		DebugLog(0,'SetDebug','Logging Started');
	else 
        DebugLog(0,'SetDebug','Logging Stopped');
        iDebugState := 0;
	end if;
end SetDebug;
   
PROCEDURE DebugLog (DebugLevel  IN PLS_INTEGER, 
                    LoggingCall IN VARCHAR2, 
                    LogString   IN VARCHAR2) is
 vcDateStamp   VARCHAR2(10);
 vcDebugString VARCHAR2(2000);
 hFile         TEXT_IO.FILE_TYPE;
begin
  if iDebugState = 0 then 
  	NULL;
  elsif bDebugPaused then 
  	NULL;
  elsif DebugLevel > iDebugLevel then 
  	NULL;
  else
  	-- Sort out the Datestamp	
  	if bDebugTimeStamp then 
  		vcDateStamp := to_char(SYSDATE,'HH24:MI:SS')||'> ';
  	end if;
  
  	-- Construct the final String
  	vcDebugString := '<'||lpad(to_char(DebugLevel),2,0)||'> '||vcDateStamp||rpad(LoggingCall||':',30);
    vcDebugString := vcDebugString||substr(LogString,1,(2000-length(vcDebugString)));
  
  	if iDebugState = 2 then
  		if DEBUG_API_ENABLED then 
  	   		Win_API_Debug_PDF.WinDebug(vcDebugString);
  		else
  			-- Can't use API calls if the API functions aren't there
	  		-- So Switch to File Logging to d2kwut$.log
	  		SetDebug(1,nvl(vcDebugFile,'d2kwutil.log'),iDebugLevel,bDebugTimeStamp);
	  		DebugLog(0,'DebugLog','Unable to Log to Debugger Switching to File');
			DebugLog(DebugLevel,LoggingCall,LogString);	  		
	  		bDebugType2Required := TRUE;
	  	end if;
  	else
     	if bDebugType2Required and DEBUG_API_ENABLED then
	     	-- API now Available - Reinstate Debugging to Debugger
	  		SetDebug(2,vcDebugFile,iDebugLevel,bDebugTimeStamp);
	  		DebugLog(0,'DebugLog','Restoring Logging to Debugger');
	  		bDebugType2Required := FALSE;
	  		DebugLog(Debuglevel,LoggingCall,LogString);
	
	  	else
		 	hFile := TEXT_IO.FOPEN(vcDebugFile,'A');
		 	TEXT_IO.PUT_LINE(hFile,vcDebugString);
		 	TEXT_IO.FCLOSE(hFile);
		end if;
  	end if;
  end if;
 exception
  	-- Don't let the debugging cause Problems of it's own
  	when others then 
  		iDebugState := 0;
 end DebugLog;
  
PROCEDURE DebugPause(LogPause in BOOLEAN := FALSE) is
begin 
  if LogPause then 
  	DebugLog(0,'DebugPause','Pausing Debug output');
  end if;	
  bDebugPaused := TRUE;
end DebugPause;

PROCEDURE DebugResume(LogResume in BOOLEAN := FALSE) is
begin 
  bDebugPaused := FALSE;
  if LogResume then 
  	DebugLog(0,'DebugResume','Resuming Debug output');
  end if;
end DebugResume;
  

  
PROCEDURE WinDebug  (  Text  IN   VARCHAR2) is
  vcBuff1 VARCHAR2(2000) := Text||chr(10);
begin 
  --Win_API_PDF.Clean_Error_Stack;
  if Win_API_PDF.API_ENABLED then
    Win_API_PDF.Register_function_call(iDebugString,'d2kwutil_DebugString',NULL,'*CHAR');
    d2kwutil_DebugString(Win_API_PDF.FunctionHandle(iDebugString),vcBuff1);
  else 
    raise Win_API_PDF.NOT_AVAILABLE;
  end if; 
exception
  when Win_API_PDF.NOT_AVAILABLE then
    Win_API_PDF.Add_error('WinDebug',Win_API_PDF.NoAPI);
    raise;
  when others then 
    Win_API_PDF.Add_error('WinDebug',Win_API_PDF.UError||Win_API_PDF.Add_External_errors); 
    raise;
end WinDebug;

  
  FUNCTION  BoolToChar(ThisBoolean IN BOOLEAN) return VARCHAR2 is
  begin
  	if ThisBoolean then 
  		RETURN 'TRUE';
  	else
  	    RETURN 'FALSE';
  	end if;
  end BoolToChar;

END;

PACKAGE WIN_API_DIALOG_PDF IS

/*-------------------------------------------------------------------------*\
 * WIN_API_DIALOG ->   This package is concerned with Displaying Common
 *      dialogs
 * Contents:
 *    Open_File    -> Open File Dialog
 *    Save_File    -> Save File Dialog
 *    Select_Printer    -> Printer Selection Dialog
 *    Choose_Font       -> Display the Font Selection Dialog
 *    Choose_Color      -> Display the Color Selection Dialog
 * Dependancies:
 *    WIN_API_ENVIRONMENT
 *    WIN_API
 *    WIN_API_DEBUG
\*-------------------------------------------------------------------------*/ 

/*-------------------------------------------------------------------------*\
 * Open_File        -> Displays the standard Open File dialog
 * Arguments: 
 *  Title           -> The Title for the Dialog Box
 *                     (Default -> 'Open File')
 *  StartDirectory  -> Where the dialog should start from
 *                     this should be in the format 'C:\TEMP'
 *                     (Default -> Windows Directory)
 *  FileFilter      ->  Restrict the list of files. The filter string 
 *                      should be in the format:
 *                      '<Description>|<filename>.<Extension>|'
 *                      typically this would be something like
 *                      'All files(*.*)|*.*|' or 'Text files(*.txt)|*.txt|'
 *                      "All Files" is the Default
 *  Modal           ->  Should the dialog be modal with respect to the 
 *                      application? 
 *                      default = TRUE
 *  AdvancedFlags   ->  (See list in WIN_API header) This option allows
 *                      you to change the attributes of the Open File 
 *                      dialog.  Here are some of the Flags that might
 *                      be of interest:
 *                      OFN_HIDEREADONLY  Hides the Read Only check box.
 *                      OFN_NONETWORKBUTTON  Hides the Network Button
 *                      OFN_EXPLORER    Display an Explorer style 
 *                        Dialog rather than the conventional one.
 *                      See your Microsoft docmentation for details on 
 *                      each flag.
 *                      To Set the Advanced_Flags varaible, just add the 
 *                      required flags together.  The default is:
 *                      WIN_API.OFN_PATHMUSTEXIST + WIN_API.OFN_FILEMUSTEXIST +
 *                      WIN_API.OFN_HIDEREADONLY + WIN_API.OFN_NOCHANGEDIR 
 *  RaiseExceptions ->  TRUE of FALSE(Default) If set to true, then if the 
 *                      command is not successful (e.g no filename is  
 *                      returned) then the explicit exception
 *                      NO_DATA_FOUND will be raised.
 *        
 * Returns:
 *  Path and name of the selected file
\*-------------------------------------------------------------------------*/
 
FUNCTION Open_File (  Title            IN  VARCHAR2     DEFAULT 'Open File',
                      StartDirectory   IN  VARCHAR2     DEFAULT '$WINDIR$',
                      FileFilter       IN  VARCHAR2     DEFAULT 'All files(*.*)|*.*|',
                      Modal            IN  BOOLEAN      DEFAULT TRUE,
                      AdvancedFlags    IN  PLS_INTEGER  DEFAULT WIN_API_PDF.OFN_FLAG_DEFAULT,
                      RaiseExceptions  IN  BOOLEAN      DEFAULT FALSE
                    )  RETURN VARCHAR2;


/*-------------------------------------------------------------------------*\
 * Open_FileEx  ->  Enhanced version of Open_File designed for use with 
 *                  The OFN_ALLOWMULTISELECT flag.  The existing Open_file 
 *                  returns the list of selected files separated with a Space
 *                  This can cause problems if you have long filenames with spaces
 *                  so this version of Open_File allows you to specify the 
 *                  Separator char, and defaults it to newline (chr(10))
 *                  Additionally as the main use of this version is to select 
 *                  Multiple files, the default flags are set to include the 
 *                  OFN_ALLOWMULTISELECT flag.
 * Arguments:       As Open_File, except to an extra single Character 
 *                  Parameter SeperatorChar before the RaiseExceptions
 *                  Boolean
\*-------------------------------------------------------------------------*/

FUNCTION Open_FileEx(  Title           IN  VARCHAR2    DEFAULT 'Open File',
                       StartDirectory  IN  VARCHAR2    DEFAULT '$WINDIR$',
                       FileFilter      IN  VARCHAR2    DEFAULT 'All files(*.*)|*.*|',
                       Modal           IN  BOOLEAN     DEFAULT TRUE,
                       AdvancedFlags   IN  PLS_INTEGER DEFAULT (WIN_API_PDF.OFN_FLAG_DEFAULT+WIN_API_PDF.OFN_ALLOWMULTISELECT),
                       SeparatorChar   IN  VARCHAR2    DEFAULT CHR(10),
                       RaiseExceptions IN  BOOLEAN     DEFAULT FALSE
                    )  RETURN VARCHAR2;


/*-------------------------------------------------------------------------*\
 * Save_File        -> Displays the standard Save File dialog
 * Arguments: 
 *  SampleName      -> The Example name for the file to display in 
 *                     the Save Window
 *  Title           -> The Title for the Dialog Box
 *                     (Default -> 'Save File As')
 *  StartDirectory  -> Where the dialog should start from
 *                     this should be in the format 'C:\TEMP'
 *                     (Default -> Windows Directory)
 *                     You can specify the Windows and Temp directories by
 *                     using the Shorthand $WINDIR$ and $TEMP$ respectively
 *                     The function will then Ask the O/S for the relevant 
 *                     locations
 *  FileFilter      -> Restrict the list of files. The filter string 
 *                     should be in the format:
 *                     '<Description>|<filename>.<Extension>|'
 *                     typically this would be something like
 *                     'All files(*.*)|*.*|' or 'Text files(*.txt)|*.txt|'
 *                     "All Files" is the Default
 *  Modal           -> Should the dialog be modal with respect to the 
 *                     application? 
 *                     default = TRUE
 *  AdvancedFlags   -> (See list in WIN_API header) This option allows
 *                     you to change the attributes of the Open File 
 *                     dialog.  Here are some of the Flags that might
 *                     be of interest:
 *                     OFN_HIDEREADONLY  Hides the Read Only check box.
 *                     OFN_NONETWORKBUTTON  Hides the Network Button
 *                     OFN_EXPLORER    Display an Explorer style 
 *                           Dialog rather than the conventional one.
 *                     See your Microsoft docmentation for details on 
 *                     each flag.
 *                     To Set the Advanced_Flags varaible, just add the 
 *                     required flags together.  The default is:
 *                     WIN_API.OFN_PATHMUSTEXIST + WIN_API.OFN_FILEMUSTEXIST +
 *                     WIN_API.OFN_HIDEREADONLY + WIN_API.OFN_NOCHANGEDIR 
 *  RaiseExceptions -> TRUE or FALSE(Default) If set to true, then if the 
 *                     command is not successful (e.g no filename is  
 *                     returned) then the explicit exception
 *                     NO_DATA_FOUND will be raised.
 *        
 * Returns:
 *  Path and name of the selected file
\*-------------------------------------------------------------------------*/
 
FUNCTION Save_File (  SampleName      IN  VARCHAR2,
                      Title           IN  VARCHAR2    DEFAULT 'Save File As',
                      StartDirectory  IN  VARCHAR2    DEFAULT '$WINDIR$',
                      FileFilter      IN  VARCHAR2    DEFAULT 'All files(*.*)|*.*|',
                      Modal           IN  BOOLEAN     DEFAULT TRUE,
                      AdvancedFlags   IN  PLS_INTEGER DEFAULT WIN_API_PDF.OFN_FLAG_DEFAULT,
                      RaiseExceptions IN  BOOLEAN     DEFAULT FALSE
        )   RETURN VARCHAR2;


/*-------------------------------------------------------------------------*\
 * Select_Printer   -> Displays the standard Printer Selection dialog.
 * Arguments: 
 *  PrinterName     -> The Name of the Printer the user Chooses
 *  Port            -> The Port for the above printer
 *  RaiseExceptions -> TRUE of FALSE(Default) If set to true, then if the 
 *                     command is not successful (e.g no Printer is  
 *                     selected) then the explicit exception
 *                     NO_DATA_FOUND will be raised.
 * Returns:
 *  Path and name of the selected file
\*-------------------------------------------------------------------------*/
 
PROCEDURE Select_Printer (  PrinterName     OUT  VARCHAR2,
                            Port            OUT  VARCHAR2,
                            RaiseExceptions IN   BOOLEAN DEFAULT FALSE);


/*-------------------------------------------------------------------------*\
 * Choose_Printer  ->  ** Do Not Use **
 *
 * This is an internal function that should not be used.
 * It is only exposed because it is shared with WIN_API_ENVIRONMENT
 * SELECT_PRINTER is the public implimetation of this Procedure.
\*-------------------------------------------------------------------------*/

PROCEDURE ChoosePrinter (       CalledBy        IN      VARCHAR2,
                                PrinterName     IN OUT  VARCHAR2,
                                Port            IN OUT  VARCHAR2,
                                Opt             IN      PLS_INTEGER,
                                RaiseExceptions IN      BOOLEAN );
                                
/*-------------------------------------------------------------------------*\
 * Choose_Font   -> Displays the standard Font Selection dialog.
 * Arguments: 
 *  (These arguments are all declared as IN OUT so that you can initialise
 *   the selection dialog with the current values)
 *  Face            -> The Name of the Font (IN OUT)
 *  PointSize       -> How Large?
 *  Bold            -> TRUE|FALSE
 *  Italic          -> TRUE|FALSE
 *  RaiseExceptions -> BOOLEAN -> Raise NO_DATA_FOUND if no font was selected
\*-------------------------------------------------------------------------*/
 
PROCEDURE Choose_Font    (  Face            IN OUT VARCHAR2,
                            PointSize       IN OUT PLS_INTEGER,
                            Bold            IN OUT BOOLEAN,
                            Italic          IN OUT BOOLEAN,
                            RaiseExceptions IN     BOOLEAN DEFAULT FALSE);
                            
/*-------------------------------------------------------------------------*\
 * Choose_Color   -> Displays the standard Color selection dialog.
 * Arguments: 
 *  (These arguments are all declared as IN OUT so that you can initialise
 *   the selection dialog with the current values)
 *  Red							-> Value between 0 - 255 for Redness
 *  Green						-> Value between 0 - 255 for Greenness
 *  Blue						-> Value between 0 - 255 for Blueness
 *  RaiseExceptions -> BOOLEAN -> Raise NO_DATA_FOUND if no color was selected
 *-------------------------------------------------------------------------
 * Return Value: Integer representing the combined RGB color code
 *               or -1 if no color was selected
\*-------------------------------------------------------------------------*/
 
FUNCTION Choose_Color    (  Red             IN OUT PLS_INTEGER,
                            Green           IN OUT PLS_INTEGER,
                            Blue            IN OUT PLS_INTEGER,
                            RaiseExceptions IN     BOOLEAN DEFAULT FALSE) RETURN PLS_INTEGER;
END WIN_API_DIALOG_PDF;


PACKAGE BODY WIN_API_DIALOG_PDF is


-- Constants for maintaining the Function Handle Array
-- These should be unique through the Whole Library
-- Dialog has indexes in the range 200 - 299
iChooseFile         CONSTANT  PLS_INTEGER  := 200;
iChoosePrinter      CONSTANT  PLS_INTEGER  := 201;
iChooseFont         CONSTANT  PLS_INTEGER  := 202;
iChooseColor        CONSTANT  PLS_INTEGER  := 203;

 -- Private Program unit headers
 FUNCTION ChooseFile(             CalledBy      IN       VARCHAR2,
                                  Modal         IN       BOOLEAN,
                                  szTitle       IN       VARCHAR2,
                                  szInitDir     IN       VARCHAR2,
                                  szFileFilter  IN       VARCHAR2,
                                  Flags         IN       PLS_INTEGER,
                                  SepChar       IN       VARCHAR2,
                                  szBuffer      IN  OUT  VARCHAR2 ) RETURN PLS_INTEGER;

 FUNCTION d2kwutil_ChooseFile (   hFunc         IN      ORA_FFI.funcHandleType,
                                  dialog_type   IN      PLS_INTEGER,
                                  hwndOwner     IN      PLS_INTEGER,
                                  szTitle       IN OUT  VARCHAR2,
                                  szInitDir     IN OUT  VARCHAR2,
                                  szFileFilter  IN OUT  VARCHAR2,
                                  AdvancedFlags IN      PLS_INTEGER,
                                  SepChar       IN      VARCHAR2,
                                  szBuffer      IN OUT  VARCHAR2) return PLS_INTEGER;

 FUNCTION d2kwutil_ChoosePrinter(  hFunc        IN      ORA_FFI.funcHandleType,
                                   hWin         IN      PLS_INTEGER,
                                   PrinterName  IN OUT  VARCHAR2,
                                   Port         IN OUT  VARCHAR2,
                                   Opt          IN       PLS_INTEGER) return PLS_INTEGER;
                                   
 Function d2kwutil_ChooseFont    ( hFunc        IN     ORA_FFI.funcHandleType,  
 								   								 hWnd         IN     PLS_INTEGER, 
		 						   								 Face         IN OUT VARCHAR2,
		 						   								 PointSize    IN OUT PLS_INTEGER,
		                           		 Bold         IN OUT PLS_INTEGER,
		                           		 Italic       IN OUT PLS_INTEGER) return PLS_INTEGER;

 Function d2kwutil_ChooseColor   ( hFunc        IN     ORA_FFI.funcHandleType,  
 								   								 hWnd         IN     PLS_INTEGER, 
 								   								 Combined 		IN OUT PLS_INTEGER,
		 						   								 Red    			IN OUT PLS_INTEGER,
		                           		 Green        IN OUT PLS_INTEGER,
		                           		 Blue       	IN OUT PLS_INTEGER) return PLS_INTEGER;

 -- Pragmas
 PRAGMA INTERFACE(C,d2kwutil_ChooseFile,11265);
 PRAGMA INTERFACE(C,d2kwutil_ChoosePrinter,11265);
 PRAGMA INTERFACE(C,d2kwutil_ChooseFont,11265);
 PRAGMA INTERFACE(C,d2kwutil_ChooseColor,11265);

 -- Public Bodies  

 FUNCTION Open_File ( Title            IN  VARCHAR2     DEFAULT 'Open File',
                      StartDirectory   IN  VARCHAR2     DEFAULT '$WINDIR$',
                      FileFilter       IN  VARCHAR2     DEFAULT 'All files(*.*)|*.*|',
                      Modal            IN  BOOLEAN      DEFAULT TRUE,
                      AdvancedFlags    IN  PLS_INTEGER  DEFAULT Win_API_PDF.OFN_FLAG_DEFAULT,
                      RaiseExceptions  IN  BOOLEAN      DEFAULT FALSE
                    ) RETURN VARCHAR2 is
  vcReturnedFile  varchar2(4096);
  iLRC            pls_integer := 0;
begin 
  vcReturnedFile := CHR(0);
  iLRC := choosefile('Open_File',Modal,Title,StartDirectory,FileFilter,AdvancedFlags,' ',vcReturnedFile);
  
  if iLRC = 1 then 
    Win_API_PDF.Add_error('Open_File','No file was selected');
    if RaiseExceptions then 
      Raise NO_DATA_FOUND;
    end if;
  else
    return vcReturnedFile;
  end if;
end Open_File;

FUNCTION Open_FileEx( Title            IN  VARCHAR2    DEFAULT 'Open File',
                      StartDirectory   IN  VARCHAR2    DEFAULT '$WINDIR$',
                      FileFilter       IN  VARCHAR2    DEFAULT 'All files(*.*)|*.*|',
                      Modal            IN  BOOLEAN     DEFAULT TRUE,
                      AdvancedFlags    IN  PLS_INTEGER DEFAULT (Win_API_PDF.OFN_FLAG_DEFAULT+Win_API_PDF.OFN_ALLOWMULTISELECT),
                      SeparatorChar    IN  VARCHAR2    DEFAULT CHR(10),
                      RaiseExceptions IN   BOOLEAN     DEFAULT FALSE
                    )  RETURN VARCHAR2 is
  vcReturnedFile  varchar2(4096);
  iLRC    pls_integer := 0;
begin 
  vcReturnedFile := CHR(0);
  iLRC := choosefile('Open_File',Modal,Title,StartDirectory,FileFilter,AdvancedFlags,SeparatorChar,vcReturnedFile);
  
  if iLRC = 1 then 
    Win_API_PDF.Add_error('Open_FileEx','No file was selected');
    if RaiseExceptions then 
      Raise NO_DATA_FOUND;
    end if;
  else
    return vcReturnedFile;
  end if;
end Open_FileEx;                    
                    


FUNCTION Save_File (  SampleName       IN  VARCHAR2,
                      Title            IN  VARCHAR2     DEFAULT 'Save File As',
                      StartDirectory   IN  VARCHAR2     DEFAULT '$WINDIR$',
                      FileFilter       IN  VARCHAR2     DEFAULT 'All files(*.*)|*.*|',
                      Modal            IN  BOOLEAN      DEFAULT TRUE,
                      AdvancedFlags    IN  PLS_INTEGER  DEFAULT Win_API_PDF.OFN_FLAG_DEFAULT,
                      RaiseExceptions  IN  BOOLEAN      DEFAULT FALSE
                    ) RETURN VARCHAR2 is
  vcReturnedFile  varchar2(4096);
  iLRC    pls_integer := 0;
begin 
  vcReturnedFile  := SampleName;
  iLRC := choosefile('Save_File',Modal,Title,StartDirectory,FileFilter,AdvancedFlags,' ',vcReturnedFile);
  
  if iLRC = 1 then 
    Win_API_PDF.Add_error('Save_File','No file was selected');
    if RaiseExceptions then 
      Raise NO_DATA_FOUND;
    end if;
  else
    return vcReturnedFile;
  end if;
end Save_File;
    
FUNCTION ChooseFile(  CalledBy      IN      VARCHAR2,
                      Modal         IN      BOOLEAN,
                      szTitle       IN      VARCHAR2,
                      szInitDir     IN      VARCHAR2,
                      szFileFilter  IN      VARCHAR2,
                      Flags         IN      PLS_INTEGER,
                      SepChar       IN      VARCHAR2,
                      szBuffer      IN OUT  VARCHAR2 ) RETURN PLS_INTEGER is
  hwndOwner  PLS_INTEGER;
  iBuff1     PLS_INTEGER;
  iBuff2     PLS_INTEGER;
  iRC        PLS_INTEGER;
  vcBuff1    VARCHAR2(255);
  vcBuff2    VARCHAR2(2000);
  vcBuff3    VARCHAR2(100);
  vcBuff4    VARCHAR2(1);
  vcBuff5    VARCHAR2(4096);
begin 
  Win_API_Debug_PDF.DebugLog(99,'ChooseFile','Args: CalledBy="'||CalledBy||', Modal='||Win_API_Debug_PDF.BoolToChar(Modal)||', szTitle="'||szTitle||'", szInitDir="'||szInitDir||'", szFileFilter="'||szFileFilter||'", Flags='||to_char(flags)||', SepChar="'||SepChar||'", szBuffer="'||szBuffer||'"');	
  Win_API_PDF.Clean_Error_Stack;
  iRC  := 0;
  if Modal then 
    hwndOwner := win_api_utility_PDF.get_active_window;
  else
    hwndOwner := 0;
  end if;

  if Win_API_PDF.API_ENABLED then 
      Win_API_PDF.Register_function_call(iChooseFile,'d2kwutil_ChooseFile','INT','INT,SHORT,*CHAR,*CHAR,*CHAR,LONG,CHAR,*CHAR');

      if CalledBy = 'Open_File' then
        iBuff1     := 1;
      else
        iBuff1    := 2;
      end if;
      iBuff2    := Flags;
      vcBuff1    := szTitle;
      
      if upper(szInitDir) = '$WINDIR$' then 
        vcBuff2 := win_api_environment_PDF.get_windows_directory;
      elsif  upper(szInitDir) = '$TEMP$' then 
        vcBuff2 := win_api_environment_PDF.get_temp_directory;
      else 
        vcBuff2 := szInitDir;
      end if;
      
      if substr(vcBuff2,length(vcBuff2),1) <> '\' then 
        vcBuff2 := vcBuff2||'\';
      end if;
      
      if szFileFilter = NULL or szFileFilter = '' then 
        vcBuff3 := 'All files(*.*)|*.*|';
      else
        vcBuff3 := szFileFilter;
      end if;
      vcBuff4 := substr(SepChar,1,1);
      vcBuff5 := RPAD(szBuffer,4096,CHR(0)); 
      
      iRC := d2kwutil_choosefile (Win_API_PDF.FunctionHandle(iChoosefile),iBuff1,hwndOwner,vcBuff1,vcBuff2,vcBuff3,iBuff2,vcBuff4,vcBuff5);
      Win_API_Debug_PDF.DebugLog(99,'ChooseFile','Result: RC='||to_char(iRC)||', szBuffer="'||vcBuff5||'"');
      szBuffer := vcBuff5;
      return iRC;
  else 
    raise Win_API_PDF.NOT_AVAILABLE;
  end if;  
exception
  when Win_API_PDF.NOT_AVAILABLE then
    Win_API_PDF.Add_error(CalledBy,Win_API_PDF.NoAPI);
    raise;
  when others then
    Win_API_PDF.Add_error(CalledBy, Win_API_PDF.UError||Win_API_PDF.Add_External_errors); 
    raise;  
end Choosefile;

PROCEDURE Select_Printer (  PrinterName     OUT  VARCHAR2,
                            Port            OUT  VARCHAR2,
                            RaiseExceptions in BOOLEAN DEFAULT FALSE) is
  
  vcBuff1  VARCHAR2(513);
  vcBuff2  VARCHAR2(513);
begin
  ChoosePrinter('Select_Printer',vcBuff1, vcBuff2,0,RaiseExceptions);
  PrinterName := vcBuff1;
  Port        := vcBuff2;
end Select_Printer;
  
  
PROCEDURE ChoosePrinter (  CalledBy        IN      VARCHAR2,
                           PrinterName     IN OUT  VARCHAR2,
                           Port            IN OUT  VARCHAR2,
                           Opt             IN      PLS_INTEGER,
                           RaiseExceptions IN      BOOLEAN) is
  iBuff1  PLS_INTEGER;
  iRC      PLS_INTEGER;
  vcBuff1  VARCHAR2(513);
  vcBuff2  VARCHAR2(513);
begin
  Win_API_Debug_PDF.DebugLog(99,'ChoosePrinter','Args: CalledBy="'||CalledBy||'", Opt='||to_char(Opt)||', RaiseExceptions='||Win_API_Debug_PDF.booltochar(RaiseExceptions));
  Win_API_PDF.Clean_Error_Stack;
  iRC  := 0;
  if Win_API_PDF.API_ENABLED then 
    Win_API_PDF.Register_function_call(iChoosePrinter,'d2kwutil_ChoosePrinter','INT','INT,*CHAR,*CHAR,INT');

    iBuff1     := win_api_utility_PDF.get_active_window(FALSE);
    vcBuff1    := RPAD(' ',512,CHR(0)); 
    vcBuff2    := RPAD(' ',512,CHR(0)); 
    iRC := d2kwutil_ChoosePrinter(Win_API_PDF.FunctionHandle(iChoosePrinter),iBuff1,vcBuff1,vcBuff2,Opt);
    Win_API_Debug_PDF.DebugLog(99,'ChoosePrinter','Result: RC='||to_char(iRC)||', PrinterName="'||vcBuff1||'", Port="'||vcBuff2||'"');
  else 
    raise Win_API_PDF.NOT_AVAILABLE;
  end if;  
  
  if iRC = 0 then 
    PrinterName   := vcBuff1;
    Port          := vcBuff2;
  else
    Win_API_PDF.Add_error(CalledBy,'No Printer Selected');
    if RaiseExceptions then 
      raise NO_DATA_FOUND;
    end if;
  end if;
exception
  when NO_DATA_FOUND then 
    raise;
  when Win_API_PDF.NOT_AVAILABLE then
    Win_API_PDF.Add_error(CalledBy,Win_API_PDF.NoAPI);
    raise;
  when others then 
    Win_API_PDF.Add_error(CalledBy,Win_API_PDF.UError||Win_API_PDF.Add_External_errors); 
    raise;
end ChoosePrinter;

PROCEDURE Choose_Font    (  Face            IN OUT VARCHAR2,
                            PointSize       IN OUT PLS_INTEGER,
                            Bold            IN OUT BOOLEAN,
                            Italic          IN OUT BOOLEAN,
                            RaiseExceptions IN     BOOLEAN DEFAULT FALSE) is
  hwndOwner  PLS_INTEGER;
  iRC  		 PLS_INTEGER;
  iBuff1  	 PLS_INTEGER;
  iBuff2  	 PLS_INTEGER;
  iBuff3  	 PLS_INTEGER;
  vcBuff1    VARCHAR2(32);
begin
  Win_API_Debug_PDF.DebugLog(99,'Choose_Font','Args: Face="'||Face||'", PointSize='||to_char(PointSize)||', Bold='||Win_API_Debug_PDF.booltochar(BOLD)||', Italic='||Win_API_Debug_PDF.booltochar(Italic));
  Win_API_PDF.Clean_Error_Stack;
  iRC  := 0;
  if Win_API_PDF.API_ENABLED then 
    Win_API_PDF.Register_function_call(iChooseFont,'d2kwutil_ChooseFont','INT','INT,*CHAR,*INT,*INT,*INT');
    hwndOwner     := win_api_utility_PDF.get_active_window;
    vcBuff1 := rpad(Face,32,chr(0));
    iBuff1 := PointSize;
    
    if Bold then
       iBuff2 := 700;
    else 
       iBuff2 := 400;
    end if;
    
    if Italic then
       iBuff3 := 255;
    else 
       iBuff3 := 0;
    end if;
    
    iRC := d2kwutil_ChooseFont(Win_API_PDF.FunctionHandle(iChooseFont),hwndOwner,vcBuff1,iBuff1,iBuff2,iBuff3);
    Win_API_Debug_PDF.DebugLog(99,'Choose_Font','Result: RC='||to_char(iRC)||', Face="'||vcBuff1||'" PointSize='||to_char(iBuff1)||', Bold='||to_char(iBuff2)||', Italic='||to_char(iBuff3));
    if iRC = 0 then 
       Win_API_PDF.Add_error('Choose_Font','No Font selection was made');
       if RaiseExceptions then 
    	  Raise NO_DATA_FOUND;
       end if;
    end if;

    Face := vcBuff1;
    PointSize := iBuff1/10;
    Bold   := (iBuff2>=700);
    Italic := (iBuff3<>0);  
  end if;                                                          
exception
  when NO_DATA_FOUND then 
    raise;
  when Win_API_PDF.NOT_AVAILABLE then
    Win_API_PDF.Add_error('Choose_Font',Win_API_PDF.NoAPI);
    raise;
  when others then 
    Win_API_PDF.Add_error('Choose_Font',Win_API_PDF.UError||Win_API_PDF.Add_External_errors); 
    raise;                                              
end Choose_Font;  


FUNCTION Choose_Color    (  Red             IN OUT PLS_INTEGER,
                            Green           IN OUT PLS_INTEGER,
                            Blue            IN OUT PLS_INTEGER,
                            RaiseExceptions IN     BOOLEAN DEFAULT FALSE) RETURN PLS_INTEGER IS
  hwndOwner  PLS_INTEGER;
  iRC  			 PLS_INTEGER;
  iBuff1  	 PLS_INTEGER := -1;
  iBuff2  	 PLS_INTEGER;
  iBuff3  	 PLS_INTEGER;
  iBuff4  	 PLS_INTEGER;
begin
  Win_API_Debug_PDF.DebugLog(99,'Choose_Color','Args: Red='||to_char(Red)||', Green='||to_char(Green)||', Blue='||to_char(Blue));
  Win_API_PDF.Clean_Error_Stack;
  iRC  := 0;
  if Win_API_PDF.API_ENABLED then 
    Win_API_PDF.Register_function_call(iChooseColor,'d2kwutil_ChooseColor','INT','INT,*INT,*INT,*INT,*INT');
    hwndOwner     := win_api_utility_PDF.get_active_window;
   
		iBuff2 := nvl(Red,0);
		iBuff3 := nvl(Green,0);
		iBuff4 := nvl(Blue,0);
    iBuff1 := (iBuff2 + (iBuff3*256) + (iBuff4*65536)); 
    
    iRC := d2kwutil_ChooseColor(Win_API_PDF.FunctionHandle(iChoosecolor),hwndOwner,iBuff1,iBuff2,iBuff3,iBuff4);
    Win_API_Debug_PDF.DebugLog(99,'Choose_Color','Result: RC='||to_char(iRC)||', Combined='||to_char(iBuff1)||',Red='||to_char(iBuff2)||',Green='||to_char(iBuff3)||',Blue='||to_char(iBuff4));
    if iRC = 0 then 
       Win_API_PDF.Add_error('Choose_Color','No Color selection was made');
       iBuff1 := -1;
       if RaiseExceptions then 
    	  Raise NO_DATA_FOUND;
       end if;
    end if;

		Red 	:= iBuff2;
		Green := iBuff3;
		Blue  := iBuff4;
  end if;           
  return iBuff1;
exception
  when NO_DATA_FOUND then 
    raise;
  when Win_API_PDF.NOT_AVAILABLE then
    Win_API_PDF.Add_error('Choose_Color',Win_API_PDF.NoAPI);
    raise;
  when others then 
    Win_API_PDF.Add_error('Choose_Color',Win_API_PDF.UError||Win_API_PDF.Add_External_errors); 
    raise;                                              
End Choose_color;                            


END WIN_API_DIALOG_PDF;


PACKAGE WIN_API_DIRECTORY_LIST_PDF IS

/*-------------------------------------------------------------------------*\
 * WIN_API_DIRECTORY_LIST -> This package cn be used to obtain lists of files
 *                           in a particular directory
 * Contents:
 *    FirstFile    		 -> Starts a "Search" and returns the name of 
 *                        The first file that matches the name/pattern 
 *												supplied
 *    NextFile	    	 -> Get the next file from the search
 *    CloseSearch   	 -> Cleans up the search
 * Dependancies:
 *    WIN_API
 *    WIN_API_DEBUG
\*-------------------------------------------------------------------------*/ 

/*-------------------------------------------------------------------------*\
 * FirstFile    	 	-> Defines a File listing search and returns the 
 *										 first matching file.
 * Arguments: 
 *  SearchFor       -> The path and name of the file(s) to search for
 *										 can contain wildcards.
 *										 e.g. C:\TEMP\*.FMB will return all Forms 
 *                     in the Temp Directory
 *	FileName				-> The First File found by the search.  If the file found
 *          					 is actually a directory the IsDirectory boolean will 
 *                     be set.		
 *										 If no files match the search criteria, this will be 
 *                     NULL.
 *	IsDirectory			-> This will be set to TRUE if the file returned is
 *     								 actually a directory
 *  RaiseExceptions -> TRUE of FALSE(Default) If set to true, then if the 
 *                     command is not successful (e.g the file does 
 *                     not exist) then the explicit exception
 *                     NO_DATA_FOUND will be raised.
 * Returns:
 *  NUMBER					-> The Handle For the search, this will be needed for 
 *							       passing to NextFile and CloseSearch.
 *										 If the Function fails this will be set to -1.
 *-------------------------------------------------------------------------
 * NOTE:							If you do a global search (e.g. *.*) the directories
 *                    "." and ".." will be returned as the first two hits
\*-------------------------------------------------------------------------*/

FUNCTION	FirstFile		 ( SearchFor			 IN		VARCHAR2,
												 FileName				 OUT	VARCHAR2,
												 IsDirectory		 OUT	BOOLEAN,
                         RaiseExceptions IN   BOOLEAN DEFAULT FALSE) RETURN PLS_INTEGER;

/*-------------------------------------------------------------------------*\
 * NextFile   			-> The Next "Hit" in the current search
 *                     This will return NULL if there are no more files
 *                     and raise the Exception NO_DATA_FOUND if RaiseExceptions
 *                     is set to TRUE.
 * Arguments: 
 *	SearchHandle	  -> The handle returned by FirstFile
 *	FileName				-> The Next File found by the search.  If the file found
 *          					 is actually a directory the IsDirectory boolean will 
 *                     be set.		
 *										 If no further files match the search criteria, this  
 *                     will be NULL.	
 *	IsDirectory			-> This will be set to TRUE if the file returned is
 *     								 actually a directory
 *  RaiseExceptions -> TRUE of FALSE(Default) If set to true, then if the 
 *                     command is not successful (e.g no more matching files)
 *                     then the explicit exception NO_DATA_FOUND will be raised.
 * Returns:
 *  (NONE)
 *-------------------------------------------------------------------------*/
 
PROCEDURE NextFile		( SearchHandle		IN 		PLS_INTEGER,
												FileName				OUT		VARCHAR2,
												IsDirectory		  OUT		BOOLEAN,
												RaiseExceptions IN   	BOOLEAN DEFAULT FALSE);


/*-------------------------------------------------------------------------*\
 * CloseSearch   	  -> Cleans up the search - You should call this if you end 
 *                     a search before you reach the end of the list of files. 
 *                     normally if you keep calling NextFiles until the end 
 *                     it will automatically close the search.
 * Arguments: 
 *	SearchHandle	  -> The handle returned by FirstFile
 * Returns:
 *  (NONE)
\*-------------------------------------------------------------------------*/
 
PROCEDURE CloseSearch	( SearchHandle		IN 		PLS_INTEGER);                       

END WIN_API_DIRECTORY_LIST_PDF;

PACKAGE BODY  WIN_API_DIRECTORY_LIST_PDF is
  -- Constants for maintaining the Function Handle Array
  -- These should be unique through the Whole Library
  -- Directory_List has indexes in the range 800 - 899
  iFirstFile          CONSTANT  PLS_INTEGER  := 800;
  iNextFile     	    CONSTANT  PLS_INTEGER  := 801;
  iCloseSearch        CONSTANT  PLS_INTEGER  := 802;

   -- Private Program unit headers
   
FUNCTION d2kwutil_dirlist_first(  hFunc          IN      ORA_FFI.funcHandleType,
                              		path     			 IN OUT  VARCHAR2,
                              		result				 IN OUT  VARCHAR2,
                              		Directory      IN OUT  PLS_INTEGER) return PLS_INTEGER;
                              		
FUNCTION d2kwutil_dirlist_next (  hFunc          IN      ORA_FFI.funcHandleType,
																	hSearch				 IN			 PLS_INTEGER,
                              		result				 IN OUT  VARCHAR2,
                              		Directory      IN OUT  PLS_INTEGER) return PLS_INTEGER;
                              		
PROCEDURE d2kwutil_dirlist_close( hFunc          IN      ORA_FFI.funcHandleType,
																	hSearch				 IN			 PLS_INTEGER);

 -- Pragmas
 PRAGMA INTERFACE(C,d2kwutil_Dirlist_first,    11265);
 PRAGMA INTERFACE(C,d2kwutil_Dirlist_next,     11265);
 PRAGMA INTERFACE(C,d2kwutil_Dirlist_close,    11265);

 -- Public Bodies 
FUNCTION	FirstFile		 ( SearchFor			 IN		VARCHAR2,
												 FileName				 OUT	VARCHAR2,
												 IsDirectory		 OUT	BOOLEAN,
                         RaiseExceptions IN   BOOLEAN DEFAULT FALSE) RETURN PLS_INTEGER IS
  iRC     PLS_INTEGER := 0;  
  vcBuff1 varchar2(512);
  vcBuff2 varchar2(512);                      
  iBuff1	PLS_INTEGER := 0;
  bIsDir	BOOLEAN := FALSE;
begin
  Win_API_Debug_PDF.DebugLog(99,'FirstFile','Args: SearchFor="'||SearchFor||'", RaiseExceptions='||Win_API_Debug_PDF.booltochar(RaiseExceptions));	  		
  Win_API_PDF.Clean_Error_Stack;
  if Win_API_PDF.API_ENABLED then
    Win_API_PDF.Register_function_call(iFirstFile,'d2kwutil_dirlist_first','LONG','*CHAR,*CHAR,*INT');
    vcBuff1    	:= SearchFor;
    vcBuff2			:= RPAD(' ',512,'.');
    iRC   := d2kwutil_dirlist_first(Win_API_PDF.FunctionHandle(iFirstFile),vcBuff1,vcBuff2,iBuff1);
    Win_API_Debug_PDF.DebugLog(99,'FirstFile','Result: RC='||to_char(iRC)||',File="'||vcBuff2||'", isDir='||iBuff1);
  else 
    raise Win_API_PDF.NOT_AVAILABLE;
  end if;  
  if iRC = -1 then 
  	FileName := NULL;
    Win_API_PDF.Add_error('FirstFile','No matching files for '||SearchFor);
    if RaiseExceptions then 
      raise NO_DATA_FOUND;
    end if;
  else
  	FileName := vcBuff2;  	
 	 	if iBuff1 = 16 then
  		IsDirectory := TRUE;
  	else
  		IsDirectory := FALSE;  	
  	end if;
  end if;

  return iRC;
  
exception
  when NO_DATA_FOUND then 
    raise;
  when Win_API_PDF.NOT_AVAILABLE then
    Win_API_PDF.Add_error('FirstFile',Win_API_PDF.NoAPI);
    raise;
  when others then 
    Win_API_PDF.Add_error('FirstFile',Win_API_PDF.UError||Win_API_PDF.Add_External_errors); 
    raise;
end FirstFile;


PROCEDURE NextFile		( SearchHandle		IN 		PLS_INTEGER,
												FileName				OUT		VARCHAR2,
												IsDirectory		  OUT		BOOLEAN,
												RaiseExceptions IN   	BOOLEAN DEFAULT FALSE) IS
  iRC     pls_integer := 0;  
  vcBuff1 varchar2(512);                    
  iBuff1	PLS_INTEGER := 0;
begin 
  Win_API_Debug_PDF.DebugLog(99,'NextFile','Args: SearchHandle='||to_char(SearchHandle)||',RaiseExceptions='||Win_API_Debug_PDF.booltochar(RaiseExceptions));	  		
  Win_API_PDF.Clean_Error_Stack;
  if Win_API_PDF.API_ENABLED then
    Win_API_PDF.Register_function_call(iNextFile,'d2kwutil_dirlist_next','INT','LONG,*CHAR,*INT');
    vcBuff1			:= RPAD(' ',512,'.');
    iRC   := d2kwutil_dirlist_next(Win_API_PDF.FunctionHandle(iNextFile),SearchHandle,vcBuff1,iBuff1);
    Win_API_Debug_PDF.DebugLog(99,'NextFile','Result: RC='||to_char(iRC)||',File="'||vcBuff1||'", isDir='||iBuff1);
  else 
    raise Win_API_PDF.NOT_AVAILABLE;
  end if;  
  if iRC = -1 then 
  	FileName := NULL;
    Win_API_PDF.Add_error('NextFile','No further matching files');
    if RaiseExceptions then 
      raise NO_DATA_FOUND;
    end if;
   else
    FileName := vcBuff1;	
 		if iBuff1 = 16 then
  		IsDirectory := TRUE;
  	else
  		IsDirectory := FALSE;  	
  	end if;
  end if;  
exception
  when NO_DATA_FOUND then 
    raise;
  when Win_API_PDF.NOT_AVAILABLE then
    Win_API_PDF.Add_error('NextFile',Win_API_PDF.NoAPI);
    raise;
  when others then 
    Win_API_PDF.Add_error('NextFile',Win_API_PDF.UError||Win_API_PDF.Add_External_errors); 
    raise;
end NextFile;

PROCEDURE CloseSearch	( SearchHandle		IN 	PLS_INTEGER) is
begin 
  Win_API_Debug_PDF.DebugLog(99,'CloseSearch','Args: SearchHandle='||to_char(SearchHandle));	  		
  Win_API_PDF.Clean_Error_Stack;
  if Win_API_PDF.API_ENABLED then
    Win_API_PDF.Register_function_call(iCloseSearch,'d2kwutil_dirlist_close','VOID','LONG');
    d2kwutil_dirlist_close(Win_API_PDF.FunctionHandle(iCloseSearch), SearchHandle);
    Win_API_Debug_PDF.DebugLog(99,'CloseSearch','Has no RC');
  else 
    raise Win_API_PDF.NOT_AVAILABLE;
  end if;  
  
exception
  when NO_DATA_FOUND then 
    raise;
  when Win_API_PDF.NOT_AVAILABLE then
    Win_API_PDF.Add_error('CloseSearch',Win_API_PDF.NoAPI);
    raise;
  when others then 
    Win_API_PDF.Add_error('CloseSearch',Win_API_PDF.UError||Win_API_PDF.Add_External_errors); 
    raise;
end CloseSearch;

END WIN_API_DIRECTORY_LIST_PDF;


PACKAGE WIN_API_ENVIRONMENT_PDF IS

/*-----------------------------------------------------------------------------------*\
 * WIN_API_ENVIRONMENT -> This package is concerned with reading from and 
 *       writing to either INI files or the Win95/WinNT Registry.
 *       Or gleaning other useful nuggets of information from the system
 * Contents:
 *    Read_INI_File           -> Gets a Value from an INI file
 *    Write_INI_File          -> Sets a Value in an INI file
 *    Get_Windows_Username    -> Login of current Windows User
 *    Get_Windows_Version     -> Returns the O/S being used
 *    Get_Environment_string  -> Expands Environment Vars e.g %path%
 *    Get_Windows_Directory   -> Gets the Working Windows Dir
 *    Get_Temp_Directory      -> Gets the Temp Dir
 *    Get_Net_Connection      -> Expand Drive Letter into a Network Path
 *    Read_Registry           -> Reads a value from the Registry 
 *    Write_Registry          -> Writes a value to the Registry in REG_SZ fmt
 *    Write_RegistryEx        -> Extended version of Write_Registry which allows 
 *                               You to choose which format to Write in
 *    Create_Registry_Key     -> Creates a new subkey in the registry
 *    Delete_Registry_Key     -> Removes a subkey from the registry
 *    Get_Working_Directory   -> Get the name of the "Start In" / Current Directory
 *                               For this runtime
 *    Set_Working_Directory   -> Alter the Working directory
 *    Get_Computer_Name       -> Get the name of this PC if defined
 *    Get_Default_Drinter     -> Returns the Name and Port of your default printer
 * Dependancies:
 *    WIN_API
 *    WIN_API_DIALOG
 *    WIN_API_DEBUG
\*------------------------------------------------------------------------------------*/ 

/*-------------------------------------------------------------------------*\
 * Read_INI_File    -> Read a Value from a named INI file 
 *                     If you need to read the ORACLE.INI file 
 *                     use TOOL_ENV.GETVAR() instead of this
 *                     package.
 *                     If using 32bit Developer/2000 you would 
 *                     probably rather use 
 *                     WIN_API_PROFILES.READ_REGISTRY() instead
 * Arguments: 
 *  FileName        -> Name of INI file e.g. WIN.INI. If the full
 *                     path is not supplied with this argument
 *                     then the DOS PATH will be searched for the
 *                     Specified INI file
 *  Section         -> Section in INI file where the entry is. 
 *                     This will be delimited using square brackets 
 *                     e.g. [printers]
 *  Entry           -> Name of Variable to read e.g. load (from win.ini)
 *  RaiseExceptions -> TRUE or FALSE(Default) If set to true, then if the 
 *                     requested variable is not found the explicit exception
 *                     NO_DATA_FOUND will be raised.
 * Returns:
 *  Value           -> A VARCHAR2 value containing the 
 *                     string (or number as a string) that the 
 *                     entry contains.
 *                     If the Entry is not found NULL is returned in 
 *                     the return value. (see RaiseExceptions above)
\*-------------------------------------------------------------------------*/
 
FUNCTION Read_INI_File (  FileName        IN  VARCHAR2,
                          Section         IN  VARCHAR2,
                          Entry           IN  VARCHAR2,
                          RaiseExceptions IN  BOOLEAN DEFAULT FALSE) return VARCHAR2;

/*-------------------------------------------------------------------------*\
 * Write_INI_File ->   Write a Value to a named INI file 
 *                     If using 32bit Developer/2000 you would 
 *                     probably rather use 
 *                     WIN_API_PROFILES.WRITE_REGISTRY_XXXX()
 * Arguments: 
 *  FileName        -> Name of INI file e.g. WIN.INI. If the full
 *                     path is not supplied with this argument
 *                     then the DOS PATH will be searched for the
 *                     Specified INI file
 *  Section         -> Section in INI file where the entry is. 
 *                     This will be delimited using square brackets 
 *                     e.g. [printers]. No need to supply the brackets
 *                     for the argument though
 *  Entry           -> Name of Variable to write e.g. load (from win.ini)
 *  Value           -> Value of the variable to write as a string.
 *  RaiseExceptions -> Set to TRUE or FALSE (default).  If this is set 
 *                     to TRUE, then errors such as not finding the 
 *                     INI file will raise NO_DATA_FOUND
 *                     If FALSE then all errors will be handled quietly
 * Returns:
 *  (NONE)
\*-------------------------------------------------------------------------*/

PROCEDURE Write_INI_File (  FileName        IN  VARCHAR2,
                            Section         IN  VARCHAR2,
                            Entry           IN  VARCHAR2,
                            Value           IN  VARCHAR2,
                            RaiseExceptions IN  BOOLEAN DEFAULT FALSE);

/*-------------------------------------------------------------------------*\
 * Get_Windows_Username -> The Username Supplied to log into Windows
 * Arguments: 
 *  RaiseExceptions     -> Set to TRUE or FALSE (default).  If this is set 
 *                         to TRUE, then Not finding the Username (or 
 *                         exceeding the buffer size) will raise
 *                         NO_DATA_FOUND
 * Returns:
 *  UserName ->    Varchar2 
\*-------------------------------------------------------------------------*/

FUNCTION Get_Windows_Username ( RaiseExceptions   IN  BOOLEAN DEFAULT FALSE)  RETURN VARCHAR2;

/*-------------------------------------------------------------------------*\
 * Get_Windows_Version -> The Version of Windows Being used.
 * Arguments: 
 *         NONE
 * Returns:
 *  Version            -> Varchar2 one of the following strings:
 *                        Windows95
 *                        Windows98
 *                        WindowsNT
\*-------------------------------------------------------------------------*/

FUNCTION Get_Windows_Version RETURN VARCHAR2;

/*-------------------------------------------------------------------------*\
 * Get_Environment_String -> Expands a named environment variable
 * Arguments: 
 *  VariableName          -> Name of the variable e.g. PATH
 *  RaiseExceptions       -> Set to TRUE or FALSE (default).  If this is set 
 *                           to TRUE, then Not finding the Variable (or 
 *                           exceeding the buffer size) will raise
 *                           NO_DATA_FOUND
 * Returns:
 *  Expanded String       ->  Varchar2 
\*-------------------------------------------------------------------------*/

FUNCTION Get_Environment_string (VariableName      IN  VARCHAR2,
                                 RaiseExceptions   IN  BOOLEAN DEFAULT FALSE)  RETURN VARCHAR2;


/*-------------------------------------------------------------------------*\
 * Get_Windows_Directory -> Obtains the path to the windows directory 
 *                          on the machine
 * Arguments: 
 *  RaiseExceptions      -> Set to TRUE or FALSE (default).  If this is set 
 *                          to TRUE, then Not finding the directory (or 
 *                          exceeding the buffer size) will raise
 *                          NO_DATA_FOUND
 * Returns:
 *  Path                 -> Varchar2 
\*-------------------------------------------------------------------------*/

FUNCTION Get_Windows_Directory ( RaiseExceptions   IN  BOOLEAN DEFAULT FALSE)  RETURN VARCHAR2;

/*-------------------------------------------------------------------------*\
 * Get_Temp_Directory -> Obtains the path to the directory that  
 *                       Windows is using for temp files
 * Arguments: 
 *  RaiseExceptions   -> Set to TRUE or FALSE (default).  If this is set 
 *                       to TRUE, then Not finding the directory (or 
 *                       exceeding the buffer size) will raise
 *                       NO_DATA_FOUND
 * Returns:
 *  Path              -> Varchar2 
\*-------------------------------------------------------------------------*/

FUNCTION Get_Temp_Directory ( RaiseExceptions   IN  BOOLEAN DEFAULT FALSE)  RETURN VARCHAR2;

/*-------------------------------------------------------------------------*\
 * Get_Net_Connection  -> Expands an attached drive letter to it's 
 *                        full network address
 * Arguments: 
 *  DriveLetter        -> Letter of the Drive to expand e.g. 'F'
 *  RaiseExceptions    -> Set to TRUE or FALSE (default).  If this is set 
 *                        to TRUE, then Not finding the Drive (or 
 *                        exceeding the buffer size) will raise
 *                        NO_DATA_FOUND
 * Returns:
 *  Expanded Connection String ->  Varchar2 
\*-------------------------------------------------------------------------*/

FUNCTION Get_Net_Connection  (DriveLetter       IN  VARCHAR2,
                              RaiseExceptions   IN  BOOLEAN DEFAULT FALSE)  RETURN VARCHAR2;

/*-------------------------------------------------------------------------*\
 * Read_Registry    -> Read the value of a particular entry in the 
 *                     Win95/NT Registry
 *                     It wil read Registry Values Stored in the 
 *                     Following Formats
 *                        REG_EXPAND_SZ, REG_SZ, REG_DWORD
 *
 * Arguments: 
 *  RegPath         -> The Full path in the registry to the required
 *                     value e.g. HKEY_LOCAL_MACHINE\SOFTWARE\ORACLE
 *  RegEntry        -> Name of the entry to read e.g. ORACLE_PATH
 *  RaiseExceptions -> Set to TRUE or FALSE (default).  If this is set 
 *                     to TRUE, then failing to find the entry raises
 *                     NO_DATA_FOUND. obtaining an entry of a datatype
 *                     that is not a string or a number raises
 *                     VALUE_ERRROR.
 * Returns:
 *  Value           -> Both Number and String entries returned
 *                     as Varchar2.
 * NOTE:
 *  If you read a registry entry of type REG_EXPAND_SZ, this call will now 
 *  automatically attempt to expand any variables included in the string
 *  such as %path%.  If the total length of the expanded string exceeds 2000
 *  bytes then the unexpanded tring will be returned.
 *  To totally supress the expansion of such strings set the
 *  WIN_API.COMPAT_EXPAND_REG_VALUES flag to FALSE at runtime.
\*-------------------------------------------------------------------------*/

FUNCTION Read_Registry (RegPath         IN  VARCHAR2,
                        RegEntry        IN  VARCHAR2, 
                        RaiseExceptions IN  BOOLEAN DEFAULT FALSE)  RETURN VARCHAR2;
/*-------------------------------------------------------------------------*\
 * Write_Registry   -> Set the value of a particular entry in the 
 *                     Win95/NT Registry in REG_EXPAND_SZ format
 *                     NOTE: The Path to the entry must already Exist
 *
 * Arguments: 
 *  RegPath         -> The Full path in the registry to the required
 *                     value e.g. HKEY_LOCAL_MACHINE\SOFTWARE\ORACLE
 *  RegEntry        -> Name of the entry to set e.g. ORACLE_PATH
 *  RegValue        -> Value to set
 *  RaiseExceptions -> Set to TRUE or FALSE (default).  If this is set 
 *                     to TRUE, then failing to set  the entry raises
 *                     NO_DATA_FOUND. 
 * Returns:
 *  (NONE)
\*-------------------------------------------------------------------------*/

PROCEDURE Write_Registry(  RegPath         IN   VARCHAR2,
                           RegEntry        IN  VARCHAR2, 
                           RegValue        IN  VARCHAR2, 
                           RaiseExceptions IN  BOOLEAN DEFAULT FALSE);
        
/*-------------------------------------------------------------------------*\
 * Write_RegistryEx -> Set the value of a particular entry in the 
 *                     Win95/NT Registry Specifying the Format 
 *                     NOTE: The Path to the entry must already Exist
 *
 * Arguments: 
 *  RegPath         -> The Full path in the registry to the required
 *                     value e.g. HKEY_LOCAL_MACHINE\SOFTWARE\ORACLE
 *  RegEntry        -> Name of the entry to set e.g. ORACLE_PATH
 *  RegValue        -> Value to set
 *  RegFormat       -> Format for Setting Supported Values REG_SZ, REG_EXPAND_SZ,
 *                     REG_DWORD
 *  RaiseExceptions -> Set to TRUE or FALSE (default).  If this is set 
 *                     to TRUE, then failing to set  the entry raises
 *                     NO_DATA_FOUND. 
 * Returns:
 *  (NONE)
\*-------------------------------------------------------------------------*/

PROCEDURE Write_RegistryEx( RegPath         IN  VARCHAR2,
                            RegEntry        IN  VARCHAR2, 
                            RegValue        IN  VARCHAR2, 
                            RegFormat       IN  PLS_INTEGER,
                            RaiseExceptions IN  BOOLEAN DEFAULT FALSE);

/*-------------------------------------------------------------------------*\
 * Create_Registry_Key  -> Create a new subkey on the Registry
 *                         NOTE: If this key already exists this call will 
 *                         be harmless and Will Suceed.
 *
 * Arguments: 
 *  RegPath             -> The Full path in the registry to the required
 *                         value e.g. HKEY_LOCAL_MACHINE\SOFTWARE\D2KWUTIL
 *  RaiseExceptions     -> Set to TRUE or FALSE (default).  If this is set 
 *                         to TRUE, then failing to create key raises
 *                         NO_DATA_FOUND. 
 * Returns:
 *  (NONE)
\*-------------------------------------------------------------------------*/

PROCEDURE Create_Registry_Key(  RegPath          IN  VARCHAR2,
                                RaiseExceptions  IN  BOOLEAN DEFAULT FALSE);        
                                
/*-------------------------------------------------------------------------*\
 * Delete_Registry_Key  ->  Removes a subkey and all it's children from 
 *                          the Registry
 *        NOTE: **** THIS CALL IS VERY DANGEROUS - YOU COULD SERIOUSLY ****
 *              **** DAMAGE YOUR SYSTEM USING THIS FUNCTION            ****
 *              **** EXERCISE CAUTION                                  ****
 *
 * Arguments: 
 *  RegPath             -> The Full path in the registry to be deleted
 *                         value e.g. HKEY_LOCAL_MACHINE\SOFTWARE\D2KWUTIL
 *  RaiseExceptions     -> Set to TRUE or FALSE (default).  If this is set 
 *                         to TRUE, then failing to delete the entry raises
 *                         NO_DATA_FOUND. 
 * Returns:
 *  (NONE)
\*-------------------------------------------------------------------------*/

PROCEDURE Delete_Registry_Key(  RegPath          IN  VARCHAR2,
                                RaiseExceptions  IN  BOOLEAN DEFAULT FALSE);        

                                
/*-------------------------------------------------------------------------*\
 * Get_Working_Directory -> Obtains the path of the current directory
 * Arguments: 
 *  RaiseExceptions      -> Set to TRUE or FALSE (default).  If this is set 
 *                          to TRUE, then Not finding the directory (or 
 *                          exceeding the buffer size) will raise
 *                          NO_DATA_FOUND
 * Returns:
 *  Path                 -> Varchar2 
\*-------------------------------------------------------------------------*/

FUNCTION Get_Working_Directory ( RaiseExceptions   IN  BOOLEAN DEFAULT FALSE)  RETURN VARCHAR2;
        
/*-------------------------------------------------------------------------*\
 * Set_Working_Directory -> Changes the path of the current directory
 * Arguments: 
 *  WorkingDirectory     -> VARCHAR2
 *  RaiseExceptions      -> Set to TRUE or FALSE (default).  If this is set 
 *                          to TRUE, then Not finding the directory (or 
 *                          exceeding the buffer size) will raise
 *                          NO_DATA_FOUND
 *
 * Returns:
 *  (None)
\*-------------------------------------------------------------------------*/

PROCEDURE Set_Working_Directory (WorkingDirectory in VARCHAR2, RaiseExceptions   IN  BOOLEAN DEFAULT FALSE);

/*-------------------------------------------------------------------------*\
 * Get_Computer_name -> Obtains the name of the running PC
 * Arguments: 
 *  RaiseExceptions  ->  Set to TRUE or FALSE (default).  If this is set 
 *                       to TRUE, then Not finding the name (or 
 *                       exceeding the buffer size) will raise
 *                       NO_DATA_FOUND
 * Returns:
 *  Computer name ->     Varchar2 
\*-------------------------------------------------------------------------*/

FUNCTION Get_Computer_Name ( RaiseExceptions   IN  BOOLEAN DEFAULT FALSE)  RETURN VARCHAR2;


/*-------------------------------------------------------------------------*\
 * Get_Default_Printer -> Obtains the name and port of the current default
 *                        Printer
 * Arguments: 
 *  Printer            -> A varchar2 variable of 512 chars long to accept the 
 *                        name of the Printer.
 *  Port               -> A varchar2 variable of 512 chars long to accept the 
 *                        name of the Port the printer is on. 
 *  RaiseExceptions    -> Set to TRUE or FALSE (default).  If this is set 
 *                        to TRUE, then Not finding the name (or 
 *                        exceeding the buffer size) will raise
 *                        NO_DATA_FOUND
 * Returns:
 *                        None
\*-------------------------------------------------------------------------*/
PROCEDURE Get_Default_Printer ( PrinterName     OUT  VARCHAR2,
                                Port            OUT  VARCHAR2,
                                RaiseExceptions IN   BOOLEAN DEFAULT FALSE);                             

END WIN_API_ENVIRONMENT_PDF;


PACKAGE BODY WIN_API_ENVIRONMENT_PDF is

-- Constants for maintaining the Function Handle Array
-- These should be unique through the Whole Library
-- Environment has indexes in the range 300 - 399
iReadINIFile          CONSTANT  PLS_INTEGER  := 300;
iWriteINIFile         CONSTANT  PLS_INTEGER  := 301;
iGetRegKey            CONSTANT  PLS_INTEGER  := 302;
iSetRegKey            CONSTANT  PLS_INTEGER  := 303;
iGetWinuser           CONSTANT  PLS_INTEGER  := 304;
iGetDOSEnv            CONSTANT  PLS_INTEGER  := 305;
iWinDir               CONSTANT  PLS_INTEGER  := 306;
iTmpDir               CONSTANT  PLS_INTEGER  := 307;
iWNetGetConnection    CONSTANT  PLS_INTEGER  := 308;
iGetWorkingDirectory  CONSTANT  PLS_INTEGER  := 309;
iSetWorkingDirectory  CONSTANT  PLS_INTEGER  := 310;
iGetComputerName      CONSTANT  PLS_INTEGER  := 311;
iGetWindowsVersion    CONSTANT  PLS_INTEGER  := 312;
iMaintRegKey          CONSTANT  PLS_INTEGER  := 313;

-- Private Program unit headers  
PROCEDURE Wrap_Write_Registry( CalledBy        IN  VARCHAR2,
                               RegPath         IN  VARCHAR2,
                               RegEntry        IN  VARCHAR2, 
                               RegValue        IN  VARCHAR2,                               
                               RegFormat       IN  PLS_INTEGER,                                
                               RaiseExceptions IN  BOOLEAN DEFAULT FALSE);

PROCEDURE Wrap_Maint_Registry( CalledBy        IN  VARCHAR2,
                               RegPath         IN  VARCHAR2,
                               Opt             IN  PLS_INTEGER,                                
                               RaiseExceptions IN  BOOLEAN DEFAULT FALSE);

FUNCTION d2kwutil_ReadINIFile ( hFunc          IN      ORA_FFI.funcHandleType,
                                FileName       IN OUT  VARCHAR2,
                                Section        IN OUT  VARCHAR2,
                                Entry          IN OUT  VARCHAR2,
                                Buffer         IN OUT  VARCHAR2,
                                DefaultVal     IN OUT  VARCHAR2,
                                InBuffLen      IN      PLS_INTEGER) return PLS_INTEGER;

FUNCTION d2kwutil_WriteINIFile( hFunc          IN      ORA_FFI.funcHandleType,
                                FileName       IN OUT  VARCHAR2,
                                Section        IN OUT  VARCHAR2,
                                Entry          IN OUT  VARCHAR2,
                                Buffer         IN OUT  VARCHAR2
                                ) return PLS_INTEGER;

FUNCTION d2kwutil_GetWinuser (  hFunc          IN      ORA_FFI.funcHandleType,
                                UserName       IN OUT  VARCHAR2,
                                InBuffLen      IN      PLS_INTEGER
                                ) RETURN PLS_INTEGER;

FUNCTION d2kwutil_GetDOSEnv (   hFunc          IN      ORA_FFI.funcHandleType,
                                SourceStr      IN OUT  VARCHAR2,
                                ExpandStr      IN OUT  VARCHAR2,
                                InBuffLen      IN      PLS_INTEGER
                                ) RETURN PLS_INTEGER;

FUNCTION d2kwutil_WinDir (      hFunc          IN      ORA_FFI.funcHandleType,
                                WindowsDir     IN OUT  VARCHAR2,
                                InBuffLen      IN      PLS_INTEGER
                                ) RETURN PLS_INTEGER;
                        
FUNCTION d2kwutil_TmpDir (      hFunc          IN      ORA_FFI.funcHandleType,
                                TempDir        IN OUT  VARCHAR2,
                                InBuffLen      IN      PLS_INTEGER
                                ) RETURN PLS_INTEGER;

FUNCTION d2kwutil_WNetGetConnection (hFunc     IN      ORA_FFI.funcHandleType,
                                DriveLetter    IN OUT  VARCHAR2,
                                Buffer         IN OUT  VARCHAR2,
                                OutBuffLen     IN OUT  PLS_INTEGER
                                ) return PLS_INTEGER;

FUNCTION d2kwutil_GetRegKey (    hFunc         IN      ORA_FFI.funcHandleType,
                                RegRoot        IN      PLS_INTEGER,
                                RegPath        IN OUT  VARCHAR2,
                                RegEntry       IN OUT  VARCHAR2,
                                RegValue       IN OUT  VARCHAR2,
                                RegValueLength IN      PLS_INTEGER,
                                RegDontExpand	 IN      PLS_INTEGER
                                ) return PLS_INTEGER;

FUNCTION d2kwutil_SetRegKey (    hFunc         IN      ORA_FFI.funcHandleType,
                                RegRoot        IN      PLS_INTEGER,
                                RegPath        IN OUT  VARCHAR2,
                                RegEntry       IN OUT  VARCHAR2,
                                RegEntryType   IN      PLS_INTEGER,
                                RegValue       IN OUT  VARCHAR2,
                                RegValueDword  IN      PLS_INTEGER,
                                RegNullInd		 IN      PLS_INTEGER 
                                ) return PLS_INTEGER;
FUNCTION d2kwutil_GetWorkingDirectory ( hFunc            IN      ORA_FFI.funcHandleType,
                                        WorkingDir       IN OUT  VARCHAR2,
                                        InBuffLen        IN      PLS_INTEGER
                                ) RETURN PLS_INTEGER;

FUNCTION d2kwutil_SetWorkingDirectory ( hFunc            IN      ORA_FFI.funcHandleType,
                                        WorkingDirect    IN OUT  VARCHAR2
                                ) RETURN PLS_INTEGER;

FUNCTION d2kwutil_GetComputerName (     hFunc            IN      ORA_FFI.funcHandleType,
                                        ComputerName     IN OUT  VARCHAR2,
                                        InBuffLen        IN OUT  PLS_INTEGER
                                ) RETURN PLS_INTEGER;
                                
FUNCTION d2kwutil_GetWindowsVersion (hFunc               IN      ORA_FFI.funcHandleType,
                                     BuildInfo           IN OUT  VARCHAR2,
                                     BuildLoWord         IN OUT  VARCHAR2
                                ) RETURN PLS_INTEGER;                                
FUNCTION d2kwutil_MaintRegKey     ( hFunc                IN      ORA_FFI.funcHandleType,
                                    RegRoot              IN      PLS_INTEGER,
                                    RegPath              IN OUT  VARCHAR2,
                                    opt                  IN      PLS_INTEGER
                                ) RETURN PLS_INTEGER;                                
                                
                                
                                
 -- Pragmas
 PRAGMA INTERFACE(C,d2kwutil_ReadINIFile,11265);
 PRAGMA INTERFACE(C,d2kwutil_WriteINIFile,11265);
 PRAGMA INTERFACE(C,d2kwutil_GetWinuser,11265);
 PRAGMA INTERFACE(C,d2kwutil_GetDOSEnv,11265);
 PRAGMA INTERFACE(C,d2kwutil_WinDir,11265);
 PRAGMA INTERFACE(C,d2kwutil_TmpDir,11265);
 PRAGMA INTERFACE(C,d2kwutil_WNetGetConnection,11265);
 PRAGMA INTERFACE(C,d2kwutil_GetRegKey,11265);
 PRAGMA INTERFACE(C,d2kwutil_SetRegKey,11265);
 PRAGMA INTERFACE(C,d2kwutil_GetWorkingDirectory,11265);
 PRAGMA INTERFACE(C,d2kwutil_SetWorkingDirectory,11265);
 PRAGMA INTERFACE(C,d2kwutil_GetComputerName,11265);
 PRAGMA INTERFACE(C,d2kwutil_GetWindowsVersion,11265);
 PRAGMA INTERFACE(C,d2kwutil_MaintRegKey,11265);

   -- Public Bodies 
FUNCTION Read_INI_File (  FileName        IN  VARCHAR2,
                          Section         IN  VARCHAR2,
                          Entry           IN  VARCHAR2,
                          RaiseExceptions IN  BOOLEAN DEFAULT FALSE) return VARCHAR2 is
  DEFAULT_PLACEHOLDER  constant varchar2(16):= 'D2KWUTIL_EMPTY';
  vcBuff1    VARCHAR2(512);
  vcBuff2    VARCHAR2(512);
  vcBuff3    VARCHAR2(512);
  vcBuff4    VARCHAR2(512);
  vcBuff5    VARCHAR2(512);
  iRC        PLS_INTEGER;

begin 
  Win_API_Debug_PDF.DebugLog(99,'Read_INI_File','Args: FileName="'||Filename||'", Section="'||Section||'", Entry="'||Entry||'", RaiseExceptions='||Win_API_Debug_PDF.booltochar(RaiseExceptions));
  Win_API_PDF.Clean_Error_Stack;
  iRC  := 0;
  if Win_API_PDF.API_ENABLED then 
      Win_API_PDF.Register_function_call(iReadINIFile,'d2kwutil_ReadINIFile','INT','*CHAR,*CHAR,*CHAR,*CHAR,*CHAR,INT');
      vcBuff1    := FileName;
      vcBuff2    := Section;
      vcBuff3    := Entry;
      vcBuff4   := RPAD(' ',512,CHR(0));
      vcBuff5    := DEFAULT_PLACEHOLDER;
      iRC   := d2kwutil_ReadINIFile(Win_API_PDF.FunctionHandle(iReadINIFile),vcBuff1,vcBuff2,vcBuff3,vcBuff4,vcBuff5,512);
      Win_API_Debug_PDF.DebugLog(99,'Read_INI_File','Result:  RC='||to_char(iRC)||', vcBuff4="'||vcBuff4||'"');	  	 
  else 
    raise Win_API_PDF.NOT_AVAILABLE;
  end if;  
  if iRC = 0 or vcBuff4 = DEFAULT_PLACEHOLDER then 
    Win_API_PDF.Add_error('Read_INI_File','Unable to obtain '||Entry||' from the ['||Section||'] section of '||FileName);
    if not RaiseExceptions then
      return NULL;
    else 
      raise NO_DATA_FOUND;
    end if;
  else
    return vcBuff4;
  end if;
exception
  when NO_DATA_FOUND then 
    raise;
  when Win_API_PDF.NOT_AVAILABLE then
    Win_API_PDF.Add_error('Read_INI_File',Win_API_PDF.NoAPI);
    raise;
  when others then 
    Win_API_PDF.Add_error('Read_INI_File',Win_API_PDF.UError||Win_API_PDF.Add_External_errors); 
    raise;
end Read_INI_File;

PROCEDURE Write_INI_File (  FileName        IN  VARCHAR2,
                            Section         IN  VARCHAR2,
                            Entry           IN  VARCHAR2,
                            Value           IN  VARCHAR2,
                            RaiseExceptions IN  BOOLEAN DEFAULT FALSE) is
  vcBuff1    VARCHAR2(512);
  vcBuff2    VARCHAR2(512);
  vcBuff3    VARCHAR2(512);
  vcBuff4    VARCHAR2(512);
  iRC        PLS_INTEGER;
begin
  Win_API_Debug_PDF.DebugLog(99,'Write_INI_File','Args: FileName="'||Filename||'", Section="'||Section||'", Entry="'||Entry||'", Value="'||Value||'", RaiseExceptions='||Win_API_Debug_PDF.booltochar(RaiseExceptions));	 
  Win_API_PDF.Clean_Error_Stack;
  iRC  := 0;
  if Win_API_PDF.API_ENABLED then 
    Win_API_PDF.Register_function_call(iWriteINIFile,'d2kwutil_WriteINIFile','INT','*CHAR,*CHAR,*CHAR,*CHAR');
    vcBuff1    := FileName;
    vcBuff2    := Section;
    vcBuff3    := Entry;
    vcBuff4   := Value;
    iRC   := d2kwutil_WriteINIFile(Win_API_PDF.FunctionHandle(iWriteINIFile),vcBuff1,vcBuff2,vcBuff3,vcBuff4);
    Win_API_Debug_PDF.DebugLog(99,'Write_INI_File','Result:  RC='||to_char(iRC));	  
  else 
    raise Win_API_PDF.NOT_AVAILABLE;
  end if;  
  if iRC = 0  then
    Win_API_PDF.Add_error('Write_INI_File','Unable to set the value of '||Entry||' in the ['||Section||'] section of '||FileName); 
    if RaiseExceptions then
      raise NO_DATA_FOUND;
    end if;
  end if;
exception
  when NO_DATA_FOUND then 
    raise;
  when Win_API_PDF.NOT_AVAILABLE then
    Win_API_PDF.Add_error('Write_INI_File',Win_API_PDF.NoAPI);
    raise;
  when others then 
    Win_API_PDF.Add_error('Write_INI_File',Win_API_PDF.UError||Win_API_PDF.Add_External_errors); 
    raise;
end Write_INI_File;

FUNCTION Get_Windows_Username (RaiseExceptions IN  BOOLEAN DEFAULT FALSE)  RETURN VARCHAR2 is
  vcBuff1    VARCHAR2(512);
  iRC        PLS_INTEGER;
begin 
  Win_API_Debug_PDF.DebugLog(99,'Get_Windows_Username','Args: RaiseExceptions='||Win_API_Debug_PDF.booltochar(RaiseExceptions));	 
  Win_API_PDF.Clean_Error_Stack;
  iRC  := 0;
  if Win_API_PDF.API_ENABLED then 
    Win_API_PDF.Register_function_call(iGetWinuser,'d2kwutil_GetWinuser','INT','*CHAR,INT');
    vcBuff1    := RPAD(' ',512,CHR(0));
    iRC   := d2kwutil_GetWinuser(Win_API_PDF.FunctionHandle(iGetWinuser),vcBuff1,512);
    Win_API_Debug_PDF.DebugLog(99,'Get_Windows_Username','Result:  RC='||to_char(iRC)||', vcBuff1="'||vcBuff1||'"');	  
  else
    raise Win_API_PDF.NOT_AVAILABLE;
  end if;  
  if iRC = 0 then 
    Win_API_PDF.Add_error('Get_Windows_Username', 'No Value Returned');
    if RaiseExceptions then
      raise NO_DATA_FOUND;
    else
      return vcBuff1;
    end if;
  else
    return vcBuff1;
  end if;
exception
  when NO_DATA_FOUND then 
    raise;
  when Win_API_PDF.NOT_AVAILABLE then
    Win_API_PDF.Add_error('Get_Windows_Username',Win_API_PDF.NoAPI);
    raise;
  when others then 
    Win_API_PDF.Add_error('Get_Windows_Username',Win_API_PDF.UError||Win_API_PDF.Add_External_errors); 
    raise;
end Get_Windows_Username;


FUNCTION Get_Windows_Directory (RaiseExceptions IN  BOOLEAN DEFAULT FALSE)  RETURN VARCHAR2 is
  vcBuff1    VARCHAR2(512);
  iRC        PLS_INTEGER;
begin 
  Win_API_Debug_PDF.DebugLog(99,'Get_Windows_Directory','Args: RaiseExceptions='||Win_API_Debug_PDF.booltochar(RaiseExceptions));	 	
  Win_API_PDF.Clean_Error_Stack;
  iRC  := 0;
  if Win_API_PDF.API_ENABLED then 
    Win_API_PDF.Register_function_call(iWinDir,'d2kwutil_WinDir','INT','*CHAR,INT');

    vcBuff1    := RPAD(' ',512,CHR(0));
    iRC   := d2kwutil_WinDir(Win_API_PDF.FunctionHandle(iWinDir),vcBuff1,512);
    Win_API_Debug_PDF.DebugLog(99,'Get_Windows_Directory','Result:  RC='||to_char(iRC)||', vcBuff1="'||vcBuff1||'"');	      
  else
    raise Win_API_PDF.NOT_AVAILABLE;
  end if;  
  if iRC = 0 then 
    Win_API_PDF.Add_error('Get_Windows_Directory','No Value Returned');
    if RaiseExceptions then
      raise NO_DATA_FOUND;
    else
      return NULL;
    end if;
  else
    return Win_API_PDF.StripDirSep(vcBuff1);
  end if;
exception
  when NO_DATA_FOUND then 
    raise;
  when Win_API_PDF.NOT_AVAILABLE then
    Win_API_PDF.Add_error('Get_Windows_Directory',Win_API_PDF.NoAPI);
    raise;
  when others then 
    Win_API_PDF.Add_error('Get_Windows_Directory',Win_API_PDF.UError||Win_API_PDF.Add_External_errors); 
    raise;
end Get_Windows_Directory;



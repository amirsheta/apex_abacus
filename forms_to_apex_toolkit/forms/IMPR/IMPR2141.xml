    <function name="get_port_name" templateSection="main">
      <textSource>
      <![CDATA[FUNCTION GET_PORT_NAME RETURN char IS
	V_PORT_NAME		VARCHAR2(100);
BEGIN
	TOOL_ENV.GETVAR('PORT_NAME',V_PORT_NAME);
	RETURN V_PORT_NAME;
END;
]]>
      </textSource>
    </function>
    <function name="v_port_cdformula" returnType="character">
      <textSource>
      <![CDATA[function V_PORT_CDFormula return Char is
V_NAME VARCHAR2(100);
begin
  SELECT PORT_NAME
  INTO   V_NAME
  FROM   SD_PORTS
  WHERE  PORT_CD = :P_CURR_PORT_CD ;
--  WHERE  PORT_CD = :RQST_PORT_CD ;
  RETURN (V_NAME);
EXCEPTION 
	WHEN NO_DATA_FOUND THEN
	RETURN(NULL);
end;]]>
      </textSource>
    </function>
    <function name="v_nameformula" returnType="character">
      <textSource>
      <![CDATA[function V_NAMEFormula return Char is
begin
  IF :START_DT IS NULL THEN
  	RETURN(' طلب إجراء تحليل عينات ');
  ELSE
  	RETURN(' طلب إجراء تحليل عينات خلال الفترة من '||TO_CHAR(:START_DT,'MI-MM-YYYY')||' إلى '||TO_CHAR(:END_DT,'MI-MM-YYYY'));
  END IF ;
  
end;]]>
      </textSource>
    </function>
    <function name="v_port_name_sec1formattrigger">
      <textSource>
      <![CDATA[
function V_PORT_NAME_SEC1FormatTrigger return boolean is
V_NAME VARCHAR2(100);
BEGIN
	IF :P_CURR_PORT_CD = 99 THEN
	RETURN(TRUE);
	ELSE
		
  SELECT PORT_NAME
  INTO   V_NAME
  FROM   SD_PORTS
  WHERE  PORT_CD = :P_CURR_PORT_CD ;
  SRW.SET_FIELD_CHAR(0,V_NAME);	
 	RETURN(TRUE);
 END IF;
EXCEPTION 
	WHEN NO_DATA_FOUND THEN

	RETURN(TRUE);
	
	
	RETURN(TRUE);
END;]]>
      </textSource>
    </function>
    <function name="cf_port_mangerformula" returnType="character">
      <textSource>
      <![CDATA[function CF_PORT_MANGERFormula return Char is
V_MNGR_NAME VARCHAR2(200);
begin
  SELECT VAR_VALUE
  INTO   V_MNGR_NAME
  FROM   SC_PORT_SETTING
  WHERE  SYSOBJ_ID = 999
    AND  VAR_NAME  = 'PORT_MANAGER_NAME'
    AND PORT_CD = :P_CURR_PORT_CD ;
  RETURN (V_MNGR_NAME);
EXCEPTION 
	WHEN NO_DATA_FOUND THEN
	RETURN(NULL);
end;]]>
      </textSource>
    </function>

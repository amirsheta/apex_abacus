	   		fh_SR := ora_ffi.register_function(Win_API.DLL_HANDLE,'d2kwutil_bwShiftR',ora_ffi.PASCAL_STD);
     			ora_ffi.register_parameter(fh_SR,ORA_FFI.C_INT);

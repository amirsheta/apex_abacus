			)  RETURN PLS_INTEGER IS
	RC                   		PLS_INTEGER;
	l_AMOUNT                      	VARCHAR2(256)	:= RPAD(SUBSTR(NVL(AMOUNT,' '),1,256),256,CHR(0));
	l_DOCUMENTTYPE                	VARCHAR2(256)	:= RPAD(SUBSTR(NVL(DOCUMENTTYPE,' '),1,256),256,CHR(0));
	l_DOCUMENTNUMBER              	VARCHAR2(256)	:= RPAD(SUBSTR(NVL(DOCUMENTNUMBER,' '),1,256),256,CHR(0));
	l_HIJRADATE                   	VARCHAR2(256)	:= RPAD(SUBSTR(NVL(HIJRADATE,' '),1,256),256,CHR(0));
	l_GREGDATE                    	VARCHAR2(256)	:= RPAD(SUBSTR(NVL(GREGDATE,' '),1,256),256,CHR(0));
   BEGIN

	rc := i_StartTrans(
			fh_StartTrans,
			l_AMOUNT,
			l_DOCUMENTTYPE,
			l_DOCUMENTNUMBER,
			l_HIJRADATE,
			l_GREGDATE);
	AMOUNT                        	:= l_AMOUNT;
	DOCUMENTTYPE                  	:= l_DOCUMENTTYPE;
	DOCUMENTNUMBER                	:= l_DOCUMENTNUMBER;
	HIJRADATE                     	:= l_HIJRADATE;
	GREGDATE                      	:= l_GREGDATE;
   RETURN RC;
   END StartTrans;


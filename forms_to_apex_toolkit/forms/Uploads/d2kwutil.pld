	   	-- Register the interface to the function
	   		fh_XOR := ora_ffi.register_function(Win_API.DLL_HANDLE,'d2kwutil_bwXOR',ora_ffi.PASCAL_STD);
     			ora_ffi.register_parameter(fh_XOR,ORA_FFI.C_INT);

      <ProgramUnit Name="ADJUST_WIDTH" ProgramUnitText="PROCEDURE Adjust_Width IS&amp;#10;&#x9;Shift number;&amp;#10;&#x9;ret number;&amp;#10;&#x9;ENTER_POS number;&amp;#10;&#x9;EXECUTE_POS number;&amp;#10;&#x9;OK_POS number;&amp;#10;&#x9;CANCEL_POS number;&amp;#10;&amp;#10;BEGIN&amp;#10;&#x9;if :PARAMETER.WINDOW_WIDTH &lt; 4 then&amp;#10;&#x9;&#x9;ret := str.DispAlert('عرض القائمة أقل من الحد المسموح به','INFORMATION');&amp;#10;&#x9;elsif :PARAMETER.WINDOW_WIDTH > 8.2 then&amp;#10;&#x9;&#x9;ret := str.DispAlert('عرض القائمة أكبر من الحد المسموح به','INFORMATION');&amp;#10;&#x9;else&amp;#10;&#x9;  Shift := 1.75 - ((:PARAMETER.WINDOW_WIDTH - 4)/2);&amp;#10;&#x9;  ENTER_POS  := Get_Item_Property('PB_ENTER', X_POS);&amp;#10;&#x9;  EXECUTE_POS :=  Get_Item_Property('PB_EXECUTE', X_POS);&amp;#10; &#x9;  CANCEL_POS:= Get_Item_Property('PB_CANCEL', X_POS);&amp;#10; &#x9;  OK_POS  := Get_Item_Property('PB_OK', X_POS);&amp;#10;&amp;#10;&#x9;  Set_Item_Property('PB_ENTER', X_POS, ENTER_POS-Shift);&amp;#10;&#x9;  Set_Item_Property('PB_EXECUTE', X_POS, EXECUTE_POS-Shift);&amp;#10; &#x9;  Set_Item_Property('PB_CANCEL', X_POS, CANCEL_POS-Shift);&amp;#10; &#x9;  Set_Item_Property('PB_OK', X_POS, OK_POS-Shift);&amp;#10;&amp;#10;&#x9;  Set_Window_Property('CGSO$WINDOW_1', WIDTH, :PARAMETER.WINDOW_WIDTH);&amp;#10;&#x9;  Set_Canvas_Property('CG$PAGE_1', WIDTH, :PARAMETER.WINDOW_WIDTH);&amp;#10;&#x9;end if;&amp;#10;END;" ProgramUnitType="Procedure"/>
      <ProgramUnit Name="ADJUST_HEIGHT" ProgramUnitText="PROCEDURE Adjust_Height IS&amp;#10;&#x9;V_HEIGHT number;&amp;#10;&#x9;SHIFT  number;&amp;#10;&#x9;RET NUMBER;&amp;#10;&amp;#10;BEGIN&amp;#10;&#x9;IF :PARAMETER.ROW_COUNT &lt;= 12 THEN&amp;#10; &#x9;  V_HEIGHT := Get_Window_Property('CGSO$WINDOW_1', HEIGHT);&amp;#10; &#x9;  SHIFT := (12 - :PARAMETER.ROW_COUNT) * 0.25;&amp;#10; &#x9;  V_HEIGHT := V_HEIGHT - SHIFT;&amp;#10;&amp;#10; &#x9;  :PARAMETER.BUTTON_Y_POS := :PARAMETER.BUTTON_Y_POS - SHIFT;&amp;#10;&amp;#10;&#x9;  Set_Window_Property('CGSO$WINDOW_1', HEIGHT, V_HEIGHT);&amp;#10;&#x9;  Set_Canvas_Property('CG$PAGE_1', HEIGHT, V_HEIGHT);&amp;#10;&#x9;ELSIF :PARAMETER.ROW_COUNT > 12 AND :PARAMETER.TARIFF_LOV = 0 then&amp;#10;&#x9;&#x9;ret := str.DispAlert('لا يمكن عرض أكثر من 12 صف من البيانات','INFORMATION');&amp;#10;&#x9;ELSE&amp;#10; &#x9;  V_HEIGHT := Get_Window_Property('CGSO$WINDOW_1', HEIGHT);&amp;#10; &#x9;  SHIFT := (:PARAMETER.ROW_COUNT - 12) * 0.25;&amp;#10; &#x9;  V_HEIGHT := V_HEIGHT + SHIFT;&amp;#10;&amp;#10; &#x9;  :PARAMETER.BUTTON_Y_POS := :PARAMETER.BUTTON_Y_POS + SHIFT;&amp;#10;&amp;#10;&#x9;  Set_Window_Property('CGSO$WINDOW_1', HEIGHT, V_HEIGHT);&amp;#10;&#x9;  Set_Canvas_Property('CG$PAGE_1', HEIGHT, V_HEIGHT);&amp;#10;&amp;#10;&#x9;END IF;&amp;#10;END;" ProgramUnitType="Procedure"/>
      <ProgramUnit Name="CG$WHEN_NEW_FORM_INSTANCE" ProgramUnitText="/* CG$WHEN_NEW_FORM_INSTANCE */&amp;#10;PROCEDURE CG$WHEN_NEW_FORM_INSTANCE IS&amp;#10;BEGIN&amp;#10;/* CGDV$POPULATE_DYNAMIC_LISTS */&amp;#10;/* Read the values for dynamic lists from the CG_REF_CODES table */&amp;#10;BEGIN&amp;#10;  CGDV$POPULATE_DYNAMIC_LISTS;&amp;#10;EXCEPTION&amp;#10;  WHEN OTHERS THEN&amp;#10;    CGTE$OTHER_EXCEPTIONS;&amp;#10;END;&amp;#10;END;" ProgramUnitType="Procedure"/>
      <ProgramUnit Name="CGDV$POPULATE_DYNAMIC_LISTS" ProgramUnitText="/* CGDV$POPULATE_DYNAMIC_LISTS */&amp;#10;PROCEDURE CGDV$POPULATE_DYNAMIC_LISTS IS&amp;#10;/* Read each lists values from its record group and populate the list */&amp;#10;  temp NUMBER;  /* Return value of populate_group call */&amp;#10;  rg_id RECORDGROUP;  /* Return value of populate_group call */&amp;#10;BEGIN&amp;#10;  rg_id := create_group_from_query('CGDV$DLRG',&amp;#10;    'SELECT RV_MEANING, RV_LOW_VALUE '||&amp;#10;    'FROM   CG_REF_CODES '||&amp;#10;    'WHERE  RV_DOMAIN = ''CAR_MODEL'' '||&amp;#10;    'ORDER BY  2');&amp;#10;  temp := populate_group(rg_id);&amp;#10;  populate_list('DCLTN_ITEMS.CARS_MODEL', rg_id);&amp;#10;  delete_group(rg_id);&amp;#10;&amp;#10;END;" ProgramUnitType="Procedure"/>
      <ProgramUnit Name="CGTE$CHECK_CONSTRAINT_VIO" ProgramUnitText="/* CGTE$CHECK_CONSTRAINT_VIO */&amp;#10;FUNCTION CGTE$CHECK_CONSTRAINT_VIO(&amp;#10;   P_SERVER_ERR IN NUMBER        /* Server error message */&amp;#10;  ,P_SERVER_MSG IN VARCHAR2)     /* Server error number  */&amp;#10;RETURN BOOLEAN IS&amp;#10;/* Check and report Primary/Unique Key, Check Constraint and User */&amp;#10;/* Defined Constraint violations                                  */&amp;#10;  constraint_name VARCHAR2(61);  /* Violated constraint */&amp;#10;BEGIN&amp;#10;  /* Check if the error code is one we are interested in */&amp;#10;  IF ( NOT (P_SERVER_ERR IN  (1, 2290) OR&amp;#10;           (P_SERVER_ERR >= 20000 AND P_SERVER_ERR &lt;= 20999) ) )&amp;#10;  THEN&amp;#10;    RETURN( FALSE );&amp;#10;  END IF;&amp;#10;&amp;#10;  /* Deal with user defined errors */&amp;#10;  IF (P_SERVER_ERR >= 20000 AND P_SERVER_ERR &lt;= 20999) THEN&amp;#10;    Des$FORM_ERRORS.PUSH(''||CGTE$STRIP_FIRST_ERROR(P_SERVER_MSG), 'E', 'OFG', 0);&amp;#10;    RETURN( TRUE );&amp;#10;  END IF;&amp;#10;&amp;#10;  /* Deal with Primary/Unique Key and Check Constraint violations */&amp;#10;  constraint_name := CGTE$STRIP_CONSTRAINT(P_SERVER_MSG);&amp;#10;  IF (P_SERVER_ERR = 1) THEN&amp;#10;    Des$FORM_ERRORS.PUSH(P_SERVER_MSG, 'I', 'OFG', 0);&amp;#10;  ELSIF (P_SERVER_ERR = 2290) THEN&amp;#10;    IF (constraint_name = 'MIN_EXMTD_QTY') THEN&amp;#10;      Des$FORM_ERRORS.PUSH('خطأ في بيانات الإعفاء للصنف  - الكمية لايمكن أن تكون أقل من الصفر', 'E', 'OFG', 0);&amp;#10;      Des$FORM_ERRORS.RAISE_FAILURE;&amp;#10;    ELSIF (constraint_name = 'MIN_EXMTD_DUTY') THEN&amp;#10;      Des$FORM_ERRORS.PUSH('خطأ في بيانات الإعفاء للصنف  - الرسوم لايمكن أن تكون أقل من الصفر', 'E', 'OFG', 0);&amp;#10;      Des$FORM_ERRORS.RAISE_FAILURE;&amp;#10;    ELSIF (constraint_name = 'MIN_EXMTD_CIF') THEN&amp;#10;      Des$FORM_ERRORS.PUSH('خطأ في بيانات الإعفاء للصنف - القيمة لايمكن أن تكون أقل من الصفر', 'E', 'OFG', 0);&amp;#10;      Des$FORM_ERRORS.RAISE_FAILURE;&amp;#10;    ELSE&amp;#10;      Des$FORM_ERRORS.PUSH(P_SERVER_MSG, 'I', 'OFG', 0);&amp;#10;    END IF;&amp;#10;  END IF;&amp;#10;  RETURN( TRUE );&amp;#10;END;" ProgramUnitType="Function"/>
      <ProgramUnit Name="EXEC_FUNS" ProgramUnitText="PROCEDURE EXEC_FUNS(CD VARCHAR2) IS&amp;#10;BEGIN&amp;#10;NULL;&amp;#10;END;" ProgramUnitType="Procedure"/>
      <ProgramUnit Name="COPY_SELECTED_VALUES" ProgramUnitText="PROCEDURE COPY_SELECTED_VALUES IS&amp;#10;MSG_LVL&#x9;VARCHAR2(5);&amp;#10;MSG_TXT VARCHAR2(200);&amp;#10;BEGIN&amp;#10;NULL;&amp;#10;/*&amp;#10;&#x9;MSG_LVL := :SYSTEM.MESSAGE_LEVEL;&amp;#10;&#x9;:SYSTEM.MESSAGE_LEVEL := '25';&amp;#10;      GO_BLOCK('DCLTN_ITEMS');&amp;#10;&#x9;FIRST_RECORD;&amp;#10;      LOOP&amp;#10;IF :CON_ITEM = 1 THEN&amp;#10;      UPDATE dcltn_item_confirms SET ACTION_TYPE=1,action_dt = HIJDATE_DB.Cur_Hij_Date,&amp;#10;             action_user_id = :PARAMETER.P_USER_ID WHERE&amp;#10;      port_cd = :PORT_CD&amp;#10;         AND item_isn = :ITEM_ISN&amp;#10;         AND dic_seq = (SELECT MAX (dic_seq)&amp;#10;                          FROM dcltn_item_confirms&amp;#10;                         WHERE port_cd = :PORT_CD AND item_isn = :ITEM_ISN);&amp;#10;&#x9;IF NOT ACTIVITY.ADD_ACTIVITY(21, 3, 27, :DCLTN_ITEMS.PORT_CD||'!'||:DCLTN_ITEMS.ITEM_ISN)&#x9;THEN&amp;#10;&#x9;&#x9;&#x9;&#x9;RAISE FORM_TRIGGER_FAILURE;&amp;#10;&#x9;END IF;&amp;#10;&amp;#10;ELSE&amp;#10;&#x9;UPDATE dcltn_item_confirms SET ACTION_TYPE=NULL,action_dt = NULL,&amp;#10;             action_user_id = NULL WHERE&amp;#10;      port_cd = :PORT_CD&amp;#10;         AND item_isn = :ITEM_ISN&amp;#10;         AND dic_seq = (SELECT MAX (dic_seq)&amp;#10;                          FROM dcltn_item_confirms&amp;#10;                         WHERE port_cd = :PORT_CD AND item_isn = :ITEM_ISN);&amp;#10;&#x9;IF NOT ACTIVITY.ADD_ACTIVITY(21, 3, 28, :DCLTN_ITEMS.PORT_CD||'!'||:DCLTN_ITEMS.ITEM_ISN)&#x9;THEN&amp;#10;&#x9;&#x9;&#x9;&#x9;RAISE FORM_TRIGGER_FAILURE;&amp;#10;&#x9;END IF;&amp;#10;END IF;&amp;#10;      IF :SYSTEM.LAST_RECORD = 'TRUE' THEN&amp;#10;&#x9;&#x9;EXIT;&amp;#10;&#x9;END IF;&amp;#10;&#x9;NEXT_RECORD;&amp;#10;      END LOOP;&amp;#10;&#x9;STANDARD.COMMIT;&amp;#10;&#x9;DO_KEY('exit_form');&amp;#10;&#x9;DO_KEY('exit_form');&amp;#10;&#x9;:SYSTEM.MESSAGE_LEVEL := MSG_LVL;&amp;#10;*/&amp;#10;END;" ProgramUnitType="Procedure"/>
      <ProgramUnit Name="CANCEL_LOV_FORM" ProgramUnitText="PROCEDURE CANCEL_LOV_FORM IS&amp;#10;MSG_LVL&#x9;VARCHAR2(5);&amp;#10;BEGIN&amp;#10;&#x9;MSG_LVL := :SYSTEM.MESSAGE_LEVEL;&amp;#10;&#x9;:SYSTEM.MESSAGE_LEVEL := '25';&amp;#10;       EXIT_FORM(NO_VALIDATE);&amp;#10;&#x9;:SYSTEM.MESSAGE_LEVEL := MSG_LVL;&amp;#10;END;" ProgramUnitType="Procedure"/>

/* Validate date field without meaning displayed */
function val( rg_name    in     varchar2
             ,rg_value   in out date
             ,fmt_mask   in     varchar2
            ) return boolean
IS
--  fmt_mask varchar2(200) := get_item_property(:SYSTEM.TRIGGER_ITEM, FORMAT_MASK);
BEGIN
  setup(rg_name); 
  /* 
  ** Loop through the records, getting the specified column's 
  ** value at each iteration and comparing it to 'the_value' 

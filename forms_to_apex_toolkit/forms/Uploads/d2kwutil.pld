.attach LIBRARY webutil END NOCONFIRM
PACKAGE WIN_API_BITOP IS

/*-------------------------------------------------------------------------*\
 * WIN_API_BYTEOP -> 	This package provides 'C' Bitwise operations for
 *			PL/SQL 
 * CAUTION:	None of these operations check the size or sign of the 
 *		integers you pass. They just perform the operation asked
 *		for.
 * Contents:	BITWISE_OR
 *		BITWISE_XOR
 *		BITWISE_AND
 *		BITWISE_SHIFT_RIGHT
 *		BITWISE_SHIFT_LEFT
 * Dependancies:
 *		WIN_API
\*-------------------------------------------------------------------------*/ 

/*-------------------------------------------------------------------------*\
 * BITWISE_OR			->	Performs a C OR operation
 * Arguments: 
 *			-> 	Two integers to OR
 * Returns:
 *	integer result
\*-------------------------------------------------------------------------*/
 FUNCTION BITWISE_OR (	X	IN	PLS_INTEGER,
		 	Y	IN	PLS_INTEGER) RETURN PLS_INTEGER;
/*-------------------------------------------------------------------------*\
 * BITWISE_XOR			->	Performs a C XOR operation
 * Arguments: 
 *			-> 	Two integers to XOR
 * Returns:
 *	integer result
\*-------------------------------------------------------------------------*/
 FUNCTION BITWISE_XOR (	X	IN	PLS_INTEGER,
		 	Y	IN	PLS_INTEGER) RETURN PLS_INTEGER;

/*-------------------------------------------------------------------------*\
 * BITWISE_AND			->	Performs a C AND operation
 * Arguments: 
 *			-> 	Two integers to AND
 * Returns:
 *	integer result
\*-------------------------------------------------------------------------*/
 FUNCTION BITWISE_AND (	X	IN	PLS_INTEGER,
		 	Y	IN	PLS_INTEGER) RETURN PLS_INTEGER;

/*-------------------------------------------------------------------------*\
 * BITWISE_SHIFT_RIGHT	->	Performs a Bitwise Right shift of an Integer
 * Arguments: 
 *		X	-> 	Integer to Shift  
 *		Steps	->	Number of Bytes to Shift	
 * Returns:
 *	integer result
\*-------------------------------------------------------------------------*/
 FUNCTION BITWISE_SHIFT_RIGHT (	X	IN	PLS_INTEGER,
				Steps	IN	PLS_INTEGER) RETURN PLS_INTEGER;


/*-------------------------------------------------------------------------*\
 * BITWISE_SHIFT_LEFT	->	Performs a Bitwise Left shift of an Integer
 * Arguments: 
 *		X	-> 	Integer to Shift  
 *		Steps	->	Number of Bytes to Shift	
 * Returns:
 *	integer result
\*-------------------------------------------------------------------------*/
 FUNCTION BITWISE_SHIFT_LEFT (	X	IN	PLS_INTEGER,
				Steps	IN	PLS_INTEGER) RETURN PLS_INTEGER;

END WIN_API_BITOP;


PACKAGE WIN_API_DIALOG IS

/*-------------------------------------------------------------------------*\
 * WIN_API_DIALOG -> 	This package is concerned with Displaying Common
 *			dialogs
 * Contents:
 *		Open_File		-> Open File Dialog
 *		Save_File		-> Save File Dialog
 *		Select_Printer		-> Printer Selection Dialog
 * Dependancies:
*		WIN_API_ENVIRONMENT
 *		WIN_API
\*-------------------------------------------------------------------------*/ 

/*-------------------------------------------------------------------------*\
 * Open_File		->	Displays the standard Open File dialog
 * Arguments: 
 *	Title		-> 	The Title for the Dialog Box
 *				(Default -> 'Open File')
 *	StartDirectory  ->	Where the dialog should start from
 *				this should be in the format 'C:\TEMP'
 *				(Default -> Windows Directory)
 *	FileFilter	-> 	Restrict the list of files. The filter string 
 *				should be in the format:
 *				 '<Description>|<filename>.<Extension>|'
 *				typically this would be something like
 * 				'All files(*.*)|*.*|' or 'Text files(*.txt)|*.txt|'
 *				All Files is the Default
 *	Modal		->	Should the dialog be modal with respect to the 
 *				application? 
 *				default -> TRUE
 *	AdvancedFlags	->	(See list in WIN_API header) This option allows
 *				you to change the attributes of the Open File 
 *				dialog.  Here are some of the Flags that might
 *				be of interest:
 *				OFN_HIDEREADONLY	Hides the Read Only check box.
 *				OFN_NONETWORKBUTTON	Hides the Network Button
 *				OFN_EXPLORER		Display an Explorer style 
 *							Dialog rather than the 
 *							conventional one.
 *				See your Microsoft docmentation for details on 
 *				each flag.
 *				To Set the Advanced_Flags varaible, just add the 
 *				required flags together.  The default is:
 *				WIN_API.OFN_PATHMUSTEXIST + WIN_API.OFN_FILEMUSTEXIST +
 *				WIN_API.OFN_HIDEREADONLY + WIN_API.OFN_NOCHANGEDIR 
 *	RaiseExceptions -> 	TRUE of FALSE(Default) If set to true, then if the 
 *			   	command is not successful (e.g no filename is  
 *				returned) then the explicit exception
 *			   	NO_DATA_FOUND will be raised.
 *				
 * Returns:
 *	Path and name of the selected file
\*-------------------------------------------------------------------------*/
 
FUNCTION Open_File (	Title		IN	VARCHAR2	DEFAULT 'Open File',
			StartDirectory  IN	VARCHAR2	DEFAULT '$WINDIR$',
			FileFilter	IN	VARCHAR2	DEFAULT 'All files(*.*)|*.*|',
			Modal		IN 	BOOLEAN		DEFAULT TRUE,
			AdvancedFlags	IN	PLS_INTEGER	DEFAULT WIN_API.OFN_FLAG_DEFAULT,
			RaiseExceptions IN 	BOOLEAN 	DEFAULT FALSE
		    )	RETURN VARCHAR2;

/*-------------------------------------------------------------------------*\
 * Save_File		->	Displays the standard Save File dialog
 * Arguments: 
 *	SampleName	->	The Example name for the file to display in 
 *				the Save Window
 *	Title		-> 	The Title for the Dialog Box
 *				(Default -> 'Save File As')
 *	StartDirectory  ->	Where the dialog should start from
 *				this should be in the format 'C:\TEMP'
 *				(Default -> Windows Directory)
 *				You can specify the Windows and Temp directories by
 *				using the Shorthand $WINDIR$ and $TEMP$ respectively
 *				The function will then Ask the O/S for the relevant 
 *				locations
 *	FileFilter	-> 	Restrict the list of files. The filter string 
 *				should be in the format:
 *				 '<Description>|<filename>.<Extension>|'
 *				typically this would be something like
 * 				'All files(*.*)|*.*|' or 'Text files(*.txt)|*.txt|'
 *				All Files is the Default
 *	Modal		->	Should the dialog be modal with respect to the 
 *				application? 
 *				default -> TRUE
 *	AdvancedFlags	->	(See list in WIN_API header) This option allows
 *				you to change the attributes of the Open File 
 *				dialog.  Here are some of the Flags that might
 *				be of interest:
 *				OFN_HIDEREADONLY	Hides the Read Only check box.
 *				OFN_NONETWORKBUTTON	Hides the Network Button
 *				OFN_EXPLORER		Display an Explorer style 
 *							Dialog rather than the 
 *							conventional one.
 *				See your Microsoft docmentation for details on 
 *				each flag.
 *				To Set the Advanced_Flags varaible, just add the 
 *				required flags together.  The default is:
 *				WIN_API.OFN_PATHMUSTEXIST + WIN_API.OFN_FILEMUSTEXIST +
 *				WIN_API.OFN_HIDEREADONLY + WIN_API.OFN_NOCHANGEDIR 
 *	RaiseExceptions -> 	TRUE of FALSE(Default) If set to true, then if the 
 *			   	command is not successful (e.g no filename is  
 *				returned) then the explicit exception
 *			   	NO_DATA_FOUND will be raised.
 *				
 * Returns:
 *	Path and name of the selected file
\*-------------------------------------------------------------------------*/
 
FUNCTION Save_File (	SampleName	IN	VARCHAR2,
			Title		IN	VARCHAR2	DEFAULT 'Save File As',
			StartDirectory  IN	VARCHAR2	DEFAULT '$WINDIR$',
			FileFilter	IN	VARCHAR2	DEFAULT 'All files(*.*)|*.*|',
			Modal		IN 	BOOLEAN		DEFAULT TRUE,
			AdvancedFlags	IN	PLS_INTEGER	DEFAULT WIN_API.OFN_FLAG_DEFAULT,
			RaiseExceptions IN 	BOOLEAN		DEFAULT FALSE
		    ) 	RETURN VARCHAR2;


/*-------------------------------------------------------------------------*\
 * Select_Printer	->	Displays the standard Printer Selection 
 *				dialog.
 * Arguments: 
 *	PrinterName	->	The Name of the Printer the user Chooses
 *	Port		-> 	The Port for the above printer
 *	RaiseExceptions -> 	TRUE of FALSE(Default) If set to true, then if the 
 *			   	command is not successful (e.g no Printer is  
				selected) then the explicit exception
 *			   	NO_DATA_FOUND will be raised.
 * Returns:
 *	Path and name of the selected file
\*-------------------------------------------------------------------------*/
 
PROCEDURE Select_Printer (	PrinterName 	OUT	VARCHAR2,
				Port		OUT	VARCHAR2,
				RaiseExceptions in BOOLEAN DEFAULT FALSE);

END WIN_API_DIALOG;


PACKAGE win_api_session IS
/*-------------------------------------------------------------------------*\
 * WIN_API_SESSION ->   This package is concerned with altering/interacting 
 *			with the MDI session as a whole 
 * Contents:
 *		One_Session		-> Allows you to restrict the number
 * 					   of copies of a product running
 *					   e.g. only allow 1 runform session
 *		Change_MDI_Icon		-> Lets you change the icon for the Runform
 *					   MDI window
 *		TimeOut			-> A Three part call that allows you 
 *					   to detect that the User has been
 *					   idle for a certain amount of time
 *		Change_cursor		-> Allows you to alter the Mouse Cursor 
 *					   to cursors not standard for Forms
 * Dependancies:
 *		WIN_API
\*-------------------------------------------------------------------------*/ 

/*-------------------------------------------------------------------------*\
 * One_Session			->	Checks for processes already running. 
 *  					
 * Arguments: 
 * 	WindowTitle	-> 	MDI Window Title to Check for
 *	ModuleName	->	Name of executable module eg 'F45RUN32.EXE'
 *                              ** Caution ** when you run from the Form Builder
 *                                 the executable will be F45DBG32.EXE
 *	MatchType	->	Looks for other applications which match on
 *				window title only, module name only or both.
 *				Values 'WINDOW', 'MODULE', 'BOTH'.
 *	Activate	->	Activates the other session if found. Values
 *				TRUE or FALSE.
 *	Class		-> 	Window Class of MDI window (find in SPY++) Defaults
 * 				for Developer/2000 products, though you might have to 
 *				change this for other products
 *	RaiseExceptions -> 	Set to TRUE or FALSE (default).  If this is set 
 *			   	to TRUE, then finding another instance of the application 
 *			   	will raise NO_DATA_FOUND
 *
 * Returns:
 *	BOOLEAN TRUE for only session, otherwise FALSE...
\*-------------------------------------------------------------------------*/

	FUNCTION One_Session (	WindowTitle	IN VARCHAR2,
				ModuleName	IN VARCHAR2,
				MatchType	IN VARCHAR2,
				Activate	IN BOOLEAN,
				Class		IN VARCHAR2 DEFAULT WIN_API.D2K_WINDOW_CLASS,
				RaiseExceptions IN BOOLEAN  DEFAULT FALSE)

	RETURN BOOLEAN;


/*-------------------------------------------------------------------------*\
 * Change_MDI_Icon		->	Changes the MDI Window Icon 
 *  					
 * Arguments: 
 *	MDIWindow		->	Handle to the MDI window (Do not use 
 *					handle returned by get_window_property
 *					as this is the MDI client - instead use the
 *                                      win_api_utility.get_active_window function 
 *	IconFile		-> 	File which contains the icon - can be
 *					exe, dll or ico file
 *	IconIndex		->	Index of icon to retrieve - zero returns
 *					first
 *
 * NOTE: If the specified icon is not located, the default Windows Flag icon will 
 *       be used.
 * Returns:
 *	(None)
\*-------------------------------------------------------------------------*/
PROCEDURE Change_MDI_Icon ( 	MDIWindow	IN	PLS_INTEGER,
				IconFile 	IN 	VARCHAR2,
				IconIndex 	IN	PLS_INTEGER DEFAULT 0);

/*-------------------------------------------------------------------------*\
 * Timeout			->	Allows you to detect inactivity by 
 *					the user.  Consists of Three Separate
 *					Program units.
 *
 * Typical Usage:
 * 	When-New-Form-Instance:
 *		declare
 *			hWind		PLS_INTEGER;
 *			CheckTimer	TIMER;
 *		begin
 *			hWind := get_window_property(FORMS_MDI_WINDOW,WINDOW_HANDLE);
 *			Win_API_Session.Timeout_Start_Timer(hWind);
 *			Create_Timer('CheckTimeout',1000,repeat);
 * 
 *		end;
 *
 *	When-Timer-Expired:
 *		begin
 *		  if upper(get_application_property(TIMER_NAME)) = CHECKTIMEOUT' then 
 *			if Win_API_Session.Timeout_get_inactive_time > 100000 then
 *				-- Logout after 100 secs of idle 
 *				Win_API_Session.timout_delete_timer;
 *				exit_form (NO_VALIDATE);
 *			end if;
 *		end if;
 *		end;
 *		
 *-------------------------------------------------------------------------*
 * Timeout Program Unit 1:
 * Timeout_Start_Timer		-> 	Switches on the timier mechanism
 *  					
 * Arguments: 
 *	WindowHandle		->	Handle to the Window that you want to 
 *					check for activity in e.g. Handle for
 *					the Forms MDI window
 * Returns:
 *	(None)
\*-------------------------------------------------------------------------*/
  PROCEDURE Timeout_Start_Timer (WindowHandle in PLS_INTEGER);

/*-------------------------------------------------------------------------*\
 * Timeout Program Unit 2:
 * Timeout_Get_Inactive_Time	-> 	Reports how long this application has
 *					been inactive for in Seconds
 *  					
 * Arguments: 
 *	(None)
 * Returns:
 *	Number -> Inactive time in Milliseconds
\*-------------------------------------------------------------------------*/
  FUNCTION Timeout_Get_Inactive_Time return number;

/*-------------------------------------------------------------------------*\
 * Timeout Program Unit 3:
 * Timeout_Delete_Timer		-> 	Is used to clean up the Timout 
 *					process and should be called as 
 *					your application exits.
 *  					
 * Arguments: 
 *	(None)
 * Returns:
 *	(None)
\*-------------------------------------------------------------------------*/
  PROCEDURE Timeout_Delete_Timer;


/*-------------------------------------------------------------------------*\
 * Change_Cursor		->	Changes the Mouse Cursor
 *  					
 * Arguments: 
 *	CursorName		->	Id of the Cursor to Select
 *
 * Returns:
 *	(None)
\*-------------------------------------------------------------------------*/
PROCEDURE Change_Cursor ( 	CursorName	IN	VARCHAR2);


END win_api_session;


PACKAGE WIN_API_Shell IS

/*-------------------------------------------------------------------------*\
 * WIN_API_SHELL -> 	This package is concerned with accesssing common
 * 			Shell functions such as WinExec and Help
 * Contents:
 *		WinExec 	-> Excutes the specified command
 *		WinHelp		-> Access MS/Windows Help file by Keyword
 *				   Search or Topic Number.
 *		MousePosition	-> Get the X/Y coords of the mouse
 *		SendMessage	-> Hook into the Windows Message Queue
 *		SendKeys 	-> Simulate keystrokes
 * Dependancies:
 *		WIN_API
\*-------------------------------------------------------------------------*/ 

/*-------------------------------------------------------------------------*\
 * WinExec 		->	Execute a command string as if you 
 *				had used the Run Option from Program Manager or
 *				the Start Menu.
 * Arguments: 
 *	Command		-> 	The Command String Just as you would issue it from 
 *				the shell
 *      WindowStyle 	->	Use the constants defined in WIN_API
 *				For this Purpose use: 
 *				SW_SHOWNORMAL -> 	Start up with applications default
 *				SW_SHOWNOACTIVATE -> 	Starts as SW_SHOWNORMAL but 
 *							does not have Focus
 *				SW_SHOWMINIMIZED -> 	Will Start Iconised or on 
 *							but will still be 
 *							the active Application
 *				SW_SHOWMINNOACTIVE -> 	Starts Iconised without
 *							focus
 *				SW_SHOWMAXIMIZED -> 	Starts Maximised
 *	RaiseExceptions -> 	TRUE of FALSE(Default) If set to true, then if the 
 *			   	command is not successful the explicit exception
 *			   	NO_DATA_FOUND will be raised.
 * Returns:
 *	(NONE)
\*-------------------------------------------------------------------------*/
 
PROCEDURE WinExec (	Command		IN	VARCHAR2,
			WindowStyle 	IN	PLS_INTEGER DEFAULT WIN_API.SW_SHOWNORMAL,
			RaiseExceptions IN	BOOLEAN DEFAULT FALSE);

/*-------------------------------------------------------------------------*\
 * WinHelp 		->	Hook into the Windows Help mechanism for
 *				Your own Help Files
 * Arguments: 
 *	HelpFile	-> 	Name (and path) of your .HLP file
 *	Target		-> 	Either the Search String if HELP_KEY
 *				or HELP_PARTIALKEY is being used
 *				or the number of the required Topic
 *				(in a string)
 *      HelpStyle 	->	Use the constants defined in WIN_API
 *				For this Purpose use: 
 *				HELP_CONTEXT ->		Requires the number of a topic
 *							in the help file 
 *							The Help Author would be able to 
 *							Provide this
 *				HELP_INDEX ->		Display the Contents of the help file
 *							no value for Target is required
 *				HELP_KEY ->		Supply a string containing the required
 *							keyword.
 *				HELP_PARTIALKEY -> 	Supply a string containing the required
 *							keyword (or portion of it) Similar to 
 *							choosing HELP->SEARCH
 *				HELP_SETCONTENTS -> 	Switch to the contents screen. You must
 *							supply the topic number of the contents
 *							topic as the target	
 *				HELP_SETINDEX -> 	Switch to the Index screen. You must
 *							supply the topic number of the Index
 *							topic as the target	
 *	RaiseExceptions -> 	TRUE of FALSE(Default) If set to true, then if the 
 *			   	help file or topic is not found then 
 *			   	NO_DATA_FOUND will be raised.
 * Returns:
 *	(NONE)
\*-------------------------------------------------------------------------*/

PROCEDURE WinHelp (	HelpFile 	IN	VARCHAR2,
			Target		IN	VARCHAR2,
			HelpType	IN	PLS_INTEGER,
			RaiseExceptions IN	BOOLEAN 	DEFAULT FALSE);

/*-------------------------------------------------------------------------*\
 * MousePosition 	->	Procedure that will give you the Mouse X
 *				and Y coordinates at any Time (not just 
 *				in Mouse related Triggers
 *				Useful for detecting if the mouse has been 
 *				moved since you last checked, Ideal for 
 *				implimenting timeouts
 * Arguments: 
 *		XPos	->	X position of the mouse cursor in Pixels 
 *		YPos	->	Y position of the mouse cursor in Pixels 
 * Returns:
 *	(NONE)
\*-------------------------------------------------------------------------*/
 
PROCEDURE MousePosition (	Xpos 	OUT	NUMBER,
				Ypos	OUT	NUMBER);

/*-------------------------------------------------------------------------*\
 * SendMessage 	->		Send any message to the Windows Message
 *				queue.  Valid messages and parameters  
 *				Are documented in your Microsoft Documentation
 * Arguments: 
 *		Target		->	Window Handle of the recipient of the 
 *					message
 *		MessageCode	->	Message Number (see WIN_API header 
 *					for some of the more common messages)
 *		Param1		->	Message parameter 1 depends on Message
 *		Param2		->	Message parameter 2 depends on Message
 *		RaiseExceptions ->	If a non zero return code comes back from 
 *					sendmessage then raise NO_DATA_FOUND
 *					default = FALSE
 *					NOTE: Some Messages will Return a Non 
 *					Zero return code to indicate 
 *					success. e.g. TRUE = 1 
 *					Treat on a message by message 
 *					basis.
 * Returns:
 *	(NONE)
\*-------------------------------------------------------------------------*/
 
PROCEDURE SendMessage (	Target		IN	PLS_INTEGER,
			MessageCode	IN	PLS_INTEGER,
			Param1		IN	PLS_INTEGER DEFAULT 0,
			Param2		IN	PLS_INTEGER DEFAULT 0,
			RaiseExceptions IN	BOOLEAN	DEFAULT FALSE);

/*-------------------------------------------------------------------------*\
 * SendKeys 	->		Simulate keystrokes
 *				  
 *				
 * Arguments: 
 *		hWnd		->	Window Handle of the recipient of the 
 *					MDI window
 *		Keys 		->	Keys to be actioned - see help for format 
 *		RaiseExceptions ->	If a non zero return code comes back from 
 *					sendmessage then raise NO_DATA_FOUND
 *					default = FALSE
 *					NOTE: Some Messages will Return a Non 
 *					Zero return code to indicate 
 *					success. e.g. TRUE = 1 
 *					Treat on a message by message 
 *					basis.
 * Returns:
 *	(NONE)
\*-------------------------------------------------------------------------*/
 
PROCEDURE SendKeys (	hWnd		IN	PLS_INTEGER,
			Keys		IN	VARCHAR2,
			RaiseExceptions IN	BOOLEAN	DEFAULT FALSE);
				
END WIN_API_SHELL;


PACKAGE WIN_API_ENVIRONMENT IS

/*-------------------------------------------------------------------------*\
 * WIN_API_ENVIRONMENT -> This package is concerned with reading from and 
 * 			writing to either INI files or the Win95/WinNT
 *			Registry.
 * Contents:
 *		Read_INI_File		-> Gets a Value from an INI file
 *		Write_INI_File		-> Sets a Value in an INI file
 *		Get_Windows_Username	-> Login of current Windows User (NT/95 only)
 *		Get_Environment_string  -> Expands Environment Vars e.g %path%
 *		Get_Windows_Directory	-> Gets the Working Windows Dir
 *		Get_Temp_Directory	-> Gets the Temp Dir
 *		Get_Net_Connection	-> Expand Drive Letter into a Network Path
 *		Read_Registry		-> Reads a value from the Registry (NT/95 only)
 *		Write_Registry		-> Writes a value to the Registry (NT/95 only)
 * Dependancies:
 *		WIN_API
\*-------------------------------------------------------------------------*/ 

/*-------------------------------------------------------------------------*\
 * Read_INI_File - Read a Value from a named INI file 
 *                 If you need to read the ORACLE.INI file 
 *                 use TOOL_ENV.GETVAR() instead of this
 *                 package.
 *                 If using 32bit Developer/2000 you would 
 *                 probably rather use 
 *                 WIN_API_PROFILES.READ_REGISTRY() instead
 * Arguments: 
 *	FileName	-> Name of INI file e.g. WIN.INI. If the full
 *     			   path is not supplied with this argument
 *			   then the DOS PATH will be searched for the
 *			   Specified INI file
 *      Section		-> Section in INI file where the entry is. 
 * 			   This will be delimited using square brackets 
 *			   e.g. [printers]
 *	Entry		-> Name of Variable to read e.g. load (from win.ini)
 *	RaiseExceptions -> TRUE or FALSE(Default) If set to true, then if the 
 *			   requested variable is not found the explicit exception
 *			   NO_DATA_FOUND will be raised.
 * Returns:
 *	Value		-> a VARCHAR2 value containing the 
 *			   string (or number as a string) that the 
 *			   entry contains.
 *			   if the Entry is not found NULL is returned in 
 *			   the return value. (see RaiseExceptions above)
\*-------------------------------------------------------------------------*/
 
FUNCTION Read_INI_File (	FileName	IN	VARCHAR2,
				Section		IN	VARCHAR2,
				Entry		IN	VARCHAR2,
				RaiseExceptions IN	BOOLEAN DEFAULT FALSE) return VARCHAR2;

/*-------------------------------------------------------------------------*\
 * Write_INI_File ->		Write a Value to a named INI file 
 *                  		If using 32bit Developer/2000 you would 
 *                  		probably rather use 
 *                  		WIN_API_PROFILES.WRITE_REGISTRY_XXXX()
 * Arguments: 
 *	FileName	-> 	Name of INI file e.g. WIN.INI. If the full
 *     			   	path is not supplied with this argument
 *			   	then the DOS PATH will be searched for the
 *			   	Specified INI file
 *      Section		-> 	Section in INI file where the entry is. 
 * 			   	This will be delimited using square brackets 
 *			   e.g. [printers]. No need to supply the brackets
				for the argument though
 *	Entry		-> 	Name of Variable to write e.g. load (from win.ini)
 *	Value		->	Value of the variable to write as a string.
 *	RaiseExceptions -> 	Set to TRUE or FALSE (default).  If this is set 
 *			   	to TRUE, then errors such as not finding the 
 *			   	INI file will raise NO_DATA_FOUND
 *			 	If FALSE then all errors will be handled quietly
 * Returns:
 *	(NONE)
\*-------------------------------------------------------------------------*/

PROCEDURE Write_INI_File (	FileName	IN	VARCHAR2,
			    	Section		IN	VARCHAR2,
			 	Entry		IN	VARCHAR2,
				Value		IN	VARCHAR2,
				RaiseExceptions IN	BOOLEAN DEFAULT FALSE);

/*-------------------------------------------------------------------------*\
 * Get_Windows_Username ->	The Username Supplied to log into Windows
 * Arguments: 
 *	RaiseExceptions -> 	Set to TRUE or FALSE (default).  If this is set 
 *			   	to TRUE, then Not finding the Username (or 
 *				exceeding the buffer size) will raise
 *				NO_DATA_FOUND
 * Returns:
 *	UserName ->		Varchar2 
\*-------------------------------------------------------------------------*/

FUNCTION Get_Windows_Username ( RaiseExceptions 	IN	BOOLEAN DEFAULT FALSE)	RETURN VARCHAR2;


/*-------------------------------------------------------------------------*\
 * Get_Environment_String ->	Expands a named environment variable
 * Arguments: 
 *	VariableName	->	Name of the variable e.g. PATH
 *	RaiseExceptions -> 	Set to TRUE or FALSE (default).  If this is set 
 *			   	to TRUE, then Not finding the Username (or 
 *				exceeding the buffer size) will raise
 *				NO_DATA_FOUND
 * Returns:
 *	Expanded String ->	Varchar2 
\*-------------------------------------------------------------------------*/

FUNCTION Get_Environment_string (VariableName		IN	VARCHAR2,
				 RaiseExceptions 	IN	BOOLEAN DEFAULT FALSE)	RETURN VARCHAR2;


/*-------------------------------------------------------------------------*\
 * Get_Windows_Directory ->	Obtains the path to the windows directory 
 *				on the machine
 * Arguments: 
 *	RaiseExceptions -> 	Set to TRUE or FALSE (default).  If this is set 
 *			   	to TRUE, then Not finding the directory (or 
 *				exceeding the buffer size) will raise
 *				NO_DATA_FOUND
 * Returns:
 *	Path ->			Varchar2 
\*-------------------------------------------------------------------------*/

FUNCTION Get_Windows_Directory ( RaiseExceptions 	IN	BOOLEAN DEFAULT FALSE)	RETURN VARCHAR2;

/*-------------------------------------------------------------------------*\
 * Get_Temp_Directory ->	Obtains the path to the directory that  
 *				Windows is using for temp files
 * Arguments: 
 *	RaiseExceptions -> 	Set to TRUE or FALSE (default).  If this is set 
 *			   	to TRUE, then Not finding the directory (or 
 *				exceeding the buffer size) will raise
 *				NO_DATA_FOUND
 * Returns:
 *	Path ->			Varchar2 
\*-------------------------------------------------------------------------*/

FUNCTION Get_Temp_Directory ( RaiseExceptions 	IN	BOOLEAN DEFAULT FALSE)	RETURN VARCHAR2;

/*-------------------------------------------------------------------------*\
 * Get_Net_Connection	->	Expands an attached drive letter to it's 
 *				full network address
 * Arguments: 
 *	DriveLetter	->	Letter of the Drive to expand e.g. 'F'
 *	RaiseExceptions -> 	Set to TRUE or FALSE (default).  If this is set 
 *			   	to TRUE, then Not finding the Username (or 
 *				exceeding the buffer size) will raise
 *				NO_DATA_FOUND
 * Returns:
 *	Expanded Connection String ->	Varchar2 
\*-------------------------------------------------------------------------*/

FUNCTION Get_Net_Connection	(DriveLetter		IN	VARCHAR2,
				 RaiseExceptions 	IN	BOOLEAN DEFAULT FALSE)	RETURN VARCHAR2;

/*-------------------------------------------------------------------------*\
 * Read_Registry	->	Read the value of a particular entry in the 
 *				Win95/NT Registry
 *
 * Arguments: 
 *	RegPath 	->	The Full path in the registry to the required
 *				value e.g. HKEY_LOCAL_MACHINE\SOFTWARE\ORACLE
 *	RegEntry	->	Name of the entry to read e.g. ORACLE_PATH
 *	RaiseExceptions -> 	Set to TRUE or FALSE (default).  If this is set 
 *			   	to TRUE, then failing to find the entry raises
 *				NO_DATA_FOUND. obtaining an entry of a datatype
 *				that is not a string or a number raises
 *				VALUE_ERRROR.
 * Returns:
 *	Value 		->	Both Number and String entries returned
 *				as Varchar2.
\*-------------------------------------------------------------------------*/

FUNCTION Read_Registry (RegPath		IN 	VARCHAR2,
			RegEntry	IN	VARCHAR2, 
			RaiseExceptions IN	BOOLEAN DEFAULT FALSE)	RETURN VARCHAR2;
/*-------------------------------------------------------------------------*\
 * Write_Registry	->	Set the value of a particular entry in the 
 *				Win95/NT Registry
 *				NOTE: The Path to the entry must already Exist
 *
 * Arguments: 
 *	RegPath 	->	The Full path in the registry to the required
 *				value e.g. HKEY_LOCAL_MACHINE\SOFTWARE\ORACLE
 *	RegEntry	->	Name of the entry to set e.g. ORACLE_PATH
 *	RegValue	->	Value to set
 *	RaiseExceptions -> 	Set to TRUE or FALSE (default).  If this is set 
 *			   	to TRUE, then failing to set  the entry raises
 *				NO_DATA_FOUND. 
 * Returns:
 *	(NONE)
\*-------------------------------------------------------------------------*/

PROCEDURE Write_Registry(	RegPath		IN 	VARCHAR2,
				RegEntry	IN	VARCHAR2, 
				RegValue	IN	VARCHAR2, 
				RaiseExceptions IN	BOOLEAN DEFAULT FALSE);

END WIN_API_ENVIRONMENT;


PACKAGE Win_API IS
/*-------------------------------------------------------------------------------*\
 * WIN_API ->		This package defines the constants used throughout 
 *			the library as a whole, including versions of those 
 *			constants defined within WINDOWS.H/WINUSER.H that 
 *			we'll be using. Add more constants in here if required
 *			The package also contains Explict Exception declarations,
 *			various status Flags and functions for Error Handling
 * NOTE:		In order to make this library portable across Forms,
 *			Reports and Graphics we do not use any application 
 *			specific built-ins such as the Forms MESSAGE() 
 *			Built-in. Instead errors are recorded in a package
 *			variable which the programmer can examine if required
\*-------------------------------------------------------------------------------*/

-- Constants

-- D2KUTIL Internal
	D2KWUTIL_VERSION	CONSTANT	VARCHAR2(7) := '1.4.0.1';
	D2K_WINDOW_CLASS	CONSTANT	VARCHAR2(20) := 'ui21MDIRoot_W32';

-- Window Style Constants (from WINUSER.H)
--	Any PU's that use these constants will explain 
--	their use.  For further information consult the
--	Windows SDK.

	SW_HIDE			CONSTANT	PLS_INTEGER := 0;
	SW_SHOWNORMAL		CONSTANT	PLS_INTEGER := 1;
	SW_SHOWMINIMIZED	CONSTANT	PLS_INTEGER := 2;
	SW_SHOWMAXIMIZED	CONSTANT	PLS_INTEGER := 3;
	SW_SHOWNOACTIVATE	CONSTANT	PLS_INTEGER := 4;
	SW_SHOW			CONSTANT	PLS_INTEGER := 5;
	SW_MINIMIZE		CONSTANT	PLS_INTEGER := 6;
	SW_SHOWMINNOACTIVE	CONSTANT	PLS_INTEGER := 7;
	SW_SHOWNA		CONSTANT	PLS_INTEGER := 8;
	SW_RESTORE		CONSTANT	PLS_INTEGER := 9;
	SW_SHOWDEFAULT		CONSTANT	PLS_INTEGER := 10;

-- Help Access Constants (From WINUSER.H)
--	See WIN_API_SHELL.WinHelp

	HELP_CONTEXT		CONSTANT	PLS_INTEGER := 1;   /* 0x0001L */
	HELP_QUIT		CONSTANT	PLS_INTEGER := 2;   /* 0x0002L */
	HELP_INDEX		CONSTANT	PLS_INTEGER := 3;   /* 0x0003L */
	HELP_CONTENTS		CONSTANT	PLS_INTEGER := 3;   /* 0x0003L */
	HELP_HELPONHELP		CONSTANT	PLS_INTEGER := 4;   /* 0x0004L */
	HELP_SETINDEX		CONSTANT	PLS_INTEGER := 5;   /* 0x0005L */
	HELP_SETCONTENTS	CONSTANT	PLS_INTEGER := 5;   /* 0x0005L */
	HELP_CONTEXTPOPUP	CONSTANT	PLS_INTEGER := 8;   /* 0x0008L */
	HELP_FORCEFILE    	CONSTANT	PLS_INTEGER := 9;   /* 0x0009L */
	HELP_KEY		CONSTANT	PLS_INTEGER := 257; /* 0x0101L */
	HELP_COMMAND      	CONSTANT	PLS_INTEGER := 258; /* 0x0102L */
	HELP_PARTIALKEY		CONSTANT	PLS_INTEGER := 261; /* 0x0105L */
	HELP_MULTIKEY     	CONSTANT	PLS_INTEGER := 513; /* 0x0201L */
	HELP_SETWINPOS		CONSTANT	PLS_INTEGER := 515; /* 0x0203L */
-- Windows 4+
	HELP_CONTEXTMENU	CONSTANT	PLS_INTEGER := 10;  /* 0x000a  */
	HELP_FINDER       	CONSTANT	PLS_INTEGER := 11;  /* 0x000b  */
	HELP_WM_HELP      	CONSTANT	PLS_INTEGER := 12;  /* 0x000c  */
	HELP_SETPOPUP_POS      	CONSTANT	PLS_INTEGER := 13;  /* 0x000d  */


-- Windows Messages for use with SendMessage
-- DO NOT utilise the Windows Sendmessage interface without being conversant
-- with the Windows message handling mechanism
-- Refer to the Microsoft Windows SDK for Messages and Parameter values
	WM_MDICASCADE		CONSTANT	PLS_INTEGER := 551;	/* 0x0227 */


-- Flags for use with File Dialog boxes ("Save As" or "Open")
-- Refer to your Microsoft documentation for details on the 
-- Exact usage and dependancies of each option
	OFN_READONLY		CONSTANT	PLS_INTEGER := 1;	/* 0x00000001 */
	OFN_OVERWRITEPROMPT	CONSTANT	PLS_INTEGER := 2;	/* 0x00000002 */
	OFN_HIDEREADONLY	CONSTANT	PLS_INTEGER := 4;	/* 0x00000004 */
	OFN_NOCHANGEDIR		CONSTANT	PLS_INTEGER := 8;	/* 0x00000008 */
	OFN_SHOWHELP		CONSTANT	PLS_INTEGER := 16;	/* 0x00000010 */
	OFN_NOVALIDATE		CONSTANT	PLS_INTEGER := 265;	/* 0x00000100 */
	OFN_ALLOWMULTISELECT	CONSTANT	PLS_INTEGER := 512;	/* 0x00000200 */
	OFN_EXTENSIONDIFFERENT	CONSTANT	PLS_INTEGER := 1024;	/* 0x00000400 */
	OFN_PATHMUSTEXIST	CONSTANT	PLS_INTEGER := 2048;	/* 0x00000800 */
	OFN_FILEMUSTEXIST	CONSTANT	PLS_INTEGER := 4096;	/* 0x00001000 */
	OFN_CREATEPROMPT	CONSTANT	PLS_INTEGER := 8192;	/* 0x00002000 */
	OFN_SHAREAWARE		CONSTANT	PLS_INTEGER := 16384;	/* 0x00004000 */
	OFN_NOREADONLYRETURN	CONSTANT	PLS_INTEGER := 32768;	/* 0x00008000 */
	OFN_NOTESTFILECREATE	CONSTANT	PLS_INTEGER := 65536;	/* 0x00010000 */
	OFN_NONETWORKBUTTON	CONSTANT	PLS_INTEGER := 131072;	/* 0x00020000 */
	OFN_NOLONGNAMES		CONSTANT	PLS_INTEGER := 262144;	/* 0x00040000 */
-- Flags only Valid For Win95
	OFN_EXPLORER		CONSTANT	PLS_INTEGER := 524288;	/* 0x00080000 */
	OFN_NODEREFERENCELINKS	CONSTANT	PLS_INTEGER := 1048576;	/* 0x00100000 */
	OFN_LONGNAMES		CONSTANT	PLS_INTEGER := 2097152;	/* 0x00200000 */

-- The defaults used here (WIN_API.OFN_PATHMUSTEXIST|WIN_API.OFN_FILEMUSTEXIST|WIN_API.OFN_HIDEREADONLY|WIN_API.OFN_NOCHANGEDIR)
	OFN_FLAG_DEFAULT	CONSTANT	PLS_INTEGER := 6156;	








-- Public Variables
   ERROR_ENCOUNTERED	BOOLEAN := FALSE;/* The Last Call resulted in an error */
   ERROR_STACK		VARCHAR2(2000);	 /* Holds Text of Last error(s) */ 
   API_ENABLED		BOOLEAN := TRUE; /* Are API functions usable ?*/
   IS32BIT		BOOLEAN	:= TRUE;
   DLL_HANDLE		ORA_FFI.LibHandleType;

-- Public Exceptions
   CALL_NOT_ALLOWED		EXCEPTION;	/* A 16 bit version of forms tried to
						   Call a 32 bit function */
   NOT_AVAILABLE		EXCEPTION;	/* A call to the API was made but
						   API functions not currently 
						   available (e.g. not on Windows) */

-- Error Constants
   UError			CONSTANT	VARCHAR2(30) := ' Caused an unexpected error: ';
   NoAPI			CONSTANT	VARCHAR2(33) := 'API Functions are not Available';

   /*----------------------------------------------------------------------------*\
    * PreLoad ->	Loads the DLL into memory but does not call a function
   \*----------------------------------------------------------------------------*/    
   PROCEDURE PreLoad;


   /*----------------------------------------------------------------------------*\
    * Clean_Error_Stack ->	Re-initialises the error mechanism
   \*----------------------------------------------------------------------------*/    
   PROCEDURE Clean_Error_Stack;

   /*----------------------------------------------------------------------------*\
    * Add_Error ->		Adds the text of the specified error to the 
    *				ERROR_STACK variable and sets the error Flag 
    *				ERROR_ENCOUTERED.
   \*----------------------------------------------------------------------------*/    
   PROCEDURE Add_Error (Set_Error_Text in varchar2);
 
   /*----------------------------------------------------------------------------*\
    * Add_External_Errors ->	If we get an unexpected error this funtion will 
    *				return a sting containing the error text
   \*----------------------------------------------------------------------------*/    
   FUNCTION Add_External_Errors return varchar2;

   /*----------------------------------------------------------------------------*\
    * Check_DLL_Handle ->		ensures that the DLL is still loaded
    *					returns FALSE if we need to RE-Register
    *					Raises NO_DATA_FOUND if the library 
    *					cannot be loaded
   \*----------------------------------------------------------------------------*/    
   FUNCTION Check_DLL_Handle (LocalLoadCount in PLS_INTEGER) RETURN BOOLEAN;

   /*----------------------------------------------------------------------------*\
    * StripDirSep ->	Removes trailing directory seperators or 
    *				SemiColons from paths, providing a known format
   \*----------------------------------------------------------------------------*/    
   FUNCTION StripDirSep ( INPath in varchar2) return varchar2; 

END Win_API; /* End Package Declaration */


PACKAGE WIN_API_UTILITY IS

/*-------------------------------------------------------------------------*\
 * WIN_API_UTILITY -> 	This package is concerned Helpful utility functions
 * Contents:
 *		Delete_File		-> Erases an O/S file
 *		Move_File		-> Moves an O/S file
 *		Copy_File		-> Copies an O/S file
 *		Generate_Temp_Filename 	-> The "official" way of getting a 
 *					   Temporary filename.
 *		Get_Active_Window	-> Useful for getting Window Handles 
 *					   when not in Forms (which supplies them
 *					   for you)
 *		Play_WAV		-> Plays a Sound file
 *		Sleep			-> Suspends the application
 *		InterruptCheck		-> Check for "Cancel" Mouse Click in tight loops
 *		
 * Dependancies:
 *		WIN_API_ENVIRONMENT
 *		WIN_API
\*-------------------------------------------------------------------------*/ 

/*-------------------------------------------------------------------------*\
 * Delete_File		->	Deletes the specified file
 * Arguments: 
 *	FileName	-> 	The location and name of the file to delete
 *	RaiseExceptions -> 	TRUE of FALSE(Default) If set to true, then if the 
 *			   	command is not successful (e.g the file does 
				not exist) then the explicit exception
 *			   	NO_DATA_FOUND will be raised.
 * Returns:
 *	(NONE)
\*-------------------------------------------------------------------------*/
 
PROCEDURE Delete_File (	FileName	IN	VARCHAR2,
			RaiseExceptions IN 	BOOLEAN DEFAULT FALSE);

/*-------------------------------------------------------------------------*\
 * Move_File		->	Moves the specified file
 * Arguments: 
 *	OldFileName	-> 	The location and name of the file to Move
 *	NewFileName	-> 	The new location and name for the file
 *	RaiseExceptions -> 	TRUE or FALSE(Default) If set to true, then if the 
 *			   	command is not successful (e.g the file does 
				not exist) then the explicit exception
 *			   	NO_DATA_FOUND will be raised.
 * Returns:
 *	(NONE)
\*-------------------------------------------------------------------------*/
 
PROCEDURE Move_File (	OldFileName	IN	VARCHAR2,
			NewFileName	IN	VARCHAR2,
			RaiseExceptions IN 	BOOLEAN DEFAULT FALSE);

/*-------------------------------------------------------------------------*\
 * Copy_File		->	Copies the specified file
 * Arguments: 
 *	OldFileName	-> 	The location and name of the file to Copy
 *	NewFileName	-> 	The new location and name for the copy of the file
 *	AllowOverWrite	->	TRUE or FALSE(Default) If FALSE, then if the NewFileName
 *				already exists then the move will fail.  If TRUE the existing
 *				file will just be overwritten.
 *	RaiseExceptions -> 	TRUE or FALSE(Default) If set to true, then if the 
 *			   	command is not successful (e.g the file does 
				not exist) then the explicit exception
 *			   	NO_DATA_FOUND will be raised.
 * Returns:
 *	(NONE)
\*-------------------------------------------------------------------------*/
 
PROCEDURE Copy_File (	OldFileName	IN	VARCHAR2,
			NewFileName	IN	VARCHAR2,
			AllowOverWrite	IN	BOOLEAN DEFAULT FALSE,
			RaiseExceptions IN 	BOOLEAN DEFAULT FALSE);

/*-------------------------------------------------------------------------*\
 * Generate_Temp_Filename->	Asks windows to generate a filename for you 
 *				The filename will take the format of a prefix
 *				(Which you can supply) and a generated number
 *				with a .TMP extension
 *				NOTE: Windows will also create the file 
 *				for you, but it will be empty.
 * Arguments: 
 *	Path		-> 	The location you want for the file
 *				NULL ==> Working Directory is the default
 *				To automatically use the Defined Temp dircetory
 *				for the PC then just specify '$TEMP$'
 *      Prefix 		->	A root for the name e.g. 'D2K'(Default)
 *				only the first 3 chars will be used.
 *	RaiseExceptions -> 	TRUE of FALSE(Default) If set to true, then if the 
 *			   	command is not successful the explicit exception
 *			   	NO_DATA_FOUND will be raised.
 * Returns:
 *	Generated Filename
\*-------------------------------------------------------------------------*/
 
FUNCTION Generate_Temp_Filename(Path	 	IN	VARCHAR2 DEFAULT NULL,
				Prefix 		IN	VARCHAR2 DEFAULT 'D2K',
				RaiseExceptions IN	BOOLEAN DEFAULT FALSE) RETURN VARCHAR2;

/*-------------------------------------------------------------------------*\
 * Get_Active_Window	->	Returns the Windows Window handle to the 
 *				Active Window
 * Arguments: 
 *	RaiseExceptions -> 	TRUE of FALSE(Default) If set to true, then if the 
 *			   	command is not successful then the explicit exception
 *			   	NO_DATA_FOUND will be raised.
 * Returns:
 *	Integer Window Handle
\*-------------------------------------------------------------------------*/
 
FUNCTION Get_Active_Window (RaiseExceptions IN	BOOLEAN DEFAULT FALSE ) RETURN PLS_INTEGER;

/*-------------------------------------------------------------------------*\
 * Play_WAV	->	Plays a Windows WAV file
 *
 * Arguments: 
 *	FileName	->	Path and Name of WAV file to play
 *	Asynchronous	->	BOOLEAN set to TRUE or FALSE(Default) 
 *				Setting to TRUE, control will return to
 *				PL/SQL immediatly, FALSE will wait until 
 *				the sound has finished
 *	RaiseExceptions	->	If The Sound File is Not Found or the PC
 *				has no Sound capability then raise 
 *				NO_DATA_FOUND (if TRUE) 
 * Returns:
 *	(NONE)
\*-------------------------------------------------------------------------*/
 
PROCEDURE Play_WAV ( 	FileName	IN	VARCHAR2,
			Asynchronous	IN	BOOLEAN DEFAULT FALSE,
			RaiseExceptions	IN	BOOLEAN DEFAULT FALSE);

/*-------------------------------------------------------------------------*\
 * Sleep		->	Sleeps for specified time.
 *
 * Arguments: 
 *	SleepTime	->	Sleep time in milliseconds
 * Returns:
 *	(NONE)
\*-------------------------------------------------------------------------*/
 
PROCEDURE Sleep    (	SleepTime    IN 	PLS_INTEGER);

/*-------------------------------------------------------------------------*\
 * InterruptCheck		->	Allows you to check to see if a button 
 *  					has been pressed even in a tight PL/SQL
 *					Loop, or whilst looping through a cursor
 *
 * Arguments: 
 *	ButtonHandle			->	Handle to a "Cancel" Button
 * Returns:
 *	TRUE if button has been clicked with the mouse.
\*-------------------------------------------------------------------------*/

FUNCTION InterruptCheck ( 	ButtonHandle	IN	PLS_INTEGER) RETURN BOOLEAN;

END WIN_API_UTILITY;


PACKAGE BODY WIN_API_UTILITY is

   -- Private persistant variables
   fh_GetTempFile	ora_ffi.funcHandleType;
   fh_DelFile		ora_ffi.funcHandleType;
   fh_MoveFile		ora_ffi.funcHandleType;
   fh_CopyFile		ora_ffi.funcHandleType;
   fh_GetAct		ora_ffi.funcHandleType;
   fh_PlayW		ora_ffi.funcHandleType;
   fh_Sleep		ora_ffi.funcHandleType;
   fh_PeekBtnClick      ora_ffi.funcHandleType;

   iGTFDLLCount		pls_integer	:= 0;
   iDEFDLLCount		pls_integer	:= 0;
   iMVFDLLCount		pls_integer	:= 0;
   iCPFDLLCount		pls_integer	:= 0;
   iGAWDLLCount		pls_integer	:= 0;
   iPWFDLLCount		pls_integer	:= 0;
   iSLPDLLCount		pls_integer     := 0;
   iPBCDLLCount         pls_integer     := 0;
   vcBuff1		varchar2(512);
   vcBuff2		varchar2(512);
   vcBuff3		varchar2(512);
   vcBuff4		varchar2(512);
   vcBuff5		varchar2(512);

   iBuff1		pls_integer;
   iBuff2		pls_integer;
   iRC			pls_integer;

   -- Private Program unit headers
   FUNCTION externGTF (		hFunc		IN	ORA_FFI.funcHandleType,
				Path		IN OUT	VARCHAR2,
				Prefix		IN OUT	VARCHAR2,
				FileName	IN OUT	VARCHAR2) return PLS_INTEGER;

   FUNCTION externDEF (		hFunc		IN	ORA_FFI.funcHandleType,
				FileName	IN OUT	VARCHAR2) return PLS_INTEGER;

   FUNCTION externMVF (		hFunc		IN	ORA_FFI.funcHandleType,
				OldFileName	IN OUT	VARCHAR2,
				NewFileName	IN OUT	VARCHAR2) return PLS_INTEGER;

   FUNCTION externCPF (		hFunc		IN	ORA_FFI.funcHandleType,
				OldFileName	IN OUT	VARCHAR2,
				NewFileName	IN OUT	VARCHAR2,
				Flags		IN	PLS_INTEGER) return PLS_INTEGER;

   FUNCTION externGAW (		hFunc		IN	ORA_FFI.funcHandleType) return PLS_INTEGER;

   FUNCTION externPWF (		hFunc		IN	ORA_FFI.funcHandleType,
				FileName	IN OUT 	VARCHAR2,
				Flags		IN 	PLS_INTEGER) return PLS_INTEGER;
   
   FUNCTION externSLP (		hFunc		IN      ORA_FFI.funcHandleType,
				SleepTime	IN	PLS_INTEGER) return PLS_INTEGER;

   FUNCTION externPBC (		hFunc		IN      ORA_FFI.funcHandleType,
				hBtn		IN	PLS_INTEGER) return PLS_INTEGER;


   -- Pragmas
   PRAGMA INTERFACE(C,externGTF,11265);
   PRAGMA INTERFACE(C,externDEF,11265);
   PRAGMA INTERFACE(C,externMVF,11265);
   PRAGMA INTERFACE(C,externCPF,11265);
   PRAGMA INTERFACE(C,externGAW,11265);
   PRAGMA INTERFACE(C,externPWF,11265);
   PRAGMA INTERFACE(C,externSLP,11265);
   PRAGMA INTERFACE(C,externPBC,11265);

   -- Public Bodies 

   PROCEDURE Delete_File (	FileName	IN	VARCHAR2,
				RaiseExceptions IN 	BOOLEAN DEFAULT FALSE) is
   begin 
	WIN_API.Clean_Error_Stack;
	iRC	:= 0;
	if WIN_API.API_ENABLED then 
		if not Win_API.Check_DLL_Handle(iDEFDLLCount)  then
	   	-- Register the interface to the function
	   		fh_DelFile := ora_ffi.register_function(WIN_API.DLL_HANDLE,'d2kwutil_DelFile',ora_ffi.PASCAL_STD);
     			ora_ffi.register_parameter(fh_DelFile,ORA_FFI.C_CHAR_PTR);
			ora_ffi.register_return(fh_DelFile,ORA_FFI.C_INT);
		end if;

		vcBuff1		:= Filename;
		iRC 	:= externDEF(fh_DelFile,vcBuff1);
	else 
		raise WIN_API.NOT_AVAILABLE;
	end if;  
	if iRC = 0 then 
		WIN_API.Add_error('Could not delete the file '||FileName);
		if RaiseExceptions then 
			raise NO_DATA_FOUND;
		end if;
	end if;
   exception
	when NO_DATA_FOUND then 
		raise;
	when WIN_API.NOT_AVAILABLE then
		Win_API.Add_error(Win_API.NoAPI);
		raise;
	when others then 
		Win_API.Add_error('Delete_File'||Win_API.UError||WIN_API.Add_External_errors); 
		raise;
   end Delete_file;

   PROCEDURE Move_File (	OldFileName	IN	VARCHAR2,
				NewFileName	IN	VARCHAR2,
				RaiseExceptions IN 	BOOLEAN DEFAULT FALSE) is
   begin 
	WIN_API.Clean_Error_Stack;
	iRC	:= 0;
	if WIN_API.API_ENABLED then 
		if not Win_API.Check_DLL_Handle(iMVFDLLCount)  then
	   	-- Register the interface to the function
	   		fh_MoveFile := ora_ffi.register_function(WIN_API.DLL_HANDLE,'d2kwutil_MoveFile',ora_ffi.PASCAL_STD);
     			ora_ffi.register_parameter(fh_MoveFile,ORA_FFI.C_CHAR_PTR);
     			ora_ffi.register_parameter(fh_MoveFile,ORA_FFI.C_CHAR_PTR);
			ora_ffi.register_return(fh_MoveFile,ORA_FFI.C_INT);
		end if;
		
		vcBuff1		:= OldFilename;
		vcBuff2		:= NewFilename;
		iRC 	:= externMVF(fh_MoveFile,vcBuff1,vcBuff2);
	else 
		raise WIN_API.NOT_AVAILABLE;
	end if;  
	if iRC = 0 then 
		WIN_API.Add_error('Could not Move the file '||OldFileName||' to '||NewFileName);
		if RaiseExceptions then 
			raise NO_DATA_FOUND;
		end if;
	end if;
   exception
	when NO_DATA_FOUND then 
		raise;
	when WIN_API.NOT_AVAILABLE then
		Win_API.Add_error(Win_API.NoAPI);
		raise;
	when others then 
		Win_API.Add_error('Move_File'||Win_API.UError||WIN_API.Add_External_errors); 
		raise;
   end Move_file;

   PROCEDURE Copy_File (	OldFileName	IN	VARCHAR2,
				NewFileName	IN	VARCHAR2,
				AllowOverWrite	IN	BOOLEAN DEFAULT FALSE,
				RaiseExceptions IN 	BOOLEAN DEFAULT FALSE) is
   begin 
	WIN_API.Clean_Error_Stack;
	iRC	:= 0;
	if WIN_API.API_ENABLED then 
		if not Win_API.Check_DLL_Handle(iCPFDLLCount)  then
	   	-- Register the interface to the function
	   		fh_CopyFile := ora_ffi.register_function(WIN_API.DLL_HANDLE,'d2kwutil_CopyFile',ora_ffi.PASCAL_STD);
     			ora_ffi.register_parameter(fh_CopyFile,ORA_FFI.C_CHAR_PTR);
     			ora_ffi.register_parameter(fh_CopyFile,ORA_FFI.C_CHAR_PTR);
     			ora_ffi.register_parameter(fh_CopyFile,ORA_FFI.C_INT);
			ora_ffi.register_return(fh_CopyFile,ORA_FFI.C_INT);
		end if;
		
		if AllowOverWrite then 
			iBuff1 := 0;
		else
			iBuff1 := 1;
		end if;

		vcBuff1		:= OldFilename;
		vcBuff2		:= NewFilename;
		iRC 	:= externCPF(fh_CopyFile,vcBuff1,vcBuff2,iBuff1);
	else 
		raise WIN_API.NOT_AVAILABLE;
	end if;  
	if iRC = 0 then 
		WIN_API.Add_error('Could not copy the file '||OldFileName||' to '||NewFileName);
		if RaiseExceptions then 
			raise NO_DATA_FOUND;
		end if;
	end if;
   exception
	when NO_DATA_FOUND then 
		raise;
	when WIN_API.NOT_AVAILABLE then
		Win_API.Add_error(Win_API.NoAPI);
		raise;
	when others then 
		Win_API.Add_error('Copy_File'||Win_API.UError||WIN_API.Add_External_errors); 
		raise;
   end Copy_file;

   FUNCTION Generate_Temp_Filename (Path	 	IN	VARCHAR2 DEFAULT NULL,
				    Prefix 		IN	VARCHAR2 DEFAULT 'D2K',
				    RaiseExceptions 	IN	BOOLEAN DEFAULT FALSE) RETURN VARCHAR2 is
   begin 
	WIN_API.Clean_Error_Stack;
	iRC	:= 0;
	if WIN_API.API_ENABLED then 
		if not Win_API.Check_DLL_Handle(iGTFDLLCount)  then
	   	-- Register the interface to the function
	   		fh_GetTempFile := ora_ffi.register_function(WIN_API.DLL_HANDLE,'d2kwutil_TmpFile',ora_ffi.PASCAL_STD);
     			ora_ffi.register_parameter(fh_GetTempFile,ORA_FFI.C_CHAR_PTR);
			ora_ffi.register_parameter(fh_GetTempFile,ORA_FFI.C_CHAR_PTR);
			ora_ffi.register_parameter(fh_GetTempFile,ORA_FFI.C_CHAR_PTR);
			ora_ffi.register_return(fh_GetTempFile,ORA_FFI.C_INT);
		end if;

		if Path is null then 
			vcBuff1 := '.';
		elsif upper(Path) = '$TEMP$' then 
			vcBuff1 := win_api_environment.get_temp_directory;
		else
			vcBuff1		:= Path;
		end if;
		vcBuff2		:= Prefix;
		vcBuff3		:= RPAD(' ',512,CHR(0));
		iRC 	:= externGTF(fh_GetTempFile,vcBuff1,vcBuff2,vcBuff3);
	else 
		raise WIN_API.NOT_AVAILABLE;
	end if;  
	if (iRC = 0 ) then 
		WIN_API.Add_error('GenerateTempFilename returned no value');
		if (RaiseExceptions) then 
			raise NO_DATA_FOUND;
		end if;
	else 
		return vcBuff3;
	end if;
   exception
	when NO_DATA_FOUND then 
		raise;
	when WIN_API.NOT_AVAILABLE then
		Win_API.Add_error(Win_API.NoAPI);
		raise;
	when others then 
		Win_API.Add_error('GenerateTempFilename'||Win_API.UError||WIN_API.Add_External_errors); 
		raise;
   end Generate_Temp_Filename;

   FUNCTION Get_Active_Window (RaiseExceptions IN	BOOLEAN DEFAULT FALSE) RETURN PLS_INTEGER is
   begin 
	WIN_API.Clean_Error_Stack;
	iRC	:= 0;
	if WIN_API.API_ENABLED then 
		if not Win_API.Check_DLL_Handle(iGAWDLLCount)  then
	   	-- Register the interface to the function
	   		fh_GetAct := ora_ffi.register_function(Win_API.DLL_HANDLE,'d2kwutil_ActiveWin',ora_ffi.PASCAL_STD);
			ora_ffi.register_return(fh_GetAct,ORA_FFI.C_INT);
		end if;
		iRC 	:= externGAW(fh_GetAct);
	else 
		raise WIN_API.NOT_AVAILABLE;
	end if;  
	if iRC = 0 then 
		Win_API.Add_error('Unable to obtain active window handle');
		if RaiseExceptions then 
			raise NO_DATA_FOUND;
		end if;
	else
		return iRC;
	end if;
   exception
	when NO_DATA_FOUND then 
		raise;
	when WIN_API.NOT_AVAILABLE then
		Win_API.Add_error(Win_API.NoAPI);
		raise;
	when others then 
		Win_API.Add_error('GET_ACTIVE_WINDOW'||Win_API.UError||WIN_API.Add_External_errors); 
		raise;
   end Get_Active_window;

  PROCEDURE Play_WAV ( 	FileName	IN	VARCHAR2,
			Asynchronous	IN	BOOLEAN DEFAULT FALSE,
			RaiseExceptions	IN	BOOLEAN DEFAULT FALSE) is
  begin 
	WIN_API.Clean_Error_Stack;
	iRC	:= 0;
	if Win_API.API_ENABLED then 
		if not Win_API.Check_DLL_Handle(iPWFDLLCount)  then
	   	-- Register the interface to the function
	   		fh_PlayW := ora_ffi.register_function(Win_API.DLL_HANDLE,'d2kwutil_PlaySound',ora_ffi.PASCAL_STD);
     			ora_ffi.register_parameter(fh_PlayW,ORA_FFI.C_CHAR_PTR);
     			ora_ffi.register_parameter(fh_PlayW,ORA_FFI.C_LONG);
			ora_ffi.register_return(fh_PlayW,ORA_FFI.C_INT);
		end if;
		vcBuff1 := Filename;


		if Asynchronous then
			iBuff1 := 1; /* SND_ASYNC -> MMSYSTEM.H */
		else
			iBuff1 := 0; /* SND_SYNC -> MMSYSTEM.H */
		end if;
		iRC 	:= externPWF(fh_PlayW,vcBuff1,iBuff1);
	else 
		raise WIN_API.NOT_AVAILABLE;
	end if; 
	if iRC = 0 then 
		Win_API.Add_error('Unable to find Sound file '||FileName||', or this system cannot play sounds');
		if RaiseExceptions then 
			raise NO_DATA_FOUND;
		end if;
	end if;
   exception
	when NO_DATA_FOUND then 
		raise;
	when WIN_API.NOT_AVAILABLE then
		Win_API.Add_error(Win_API.NoAPI);
		raise;
	when others then 
		Win_API.Add_error('PLAY_WAV'||Win_API.UError||WIN_API.Add_External_errors); 
		raise;
   end Play_WAV;

  PROCEDURE Sleep ( 	SleepTime	IN	PLS_INTEGER) is

  begin 
	WIN_API.Clean_Error_Stack;
	iRC	:= 0;
	if Win_API.API_ENABLED then 
		if not Win_API.Check_DLL_Handle(iPWFDLLCount)  then
	   	-- Register the interface to the function
	   		fh_Sleep := ora_ffi.register_function(Win_API.DLL_HANDLE,'d2kwutil_Sleep',ora_ffi.PASCAL_STD);
     			ora_ffi.register_parameter(fh_Sleep,ORA_FFI.C_LONG);
			ora_ffi.register_return(fh_Sleep,ORA_FFI.C_INT);
		end if;
		iBuff1  := SleepTime;
		iRC 	:= externSLP(fh_Sleep,iBuff1);
	else 
		raise WIN_API.NOT_AVAILABLE;
	end if; 
   exception
	when NO_DATA_FOUND then 
		raise;
	when WIN_API.NOT_AVAILABLE then
		Win_API.Add_error(Win_API.NoAPI);
		raise;
	when others then 
		Win_API.Add_error('Sleep'||Win_API.UError||WIN_API.Add_External_errors); 
		raise;
   end Sleep;

  FUNCTION InterruptCheck ( 	ButtonHandle	IN	PLS_INTEGER) 
	RETURN BOOLEAN is

  begin 
	WIN_API.Clean_Error_Stack;
	iRC	:= 0;
	if Win_API.API_ENABLED then 
		if not Win_API.Check_DLL_Handle(iPBCDLLCount)  then
	   	-- Register the interface to the function
	   		fh_PeekBtnClick := ora_ffi.register_function(Win_API.DLL_HANDLE,
					'd2kwutil_PeekButtonClick',ora_ffi.PASCAL_STD);
     			ora_ffi.register_parameter(fh_PeekBtnClick,ORA_FFI.C_INT);
			ora_ffi.register_return(fh_PeekBtnClick,ORA_FFI.C_INT);
		end if;
		iBuff1  := ButtonHandle;
		iRC 	:= externPBC(fh_PeekBtnClick,iBuff1);
		if iRC = 0 then
			return FALSE;
		else
			return TRUE;
		end if;
	else 
		raise WIN_API.NOT_AVAILABLE;
	end if; 
   exception
	when NO_DATA_FOUND then 
		raise;
	when WIN_API.NOT_AVAILABLE then
		Win_API.Add_error(Win_API.NoAPI);
		raise;
	when others then 
		Win_API.Add_error('InterruptCheck'||Win_API.UError||WIN_API.Add_External_errors); 
		raise;
   end InterruptCheck;

END WIN_API_UTILITY;


PACKAGE BODY WIN_API_SHELL is

   -- Private persistant variables
   fh_WinExec		ora_ffi.funcHandleType;
   fh_WinHelp		ora_ffi.funcHandleType;
   fh_MousePos		ora_ffi.funcHandleType;
   fh_SM		ora_ffi.funcHandleType;
   fh_SendKeys		ora_ffi.funcHandleType;

   -- For the Call to Is_Application_Loaded;
   hThisModule		pls_integer;

   iWEXDLLCount		pls_integer	:= 0;
   iWMPDLLCount		pls_integer	:= 0;
   iSMDLLCount		pls_integer	:= 0;
   iSKDLLCount          pls_integer     := 0;
   vcBuff1		varchar2(512);
   vcBuff2		varchar2(2000);
   vcBuff3		varchar2(512);
   vcBuff4		varchar2(512);
   vcBuff5		varchar2(512);

   iBuff1		pls_integer;
   iBuff2		pls_integer;
   iRC			pls_integer;

   -- Private Program unit headers
   FUNCTION externWEX (		hFunc		IN	ORA_FFI.funcHandleType,
				Command		IN OUT	VARCHAR2,
				WindowStyle	IN 	PLS_INTEGER) return PLS_INTEGER;

   FUNCTION externWHPS(		hFunc		IN	ORA_FFI.funcHandleType,
				FileName	IN OUT	VARCHAR2,
				HelpStyle	IN 	PLS_INTEGER,
				Target		IN OUT	VARCHAR2) return PLS_INTEGER;

   FUNCTION externWHPD(		hFunc		IN	ORA_FFI.funcHandleType,
				FileName	IN OUT	VARCHAR2,
				HelpStyle	IN 	PLS_INTEGER,
				Target		IN 	PLS_INTEGER) return PLS_INTEGER;

   PROCEDURE externWMP (	hFunc		IN	ORA_FFI.funcHandleType,
				XPos		IN OUT	PLS_INTEGER,
				YPos		IN OUT	PLS_INTEGER);

   FUNCTION externSM(		hFunc		IN	ORA_FFI.funcHandleType,
				hWnd		IN 	PLS_INTEGER,
				uMsg		IN 	PLS_INTEGER,
				wParam		IN 	PLS_INTEGER,
				lParam		IN 	PLS_INTEGER) return PLS_INTEGER;

   FUNCTION externSK(		hFunc		IN	ORA_FFI.funcHandleType,
				hWnd		IN	PLS_INTEGER,
				Keys		IN OUT  VARCHAR2)    return PLS_INTEGER;

   -- Pragmas
   PRAGMA INTERFACE(C,externWEX,11265);
   PRAGMA INTERFACE(C,externWHPS,11265);
   PRAGMA INTERFACE(C,externWHPD,11265);
   PRAGMA INTERFACE(C,externWMP,11265);
   PRAGMA INTERFACE(C,externSM,11265);
   PRAGMA INTERFACE(C,externSK,11265);

   -- Public Bodies 
PROCEDURE WinExec (	Command		IN	VARCHAR2,
			WindowStyle 	IN	PLS_INTEGER DEFAULT WIN_API.SW_SHOWNORMAL,
			RaiseExceptions IN	BOOLEAN DEFAULT FALSE) is
   begin 
	Win_API.Clean_Error_Stack;
	iRC	:= 0;
	if Win_API.API_ENABLED then 
		if not Win_API.Check_DLL_Handle(iWEXDLLCount)  then
	   	-- Register the interface to the function
	   		fh_WinExec := ora_ffi.register_function(Win_API.DLL_HANDLE,'d2kwutil_WinExec',ora_ffi.PASCAL_STD);
     			ora_ffi.register_parameter(fh_WinExec,ORA_FFI.C_CHAR_PTR);
     			ora_ffi.register_parameter(fh_WinExec,ORA_FFI.C_INT);
			ora_ffi.register_return(fh_WinExec,ORA_FFI.C_INT);
		end if;

		vcBuff1		:= Command;
		iRC 	:= externWEX(fh_WinExec,vcBuff1,WindowStyle);
	else 
		raise WIN_API.NOT_AVAILABLE;
	end if;  
	if iRC < 31 then 
		Win_API.Add_error('Unable to execute '||Command);
		if RaiseExceptions then 
			raise NO_DATA_FOUND;
		end if;
	end if;
   exception
	when NO_DATA_FOUND then 
		raise;
	when WIN_API.NOT_AVAILABLE then
		Win_API.Add_error(Win_API.NoAPI);
		raise;
	when others then
		Win_API.Add_error('WINEXEC'||Win_API.UError||WIN_API.Add_External_errors); 
		raise;
   end WinExec;

PROCEDURE WinHelp (	HelpFile 	IN	VARCHAR2,
			Target		IN	VARCHAR2,
			HelpType	IN	PLS_INTEGER,
			RaiseExceptions IN	BOOLEAN 	DEFAULT FALSE) is
   begin 
	Win_API.Clean_Error_Stack;
	iRC	:= 0;
	if Win_API.API_ENABLED then 
		-- Help Finder is really just on 95
		if not WIN_API.IS32BIT and HelpType = WIN_API.HELP_FINDER then 
			raise WIN_API.CALL_NOT_ALLOWED;
		end if;
	   	-- As we use the same interface with different args always
		-- Register the interface to the function
	   	fh_WinHelp := ora_ffi.register_function(Win_API.DLL_HANDLE,'d2kwutil_WinHelp',ora_ffi.PASCAL_STD);
     		ora_ffi.register_parameter(fh_WinHelp,ORA_FFI.C_CHAR_PTR);
     		ora_ffi.register_parameter(fh_WinHelp,ORA_FFI.C_INT);
			
		if HelpType in(WIN_API.HELP_KEY,WIN_API.HELP_PARTIALKEY) then
      			ora_ffi.register_parameter(fh_WinHelp,ORA_FFI.C_CHAR_PTR);
		else
      			ora_ffi.register_parameter(fh_WinHelp,ORA_FFI.C_LONG);
		end if;
		ora_ffi.register_return(fh_WinHelp,ORA_FFI.C_INT);
	else 
		raise WIN_API.NOT_AVAILABLE;
	end if;

	vcBuff1		:= HelpFile;
	vcBuff2		:= Target;
	iBuff1		:= NULL;
	if HelpType in(WIN_API.HELP_KEY,WIN_API.HELP_PARTIALKEY) then 
		iRC 	:= externWHPS(fh_WinHelp,vcBuff1,HelpType,vcBuff2);
	elsif HelpType in  (WIN_API.HELP_INDEX, WIN_API.HELP_QUIT,WIN_API.HELP_FINDER) then 
		iRC 	:= externWHPD(fh_WinHelp,vcBuff1,HelpType,0);
	else
		iBuff2 := to_number(vcBuff2);
		iRC 	:= externWHPD(fh_WinHelp,vcBuff1,HelpType,iBuff2);
	end if; 
	if iRC = 0 then 
		Win_API.Add_error('Unable to locate Help file :'||HelpFile);
		if RaiseExceptions then 
			raise NO_DATA_FOUND;
		end if;
	end if;
   exception
	when NO_DATA_FOUND then 
		raise;
	when VALUE_ERROR then 
		Win_API.Add_error('When accessing Help a string was supplied in place of a Topic number');
		raise;
	when WIN_API.NOT_AVAILABLE then
		Win_API.Add_error(Win_API.NoAPI);
		raise;
	when others then 
		Win_API.Add_error('WINHELP'||Win_API.UError||WIN_API.Add_External_errors);
		raise;
   end WinHelp;

PROCEDURE MousePosition (	Xpos 	OUT	NUMBER,
				Ypos	OUT	NUMBER) is
   begin 
	Win_API.Clean_Error_Stack;
	iRC	:= 0;
	if Win_API.API_ENABLED then 
		if not Win_API.Check_DLL_Handle(iWMPDLLCount)  then
	   	-- Register the interface to the function
	   		fh_MousePos := ora_ffi.register_function(Win_API.DLL_HANDLE,'d2kwutil_Mouse_x_y',ora_ffi.PASCAL_STD);
     			ora_ffi.register_parameter(fh_MousePos,ORA_FFI.C_INT_PTR);
     			ora_ffi.register_parameter(fh_MousePos,ORA_FFI.C_INT_PTR);
		end if;

		iBuff1		:= 0;
		iBuff2		:= 0;
		externWMP(fh_MousePos,iBuff1,iBuff2);
		Xpos := iBuff1;
		Ypos := iBuff2;
	else 
		raise WIN_API.NOT_AVAILABLE;
	end if;  
   exception
	when WIN_API.NOT_AVAILABLE then
		Win_API.Add_error(Win_API.NoAPI);
		raise;
	when others then 
		Win_API.Add_error('MOUSEPOSITION'||Win_API.UError||WIN_API.Add_External_errors); 
		raise;
   end MousePosition;

  PROCEDURE SendMessage (	Target		IN	PLS_INTEGER,
			MessageCode	IN	PLS_INTEGER,
			Param1		IN	PLS_INTEGER DEFAULT 0,
			Param2		IN	PLS_INTEGER DEFAULT 0,
			RaiseExceptions IN	BOOLEAN	DEFAULT FALSE) is
   begin 
	Win_API.Clean_Error_Stack;
	iRC	:= 0;
	if Win_API.API_ENABLED then 
		if not Win_API.Check_DLL_Handle(iSMDLLCount)  then
	   	-- Register the interface to the function
	   		fh_SM := ora_ffi.register_function(Win_API.DLL_HANDLE,'d2kwutil_SendMsg',ora_ffi.PASCAL_STD);
     			ora_ffi.register_parameter(fh_SM,ORA_FFI.C_INT);
     			ora_ffi.register_parameter(fh_SM,ORA_FFI.C_INT);
     			ora_ffi.register_parameter(fh_SM,ORA_FFI.C_INT);
     			ora_ffi.register_parameter(fh_SM,ORA_FFI.C_LONG);
     			ora_ffi.register_return(fh_SM,ORA_FFI.C_INT);
		end if;

		iRC := externSM(fh_SM,Target, MessageCode, Param1, Param2);
		if iRC <> 0 then
			Win_API.Add_error('SendMessage '||to_char(MessageCode)||' with parameters '||to_char(Param1)||'/'||to_char(Param2)||' to window '||to_char(Target)||', returned a Non-Zero return code ('||to_char(iRC)||')');
			if RaiseExceptions then 
				raise NO_DATA_FOUND;
			end if;
		end if; 
	else 
		raise WIN_API.NOT_AVAILABLE;
	end if;  
   exception
	when NO_DATA_FOUND then 
		raise;
	when WIN_API.NOT_AVAILABLE then
		Win_API.Add_error(Win_API.NoAPI);
		raise;
	when others then
		Win_API.Add_error('SENDMESSAGE'||Win_API.UError||WIN_API.Add_External_errors);  
		raise;
   end SendMessage;

  PROCEDURE SendKeys	 (Hwnd          IN      PLS_INTEGER,
			Keys		IN	VARCHAR2,
			RaiseExceptions IN	BOOLEAN	DEFAULT FALSE) is  
  begin 
	Win_API.Clean_Error_Stack;
	iRC	:= 0;
	if Win_API.API_ENABLED then 
		if not Win_API.Check_DLL_Handle(iSKDLLCount)  then
	   	-- Register the interface to the function

	   		fh_SendKeys := ora_ffi.register_function(Win_API.DLL_HANDLE,'d2kwutil_SendKeys',ora_ffi.PASCAL_STD);
     			ora_ffi.register_parameter(fh_SendKeys,ORA_FFI.C_INT);
     			ora_ffi.register_parameter(fh_SendKeys,ORA_FFI.C_CHAR_PTR);
     			ora_ffi.register_return(fh_SendKeys,ORA_FFI.C_INT);
		end if;
		vcbuff1 := rpad(keys,255,chr(0));
		iBuff1 := hWnd;
		iRC := externSK(fh_SendKeys,iBuff1, vcbuff1);
		if iRC <> 0 then
		    	
			if iRC = 2 then
                        Win_API.Add_error('SendKeys: Missing close brace } in key string '||Keys);
			elsif iRC = 3 then
			Win_API.Add_error('SendKeys: Invalid Key in key string '||Keys);
			elsif iRC = 4 then
			Win_API.Add_error('SendKeys: Missing Close Parenthesis ) in key string '||Keys);
			elsif iRC = 5 then
			Win_API.Add_error('SendKeys: Invalid count in key string '||Keys);
			elsif iRC = 6 then
			Win_API.Add_error('SendKeys: Key string too long - '||Keys);
			elsif iRC = 7 then
			Win_API.Add_error('SendKeys: Can''t install hook');
			else
			Win_API.Add_error('SendKeys: Unknown error message = '|| to_char(iRC));
			end if;
			
			if RaiseExceptions then 
				raise NO_DATA_FOUND;
			end if;
		end if; 
	else 
		raise WIN_API.NOT_AVAILABLE;
	end if;  
   exception
	when NO_DATA_FOUND then 
		raise;
	when WIN_API.NOT_AVAILABLE then
		Win_API.Add_error(Win_API.NoAPI);
		raise;
	when others then
		Win_API.Add_error('SendKeys: '||Win_API.UError||WIN_API.Add_External_errors);  
		raise;
   end SendKeys;

END WIN_API_SHELL;


PACKAGE BODY win_api_session IS
  	
   -- Private persistant variables
   fh_OneSession		ora_ffi.funcHandleType;
   fh_ChangeIcon		ora_ffi.funcHandleType;
   fh_ChangeCursor		ora_ffi.funcHandleType;
   fh_TimeOutInit		ora_ffi.funcHandleType;
   fh_TimeOutElapsed		ora_ffi.funcHandleType;
   fh_TimeOutUnHook		ora_ffi.funcHandleType;

   -- For the Call to Is_Application_Loaded;
   hThisModule		pls_integer;

   iONESESSDLLCount	pls_integer	:= 0;
   iICONDLLCount	pls_integer	:= 0;
   iCurCount		pls_integer	:= 0;
   iINITDLLCount	pls_integer	:= 0;
   iELAPSEDDLLCount	pls_integer	:= 0;
   iUNHOOKDLLCount	pls_integer	:= 0;

   vcBuff1		varchar2(512);
   vcBuff2		varchar2(512);
   vcBuff3		varchar2(512);
   iBuff1		pls_integer;
   iBuff2		pls_integer;
   iBuff3		pls_integer;
   iRC			pls_integer;

  -- Private Program unit headers
  FUNCTION externONESESS (	hFunc		IN 	ORA_FFI.funcHandleType,
				WindowTitle	IN OUT	VARCHAR2,
				ModuleName	IN OUT  VARCHAR2,
				Class		IN OUT  VARCHAR2,
				Activate	IN	PLS_INTEGER)
	return PLS_INTEGER;


  FUNCTION externICON	(	hFunc		IN	ORA_FFI.funcHandleType,
				hWnd		IN	PLS_INTEGER,
				IconFile	IN OUT	VARCHAR2,
				IconIndex	IN 	PLS_INTEGER,
				IconFileSM	IN OUT	VARCHAR2,
				IconIndexSM	IN	PLS_INTEGER)
	return	PLS_INTEGER;

  FUNCTION externCursor (	hFunc		IN	ORA_FFI.funcHandleType,
				CursorName	IN OUT 	VARCHAR2)
	return PLS_INTEGER;

  FUNCTION externINIT	 (	hFunc		IN 	ORA_FFI.funcHandleType,
				hWnd		IN 	PLS_INTEGER)
	return PLS_INTEGER;

  FUNCTION externELAPSED (	fFunc		IN	ORA_FFI.funcHandleType)
	return	NUMBER;

  FUNCTION externUNHOOK  (	fFunc		IN	ORA_FFI.funcHandleType)
	return PLS_INTEGER;


   -- Pragmas
   PRAGMA INTERFACE(C,externONESESS,11265);
   PRAGMA INTERFACE(C,externICON,11265);
   PRAGMA INTERFACE(C,externCursor,11265);
   PRAGMA INTERFACE(C,externINIT,11265);
   PRAGMA INTERFACE(C,externELAPSED,11265);
   PRAGMA INTERFACE(C,externUNHOOK,11265);

   -- Public Bodies

function One_Session(	WindowTitle     IN VARCHAR2,
			ModuleName	IN VARCHAR2,
			MatchType	IN VARCHAR2,
			Activate	BOOLEAN,
			Class		IN VARCHAR2 DEFAULT WIN_API.D2K_WINDOW_CLASS,
			RaiseExceptions IN BOOLEAN DEFAULT FALSE)  return BOOLEAN IS
   BEGIN
	Win_API.Clean_Error_Stack;
	iRC	:= 0;
	if Win_API.API_ENABLED then 
		if not Win_API.Check_DLL_Handle(iONESESSDLLCount)  then
	   	-- Register the interface to the function
	   		fh_OneSession := ora_ffi.register_function(Win_API.DLL_HANDLE,'d2kwutil_OneSession',ora_ffi.PASCAL_STD);
     			ora_ffi.register_parameter(fh_OneSession,ORA_FFI.C_CHAR_PTR);
     			ora_ffi.register_parameter(fh_OneSession,ORA_FFI.C_CHAR_PTR);
     			ora_ffi.register_parameter(fh_OneSession,ORA_FFI.C_CHAR_PTR);
     			ora_ffi.register_parameter(fh_OneSession,ORA_FFI.C_INT);
			ora_ffi.register_return(fh_OneSession,ORA_FFI.C_INT);
		end if;

		IF (MatchType = 'MODULE') 	THEN ibuff1 := 1;
		ELSIF (MatchType = 'WINDOW') 	THEN ibuff1 := 2;
		ELSE 				ibuff1 := 3;
		END IF;

		IF (Activate) THEN
			ibuff1 := ibuff1 + 3;
		END IF;
		vcBuff1		:= WindowTitle;
		vcBuff2		:= ModuleName;
	        vcBuff3		:= Class;
		iRC 	:= externONESESS(fh_OneSession,vcBuff1,vcBuff2,vcBuff3,iBuff1);
	else 
		raise WIN_API.NOT_AVAILABLE;
	end if;  
	if iRC = 0 and RaiseExceptions then 
		raise NO_DATA_FOUND;
	elsif iRC = 0 then 
        	return(FALSE);
	else 
		return TRUE;
	end if;
   exception
	when NO_DATA_FOUND then 
		raise;
	when WIN_API.NOT_AVAILABLE then
		Win_API.Add_error(Win_API.NoAPI);
		raise;
	when others then
		Win_API.Add_error('One_Session: '||Win_API.UError||WIN_API.Add_External_errors); 
		raise;
   END One_Session;

procedure Change_MDI_Icon(	MDIWindow	IN PLS_INTEGER,
				IconFile	IN VARCHAR2,
				IconIndex	IN PLS_INTEGER DEFAULT 0) IS
   BEGIN
	Win_API.Clean_Error_Stack;
	iRC	:= 0;
	if Win_API.API_ENABLED then 
		if not Win_API.Check_DLL_Handle(iICONDLLCount)  then
	   	-- Register the interface to the function
	   		fh_ChangeIcon := ora_ffi.register_function(Win_API.DLL_HANDLE,'d2kwutil_ChangeMDIIcon',ora_ffi.PASCAL_STD);
			ora_ffi.register_parameter(fh_ChangeIcon,ORA_FFI.C_INT); 
    			ora_ffi.register_parameter(fh_ChangeIcon,ORA_FFI.C_CHAR_PTR);
     			ora_ffi.register_parameter(fh_ChangeIcon,ORA_FFI.C_INT);
     			ora_ffi.register_parameter(fh_ChangeIcon,ORA_FFI.C_CHAR_PTR);
     			ora_ffi.register_parameter(fh_ChangeIcon,ORA_FFI.C_INT);
			ora_ffi.register_return(fh_ChangeIcon,ORA_FFI.C_INT);
		end if;

		vcBuff1		:= rpad(IconFile,255,chr(0));
		vcBuff2		:= rpad(IconFile,255,chr(0));

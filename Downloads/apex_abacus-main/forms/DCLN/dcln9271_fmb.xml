      <ProgramUnit Name="PRINT_CHECK_VAL" ProgramUnitText="&amp;#10;---------------------------------------------------&amp;#10;PROCEDURE PRINT_CHECK_VAL IS&amp;#10; &amp;#10; &amp;#10;   pl_id            paramlist;&amp;#10;   v_report_file    VARCHAR2 (100);&amp;#10;   v_count          NUMBER (5);&amp;#10;   x                NUMBER (7);&amp;#10;   y                NUMBER (7);&amp;#10;   c_date           DATE;&amp;#10;   p_curr_port_cd   NUMBER;&amp;#10;   v_rep_file       VARCHAR2 (30);&amp;#10;   v_ret            BOOLEAN;&amp;#10;   o_msg            VARCHAR2 (200);&amp;#10;   v_msg_lvl        NUMBER;&amp;#10;BEGIN&amp;#10;   v_ret := dcltn.check_salvage (:port_cd, :dcltn_isn, o_msg);&amp;#10;&amp;#10;   IF v_ret&amp;#10;   THEN&amp;#10;      FORMS_DDL('COMMIT');&amp;#10;      &amp;#10;      pl_id := GET_PARAMETER_LIST ('tmpdata');&amp;#10;&amp;#10;      IF NOT ID_NULL (pl_id)&amp;#10;      THEN&amp;#10;         DESTROY_PARAMETER_LIST (pl_id);&amp;#10;      END IF;&amp;#10;&amp;#10;      pl_id := CREATE_PARAMETER_LIST ('tmpdata');&amp;#10;-- طباعه او على الشاشه&amp;#10;     -- ADD_PARAMETER (pl_id, 'DESTYPE', text_parameter, 'SCREEN');&amp;#10;       Add_Parameter(pl_id,'DESTYPE',TEXT_PARAMETER,'PRINTER');&amp;#10;      ADD_PARAMETER (pl_id, 'PARAMFORM', text_parameter, 'NO');&amp;#10;      ADD_PARAMETER (pl_id, 'PRINTJOB', text_parameter, 'YES');&amp;#10;      -- Add_Parameter(pl_id,'P_SHP_AGNT_NBR',TEXT_PARAMETER,:LICE_NO);&amp;#10;      -- Add_Parameter(pl_id,'P_TYPE',TEXT_PARAMETER, :P_TYPE);&amp;#10;      ADD_PARAMETER (pl_id, 'P_CURR_PORT_CD', text_parameter, :port_cd);&amp;#10;      --ADD_PARAMETER (pl_id, 'P_REPORT_NO', text_parameter, :report_no);&amp;#10;      ADD_PARAMETER (pl_id,&amp;#10;                     'P_MODULE_NAME',&amp;#10;                     text_parameter,&amp;#10;                     :parameter.p_module_name&amp;#10;                    );&amp;#10;       &amp;#10;&amp;#10;      ------- حالة الجدول فعال او غير فعال&amp;#10;       --  Add_Parameter(pl_id,'P_STATUS',TEXT_PARAMETER, :RG_STATUS); p_nbr&amp;#10;&amp;#10;      -------------add report user parameters ---------------&amp;#10;      Add_Parameter(pl_id,'P_DCLTN_ISN',TEXT_PARAMETER, :DCLTN_ISN);&amp;#10;      -------------end add report parameters ---------------&amp;#10;       &amp;#10;      ADD_PARAMETER (pl_id, 'ORACLE_SHUTDOWN', text_parameter, 'YES');&amp;#10;      &amp;#10;      v_rep_file := 'DCLN9271.REP';  &amp;#10;                             &amp;#10;      --V_REPORT_FILE := :PARAMETER.P_REPORT_PATH||:PARAMETER.P_REPORT_FILE;&amp;#10;      --v_report_file := :parameter.p_report_path || v_rep_file;&amp;#10;           V_REPORT_FILE := 'D:\PROD\CSTMS_DCLTN\REP\'||V_REP_FILE;&amp;#10;     -- MESSAGE (:parameter.p_report_file);&amp;#10;      REP.Run_Product (reports,&amp;#10;                   v_report_file,&amp;#10;                   synchronous,&amp;#10;                   runtime,&amp;#10;                   filesystem,&amp;#10;                   pl_id,&amp;#10;                   NULL&amp;#10;                  );&amp;#10;      NULL;&amp;#10;   ELSE&amp;#10;      MESSAGE ('لا يوجد سجلات تحقق المطلوب');&amp;#10;      MESSAGE ('لا يوجد سجلات تحقق المطلوب');&amp;#10;      RAISE form_trigger_failure;&amp;#10;   END IF;&amp;#10;END;" ProgramUnitType="Procedure"/>
      <ProgramUnit Name="P_ORDER" ProgramUnitText="/*&amp;#10;NEW DECSUB CLASS&amp;#10;DESCRIPTION: TO SET WINDOW PROPERTY&amp;#10;PROGRAMMER : MOHAMED HABIB&amp;#10;VERSION    : 1.&amp;#10;DATE       : 18-4-2010&amp;#10;*/-----------------------------------------------&amp;#10;PROCEDURE P_ORDER IS&amp;#10;BEGIN&amp;#10;/*IF :CALLING_PARAMETERS.ORDER = 'A' THEN&amp;#10;&#x9; &#x9;:parameter.V_ORDER := ' ORDER BY ( '||:F_NAME||') ' ;&amp;#10;ELSE&amp;#10;:parameter.V_ORDER := ' ORDER BY ( '||:F_NAME||') DESC' ;&amp;#10;END IF;&amp;#10;*/&amp;#10;NULL;&amp;#10;END ;" ProgramUnitType="Procedure"/>
      <ProgramUnit Name="CHECK_VAL" ProgramUnitText="/* Formatted on 2013/11/21 10:53 (Formatter Plus v4.8.8) */&amp;#10;--------------------------------------------&amp;#10;&amp;#10;PROCEDURE check_val&amp;#10;IS&amp;#10;   pl_id            paramlist;&amp;#10;   v_report_file    VARCHAR2 (100);&amp;#10;   v_count          NUMBER (5);&amp;#10;   x                NUMBER (7);&amp;#10;   y                NUMBER (7);&amp;#10;   c_date           DATE;&amp;#10;   p_curr_port_cd   NUMBER;&amp;#10;   v_rep_file       VARCHAR2 (30);&amp;#10;   v_ret            BOOLEAN;&amp;#10;   o_msg            VARCHAR2 (200);&amp;#10;   v_msg_lvl        NUMBER;&amp;#10;BEGIN&amp;#10;   v_ret := dcltn.check_salvage (:port_cd, :dcltn_isn, o_msg);&amp;#10;&amp;#10;   IF v_ret&amp;#10;   THEN&amp;#10;      FORMS_DDL('COMMIT');&amp;#10;      &amp;#10;      pl_id := GET_PARAMETER_LIST ('tmpdata');&amp;#10;&amp;#10;      IF NOT ID_NULL (pl_id)&amp;#10;      THEN&amp;#10;         DESTROY_PARAMETER_LIST (pl_id);&amp;#10;      END IF;&amp;#10;&amp;#10;      pl_id := CREATE_PARAMETER_LIST ('tmpdata');&amp;#10;-- طباعه او على الشاشه&amp;#10;      ADD_PARAMETER (pl_id, 'DESTYPE', text_parameter, 'SCREEN');&amp;#10;      -- Add_Parameter(pl_id,'DESTYPE',TEXT_PARAMETER,'PRINTER');&amp;#10;      ADD_PARAMETER (pl_id, 'PARAMFORM', text_parameter, 'NO');&amp;#10;      ADD_PARAMETER (pl_id, 'PRINTJOB', text_parameter, 'YES');&amp;#10;      -- Add_Parameter(pl_id,'P_SHP_AGNT_NBR',TEXT_PARAMETER,:LICE_NO);&amp;#10;      -- Add_Parameter(pl_id,'P_TYPE',TEXT_PARAMETER, :P_TYPE);&amp;#10;      ADD_PARAMETER (pl_id, 'P_CURR_PORT_CD', text_parameter, :port_cd);&amp;#10;      --ADD_PARAMETER (pl_id, 'P_REPORT_NO', text_parameter, :report_no);&amp;#10;      ADD_PARAMETER (pl_id,&amp;#10;                     'P_MODULE_NAME',&amp;#10;                     text_parameter,&amp;#10;                     :parameter.p_module_name&amp;#10;                    );&amp;#10;       &amp;#10;&amp;#10;      ------- حالة الجدول فعال او غير فعال&amp;#10;       --  Add_Parameter(pl_id,'P_STATUS',TEXT_PARAMETER, :RG_STATUS); p_nbr&amp;#10;&amp;#10;      -------------add report user parameters ---------------&amp;#10;      Add_Parameter(pl_id,'P_DCLTN_ISN',TEXT_PARAMETER, :DCLTN_ISN);&amp;#10;      -------------end add report parameters ---------------&amp;#10;       &amp;#10;      ADD_PARAMETER (pl_id, 'ORACLE_SHUTDOWN', text_parameter, 'YES');&amp;#10;      &amp;#10;      v_rep_file := 'DCLN9271.REP';  &amp;#10;                             &amp;#10;      --V_REPORT_FILE := :PARAMETER.P_REPORT_PATH||:PARAMETER.P_REPORT_FILE;&amp;#10;      --v_report_file := :parameter.p_report_path || v_rep_file;&amp;#10;           V_REPORT_FILE := 'D:\PROD\CSTMS_DCLTN\REP\'||V_REP_FILE;&amp;#10;     -- MESSAGE (:parameter.p_report_file);&amp;#10;      REP.Run_Product (reports,&amp;#10;                   v_report_file,&amp;#10;                   synchronous,&amp;#10;                   runtime,&amp;#10;                   filesystem,&amp;#10;                   pl_id,&amp;#10;                   NULL&amp;#10;                  );&amp;#10;      NULL;&amp;#10;   ELSE&amp;#10;      MESSAGE ('لا يوجد سجلات تحقق المطلوب');&amp;#10;      MESSAGE ('لا يوجد سجلات تحقق المطلوب');&amp;#10;      RAISE form_trigger_failure;&amp;#10;   END IF;&amp;#10;END;" ProgramUnitType="Procedure"/>
      <ProgramUnit Name="CGDV$POPULATE_DYNAMIC_LISTS" ProgramUnitText="/*&amp;#10;NEW DECSUB CLASS&amp;#10;DESCRIPTION: TO SET WINDOW PROPERTY&amp;#10;PROGRAMMER : MOHAMED HABIB&amp;#10;VERSION    : 1.&amp;#10;DATE       : 18-4-2010&amp;#10;*/&amp;#10;---------------------------------------------------&amp;#10;PROCEDURE CGDV$POPULATE_DYNAMIC_LISTS IS&amp;#10;&amp;#10;  temp NUMBER;  &amp;#10;  rg_id RECORDGROUP; &amp;#10;BEGIN&amp;#10;  rg_id := create_group_from_query('CGDV$DLRG',&amp;#10;    'SELECT RV_MEANING, RV_LOW_VALUE '||&amp;#10;    'FROM   CG_REF_CODES '||&amp;#10;    'WHERE  RV_DOMAIN = ''AGNT_STATUS'' '||&amp;#10;    'ORDER BY  2');&amp;#10;  temp := populate_group(rg_id);&amp;#10;  populate_list('CALLING_PARAMETERS.P_TYPE', rg_id);&amp;#10;  delete_group(rg_id);&amp;#10;/*&amp;#10;  rg_id := create_group_from_query('CGDV$DLRG',&amp;#10;    'SELECT RV_MEANING, RV_LOW_VALUE '||&amp;#10;    'FROM   CG_REF_CODES '||&amp;#10;    'WHERE  RV_DOMAIN = ''INST_STATUS'' '||&amp;#10;    'ORDER BY  2');&amp;#10;  temp := populate_group(rg_id);&amp;#10;  populate_list('CSTMS_INSTS.INST_STATUS', rg_id);&amp;#10;  delete_group(rg_id);&amp;#10;&amp;#10;  rg_id := create_group_from_query('CGDV$DLRG',&amp;#10;    'SELECT RV_MEANING, RV_LOW_VALUE '||&amp;#10;    'FROM   CG_REF_CODES '||&amp;#10;    'WHERE  RV_DOMAIN = ''LIC_TYPE'' '||&amp;#10;    'ORDER BY  2');&amp;#10;  temp := populate_group(rg_id);&amp;#10;  populate_list('CSTMS_INSTS.BRKR_LIC_TYPE', rg_id);&amp;#10;  delete_group(rg_id);&amp;#10;&amp;#10;  rg_id := create_group_from_query('CGDV$DLRG',&amp;#10;    'SELECT RV_MEANING, RV_LOW_VALUE '||&amp;#10;    'FROM   CG_REF_CODES '||&amp;#10;    'WHERE  RV_DOMAIN = ''PORT_TYPE_CD'' '||&amp;#10;    'ORDER BY  2');&amp;#10;  temp := populate_group(rg_id);&amp;#10;  populate_list('CSTMS_INSTS.FP_PORT_TYPE_CD', rg_id);&amp;#10;  delete_group(rg_id);&amp;#10;*/&amp;#10;END;" ProgramUnitType="Procedure"/>
      <ProgramUnit Name="CHK_SALVAG" ProgramUnitText="PROCEDURE CHK_SALVAG IS &amp;#10;   v_ret   BOOLEAN;&amp;#10;   o_msg   VARCHAR2 (200);&amp;#10;   v_msg_lvl NUMBER ;&amp;#10;BEGIN&amp;#10;   v_ret := dcltn.check_salvage (:PORT_CD, :DCLTN_ISN, o_msg);&amp;#10;&amp;#10;   IF v_ret&amp;#10;   THEN&amp;#10;&#x9;STR.DISPALERT(o_msg,'ERROR');&amp;#10;&#x9;--:System.Message_Level := 25;&amp;#10;&#x9;&#x9;FORMS_DDL('COMMIT');&amp;#10;&#x9;--:System.Message_Level := v_msg_lvl;&amp;#10;&#x9;RAISE FORM_TRIGGER_FAiLURE ;&amp;#10;   END IF;&amp;#10;END; " ProgramUnitType="Procedure"/>
      <ProgramUnit Name="FILL_DCLTN_ISN" ProgramUnitText="PROCEDURE FILL_DCLTN_ISN IS&amp;#10;BEGIN&amp;#10;  IF :PORT_CD IS NOT NULL AND :DCLTN_DT IS NOT NULL AND :DCLTN_NBR IS NOT NULL THEN&amp;#10;  &#x9;&amp;#10;  &#x9;SELECT DCLTN_ISN&amp;#10;  &#x9;INTO :DCLTN_ISN&amp;#10;  &#x9;FROM DECLARATIONS&amp;#10;  &#x9;WHERE PORT_CD   = :PORT_CD&amp;#10;  &#x9; &#x9;AND DCLTN_NBR = :DCLTN_NBR&amp;#10;  &#x9; &#x9;AND DCLTN_DT  = :DCLTN_DT&amp;#10;  &#x9; &#x9;;&amp;#10;  END IF;&amp;#10;  EXCEPTION&#x9;&amp;#10;  &#x9;&#x9;&#x9;WHEN OTHERS THEN&amp;#10;  &#x9;&#x9;&#x9;&#x9;:DCLTN_ISN := NULL ;&amp;#10;END;" ProgramUnitType="Procedure"/>

-- Bodies for Public PUs
   FUNCTION  str_1252_to_pos(
			win_str             	IN OUT	VARCHAR2,
			sz                  	IN OUT	PLS_INTEGER,
			pos_str             	IN OUT	VARCHAR2
			)  RETURN PLS_INTEGER IS
	RC                   		PLS_INTEGER;
	l_win_str                     	VARCHAR2(256)	:= RPAD(SUBSTR(NVL(win_str,' '),1,256),256,CHR(0));
	l_sz                          	PLS_INTEGER	:= sz;
	l_pos_str                     	VARCHAR2(256)	:= RPAD(SUBSTR(NVL(pos_str,' '),1,256),256,CHR(0));
   BEGIN

	rc := i_str_1252_to_pos(
			fh_str_1252_to_pos,
			l_win_str,
			l_sz,
			l_pos_str);
	win_str                       	:= l_win_str;
	sz                            	:= l_sz;
	pos_str                       	:= l_pos_str;
   RETURN RC;
   END str_1252_to_pos;

   FUNCTION  sc_send_payment_details(
			port_no             	IN OUT	VARCHAR2,
			doc_type            	IN OUT	VARCHAR2,
			doc_no              	IN OUT	VARCHAR2,
			doc_date            	IN OUT	VARCHAR2,
			amount_paid         	IN OUT	PLS_INTEGER,
			rcpt_msg            	IN OUT	VARCHAR2,
			pay_status          	IN OUT	PLS_INTEGER,
			card_id             	IN OUT	VARCHAR2,
			txn_auth_code       	IN OUT	VARCHAR2,
			txn_no              	IN OUT	VARCHAR2,
			txn_date            	IN OUT	VARCHAR2,
			txn_comp_code       	IN OUT	VARCHAR2,
			txn_msg             	IN OUT	VARCHAR2
			)  RETURN PLS_INTEGER IS
	RC                   		PLS_INTEGER;
	l_port_no                     	VARCHAR2(256)	:= RPAD(SUBSTR(NVL(port_no,' '),1,256),256,CHR(0));
	l_doc_type                    	VARCHAR2(256)	:= RPAD(SUBSTR(NVL(doc_type,' '),1,256),256,CHR(0));
	l_doc_no                      	VARCHAR2(256)	:= RPAD(SUBSTR(NVL(doc_no,' '),1,256),256,CHR(0));
	l_doc_date                    	VARCHAR2(256)	:= RPAD(SUBSTR(NVL(doc_date,' '),1,256),256,CHR(0));
	l_amount_paid                 	PLS_INTEGER	:= amount_paid;
	l_rcpt_msg                    	VARCHAR2(256)	:= RPAD(SUBSTR(NVL(rcpt_msg,' '),1,256),256,CHR(0));
	l_pay_status                  	PLS_INTEGER	:= pay_status;
	l_card_id                     	VARCHAR2(256)	:= RPAD(SUBSTR(NVL(card_id,' '),1,256),256,CHR(0));
	l_txn_auth_code               	VARCHAR2(256)	:= RPAD(SUBSTR(NVL(txn_auth_code,' '),1,256),256,CHR(0));
	l_txn_no                      	VARCHAR2(256)	:= RPAD(SUBSTR(NVL(txn_no,' '),1,256),256,CHR(0));
	l_txn_date                    	VARCHAR2(256)	:= RPAD(SUBSTR(NVL(txn_date,' '),1,256),256,CHR(0));
	l_txn_comp_code               	VARCHAR2(256)	:= RPAD(SUBSTR(NVL(txn_comp_code,' '),1,256),256,CHR(0));
	l_txn_msg                     	VARCHAR2(256)	:= RPAD(SUBSTR(NVL(txn_msg,' '),1,256),256,CHR(0));
   BEGIN

	rc := i_sc_send_payment_details(
			fh_sc_send_payment_details,
			l_port_no,
			l_doc_type,
			l_doc_no,
			l_doc_date,
			l_amount_paid,
			l_rcpt_msg,
			l_pay_status,
			l_card_id,
			l_txn_auth_code,
			l_txn_no,
			l_txn_date,
			l_txn_comp_code,
			l_txn_msg);
	port_no                       	:= l_port_no;
	doc_type                      	:= l_doc_type;
	doc_no                        	:= l_doc_no;
	doc_date                      	:= l_doc_date;
	amount_paid                   	:= l_amount_paid;
	rcpt_msg                      	:= l_rcpt_msg;
	pay_status                    	:= l_pay_status;
	card_id                       	:= l_card_id;
	txn_auth_code                 	:= l_txn_auth_code;
	txn_no                        	:= l_txn_no;
	txn_date                      	:= l_txn_date;
	txn_comp_code                 	:= l_txn_comp_code;
	txn_msg                       	:= l_txn_msg;
   RETURN RC;
   END sc_send_payment_details;

   FUNCTION  sc_get_terminal_id(
			terminal_id         	IN OUT	VARCHAR2
			)  RETURN PLS_INTEGER IS
	RC                   		PLS_INTEGER;
	l_terminal_id                 	VARCHAR2(256)	:= RPAD(SUBSTR(NVL(terminal_id,' '),1,256),256,CHR(0));
   BEGIN

	rc := i_sc_get_terminal_id(
			fh_sc_get_terminal_id,
			l_terminal_id);
	terminal_id                   	:= l_terminal_id;
   RETURN RC;
   END sc_get_terminal_id;

   FUNCTION  sc_dll_init RETURN PLS_INTEGER IS
	RC                   		PLS_INTEGER;
   BEGIN

	rc := i_sc_dll_init(
			fh_sc_dll_init);
   RETURN RC;
   END sc_dll_init;


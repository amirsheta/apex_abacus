FUNCTION Get_Windows_Version RETURN VARCHAR2 is
  iRC        PLS_INTEGER := 0;
  rcBuff     VARCHAR2(30);
  vcBuff1    VARCHAR2(30) := rpad(' ',30); 
  vcBuff2    VARCHAR2(16) := rpad(' ',16);
begin 
  Win_API_Debug_PDF.DebugLog(99,'Get_Windows_Version','Args: <No Arguments>');	  	 	
  Win_API_PDF.Clean_Error_Stack;
  if Win_API_PDF.API_ENABLED then 
    Win_API_PDF.Register_function_call(iGetWindowsVersion,'d2kwutil_GetWindowsVersion','INT','*CHAR,*CHAR');
    iRC   := d2kwutil_GetWindowsVersion(Win_API_PDF.FunctionHandle(iGetWindowsVersion),vcBuff1,vcBuff2);
    Win_API_Debug_PDF.DebugLog(99,'Get_Windows_Version','Result:  RC='||to_char(iRC)||', vcBuff1="'||vcBuff1||'", vcBuff2="'||vcBuff2||'"');	      
  else
    raise Win_API_PDF.NOT_AVAILABLE;
  end if; 

  if iRC = 1 and vcBuff2 = '1998' then
    rcBuff := 'Windows98';
  elsif iRC = 1 then 
    rcBuff := 'Windows95';
  elsif iRC = 2  and substr(vcBuff1,1,1) = '5' then 
    rcBuff := 'Windows2000';
  elsif iRC = 2 then 
    rcBuff := 'WindowsNT';
  else
    rcBuff := 'Unknown Type: '||to_char(iRC)||' BuildInfo: '||vcBuff1;
  end if;
  
  return rcBuff;
exception
  when Win_API_PDF.NOT_AVAILABLE then
    Win_API_PDF.Add_error('Get_Windows_Version',Win_API_PDF.NoAPI);
    raise;
  when others then 
    Win_API_PDF.Add_error('Get_Windows_Version',Win_API_PDF.UError||Win_API_PDF.Add_External_errors); 
    raise;
end Get_Windows_Version;

PROCEDURE Get_Default_Printer (  PrinterName     OUT  VARCHAR2,
                                 Port            OUT  VARCHAR2,
                                 RaiseExceptions IN   BOOLEAN DEFAULT FALSE) is
  
  vcBuff1  VARCHAR2(513);
  vcBuff2  VARCHAR2(513);
begin
  Win_API_Dialog_PDF.ChoosePrinter('Get_Default_Printer',vcBuff1, vcBuff2,1,RaiseExceptions);
  PrinterName := vcBuff1;
  Port        := vcBuff2;
end Get_Default_Printer;


END WIN_API_ENVIRONMENT_PDF;


PACKAGE WIN_API_FILE_PDF IS

/*-------------------------------------------------------------------------*\
 * WIN_API_FILE -> This package is concerned with getting information 
 *                 about and Manipulating files.
 * Contents:
 *    Created_Date     -> Obtain the date on which a file
 *                        was created
 *    Accessed_Date    -> Obtain the date on which a file
 *                        was last Accessed NTFS & FAT32 Only
 *    Modified_Date    -> Obtain the date on which a file
 *                        was last changed
 *    File_Size        -> Obtain the Size of the file in bytes
 *    File_Atttributes -> Obtain the various file attributes
 *
 *    Open_File        -> Opens a Binary file for Reading and Writing
 *    Close_File       -> Closes a Binary File. 
 *    Rewind_file      -> Positions the File pointer to the start of the 
 *                        file
 *    Flush_File_Buffer-> Forces the data in the file buffer to file
 *    Read_Data        -> Read data from a file
 *    Write_Data       -> Write data to a file
 *    Temp_File        -> Creates a temporary file that can be written to
 *                        and is automatically cleaned up on close.
 *    Get_Pointer      -> Get the current position of the file pointer
 *    Set_Pointer      -> Set the current position of the file pointer 
 *    End_Of_File      -> Returns True if the End-Of-File marker has been Reached.  
 * Dependancies:
 *    WIN_API
 *    WIN_API_DEBUG
\*-------------------------------------------------------------------------*/ 

/*-------------------------------------------------------------------------*\
 * Created_Date     -> The date/time that the File was created
 * Arguments: 
 *  FileName        -> The location and name of the file to check
 *  ReturnDate      -> Oracle Date variable containing the date 
 *                     requested.
 *  ReturnMS        -> Returns the Milliseconds portion of the date
 *                     that is not covered in the Normal date format 
 *  RaiseExceptions -> TRUE of FALSE(Default) If set to true, then if the 
 *                     command is not successful (e.g the file does 
 *                     not exist) then the explicit exception
 *                     NO_DATA_FOUND will be raised.
 * Returns:
 *  (NONE)
\*-------------------------------------------------------------------------*/
 
PROCEDURE Created_Date ( FileName        IN   VARCHAR2,
                         ReturnDate      OUT  DATE,
                         ReturnMS        OUT  NUMBER,
                         RaiseExceptions IN   BOOLEAN DEFAULT FALSE);

/*-------------------------------------------------------------------------*\
 * Accessed_Date    -> The date/time that the File was last Accessed
 *                      (NTFS & FAT32 only)
 * Arguments: 
 *  FileName        -> The location and name of the file to check
 *  ReturnDate      -> Oracle Date variable containing the date 
 *                     requested.
 *  ReturnMS        -> Returns the Milliseconds portion of the date
 *                     that is not covered in the Normal date format 
 *  RaiseExceptions -> TRUE of FALSE(Default) If set to true, then if the 
 *                     command is not successful (e.g the file does 
 *                     not exist) then the explicit exception
 *                     NO_DATA_FOUND will be raised.
 * Returns:
 *  (NONE)
\*-------------------------------------------------------------------------*/
 
PROCEDURE Accessed_Date( FileName        IN   VARCHAR2,
                         ReturnDate      OUT  DATE,
                         ReturnMS        OUT  NUMBER,
                         RaiseExceptions IN   BOOLEAN DEFAULT FALSE);


/*-------------------------------------------------------------------------*\
 * Modified_Date    -> The date/time that the File was last changed
 * Arguments: 
 *  FileName        -> The location and name of the file to check
 *  ReturnDate      -> Oracle Date variable containing the date 
 *                     requested.
 *  ReturnMS        -> Returns the Milliseconds portion of the date
 *                     that is not covered in the Normal date format 
 *  RaiseExceptions -> TRUE of FALSE(Default) If set to true, then if the 
 *                     command is not successful (e.g the file does 
 *                     not exist) then the explicit exception
 *                     NO_DATA_FOUND will be raised.
 * Returns:
 *  (NONE)
\*-------------------------------------------------------------------------*/
 
PROCEDURE Modified_Date ( FileName        IN   VARCHAR2,
                          ReturnDate      OUT  DATE,
                          ReturnMS        OUT  NUMBER,
                          RaiseExceptions IN   BOOLEAN DEFAULT FALSE);

/*-------------------------------------------------------------------------*\
 * File_Size         -> The Size in Bytes of the named file
 * Arguments: 
 *  FileName         -> The location and name of the file to check
 *  RaiseExceptions  -> TRUE of FALSE(Default) If set to true, then if the 
 *                      command is not successful (e.g the file does 
 *                      not exist) then the explicit exception
 *                      NO_DATA_FOUND will be raised.
 * Returns:
 *  Size of the File in Bytes
\*-------------------------------------------------------------------------*/
 
FUNCTION File_Size (  FileName            IN  VARCHAR2,
                      RaiseExceptions     IN   BOOLEAN DEFAULT FALSE) return NUMBER;

/*-------------------------------------------------------------------------*\
 * File_Attributes  -> Attributes of the named file
 * Arguments: 
 *  FileName        -> The location and name of the file to check
 *  Archive         -> Boolean 
 *  Compressed      -> Boolean
 *  Hidden          -> Boolean
 *  ReadOnly        -> Boolean
 *  System          -> Boolean
 *  Temporary       -> Boolean
 *  RaiseExceptions -> TRUE of FALSE(Default) If set to true, then if the 
 *                     command is not successful (e.g the file does 
 *                     not exist) then the explicit exception
 *                     NO_DATA_FOUND will be raised.
 * Returns:
 *  (NONE)
\*-------------------------------------------------------------------------*/
 
PROCEDURE File_Attributes ( FileName         IN   VARCHAR2,
                            Archive          OUT  BOOLEAN,
                            Compressed       OUT  BOOLEAN,
                            Hidden           OUT  BOOLEAN,
                            ReadOnly         OUT  BOOLEAN,
                            System           OUT  BOOLEAN,
                            Temporary        OUT  BOOLEAN,
                            RaiseExceptions  IN   BOOLEAN DEFAULT FALSE);
                            
/*-------------------------------------------------------------------------*\
 * Open_File  -> Opens a Binary File to allow reading and writing
 * Arguments:
 *  Filename  -> Name of the file to open
 *  FileMode  -> One of the following Indicators
 *               "r"  opens an existing file for Reading
 *               "W"  opens new file for Writing.  If the file already exists
 *                    its contents will be destroyed
 *               "a"  opens new or existing file for Appending 
 *                    (EOF marker not removed)
 *                    All writes occur at the end of the file existing data cannot
 *                    be overwritten
 *               "r+" opens existing file for Reading and Writing 
 *               "w+" opens new file for Reading and Writing
 *               "a+" opens new or existing file for Reading and Appending
 *                    (EOF marker is removed)
 *                    All writes occur at the end of the file existing data cannot
 *                    be overwritten
 *              NOTE: If reading and writing at the same time you must ensure that
 *                    you reposition the file pointer before switching between 
 *                    the read and write operations.
 *  RaiseExceptions-> TRUE of FALSE(Default) If set to true, then if the file 
 *                    could not be opened, the exception NO_DATA_FOUND will be
 *                    raised.
 * Return Value: Handle to the opened file of type WIN_API.FILE_TYPE
\*-------------------------------------------------------------------------*/                            
 Function Open_File (FileName IN VARCHAR2, FileMode IN VARCHAR2, RaiseExceptions IN BOOLEAN DEFAULT FALSE) return WIN_API_PDF.FILE_TYPE;
 
/*-------------------------------------------------------------------------*\
 * Close_File  -> Closes a Binary File that was opened with Open_File
 * Arguments:
 *  FileHandle -> Variable of Type WIN_API.FILE_TYPE for the file to close.
 *  RaiseExceptions-> TRUE of FALSE(Default) If set to true, then if the file 
 *                    could not be closed, the exception NO_DATA_FOUND will be
 *                    raised. 
\*-------------------------------------------------------------------------*/                             
 Procedure Close_File (FileHandle IN WIN_API_PDF.FILE_TYPE, RaiseExceptions IN BOOLEAN DEFAULT FALSE);
                                                                                                  
/*-------------------------------------------------------------------------*\
 * Rewind_File  -> Repositions the File pointer to the beginning of the file
 * Arguments:
 *  FileHandle -> Variable of Type WIN_API.FILE_TYPE for the file.
 *  RaiseExceptions-> TRUE of FALSE(Default) If set to true, then if an empty 
 *                    file handle is passed NO_DATA_FOUND will be raised. 
\*-------------------------------------------------------------------------*/                             
 Procedure Rewind_File (FileHandle IN WIN_API_PDF.FILE_TYPE, RaiseExceptions IN BOOLEAN DEFAULT FALSE);                                                                                                  

/*-------------------------------------------------------------------------*\
 * Read_Data  -> Reads  up to c.16k of data from the current position
 *               of the File Pointer
 *
 * Arguments:
 *  FileHandle     -> Variable of Type WIN_API.FILE_TYPE for the file.
 *  DataBuffer     -> A VARCHAR2 variable long enough to take the requested
 *                    amount of data. You should make this twice the length 
 *                    of the number of bytes that will be returned.
 *                    If the IgnoreNulls boolean is set to FALSE any 
 *                    NULLs that are read from the file will be translated
 *                    into "\0" in the databuffer and likewise any "\" characters 
 *                    will be translated into "\\"
 *                    Otherwise NULLs will be converted to "." and "\" 
 *                    will remain as a single "\"
 *  BytesRequired  -> The Number of Bytes that you want to read. Max value is 16165 bytes
 *  IgnoreNulls    -> Control the representation of NULL characters.
 *  BytesRead      -> The number of bytes actually read.  This may be less that the 
 *                    number requested if the End-Of-File Marker was encountered 
 *                    before the full number of bytes was read.
 *                    If the Number of Bytes returned is less than the length of
 *                    the databuffer after the function has returned, this 
 *                    indicates that there are NULLs or "\" characters that have
 *                    escaped using "\0" and "\\" respectively.
 *  RaiseExceptions-> TRUE of FALSE(Default) If set to true, then if there
 *                    is a read error then NO_DATA_FOUND will be raised. 
 *  Return Value:     Boolean, Returns TRUE if you have not yet encountered 
 *                    the end of file marker.  Returns FALSE if the EOF was 
 *                    encountered during this read.
\*-------------------------------------------------------------------------*/                             
 Function Read_Data(FileHandle      IN     WIN_API_PDF.FILE_TYPE,
                    DataBuffer      IN OUT VARCHAR2,                    
                    BytesRequired   IN     PLS_INTEGER,
                    IgnoreNulls     IN     BOOLEAN DEFAULT FALSE,
                    BytesRead       IN OUT PLS_INTEGER,
                    RaiseExceptions IN     BOOLEAN DEFAULT FALSE) return BOOLEAN;

/*-------------------------------------------------------------------------*\
 * Write_Data  -> Writes up to c.16k of data from the current position
 *                of the File Pointer (or the end of file if operating in 
 *                Append Mode)
 * Arguments:
 *  FileHandle     -> Variable of Type WIN_API.FILE_TYPE for the file.
 *  DataBuffer     -> A VARCHAR2 variable containing the Data to Write
 *                    you can write up to 16165 bytes in a single operation
 *                    If your data contains NULL characters 0x00 then you must
 *                    encode it as \0,  To specify a "\" character (0x5C - 
 *                    decimal value 92) you must escape it with another "\"
 *                    character, thus \0 == NULL and \\ == \
 *                    For convenience the function will also translate the 
 *                    escapes \n and \t into newline and tab respectivly
 *  RaiseExceptions-> TRUE of FALSE(Default) If set to true, then if there
 *                    is a write error then NO_DATA_FOUND will be raised. 
\*-------------------------------------------------------------------------*/                             
 Procedure Write_Data(FileHandle      IN     WIN_API_PDF.FILE_TYPE,
                      DataBuffer      IN     VARCHAR2,
                      RaiseExceptions IN BOOLEAN DEFAULT FALSE);
                      
/*-------------------------------------------------------------------------*\
 * Flush_File_Buffer -> Forces the file buffer to be flushed 
 *                      to disk. 
 *                      You need to make this call when switching 
 *                      modes on a Read / Write file.
 * Arguments:
 *  RaiseExceptions-> TRUE of FALSE(Default) If set to true, then if the file 
 *                    could not be opened, the exception NO_DATA_FOUND will be
 *                    raised.
\*-------------------------------------------------------------------------*/                            
 Procedure Flush_File_Buffer (FileHandle      IN     WIN_API_PDF.FILE_TYPE, RaiseExceptions IN BOOLEAN DEFAULT FALSE);


/*-------------------------------------------------------------------------*\
 * Temp_File  -> Creates and Opens a Temporary file reading and writing
 *               The File is opened in w+ mode.
 *               The file is automatically deleted on close or exit.
 * Arguments:
 *  RaiseExceptions-> TRUE of FALSE(Default) If set to true, then if the file 
 *                    could not be opened, the exception NO_DATA_FOUND will be
 *                    raised.
 * Return Value: Handle to the opened file of type WIN_API.FILE_TYPE
\*-------------------------------------------------------------------------*/                            
 Function Temp_File (RaiseExceptions IN BOOLEAN DEFAULT FALSE) return WIN_API_PDF.FILE_TYPE;
 
                                            
/*-------------------------------------------------------------------------*\
 * Get_Pointer  -> Returns the current position of the file pointer
 * Arguments:
 *  FileHandle     -> Variable of Type WIN_API.FILE_TYPE for the file.
 *  RaiseExceptions-> TRUE of FALSE(Default) If set to true, then if the
 *                    file handle is invalid then NO_DATA_FOUND will be
 *                    raised. 
\*-------------------------------------------------------------------------*/  
 Function  Get_Pointer(FileHandle      IN     WIN_API_PDF.FILE_TYPE,
                       RaiseExceptions IN     BOOLEAN DEFAULT FALSE) return PLS_INTEGER;
                       
/*-------------------------------------------------------------------------*\
 * Set_Pointer     -> Sets the current position of the file pointer
 * Arguments:
 *  FileHandle     -> Variable of Type WIN_API.FILE_TYPE for the file.
 *  StartPos       -> Varchar2 string containing one of the following
 *                    START|END|CURRENT
 *                    Defines where the offset value should be calculated 
 *                    from
 *  Offset         -> Number of Bytes from StartPos to move the Pointer
 *                    
 *  RaiseExceptions-> TRUE of FALSE(Default) If set to true, then if the
 *                    file handle is invalid or the set_pos fails
 *                    then NO_DATA_FOUND will be raised. 
\*-------------------------------------------------------------------------*/  
 Procedure Set_Pointer(FileHandle      IN      WIN_API_PDF.FILE_TYPE,
 					   StartPos        IN      VARCHAR2,
 					   Offset          IN      PLS_INTEGER,
                       RaiseExceptions IN      BOOLEAN DEFAULT FALSE);
                       
/*-------------------------------------------------------------------------*\
 * End_Of_File  -> Checks to see if the End-of-File marker has been reached
 *                 on the specified file.
 * Arguments:
 *  FileHandle     -> Variable of Type WIN_API.FILE_TYPE for the file.
 *  RaiseExceptions-> TRUE of FALSE(Default) If set to true, then if the file 
 *                    handle is invalid, the exception NO_DATA_FOUND will be
 *                    raised.
 * Return Value: BOOLEAN TRUE if the EOF has been reached.
\*-------------------------------------------------------------------------*/                            
 Function End_of_File (FileHandle IN WIN_API_PDF.FILE_TYPE, RaiseExceptions IN BOOLEAN DEFAULT FALSE) return BOOLEAN;
                       
END WIN_API_FILE_PDF;


PACKAGE BODY WIN_API_FILE_PDF is
-- Constants for maintaining the Function Handle Array
-- These should be unique through the Whole Library
-- File has indexes in the range 400 - 499
iFileInfo          CONSTANT  PLS_INTEGER  := 400;
iFileOpen          CONSTANT  PLS_INTEGER  := 401;
iFileClose         CONSTANT  PLS_INTEGER  := 402;
iFileRewind        CONSTANT  PLS_INTEGER  := 403;
iFileRead          CONSTANT  PLS_INTEGER  := 404;
iFileWrite         CONSTANT  PLS_INTEGER  := 405;
iFileTell          CONSTANT  PLS_INTEGER  := 406;
iFileSeek          CONSTANT  PLS_INTEGER  := 407;
iFileTemp          CONSTANT  PLS_INTEGER  := 408;
iFileFlush         CONSTANT  PLS_INTEGER  := 409;
iFileEOF           CONSTANT  PLS_INTEGER  := 410;


-- Shared Variables
iBuff1          pls_integer;
iBuff2          pls_integer;
iBuff3          pls_integer;
iBuff4          pls_integer;
iBuff5          pls_integer;
iBuff6          pls_integer;
iBuff7          pls_integer;
iBuff8          pls_integer;
iBuff9          pls_integer;

-- Private Program unit headers
PROCEDURE File_info (        CalledBy         IN  VARCHAR2,
                             FileName         IN  VARCHAR2,
                             Option1          IN  PLS_INTEGER,
                             Option2          IN  PLS_INTEGER,
                             RaiseExceptions  IN  BOOLEAN);
PROCEDURE CheckFileHandle (  CalledBy         IN  VARCHAR2,
                             FileHandle       IN  Win_API_PDF.FILE_TYPE);  
                                                                                                                                                         
FUNCTION d2kwutil_FileInfo ( hFunc      IN      ORA_FFI.funcHandleType,
                             FileName   IN OUT  VARCHAR2,
                             Option1    IN      PLS_INTEGER,
                             Option2    IN      PLS_INTEGER,
                             dwOut1     IN OUT  PLS_INTEGER,
                             dwOut2     IN OUT  PLS_INTEGER,
                             dwOut3     IN OUT  PLS_INTEGER,
                             dwOut4     IN OUT  PLS_INTEGER,
                             dwOut5     IN OUT  PLS_INTEGER,
                             dwOut6     IN OUT  PLS_INTEGER,
                             dwOut7     IN OUT  PLS_INTEGER
                           ) return PLS_INTEGER;

FUNCTION d2kwutil_FileOpen ( hFunc      IN      ORA_FFI.funcHandleType,
                             FileName   IN OUT  VARCHAR2,
                             FileMode   IN OUT  VARCHAR2                      
                           ) return Win_API_PDF.FILE_TYPE;

FUNCTION d2kwutil_FileClose( hFunc      IN      ORA_FFI.funcHandleType,
                             FileHandle IN      PLS_INTEGER
                           ) return PLS_INTEGER;

PROCEDURE d2kwutil_FileRewind( hFunc      IN      ORA_FFI.funcHandleType,
                               FileHandle IN      PLS_INTEGER);
                           
FUNCTION d2kwutil_FileRead(  hFunc      IN      ORA_FFI.funcHandleType,
                             FileHandle IN      PLS_INTEGER,
                             Buffer     IN OUT  VARCHAR2,
                             Bytes      IN      PLS_INTEGER,
                             NullMask   IN OUT  VARCHAR2,
                             NullChar   IN      PLS_INTEGER,
                             EOF        IN OUT  PLS_INTEGER 
                           ) return PLS_INTEGER;

FUNCTION d2kwutil_FileWrite( hFunc      IN      ORA_FFI.funcHandleType,
                             FileHandle IN      PLS_INTEGER,
                             Buffer     IN      VARCHAR2,
                             Bytes      IN      PLS_INTEGER,
                             NullMask   IN      VARCHAR2 
                           ) return PLS_INTEGER;

FUNCTION d2kwutil_FileTell ( hFunc      IN      ORA_FFI.funcHandleType,
                             FileHandle IN      PLS_INTEGER
                           ) return PLS_INTEGER;
                             
FUNCTION d2kwutil_FileSeek( hFunc      IN      ORA_FFI.funcHandleType,
                             FileHandle IN      PLS_INTEGER,
                             Origin     IN      PLS_INTEGER,
                             Offset     IN      PLS_INTEGER) return PLS_INTEGER;

FUNCTION d2kwutil_FileTemp( hFunc      IN      ORA_FFI.funcHandleType
                          ) return PLS_INTEGER;
                          
FUNCTION d2kwutil_FileFlush(hFunc      IN      ORA_FFI.funcHandleType,
                            FileHandle IN      PLS_INTEGER
                           ) return PLS_INTEGER;

FUNCTION d2kwutil_FileEOF(  hFunc      IN      ORA_FFI.funcHandleType,
                            FileHandle IN      PLS_INTEGER
                           ) return PLS_INTEGER;



-- Pragmas
PRAGMA INTERFACE(C,d2kwutil_FileInfo,  11265);
PRAGMA INTERFACE(C,d2kwutil_FileOpen,  11265);
PRAGMA INTERFACE(C,d2kwutil_FileClose, 11265);
PRAGMA INTERFACE(C,d2kwutil_FileRewind,11265);
PRAGMA INTERFACE(C,d2kwutil_FileRead,  11265);
PRAGMA INTERFACE(C,d2kwutil_FileWrite, 11265);
PRAGMA INTERFACE(C,d2kwutil_FileTell,  11265);
PRAGMA INTERFACE(C,d2kwutil_FileSeek,  11265);
PRAGMA INTERFACE(C,d2kwutil_FileTemp,  11265);
PRAGMA INTERFACE(C,d2kwutil_FileFlush, 11265);
PRAGMA INTERFACE(C,d2kwutil_FileEOF,   11265);

-- Internal Bodies

Procedure File_info ( CalledBy         IN  VARCHAR2,  
                      FileName         IN  VARCHAR2,
                      Option1          IN  PLS_INTEGER,
                      Option2          IN  PLS_INTEGER,
                      RaiseExceptions  IN BOOLEAN) is
 vcBuff1  varchar2(512);
 iRC      pls_integer;
begin
  Win_API_Debug_PDF.DebugLog(99,'File_Info','Args:  CalledBy="'||CalledBy||'", FileName="'||FileName||'", Option1='||to_char(Option1)||', Option2='||to_char(Option2)||', RaiseExceptions='||Win_API_Debug_PDF.booltochar(RaiseExceptions));	  	
  Win_API_PDF.Clean_Error_Stack;
  iRC    := 0;
  iBuff1 := 0;
  iBuff2 := 0;
  iBuff3 := 0;
  iBuff4 := 0;
  iBuff5 := 0;
  iBuff6 := 0;
  iBuff7 := 0;
  iBuff8 := 0;
  iBuff9 := 0;
  
  if Win_API_PDF.API_ENABLED then 
    Win_API_PDF.Register_function_call(iFileInfo,'d2kwutil_FileInfo','LONG','*CHAR,INT,INT,*LONG,*LONG,*LONG,*LONG,*LONG,*LONG,*LONG');
    vcBuff1 := RPAD(Filename,512,CHR(0));
    iBuff1  := Option1;
    iBuff2  := Option2;
    iRC     := d2kwutil_FileInfo(Win_API_PDF.FunctionHandle(iFileInfo),vcBuff1,iBuff1,iBuff2,iBuff3,iBuff4,iBuff5,iBuff6,iBuff7,iBuff8,iBuff9);
    Win_API_Debug_PDF.DebugLog(99,'File_Info','Result:  RC='||to_char(iRC)||', iBuff1='||to_char(iBuff1)||', iBuff2='||to_char(iBuff2)||', iBuff3='||to_char(iBuff3)||', iBuff4='||to_char(iBuff4)||', iBuff5='||to_char(iBuff5)||', iBuff6='||to_char(iBuff6)||', iBuff7='||to_char(iBuff7)||', iBuff8='||to_char(iBuff8)||', iBuff9='||to_char(iBuff9));
  else 
    raise Win_API_PDF.NOT_AVAILABLE;
  end if;
  if iRC in (0, -1074255551, -1074245406) then
    Win_API_PDF.Add_error(CalledBy,'File '||FileName||' does not exist');
    if RaiseExceptions then 
      raise NO_DATA_FOUND;
    end if;
  elsif iRC <> 1 then 
    Win_API_PDF.Add_error(CalledBy,'Gathering Information about '||FileName||' generated system error '||to_char(iRC));
    if RaiseExceptions then 
      raise NO_DATA_FOUND;
    end if;
  end if;
exception
  when NO_DATA_FOUND then 
    raise;
  when Win_API_PDF.NOT_AVAILABLE then
    Win_API_PDF.Add_error(CalledBy,Win_API_PDF.NoAPI);
    raise;
  when others then 
    Win_API_PDF.Add_error(CalledBy, Win_API_PDF.UError||Win_API_PDF.Add_External_errors); 
    raise;
end;

PROCEDURE CheckFileHandle (  CalledBy         IN  VARCHAR2,
                             FileHandle       IN  Win_API_PDF.FILE_TYPE) is
begin 
	if FileHandle = 0 or FileHandle is NULL then
		Win_API_PDF.add_error(CalledBy,'File Handle is Invalid');
	    	Raise NO_DATA_FOUND;
	end if;
end;
                    



-- Public Bodies

PROCEDURE Created_Date (  FileName        IN   VARCHAR2,
                          ReturnDate      OUT  DATE,
                          ReturnMS        OUT  NUMBER,
                          RaiseExceptions IN   BOOLEAN DEFAULT FALSE) is
begin 
  File_Info('Created_Date',Filename,1,1,RaiseExceptions);
  ReturnDate := to_date(to_char(iBuff3,'0999')||to_char(iBuff4,'09')||to_char(iBuff5,'09')||to_char(iBuff6,'09')||to_char(iBuff7,'09')||to_char(iBuff8,'09'),'YYYYMMDDHH24MISS');
  ReturnMS   := iBuff9;
end Created_Date;

PROCEDURE Accessed_Date ( FileName        IN   VARCHAR2,
                          ReturnDate      OUT  DATE,
                          ReturnMS        OUT  NUMBER,
                          RaiseExceptions IN   BOOLEAN DEFAULT FALSE) is
begin 
  File_Info('Accessed_Date',Filename,1,2,RaiseExceptions);
  ReturnDate := to_date(to_char(iBuff3,'0999')||to_char(iBuff4,'09')||to_char(iBuff5,'09')||to_char(iBuff6,'09')||to_char(iBuff7,'09')||to_char(iBuff8,'09'),'YYYYMMDDHH24MISS');
  ReturnMS   := iBuff9;
end Accessed_Date;

PROCEDURE Modified_Date ( FileName        IN   VARCHAR2,
                          ReturnDate      OUT  DATE,
                          ReturnMS        OUT  NUMBER,
                          RaiseExceptions IN   BOOLEAN DEFAULT FALSE) is
begin 
  File_Info('Modified_Date',Filename,1,3,RaiseExceptions);
  ReturnDate := to_date(to_char(iBuff3,'0999')||to_char(iBuff4,'09')||to_char(iBuff5,'09')||to_char(iBuff6,'09')||to_char(iBuff7,'09')||to_char(iBuff8,'09'),'YYYYMMDDHH24MISS');
  ReturnMS   := iBuff9;
end Modified_Date;

FUNCTION File_Size (  FileName            IN   VARCHAR2,
                      RaiseExceptions     IN   BOOLEAN DEFAULT FALSE) return NUMBER is
begin
  File_Info('File_Size',Filename,2,0,RaiseExceptions);
  RETURN iBuff3;
end File_Size;


PROCEDURE File_Attributes(  FileName        IN   VARCHAR2,
                            Archive         OUT  BOOLEAN,
                            Compressed      OUT  BOOLEAN,
                            Hidden          OUT  BOOLEAN,
                            ReadOnly        OUT  BOOLEAN,
                            System          OUT  BOOLEAN,
                            Temporary       OUT  BOOLEAN,
                            RaiseExceptions IN   BOOLEAN DEFAULT FALSE) is
begin 
  File_Info('File_Attributes',Filename,3,0,RaiseExceptions);
  Archive       := (iBuff3 != 0);
  Compressed    := (iBuff4 != 0);
  /*IsDirectory  := (iBuff5 != 0); */
  Hidden        := (iBuff6 != 0);
  ReadOnly      := (iBuff7 != 0);
  System        := (iBuff8 != 0);
  Temporary     := (iBuff9 != 0);
end File_Attributes;

Function Open_File (FileName        IN VARCHAR2, 
                    FileMode        IN VARCHAR2, 
                    RaiseExceptions IN BOOLEAN DEFAULT FALSE) return Win_API_PDF.FILE_TYPE is
 ptrHandle Win_API_PDF.FILE_TYPE := 0;
 vcBuff1   VARCHAR2(256) := rpad(FileName,256,chr(0));                    
 vcBuff2   VARCHAR2(4);
begin                    
  Win_API_Debug_PDF.DebugLog(99,'Open_File','Args:  FileName="'||FileName||'", FileMode="'||FileMode||'", RaiseExceptions='||Win_API_Debug_PDF.booltochar(RaiseExceptions));	  	
  Win_API_PDF.Clean_Error_Stack;
  if Win_API_PDF.API_ENABLED then 
    Win_API_PDF.Register_function_call(iFileOpen,'d2kwutil_FileOpen','LONG','*CHAR,*CHAR');
    vcBuff2 := lower(FileMode)||'b';
    if FileName is NULL or replace(FileName,' ',NULL) is NULL then 
    	Win_API_PDF.Add_error('Open_File','You must supply the name of the file to open');
    	    if RaiseExceptions then 
      			raise NO_DATA_FOUND;
    		end if;
    else    	
        ptrHandle := d2kwutil_FileOpen(Win_API_PDF.FunctionHandle(iFileOpen),vcBuff1,vcBuff2);
        Win_API_Debug_PDF.DebugLog(99,'Open_File','Result:  File_Handle='||to_char(ptrHandle));
    end if;
  else 
    raise Win_API_PDF.NOT_AVAILABLE;
  end if;
  if ptrHandle = 0 then
    Win_API_PDF.Add_error('Open_File','Cannot open file '||FileName||' with mode "'||FileMode||'"');
    if RaiseExceptions then 
      raise NO_DATA_FOUND;
    end if;
  end if;
  return ptrHandle;
exception
  when NO_DATA_FOUND then 
    raise;
  when Win_API_PDF.NOT_AVAILABLE then
    Win_API_PDF.Add_error('Open_File',Win_API_PDF.NoAPI);
    raise;
  when others then 
    Win_API_PDF.Add_error('Open_File', Win_API_PDF.UError||Win_API_PDF.Add_External_errors); 
    raise;
end;

Procedure Close_File(FileHandle      IN Win_API_PDF.FILE_TYPE, 
                     RaiseExceptions IN BOOLEAN DEFAULT FALSE) is
 iRC       PLS_INTEGER;
begin                    
  Win_API_Debug_PDF.DebugLog(99,'Close_File','Args:  FileHandle='||to_char(FileHandle)||', RaiseExceptions='||Win_API_Debug_PDF.booltochar(RaiseExceptions));	  	
  Win_API_PDF.Clean_Error_Stack;
  if Win_API_PDF.API_ENABLED then
  	CheckFileHandle('Close_File',FileHandle);   	 
    Win_API_PDF.Register_function_call(iFileClose,'d2kwutil_FileClose','INT','LONG');   
    iRC := d2kwutil_FileClose(Win_API_PDF.FunctionHandle(iFileClose),FileHandle);
    Win_API_Debug_PDF.DebugLog(99,'Close_File','Result:  RC='||to_char(iRC));
  else 
    raise Win_API_PDF.NOT_AVAILABLE;
  end if;
  if iRC <> 0 then
    Win_API_PDF.Add_error('Close_File','Cannot Close File');
    if RaiseExceptions then 
      raise NO_DATA_FOUND;
    end if;
  end if;
exception

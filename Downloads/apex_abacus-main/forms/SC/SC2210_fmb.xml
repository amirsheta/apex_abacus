      <ProgramUnit Name="CHECK_VALUE" ProgramUnitText="PROCEDURE check_value IS&amp;#10;BEGIN&amp;#10;  DECLARE&amp;#10;  pl_id ParamList; &amp;#10;  V_REPORT_FILE VARCHAR2(100);&amp;#10;  v_count number(5); &#x9;&amp;#10;BEGIN &amp;#10;SELECT count(TCC.CLOSING_CD) into v_count &amp;#10;FROM&amp;#10;TRNST_CLSNGS TCC&amp;#10;WHERE&amp;#10;(:P_status  IS NULL  OR :P_status  = STATUS);&amp;#10; -----****&amp;#10;&amp;#10; ---*** &amp;#10; IF v_count > 0 then &amp;#10;-- -----------------------------------------------------------------------------------------   &#x9;&amp;#10;      pl_id := Get_Parameter_List('tmpdata'); &amp;#10;     IF NOT Id_Null(pl_id) THEN &amp;#10;      Destroy_Parameter_List( pl_id ); &amp;#10;     END IF; &amp;#10;    pl_id := Create_Parameter_List('tmpdata'); &amp;#10;    Add_Parameter(pl_id,'DESTYPE',TEXT_PARAMETER,'SCREEN'); &amp;#10;    Add_Parameter(pl_id,'PARAMFORM',TEXT_PARAMETER,'NO'); &amp;#10;    Add_Parameter(pl_id,'PRINTJOB',TEXT_PARAMETER,'YES'); &amp;#10;    Add_Parameter(pl_id,'P_STATUS',TEXT_PARAMETER,:P_STATUS);&amp;#10;   &amp;#10;        Add_Parameter(pl_id,'P_REPORT_NO',TEXT_PARAMETER,:REPORT_NO);&amp;#10;  Add_Parameter(pl_id,'P_CURR_PORT_CD',TEXT_PARAMETER,:PARAMETER.P_CURR_PORT_CD);&amp;#10;  Add_Parameter(pl_id,'P_MODULE_NAME',TEXT_PARAMETER,:PARAMETER.P_MODULE_NAME);&amp;#10;   Add_Parameter(pl_id,'P_CLASS_CD',TEXT_PARAMETER,:PARAMETER.P_CLASS_CD);&amp;#10;  Add_Parameter(pl_id,'P_MODULE_ID',TEXT_PARAMETER,:PARAMETER.P_MODULE_ID);&amp;#10;    ADD_PARAMETER(pl_id,'ORACLE_SHUTDOWN',TEXT_PARAMETER,'YES');&amp;#10;    ADD_PARAMETER(pl_id,'MAXIMIZE',TEXT_PARAMETER,'YES');&amp;#10;    V_REPORT_FILE := :PARAMETER.P_REPORT_PATH||:PARAMETER.P_REPORT_FILE;&amp;#10;       rep.Run_Product( REPORTS , V_REPORT_FILE , SYNCHRONOUS, RUNTIME , FILESYSTEM , pl_id , NULL); &amp;#10; ELSE&amp;#10;  &#x9;&amp;#10;&#x9;MESSAGE('لا يوجد سجلات  تحقق المطلوب'); &amp;#10;&#x9;MESSAGE(' لا يوجد سجلات تحقق المطلوب');&amp;#10;&#x9;RAISE FORM_TRIGGER_FAILURE;&amp;#10; END IF;&amp;#10;&amp;#10; END ;&amp;#10;END;&amp;#10;" ProgramUnitType="Procedure"/>

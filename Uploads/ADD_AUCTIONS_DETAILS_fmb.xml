      <Trigger Name="WHEN-NEW-FORM-INSTANCE" DirtyInfo="true" TriggerText="DECLARE&amp;#10;&#x9;V_PORT_NAME VARCHAR2(50);&amp;#10;&#x9;V_DCLTN_AUCTION_ISN NUMBER ;&amp;#10;BEGIN&amp;#10;&#x9;SET_WINDOW_PROPERTY('CGSO$WINDOW_1',TITLE,:PARAMETER.WINDOW_TITLE);&amp;#10;  &amp;#10;       :DCLTN_TYPE_CD&#x9;:= :PARAMETER.P_DCLTN_TYPE_CD;&amp;#10;       :DCLTN_NBR     := :PARAMETER.P_DCLTN_NBR ;&amp;#10;       :DCLTN_DT      := :PARAMETER.P_DCLTN_DT ; &amp;#10;    &amp;#10;      SELECT TYPE_NAME&amp;#10;      INTO  :DCLTN_TYPE_NAME&amp;#10;      FROM   DCLTN_TYPES &amp;#10;      WHERE  TYPE_ID = :PARAMETER.P_DCLTN_TYPE_CD;&amp;#10;      &amp;#10;    SET_ITEM_PROPERTY('DCLTN_TYPE_CD',ENABLED,PROPERTY_FALSE);&amp;#10;    SET_ITEM_PROPERTY('DCLTN_NBR',ENABLED,PROPERTY_FALSE);&amp;#10;    SET_ITEM_PROPERTY('DCLTN_DT',ENABLED,PROPERTY_FALSE);&amp;#10;    SET_ITEM_PROPERTY('DCLTN_TYPE_NAME',ENABLED,PROPERTY_FALSE);&amp;#10;    &amp;#10; &#x9;BEGIN&amp;#10;   SELECT DCLTN_AUCTION_ISN&amp;#10;    INTO :PARAMETER.DCLTN_AUCTION_ISN&amp;#10;    FROM DCLTN_AUCTIONS&amp;#10;    WHERE PORT_CD       = :PARAMETER.P_PORT_CD &amp;#10;    AND   DCLTN_TYPE_CD&#x9;= :PARAMETER.P_DCLTN_TYPE_CD&amp;#10;    AND   DCLTN_NBR     = :PARAMETER.P_DCLTN_NBR &amp;#10;    AND   DCLTN_DT      = :PARAMETER.P_DCLTN_DT ; &amp;#10;&#x9;EXCEPTION WHEN NO_DATA_FOUND THEN &amp;#10;&#x9;&#x9;  NULL ;&amp;#10;   END ; &amp;#10;    &amp;#10;IF :PARAMETER.DCLTN_AUCTION_ISN IS NOT NULL THEN &amp;#10;  &#x9;   &amp;#10;  &#x9;     SELECT AUCTION_NBR ,  AUCTION_FEES , AUCTION_VALUE ,AUCTION_FEES_INV_NBR  ,AUCTION_VALUE_INV_NBR&amp;#10;  &#x9;      INTO :AUCTION_NBR ,  :AUCTION_FEES , :AUCTION_VALUE ,:AUCTION_FEES_INV_NBR  ,:AUCTION_VALUE_INV_NBR&amp;#10;  &#x9;     FROM DCLTN_AUCTIONS &amp;#10;  &#x9;   WHERE PORT_CD           =  :PARAMETER.P_PORT_CD&amp;#10;  &#x9;     AND DCLTN_AUCTION_ISN =  :PARAMETER.DCLTN_AUCTION_ISN ;&amp;#10;END IF;&amp;#10;  &#x9;&amp;#10;  &#x9;IF :AUCTION_NBR IS NOT NULL THEN &amp;#10;  &#x9;&#x9;SET_ITEM_PROPERTY('AUCTION_NBR',NAVIGABLE,PROPERTY_FALSE);&amp;#10;  &#x9;   SET_ITEM_PROPERTY('AUCTION_NBR',ENABLED,PROPERTY_FALSE);&amp;#10;  &#x9;END IF;&amp;#10;  &#x9;IF :AUCTION_FEES IS NOT NULL THEN &amp;#10;  &#x9;&#x9;SET_ITEM_PROPERTY('AUCTION_FEES',NAVIGABLE,PROPERTY_FALSE);&amp;#10;  &#x9;   SET_ITEM_PROPERTY('AUCTION_FEES',ENABLED,PROPERTY_FALSE);&amp;#10;  &#x9;END IF;&amp;#10;      &#x9;IF :AUCTION_VALUE IS NOT NULL THEN &amp;#10;      &#x9;&#x9;SET_ITEM_PROPERTY('AUCTION_VALUE',NAVIGABLE,PROPERTY_FALSE);&amp;#10;  &#x9;   SET_ITEM_PROPERTY('AUCTION_VALUE',ENABLED,PROPERTY_FALSE);&amp;#10;      &#x9;END IF;&amp;#10;         &#x9;IF :AUCTION_FEES_INV_NBR IS NOT NULL THEN&amp;#10;         &#x9;&#x9;SET_ITEM_PROPERTY('AUCTION_FEES_INV_NBR',NAVIGABLE,PROPERTY_FALSE); &amp;#10;  &#x9;   SET_ITEM_PROPERTY('AUCTION_FEES_INV_NBR',ENABLED,PROPERTY_FALSE);&amp;#10;      &#x9;END IF;&amp;#10;      &#x9;      /*  &#x9;IF :AUCTION_VALUE_INV_NBR IS NOT NULL THEN&amp;#10;      &#x9;        &#x9;&#x9;SET_ITEM_PROPERTY('AUCTION_VALUE_INV_NBR',NAVIGABLE,PROPERTY_FALSE);  &amp;#10;  &#x9;   SET_ITEM_PROPERTY('AUCTION_VALUE_INV_NBR',ENABLED,PROPERTY_FALSE);&amp;#10;      &#x9;END IF;*/&amp;#10;END;&amp;#10;if :PARAMETER.P_PORT_CD is not null then&amp;#10;DECLARE &amp;#10;&#x9;V_PORT_TYPE NUMBER;&amp;#10;BEGIN &amp;#10;&#x9;&#x9;SELECT PORT_TYPE &amp;#10;&#x9;&#x9;INTO V_PORT_TYPE&amp;#10;&#x9;&#x9;FROM SD_PORTS&amp;#10;    WHERE PORT_CD =:PARAMETER.P_PORT_CD;&amp;#10;    &amp;#10;END;&amp;#10;end if;"/>
      <Trigger Name="ON-ERROR" DirtyInfo="true" TriggerText=" DECLARE  &amp;#10;   errnum NUMBER       := ERROR_CODE;  &amp;#10;   errtxt VARCHAR2(80) := ERROR_TEXT;  &amp;#10;   errtyp VARCHAR2(20)  := ERROR_TYPE;  &amp;#10;   alert_is     alert;   &amp;#10;   alert_button number;&amp;#10;   MsgTxt VARCHAR2(2000);&amp;#10;   &amp;#10; BEGIN  &amp;#10;&#x9; IF errnum = 41051 then&amp;#10;&#x9; &#x9;null;&amp;#10;&#x9; else&amp;#10;&#x9; &#x9; IF errtyp = 'FRM' THEN&amp;#10;&#x9;&#x9; &#x9;errtyp := 'خطأ : ش';&amp;#10;&#x9;&#x9; ELSIF errtyp = 'ORA' THEN&amp;#10;&#x9;&#x9; &#x9;errtyp := 'خطأ : ق';&amp;#10;&#x9;&#x9; END IF;&amp;#10;&#x9;&#x9; &amp;#10;&#x9;&#x9; MsgTxt := errtyp||'-'||TO_CHAR(errnum)||': '||errtxt;&amp;#10;&#x9;   alert_is := find_alert('CFG_ERROR');  &amp;#10;&#x9;&amp;#10;&#x9;&#x9; if  (not id_null(alert_is)) then &amp;#10;&#x9;  &#x9;&#x9;set_alert_property(alert_is, ALERT_MESSAGE_TEXT, MsgTxt );  &amp;#10;&#x9;  &#x9;&#x9;alert_button := show_alert(alert_is);  &amp;#10;&#x9;&#x9; else&amp;#10;&#x9;     Message(MsgTxt);  &amp;#10;&#x9;&#x9; end if;&amp;#10;&#x9;&#x9;&amp;#10;&#x9;  RAISE Form_Trigger_Failure;  &amp;#10;end if;&amp;#10; END;  &amp;#10;  &amp;#10; "/>
      <Trigger Name="ON-MESSAGE" DirtyInfo="true" TriggerText=" DECLARE  &amp;#10;   msgnum NUMBER       := MESSAGE_CODE;  &amp;#10;   msgtxt VARCHAR2(80) := MESSAGE_TEXT;  &amp;#10;   msgtyp VARCHAR2(20)  := MESSAGE_TYPE;  &amp;#10; BEGIN&amp;#10;&#x9; IF msgtyp = 'FRM' THEN&amp;#10;&#x9; &#x9;msgtyp := 'معلومه : ش';&amp;#10;&#x9; ELSIF msgtyp = 'ORA' THEN&amp;#10;&#x9; &#x9;msgtyp := 'معلومه : ق';&amp;#10;&#x9; END IF;&amp;#10;&#x9; &#x9;&amp;#10; &#x9;&#x9;&#x9;&amp;#10;     Message(msgtyp||'-'||TO_CHAR(msgnum)||': '||msgtxt);  &amp;#10;&amp;#10; END;  &amp;#10;  &amp;#10; "/>
      <Trigger Name="PRE-FORM" DirtyInfo="true" TriggerText="/* CGYR$SET_DATE_FORMAT */&amp;#10;/* Establish Single Standard Format Mask with 4-digit-year element */&amp;#10;BEGIN&amp;#10;  set_application_property(DATE_FORMAT_COMPATIBILITY_MODE, '5.0');&amp;#10;  set_application_property(PLSQL_DATE_FORMAT, 'YYYY/MM/DD HH24:MI:SS');&amp;#10;  set_application_property(BUILTIN_DATE_FORMAT, 'YYYY/MM/DD HH24:MI:SS');&amp;#10;  forms_ddl('ALTER SESSION SET NLS_DATE_FORMAT = ''YYYY/MM/DD HH24:MI:SS''');&amp;#10;END;&amp;#10;"/>

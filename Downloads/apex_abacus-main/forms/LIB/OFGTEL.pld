.attach LIBRARY Ofgmes END NOCONFIRM


PROCEDURE CG$CHK_PACKAGE_FAILURE IS
/* If packaged procedure has failed then raise */
/* FORM_TRIGGER_FAILURE */
BEGIN
  IF NOT FORM_SUCCESS THEN
    RAISE FORM_TRIGGER_FAILURE;
  END IF;
END;


PACKAGE cg$form_errors IS

 procedure raise_failure;

 procedure push(msg      in varchar2,
                error    in varchar2 default 'I',
                msg_type in varchar2 default '',
                msgid    in integer  default 0,
                loc      in varchar2 default '');


 function  MsgGetText(p_MsgNo    in Number,
                      p_DfltText in Varchar2 default null,
                      p_Subst1   in Varchar2 default null,
                      p_Subst2   in Varchar2 default null,
                      p_Subst3   in Varchar2 default null,
                      p_Subst4   in Varchar2 default null,
                      p_lanId    in number   default null)
      return varchar2;
END;


PACKAGE BODY cg$form_errors IS

procedure raise_failure is
begin
  raise form_trigger_failure;
end;

procedure push(msg      in varchar2,
               error    in varchar2 default 'I',
               msg_type in varchar2 default '',
               msgid    in integer  default 0,
               loc      in varchar2 default '')
is
  msg_string   varchar2(1000) := msg;
  alert_is     alert;
  alert_button number;
begin

/* select the alert to use from the template form */
/* according to the value in errt                 */
if (error  = 'F')  
then  
  alert_is   := find_alert('CFG_SYSTEM_ERROR');
  msg_string := 'Fatal Error: '||msg_string;   
elsif (error  = 'E')  
then  
  alert_is := find_alert('CFG_ERROR');  
  msg_string := 'Error: '||msg_string;   
elsif (error = 'W')  
then  
  alert_is := find_alert('CFG_WARNING_A');  
  msg_string := 'Warning: '||msg_string;
elsif (error  = 'I')  
then  
  alert_is := find_alert('CFG_INFORMATION');  
  msg_string := 'Information: '||msg_string;
end if;  

if (error IN ('F','E','W','I'))  
and (not id_null(alert_is)) 
then 
  set_alert_property(alert_is, ALERT_MESSAGE_TEXT, msg_string );  
  alert_button := show_alert(alert_is);  
else
  message(msg_string);
end if;  

end;

procedure push(msg      in varchar2,
               error    in boolean  default TRUE,
               msg_type in varchar2 default '',
               msgid    in integer  default 0,
               loc      in varchar2 default '')
is
begin
  message(msg);
end;

function  MsgGetText(p_MsgNo    in Number,
                     p_DfltText in Varchar2 default null,
                     p_Subst1   in Varchar2 default null,
                     p_Subst2   in Varchar2 default null,
                     p_Subst3   in Varchar2 default null,
                     p_Subst4   in Varchar2 default null,
                     p_lanId    in number   default null)
     return varchar2 is
  l_temp varchar2(1000) := p_DfltText;
BEGIN

  /* Get the message from the library */
  /* for generator messages           */
  if ( p_MsgNo != 0 )
  then
    cg$message.get_message(p_MsgNo, l_temp, p_Subst1, p_Subst2, p_Subst3, p_Subst4);
  end if;

  l_temp := replace(l_temp, '<p1>', p_Subst1);
  l_temp := replace(l_temp, '<p2>', p_Subst2);
  l_temp := replace(l_temp, '<p3>', p_Subst3);
  l_temp := replace(l_temp, '<p4>', p_Subst4);

  return l_temp;

END;


END;


PACKAGE cg$globals IS
  block_where_clause varchar2(2000) := 'first_time';
END;


procedure CG$QUERY_FIND (lov_name       in VARCHAR2) is  
begin  
  validate(record_scope);  
  if not(FORM_SUCCESS) then  
    go_item(name_in('SYSTEM.ERROR_BLOCK')||'.'  
          ||name_in('SYSTEM.ERROR_ITEM'));  
    raise FORM_TRIGGER_FAILURE;  
  end if;  
  
  if show_LOV(lov_name) then  
    do_key('clear_block');  
    -- Make sure the clear block was successful  
    if name_in('SYSTEM.BLOCK_STATUS') != 'NEW' then  
      raise FORM_TRIGGER_FAILURE;  
    end if;  
   
    copy('TRUE', 'parameter.CG$QUERY_FIND');  
    do_key('Execute_Query');  
    copy('FALSE', 'parameter.CG$QUERY_FIND');  
  
  end if;  
end cg$query_find; 


PACKAGE CGDV$REF_CODES IS

  /* Hard LOV style domain validation */

  /* overload the validate function for the six scenarios  */
  /* 1) Validate char field with meaning displayed         */
  /* 2) Validate number field with meaning displayed       */
  /* 3) Validate date field with meaning displayed         */
  /* 4) Validate char field                                */
  /* 5) Validate number field                              */
  /* 6) Validate date field                                */
         
  /* Validate char field with meaning displayed */
  function val( rg_name    in     varchar2
               ,rg_value   in out varchar2
               ,rg_meaning in out varchar2
               ,val_code   in     boolean
              ) return boolean;
         
  /* Validate number field with meaning displayed */
  function val( rg_name    in     varchar2
               ,rg_value   in out number
               ,rg_meaning in out varchar2
               ,val_code   in     boolean
              ) return boolean;
  /* Validate date field with meaning displayed */
  function val( rg_name    in     varchar2
               ,rg_value   in out date
               ,rg_meaning in out varchar2
               ,fmt_mask   in     varchar2
               ,val_code   in     boolean
              ) return boolean;
         
  /* Validate char field without meaning displayed */
  function val( rg_name    in     varchar2
               ,rg_value   in out varchar2
              ) return boolean;
         
  /* Validate number field without meaning displayed */
  function val( rg_name    in     varchar2
               ,rg_value   in out number
              ) return boolean;

  /* Validate date field without meaning displayed */
  function val( rg_name    in     varchar2
               ,rg_value   in out date
               ,fmt_mask   in     varchar2
              ) return boolean;


  /* Soft LOV style domain validation */

  /* overload the validate function for the three scenarios  */
  /* 1) Validate char field with meaning displayed           */
  /* 2) Validate number field with meaning displayed         */
  /* 3) Validate date field with meaning displayed           */
  /* 4) Validate char field without meaning displayed        */
  /* 5) Validate number field without meaning displayed      */
  /* 6) Validate date field without meaning displayed        */

/* Check numeric ref codes */
  procedure soft_val( p_value   in out number
                     ,p_domain  in     varchar2
                     ,p_table   in     varchar2 default null
                    );

  /* Check character ref codes */
  procedure soft_val( p_value   in out varchar2
                     ,p_domain  in     varchar2
                     ,p_table   in     varchar2 default null
                    );

  /* Check date ref codes */
  procedure soft_val( p_value   in out date
                     ,p_domain  in     varchar2
                     ,fmt_mask  in     varchar2
                     ,p_table   in     varchar2 default null
                    );

  /* Check numeric ref codes */
  procedure soft_val( p_value   in out number
                     ,p_meaning in out varchar2
                     ,p_domain  in     varchar2
                     ,p_val_code  in     boolean
                     ,p_table   in     varchar2 default null
                    );

  /* Check character ref codes */
  procedure soft_val( p_value   in out varchar2
                     ,p_meaning in out varchar2
                     ,p_domain  in     varchar2
                     ,p_val_code  in     boolean
                     ,p_table   in     varchar2 default null
                    );

  /* Check date ref codes */
  procedure soft_val( p_value   in out date
                     ,p_meaning in out varchar2
                     ,p_domain  in     varchar2
                     ,fmt_mask  in     varchar2
                     ,p_val_code  in     boolean
                     ,p_table   in     varchar2 default null
                    );
END;


PACKAGE BODY CGDV$REF_CODES IS
 
  rg_id        RecordGroup;
  low_value    GroupColumn;
  high_value   GroupColumn;
  abbreviation GroupColumn;
  meaning      GroupColumn;
  RowCount     Number;
 
  procedure setup(rg_name in varchar2);
 
 
/* Validate char field with meaning displayed */
function val( rg_name    in     varchar2
             ,rg_value   in out varchar2
             ,rg_meaning in out varchar2
             ,val_code   in     boolean
            ) return boolean
IS
BEGIN
  setup(rg_name);
  /* 
  ** Loop through the records, getting the specified column's 
  ** value at each iteration and comparing it to 'the_value' 
  ** passed in.  Compare the values in a case insensitive 
  ** manner. 
  */ 
  FOR j IN 1..Rowcount
  LOOP 
    /* 
    ** Several different scenarios here:
    ** i)  range
    ** ii) use abbreviation
    */ 
  if (val_code)
  then
    IF (Id_Null(high_value) )  /* High value is null - not a range */
    THEN 
      If (rg_value = Get_Group_Char_Cell( low_value, j ))
      then
 
        rg_meaning := Get_Group_Char_Cell( meaning, j );
        return(TRUE);
 
      elsif ((Id_Null(abbreviation) = FALSE ) 
         and (rg_value = Get_Group_Char_Cell( abbreviation, j)))
      then
 
        rg_value   := Get_Group_Char_Cell( low_value, j );
        rg_meaning := Get_Group_Char_Cell( meaning, j );
        return(TRUE);
 
      end if;
    ELSE
      /* ie it is a range */
      if ( ( ascii(rg_value) >= ascii(Get_Group_Char_Cell( low_value, j )))
       and ( ascii(rg_value) <= ascii(Get_Group_Char_Cell( high_value, j))) )
      then
        rg_meaning := Get_Group_Char_Cell( meaning, j );
        return(TRUE);
      end if;
    END IF; 
  else
    If (rg_meaning = Get_Group_Char_Cell( meaning, j ))
    then
      rg_value := Get_Group_Char_Cell( low_value, j );
      return(TRUE);
    end if;
  end if;
  END LOOP; 
 
  /* If we didn't find a value then set the output to NULL */
  if (val_code)
  then
    rg_meaning := NULL;
  else
  	rg_value := NULL;
  end if;
  
  return(FALSE);
 
END;
 
/* Validate number field with meaning displayed */
function val( rg_name    in     varchar2
             ,rg_value   in out number
             ,rg_meaning in out varchar2
             ,val_code   in     boolean
            ) return boolean
IS
BEGIN

  setup(rg_name); 
  /* 
  ** Loop through the records, getting the specified column's 
  ** value at each iteration and comparing it to 'the_value' 
  ** passed in.  Compare the values in a case insensitive 
  ** manner. 
  */ 
  FOR j IN 1..Rowcount
  LOOP
  	if (val_code)
  		then 
	    IF (Id_Null(high_value) )  /* High value is null - not a range */
	    THEN 
	      If (rg_value = Get_Group_Char_Cell( low_value, j ))
	      then
	 
	        rg_meaning := Get_Group_Char_Cell( meaning, j );
	        return(TRUE);
	 
	      end if;
	    ELSE
	      /* ie it is a range */
	      if ( ( rg_value >= to_number(Get_Group_Char_Cell( low_value, j )))
	       and ( rg_value <= to_number(Get_Group_Char_Cell( high_value, j))) )
	      then
	        rg_meaning := Get_Group_Char_Cell( meaning, j );
	        return(TRUE);
	      end if;
	    END IF; 
    else
      If (rg_meaning = Get_Group_Char_Cell( meaning, j ))
      then
        rg_value := Get_Group_Char_Cell( low_value, j );
        return(TRUE);
      end if;
    end if;
  END LOOP; 
  
  /* If we didn't find a value then set the output to NULL */
  if (val_code)
  then
    rg_meaning := NULL;
  else
  	rg_value := NULL;
  end if;
  
  return(FALSE);
 
END;

/* Validate date field with meaning displayed */
function val( rg_name    in     varchar2
             ,rg_value   in out date
             ,rg_meaning in out varchar2
             ,fmt_mask   in     varchar2
             ,val_code   in     boolean
            ) return boolean
IS
--  fmt_mask varchar2(200) := get_item_property(:SYSTEM.TRIGGER_ITEM, FORMAT_MASK);
BEGIN
  
  setup(rg_name); 

  /* 
  ** Loop through the records, getting the specified column's 
  ** value at each iteration and comparing it to 'the_value' 
  ** passed in.  Compare the values in a case insensitive 
  ** manner. 
  */ 
  FOR j IN 1..Rowcount
  LOOP 
  	if (val_code)
  	then
	    IF (Id_Null(high_value) )  /* High value is null - not a range */
	    THEN 
	      If (rg_value = to_date(Get_Group_Char_Cell( low_value,j), fmt_mask))
	      then
	 
	        rg_meaning := Get_Group_Char_Cell( meaning, j );
	        return(TRUE);
	 
	      end if;
	    ELSE
	
	      /* ie it is a range */
	      if ( ( rg_value >= to_date(Get_Group_Char_Cell( low_value, j ), fmt_mask))
	       and ( rg_value <= to_date(Get_Group_Char_Cell( high_value, j), fmt_mask)) )
	      then
	        rg_meaning := Get_Group_Char_Cell( meaning, j );
	        return(TRUE);
	      end if;
	    END IF; 
    else
      If (rg_meaning = Get_Group_Char_Cell( meaning, j ))
      then
        rg_value := Get_Group_Char_Cell( low_value, j );
        return(TRUE);
      end if;
    end if;
  END LOOP; 
   
  /* If we didn't find a value then set the output to NULL */
  if (val_code)
  then
    rg_meaning := NULL;
  else
  	rg_value := NULL;
  end if;
  
  return(FALSE);
END;


 
/* Validate char field without meaning displayed */
function val( rg_name    in     varchar2
             ,rg_value   in out varchar2
            ) return boolean
IS
BEGIN
  setup(rg_name);
  /* 
  ** Loop through the records, getting the specified column's 
  ** value at each iteration and comparing it to 'the_value' 
  ** passed in.  Compare the values in a case insensitive 
  ** manner. 
  */ 
  FOR j IN 1..Rowcount
  LOOP 
    /* 
    ** Several different scenarios here:
    ** i)  range
    ** ii) use abbreviation
    */ 
    IF (Id_Null(high_value) )  /* High value is null - not a range */
    THEN 
      If (rg_value = Get_Group_Char_Cell( low_value, j ))
      then
        return(TRUE);
      elsif ((Id_Null(abbreviation) = FALSE ) 
         and (rg_value = Get_Group_Char_Cell( abbreviation, j)))
      then
        rg_value   := Get_Group_Char_Cell( low_value, j );
        return(TRUE);
      end if;
    ELSE
      /* ie it is a range */
      if ( ( ascii(rg_value) >= ascii(Get_Group_Char_Cell( low_value, j )))
       and ( ascii(rg_value) <= ascii(Get_Group_Char_Cell( high_value, j))) )
      then
        return(TRUE);
      end if;
    END IF; 
  END LOOP; 
 
  return(FALSE);
 
END;
 
/* Validate number field without meaning displayed */

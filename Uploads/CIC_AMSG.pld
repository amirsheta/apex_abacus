

PACKAGE Des$Form_errors IS
  --**********************************************************
	-- refere to M.Fetouh 26-5-2001

 procedure raise_failure;

 procedure push(msg      in varchar2,
                error    in varchar2 default 'I',
                msg_type in varchar2 default '',
                msgid    in integer  default 0,
                loc      in varchar2 default '');


 function  MsgGetText(p_MsgNo    in Number,
                      p_DfltText in Varchar2 default null,
                      p_Subst1   in Varchar2 default null,
                      p_Subst2   in Varchar2 default null,
                      p_Subst3   in Varchar2 default null,
                      p_Subst4   in Varchar2 default null,
                      p_lanId    in number   default null)
      return varchar2;
END;


PACKAGE BODY Des$Form_errors IS

  --**********************************************************
	-- refere to M.Fetouh 26-5-2001
------------------------------------------------------------------------------------
procedure raise_failure is
------------------------------------------------------------------------------------
begin
  raise form_trigger_failure;
end;


  --**********************************************************
	-- refere to M.Fetouh 26-5-2001
	
------------------------------------------------------------------------------------
procedure push(msg      in varchar2,
               error    in varchar2 default 'I',
               msg_type in varchar2 default '',
               msgid    in integer  default 0,
               loc      in varchar2 default '')
is
------------------------------------------------------------------------------------
  msg_string   varchar2(2000) := msg;
  alert_is     alert;
  alert_button number;
begin


if (msgid = 0)
	then
	declare
		First_Pos number;
		Second_Pos number;
		tmp1 varchar2(2000);
		tmp2 varchar2(2000);
	begin
		tmp1 := replace(msg_string, 'FRM', 'Ô');
		tmp2 := replace(tmp1, 'ORA', 'Ş');
			
		msg_string := tmp2; 
	end;
	
end if;

/* select the alert to use from the template form */
/* according to the value in errt                 */
if (error  = 'F')  
then  
  alert_is   := find_alert('CFG_SYSTEM_ERROR');
  msg_string := 'ÎØÃ ÈÇáäÙÇã : '||msg_string;   
elsif (error  = 'E')  
then  
  alert_is := find_alert('CFG_ERROR');  
  msg_string := 'ÎØÃ : '||msg_string;   
elsif (error = 'W')  
then  
  alert_is := find_alert('CFG_WARNING_A');  
  msg_string := 'ÊÍĞíÑ : '||msg_string;
elsif (error  = 'I')  
then  
  alert_is := find_alert('CFG_INFORMATION');  
  msg_string := 'ãÚáæãå : '||msg_string;
end if;  


if (error IN ('F','E', 'W'))    
and (not id_null(alert_is)) 
then 
  set_alert_property(alert_is, ALERT_MESSAGE_TEXT, msg_string );  
  alert_button := show_alert(alert_is);  
	raise_failure;
else
  message(msg_string);
end if;  

end;

  --**********************************************************
	-- refere to M.Fetouh 26-5-2001
	
------------------------------------------------------------------------------------
procedure push(msg      in varchar2,
               error    in boolean  default TRUE,
               msg_type in varchar2 default '',
               msgid    in integer  default 0,
               loc      in varchar2 default '')
is
------------------------------------------------------------------------------------
begin
  message(msg);
end;

  --**********************************************************
	-- refere to M.Fetouh 26-5-2001
	
------------------------------------------------------------------------------------
function  MsgGetText(p_MsgNo    in Number,
                     p_DfltText in Varchar2 default null,
                     p_Subst1   in Varchar2 default null,
                     p_Subst2   in Varchar2 default null,
                     p_Subst3   in Varchar2 default null,
                     p_Subst4   in Varchar2 default null,
                     p_lanId    in number   default null)
     return varchar2 is
------------------------------------------------------------------------------------
  l_temp varchar2(2000) := p_DfltText;
BEGIN

  /* Get the message from the library */
  /* for generator messages           */
  if ( p_MsgNo != 0 )
  then
    Des$message.get_message(p_MsgNo, l_temp, p_Subst1, p_Subst2, p_Subst3, p_Subst4);
  end if;

  l_temp := replace(l_temp, '<p1>', p_Subst1);
  l_temp := replace(l_temp, '<p2>', p_Subst2);
  l_temp := replace(l_temp, '<p3>', p_Subst3);
  l_temp := replace(l_temp, '<p4>', p_Subst4);

  return l_temp;

END;


END;


PACKAGE Des$MESSAGE IS
  --**********************************************************
	-- refere to M.Fetouh 26-5-2001
	

  /*
   * Call this function from the procedure defined in the 
   * MSGSFT preference.  'msg' will be returned containing
   * a string for display if it is a known generator message
   * otherwise it will be null.
   */
  procedure get_message(msgno  in     varchar2
                       ,msg    in out varchar2
                       ,param1 in     varchar2 default ''
                       ,param2 in     varchar2 default ''
                       ,param3 in     varchar2 default ''
                       ,param4 in     varchar2 default '');

  procedure split_string(msg    in     varchar2
                        ,pcount in     number
                        ,s1     in out varchar2
                        ,s2     in out varchar2
                        ,s3     in out varchar2
                        ,s4     in out varchar2
                        ,s5     in out varchar2);
 
  procedure mess_list(msgno  in  varchar2
                     ,str    out varchar2);


END;


PACKAGE BODY Des$Message IS

  --**********************************************************
	-- refere to M.Fetouh 26-5-2001
	
----------------------------------------------------------------------------------
procedure get_message
(msgno  in     varchar2
,msg    in out varchar2
,param1 in     varchar2 default ''
,param2 in     varchar2 default ''
,param3 in     varchar2 default ''
,param4 in     varchar2 default '')
IS
----------------------------------------------------------------------------------
  tmp_string     varchar2(200) := msg;
  tmp_string1    varchar2(200) := '';
  tmp_string2    varchar2(200) := '';
  tmp_string3    varchar2(200) := '';
  tmp_string4    varchar2(200) := '';
  tmp_end_string varchar2(200) := '';
  param_count    number        := 4;
BEGIN

  mess_list(msgno, msg);

  -- find out how many parameters there are...
  if (param4 is null) then param_count := 3; end if;
  if (param3 is null) then param_count := 2; end if;
  if (param2 is null) then param_count := 1; end if;
  if (param1 is null) then param_count := 0; end if;

  if (param_count != 0)
  then
    split_string(msg,param_count,tmp_string1,tmp_string2,
                   tmp_string3,tmp_string4,tmp_end_string);

    msg := tmp_string1||param1||tmp_string2||param2||
           tmp_string3||param3||tmp_string4||param4||tmp_end_string;

  end if;

END; /* get_message */

  --**********************************************************
	-- refere to M.Fetouh 26-5-2001

----------------------------------------------------------------------------------
PROCEDURE split_string
(msg    in     varchar2
,pcount in     number
,s1     in out varchar2
,s2     in out varchar2
,s3     in out varchar2
,s4     in out varchar2
,s5     in out varchar2)
IS
----------------------------------------------------------------------------------
  tmp varchar2(200) := msg;
BEGIN

  -- chop up the message string
  if (pcount >= 1) then
    s1  := substr(tmp,1,instr(tmp,'%s')-1);
    tmp := substr(tmp,length(s1||'%s')+1);
  end if;

  if (pcount >= 2) then
    s2  := substr(tmp,1,instr(tmp,'%s')-1);
    tmp := substr(tmp,length(s2||'%s')+1);
  end if;

  if (pcount >= 3) then
    s3  := substr(tmp,1,instr(tmp,'%s')-1);
    tmp := substr(tmp,length(s3||'%s')+1);
  end if;

  if (pcount = 4) then
    s4  := substr(tmp,1,instr(tmp,'%s')-1);
    tmp := substr(tmp,length(s4||'%s')+1);
  end if;

  s5  := tmp;

END; /* split_string */


  --**********************************************************
	-- refere to M.Fetouh 26-5-2001

----------------------------------------------------------------------------------

   FUNCTION  StartTrans(
			AMOUNT              	IN OUT	VARCHAR2,
			DOCUMENTTYPE        	IN OUT	VARCHAR2,
			DOCUMENTNUMBER      	IN OUT	VARCHAR2,
			HIJRADATE           	IN OUT	VARCHAR2,
